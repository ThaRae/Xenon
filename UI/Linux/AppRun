#!/bin/sh
# The AppImage's entry point (Meta/release.py packages it). The AppImage's runtime mounts the image and starts this from
# it; Xenon then finds its helper processes, libraries and resources relative to its own executable, in usr/.

appdir=$(dirname "$(readlink -f "$0")")

# Qt plugins that the system's settings point at are built for the system's Qt, not the one in the AppImage.
unset QT_PLUGIN_PATH

# OpenSSL looks for the system's certificates where the build's was configured to, in /etc/ssl, which isn't where every
# distribution keeps them (Fedora's are in /etc/pki). Unless they've been pointed elsewhere already, point it at the
# system's bundle. The engine passes SSL_CERT_FILE on to the process that makes requests.
if [ -z "${SSL_CERT_FILE:-}" ] && [ -z "${SSL_CERT_DIR:-}" ]; then
    for bundle in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/ca-bundle.pem \
        /etc/pki/tls/cacert.pem /etc/ssl/cert.pem; do
        if [ -f "$bundle" ]; then
            SSL_CERT_FILE=$bundle
            export SSL_CERT_FILE
            break
        fi
    done
fi

if [ -n "${APPIMAGE:-}" ] && [ -f "$appdir/usr/share/applications/org.xenon.Xenon.desktop" ]; then
    appimage=$(readlink -f "$APPIMAGE")
    exec_path=$(printf '%s\n' "$appimage" | sed -e 's/\\/\\\\/g' -e 's/["`$]/\\&/g' -e 's/%/%%/g')
    try_exec_path=$(printf '%s\n' "$appimage" | sed -e 's/\\/\\\\/g')
    data_home=${XDG_DATA_HOME:-"$HOME"/.local/share}
    applications_dir=$data_home/applications
    desktop_file=$applications_dir/org.xenon.Xenon.desktop
    mkdir -p "$applications_dir"
    while IFS= read -r line; do
        case $line in
            "Exec=Xenon "*) printf 'Exec="%s" %s\n' "$exec_path" "${line#Exec=Xenon }" ;;
            "[Desktop Entry]") printf '%s\nTryExec=%s\n' "$line" "$try_exec_path" ;;
            *) printf '%s\n' "$line" ;;
        esac
    done < "$appdir/usr/share/applications/org.xenon.Xenon.desktop" > "$desktop_file.$$"
    if cmp -s "$desktop_file.$$" "$desktop_file"; then
        rm -f "$desktop_file.$$"
    else
        mv "$desktop_file.$$" "$desktop_file"
        if command -v update-desktop-database >/dev/null; then
            update-desktop-database "$applications_dir"
        fi
    fi
    icons_dir=$data_home/icons/hicolor
    for icon in "$appdir"/usr/share/icons/hicolor/*/apps/org.xenon.Xenon.png; do
        [ -f "$icon" ] || continue
        size=$(basename "$(dirname "$(dirname "$icon")")")
        mkdir -p "$icons_dir/$size/apps"
        cmp -s "$icon" "$icons_dir/$size/apps/org.xenon.Xenon.png" || cp "$icon" "$icons_dir/$size/apps/org.xenon.Xenon.png"
    done
fi

exec "$appdir/usr/bin/Xenon" "$@"
