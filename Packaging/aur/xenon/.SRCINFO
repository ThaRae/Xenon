	makedepends = python
	makedepends = qt6-base
	makedepends = qt6-positioning
	makedepends = qt6-tools
	makedepends = qt6-wayland
	makedepends = rustup
	makedepends = tar
	makedepends = unzip
	makedepends = xcb-util-wm
	makedepends = zip
	depends = expat
	depends = fontconfig
