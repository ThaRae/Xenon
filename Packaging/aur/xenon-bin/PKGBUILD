# Maintainer: ThaRae <https://github.com/ThaRae>

pkgname=xenon-bin
pkgver=0.1.3
pkgrel=1
pkgdesc='Web browser built on the Ladybird engine, with the features of Helium'
arch=(x86_64)
url='https://github.com/ThaRae/Xenon'
license=(BSD-2-Clause GPL-3.0-only MIT CC0-1.0)
depends=(expat fontconfig freetype2 glibc harfbuzz hicolor-icon-theme libdrm libgcc libglvnd libice libsm libstdc++
         libx11 libxcb ttf-font wayland zlib)
optdepends=('pulse-native-provider: audio'
            'geoclue: geolocation')
makedepends=(squashfs-tools)
provides=(xenon)
conflicts=(xenon)
options=(!strip !debug !emptydirs)
source=("https://github.com/ThaRae/xenon-releases/releases/download/v$pkgver/Xenon-$pkgver-$CARCH.AppImage")
noextract=("Xenon-$pkgver-$CARCH.AppImage")
sha256sums=('e8b2fbb5afd5f392b116390fd83c673643d6c14ab8d81cf8096c16d50d81aa43')

prepare() {
  local appimage=Xenon-$pkgver-$CARCH.AppImage
  local section_headers section_header_size section_header_count
  section_headers=$(od -An -j40 -N8 -tu8 "$appimage")
  section_header_size=$(od -An -j58 -N2 -tu2 "$appimage")
  section_header_count=$(od -An -j60 -N2 -tu2 "$appimage")
  rm -rf Xenon.AppDir
  unsquashfs -quiet -no-progress -offset $((section_headers + section_header_size * section_header_count)) \
    -dest Xenon.AppDir "$appimage"
}

package() {
  local app_dir=Xenon.AppDir

  install -d "$pkgdir/usr/lib/xenon" "$pkgdir/usr/bin"
  cp -a "$app_dir/AppRun" "$app_dir/usr" "$pkgdir/usr/lib/xenon/"
  ln -s /usr/lib/xenon/AppRun "$pkgdir/usr/bin/xenon"

  install -Dm644 "$app_dir/usr/share/applications/org.xenon.Xenon.desktop" -t "$pkgdir/usr/share/applications"
  sed -i 's/^Exec=Xenon/Exec=xenon/' "$pkgdir/usr/share/applications/org.xenon.Xenon.desktop"
  cp -a "$app_dir/usr/share/icons" "$pkgdir/usr/share/"

  install -Dm644 "$app_dir/usr/share/Lagom/xenon/filter-lists/"{NOTICE.txt,LICENSE-GPL-3.0.txt} \
    -t "$pkgdir/usr/share/licenses/$pkgname/filter-lists"
}
