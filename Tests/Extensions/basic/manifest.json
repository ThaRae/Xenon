{
    "manifest_version": 3,
    "name": "__MSG_name__",
    "description": "Xenon's test extension for chrome-extension:// pages and the chrome.* APIs they use.",
    "version": "1.0",
    "default_locale": "en",
    "action": {
        "default_popup": "popup.html",
        "default_title": "__MSG_title__",
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png"
        }
    },
    "permissions": [
        "storage",
        "alarms",
        "tabs",
        "offscreen"
    ],
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    }
}
