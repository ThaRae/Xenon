From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan <ryan@esterlines.com>
Date: Thu, 29 Oct 2026 09:36:07 -0400
Subject: [PATCH] AK+LibWeb: Decommit the memory used to build the content
 blocker

On Linux, mimalloc is set to purge by resetting pages (MADV_FREE),
which leaves them in the process's RSS until the kernel is short of
memory, so the collect after building the content blocker's engine did
not give its several-times-larger peak back. Add
ak_kmalloc_decommit_free_pages(), which decommits for one collect and
then puts the purge option back as it was, and use it there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 AK/kmalloc.cpp                             | 17 +++++++++++++++++
 AK/kmalloc.h                               |  1 +
 Libraries/LibWeb/Loader/ContentBlocker.cpp |  4 +++-
 3 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/AK/kmalloc.cpp b/AK/kmalloc.cpp
index 759ea183bcbb014902ec566727e99f8e244fb465..a89185eb2db1d3f0c169d8dc4e15a2ef7497c15b 100644
--- a/AK/kmalloc.cpp
+++ b/AK/kmalloc.cpp
@@ -106,6 +106,10 @@ extern "C" void ladybird_did_end_short_lived_thread()
 {
 }
 
+void ak_kmalloc_decommit_free_pages()
+{
+}
+
 #else
 
 #    if defined(AK_OS_LINUX) || defined(AK_OS_MACOS)
@@ -239,4 +243,17 @@ extern "C" void ladybird_did_end_short_lived_thread()
 #    endif
 }
 
+void ak_kmalloc_decommit_free_pages()
+{
+    // On Linux a purge only resets pages (see MimallocConfiguration above), which keeps them in RSS until the kernel is
+    // short of memory, so ak_kmalloc_collect() alone does not give a process's memory back. Decommit for this collect
+    // instead, so that freed pages leave the process's RSS and PSS. Later reuse faults them in again, so this is for a
+    // moment when the process is not about to allocate much, not for every collect. Where purges already decommit
+    // (mimalloc's default, kept on macOS), the option is left as it was.
+    auto purge_decommits = mi_option_get(mi_option_purge_decommits);
+    mi_option_set(mi_option_purge_decommits, 1);
+    ak_kmalloc_collect();
+    mi_option_set(mi_option_purge_decommits, purge_decommits);
+}
+
 #endif
diff --git a/AK/kmalloc.h b/AK/kmalloc.h
index da02a54142c94b9e6281b269a46fb21259431e42..de297a61d566a46c86c2e2e84daf903bb7b4d2a1 100644
--- a/AK/kmalloc.h
+++ b/AK/kmalloc.h
@@ -31,6 +31,7 @@ void ak_kfree(void* ptr);
 [[nodiscard]] void* ak_krealloc(HeapPartition, void* ptr, size_t size);
 [[nodiscard]] size_t ak_kmalloc_usable_size(void const* ptr);
 void ak_kmalloc_collect();
+void ak_kmalloc_decommit_free_pages();
 
 // Sends the calling thread's general allocations to a heap of their own, until ak_leave_scratch_heap() is given what
 // this returned. Work that frees nearly everything it allocates can use it to keep its temporary data out of the pages
diff --git a/Libraries/LibWeb/Loader/ContentBlocker.cpp b/Libraries/LibWeb/Loader/ContentBlocker.cpp
index 004bc2a6667e8113ae1b3c798b31625cd8635696..c4d0c52deaa92d99a2428178340f4a9ec8a365d0 100644
--- a/Libraries/LibWeb/Loader/ContentBlocker.cpp
+++ b/Libraries/LibWeb/Loader/ContentBlocker.cpp
@@ -162,7 +162,9 @@ ErrorOr<void> ContentBlocker::set_rules_from_bytes(ReadonlyBytes rules_bytes, Re
 {
     // NB: Building an engine allocates several times what the engine keeps, on this thread, whose heap nothing else
     //     collects. Give that memory back, and an old engine's, rather than keeping it for the life of the process.
-    ScopeGuard collect_memory = [] { ak_kmalloc_collect(); };
+    //     A plain collect only resets the freed pages on Linux, which keeps them in RSS, so decommit them: this runs
+    //     only when the rules arrive or change, not on every collect.
+    ScopeGuard collect_memory = [] { ak_kmalloc_decommit_free_pages(); };
 
     // OPTIMIZATION: Building an engine costs the same tokenizing and flatbuffer work whether or not there are any
     //               rules to put in it, and every caller already treats a missing engine as "nothing is blocked".
