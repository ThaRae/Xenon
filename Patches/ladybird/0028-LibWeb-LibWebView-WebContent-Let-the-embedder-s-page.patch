+// NB: Only the embedder's own schemes have documents it might let use the clipboard, so others don't ask.
+static bool is_embedder_scheme_document(Web::DOM::Document const& document)
+{
+    auto const& origin = document.origin();
+    return !origin.is_opaque() && origin.scheme().has_value() && URL::is_embedder_scheme(*origin.scheme());
+}
+
+bool PageClient::page_embedder_allows_clipboard_write(Web::DOM::Document& document)
+{
+    if (!is_embedder_scheme_document(document))
+        return false;
+    auto response = client().send_sync_but_allow_failure<Messages::WebContentClient::DidRequestEmbedderClipboardWriteAccess>(m_id, document.id());
+    return response && response->allowed();
+}
+
+Optional<Vector<Web::Clipboard::SystemClipboardItem>> PageClient::page_did_request_clipboard_entries_for_script(Web::DOM::Document& document)
+{
+    if (!is_embedder_scheme_document(document))
+        return {};
+    auto response = client().send_sync_but_allow_failure<Messages::WebContentClient::DidRequestEmbedderClipboardEntries>(m_id, document.id());
+    if (!response)
+        return {};
+    return response->take_items();
+}
