@@ -0,0 +1,27 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Span.h>
+#include <AK/Types.h>
+#include <LibWeb/Export.h>
+#include <LibWebCommon/Farbling/FarblingSeed.h>
+
+namespace Web::Farbling {
+
+struct WEB_API RgbaFarblingCache {
+    Seed seed {};
+    u64 content_fnv { 0 };
+    u8 hmac[32] {};
+    bool valid { false };
+};
+
+// HMAC-SHA256 of (seed, packed unpremultiplied RGBA8888), then XOR the low bit of one RGB channel of one pixel for
+// each 16 bits of the digest. No-op when Off, when the origin is opaque, or when every byte is zero.
+WEB_API void perturb_rgba8888(Bytes pixels, Seed const&, bool origin_is_opaque, RgbaFarblingCache* = nullptr);
+
+}
