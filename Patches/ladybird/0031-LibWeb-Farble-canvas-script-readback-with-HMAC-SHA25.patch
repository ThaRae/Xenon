+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/ByteBuffer.h>
+#include <LibTest/TestCase.h>
+#include <LibWeb/Farbling/CanvasPerturb.h>
+
+static ByteBuffer make_pixels()
+{
+    auto pixels = MUST(ByteBuffer::create_zeroed(16));
+    pixels[0] = 40;
+    pixels[1] = 80;
+    pixels[2] = 120;
+    pixels[3] = 255;
+    pixels[4] = 10;
+    pixels[5] = 20;
+    pixels[6] = 30;
+    pixels[7] = 255;
+    pixels[8] = 200;
+    pixels[9] = 150;
+    pixels[10] = 100;
+    pixels[11] = 255;
+    pixels[12] = 1;
+    pixels[13] = 2;
+    pixels[14] = 3;
+    pixels[15] = 4;
+    return pixels;
+}
+
+TEST_CASE(same_seed_and_pixels_are_deterministic)
+{
+    auto first = make_pixels();
+    auto second = make_pixels();
+    Web::Farbling::Seed seed { .level = Web::Farbling::Level::Standard, .high = 0x0123456789abcdefULL, .low = 0xfedcba9876543210ULL };
+    Web::Farbling::perturb_rgba8888(first.bytes(), seed, false);
+    Web::Farbling::perturb_rgba8888(second.bytes(), seed, false);
+    EXPECT_EQ(first.bytes(), second.bytes());
+}
+
+TEST_CASE(different_seeds_differ)
+{
+    auto first = make_pixels();
+    auto second = make_pixels();
+    Web::Farbling::perturb_rgba8888(first.bytes(), { .level = Web::Farbling::Level::Standard, .high = 1, .low = 2 }, false);
+    Web::Farbling::perturb_rgba8888(second.bytes(), { .level = Web::Farbling::Level::Standard, .high = 3, .low = 4 }, false);
+    EXPECT_NE(first.bytes(), second.bytes());
+}
+
+TEST_CASE(off_is_a_no_op)
+{
+    auto pixels = make_pixels();
+    auto original = MUST(ByteBuffer::copy(pixels));
+    Web::Farbling::perturb_rgba8888(pixels.bytes(), { .level = Web::Farbling::Level::Off, .high = 1, .low = 2 }, false);
+    EXPECT_EQ(pixels.bytes(), original.bytes());
+}
+
+TEST_CASE(blank_stays_blank)
+{
+    auto pixels = MUST(ByteBuffer::create_zeroed(16));
+    Web::Farbling::perturb_rgba8888(pixels.bytes(), { .level = Web::Farbling::Level::Standard, .high = 1, .low = 2 }, false);
+    for (auto byte : pixels.bytes())
+        EXPECT_EQ(byte, static_cast<u8>(0));
+}
+
+TEST_CASE(opaque_origin_is_a_no_op)
+{
+    auto pixels = make_pixels();
+    auto original = MUST(ByteBuffer::copy(pixels));
+    Web::Farbling::perturb_rgba8888(pixels.bytes(), { .level = Web::Farbling::Level::Standard, .high = 1, .low = 2 }, true);
+    EXPECT_EQ(pixels.bytes(), original.bytes());
+}
+
+TEST_CASE(noise_is_tiny)
+{
+    auto pixels = make_pixels();
+    auto original = MUST(ByteBuffer::copy(pixels));
+    Web::Farbling::perturb_rgba8888(pixels.bytes(), { .level = Web::Farbling::Level::Standard, .high = 1, .low = 2 }, false);
+    size_t differing = 0;
+    u8 max_delta = 0;
+    for (size_t i = 0; i < pixels.size(); ++i) {
+        u8 const delta = pixels[i] > original[i] ? pixels[i] - original[i] : original[i] - pixels[i];
+        if (delta != 0) {
+            ++differing;
+            if (delta > max_delta)
+                max_delta = delta;
+        }
+    }
+    EXPECT(differing > 0);
+    EXPECT(differing <= 16);
+    EXPECT_EQ(max_delta, static_cast<u8>(1));
+}
+
+TEST_CASE(cache_reuse_matches_fresh_hmac)
+{
+    auto cached_pixels = make_pixels();
+    auto cached_again = make_pixels();
+    auto fresh_pixels = make_pixels();
+    Web::Farbling::Seed seed { .level = Web::Farbling::Level::Standard, .high = 9, .low = 8 };
+    Web::Farbling::RgbaFarblingCache cache;
+    Web::Farbling::perturb_rgba8888(cached_pixels.bytes(), seed, false, &cache);
+    EXPECT(cache.valid);
+    Web::Farbling::perturb_rgba8888(cached_again.bytes(), seed, false, &cache);
+    Web::Farbling::perturb_rgba8888(fresh_pixels.bytes(), seed, false);
+    EXPECT_EQ(cached_pixels.bytes(), cached_again.bytes());
+    EXPECT_EQ(cached_pixels.bytes(), fresh_pixels.bytes());
+}
