new file mode 100644
index 0000000000000000000000000000000000000000..0219a55a1b6f9e4bacc1a38c6ec28be3b294a3dc
--- /dev/null
+++ b/Libraries/LibWeb/Farbling/CanvasPerturb.cpp
@@ -0,0 +1,81 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/Memory.h>
+#include <LibCrypto/Authentication/HMAC.h>
+#include <LibCrypto/Hash/HashManager.h>
+#include <LibWeb/Farbling/CanvasPerturb.h>
+
+namespace Web::Farbling {
+
+static void write_be64(u8* out, u64 value)
+{
+    for (int i = 0; i < 8; ++i)
+        out[i] = static_cast<u8>(value >> (56 - 8 * i));
+}
+
+static u64 fnv1a64(ReadonlyBytes bytes)
+{
+    u64 hash = 14695981039346656037ULL;
+    for (auto byte : bytes) {
+        hash ^= byte;
+        hash *= 1099511628211ULL;
+    }
+    return hash;
+}
+
+static bool buffer_is_blank(ReadonlyBytes pixels)
+{
+    for (auto byte : pixels) {
+        if (byte != 0)
+            return false;
+    }
+    return true;
+}
+
+static void apply_hmac_mask(Bytes pixels, u8 const hmac[32])
+{
+    size_t const pixel_count = pixels.size() / 4;
+    if (pixel_count == 0)
+        return;
+    for (size_t i = 0; i < 16; ++i) {
+        u16 const v = hmac[2 * i] | static_cast<u16>(hmac[2 * i + 1] << 8);
+        size_t const pixel = v % pixel_count;
+        u8 const channel = static_cast<u8>((v >> 8) % 3);
+        pixels[pixel * 4 + channel] ^= 1;
+    }
+}
+
+void perturb_rgba8888(Bytes pixels, Seed const& seed, bool origin_is_opaque, RgbaFarblingCache* cache)
+{
+    if (!seed.enabled() || origin_is_opaque || pixels.size() < 4 || buffer_is_blank(pixels))
+        return;
+
+    u64 const content_fnv = fnv1a64(pixels);
+    if (cache && cache->valid && cache->seed == seed && cache->content_fnv == content_fnv) {
+        apply_hmac_mask(pixels, cache->hmac);
+        return;
+    }
+
+    u8 key[16];
+    write_be64(key, seed.high);
+    write_be64(key + 8, seed.low);
+    Crypto::Authentication::HMAC hmac(Crypto::Hash::HashKind::SHA256, { key, sizeof(key) });
+    auto digest = hmac.process(pixels);
+    VERIFY(digest.size() >= 32);
+
+    if (cache) {
+        cache->seed = seed;
+        cache->content_fnv = content_fnv;
+        memcpy(cache->hmac, digest.data(), 32);
+        cache->valid = true;
+        apply_hmac_mask(pixels, cache->hmac);
+        return;
+    }
+    apply_hmac_mask(pixels, digest.data());
+}
+
+}
diff --git a/Libraries/LibWeb/Farbling/CanvasPerturb.h b/Libraries/LibWeb/Farbling/CanvasPerturb.h
