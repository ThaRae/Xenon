+}
+
+void CanvasHost::perturb_script_rgba8888(Bytes pixels)
+{
+    auto& settings = relevant_settings_object(canvas_relevant_global_object());
+    Farbling::perturb_rgba8888(pixels, settings.farbling_seed(), settings.origin().is_opaque(), &m_script_farbling_cache);
+}
+
+void CanvasHost::apply_script_farbling(Gfx::Bitmap& bitmap)
+{
+    auto& settings = relevant_settings_object(canvas_relevant_global_object());
+    auto seed = settings.farbling_seed();
+    bool const opaque_origin = settings.origin().is_opaque();
+    if (!seed.enabled() || opaque_origin)
+        return;
+
+    int const width = bitmap.width();
+    int const height = bitmap.height();
+    if (width <= 0 || height <= 0)
+        return;
+    size_t const row_bytes = static_cast<size_t>(width) * 4;
+    size_t const nbytes = row_bytes * static_cast<size_t>(height);
+    auto rgba = MUST(ByteBuffer::create_uninitialized(nbytes));
+
+    bool packed_from_readback = false;
+    if (auto* context = canvas_2d_context()) {
+        context->ensure_backing_storage();
+        auto pixels = context->read_pixels({ {}, { width, height } }, Gfx::AlphaType::Unpremultiplied, context->color_space());
+        if (pixels && pixels->size() == bitmap.size() && pixels->format() == Gfx::BitmapFormat::RGBA8888
+            && pixels->alpha_type() == Gfx::AlphaType::Unpremultiplied) {
+            for (int y = 0; y < height; ++y)
+                memcpy(rgba.data() + static_cast<size_t>(y) * row_bytes, pixels->scanline_u8(y), row_bytes);
+            packed_from_readback = true;
+        }
+    }
+    if (!packed_from_readback) {
+        if (bitmap.alpha_type() == Gfx::AlphaType::Premultiplied)
+            bitmap.set_alpha_type_destructive(Gfx::AlphaType::Unpremultiplied);
+        for (int y = 0; y < height; ++y) {
+            for (int x = 0; x < width; ++x) {
+                auto color = bitmap.get_pixel(x, y);
+                size_t const i = (static_cast<size_t>(y) * static_cast<size_t>(width) + static_cast<size_t>(x)) * 4;
+                rgba[i] = color.red();
+                rgba[i + 1] = color.green();
+                rgba[i + 2] = color.blue();
+                rgba[i + 3] = color.alpha();
+            }
+        }
+    }
+
+    Farbling::perturb_rgba8888(rgba.bytes(), seed, opaque_origin, &m_script_farbling_cache);
+
+    if (bitmap.alpha_type() == Gfx::AlphaType::Premultiplied)
+        bitmap.set_alpha_type_destructive(Gfx::AlphaType::Unpremultiplied);
+    for (int y = 0; y < height; ++y) {
+        for (int x = 0; x < width; ++x) {
+            size_t const i = (static_cast<size_t>(y) * static_cast<size_t>(width) + static_cast<size_t>(x)) * 4;
+            bitmap.set_pixel(x, y, Gfx::Color(rgba[i], rgba[i + 1], rgba[i + 2], rgba[i + 3]));
+        }
+    }
+}
+
+Optional<Gfx::DecodedImageFrame> CanvasHost::farbled_script_frame(Gfx::DecodedImageFrame const& frame)
+{
+    auto clone_or_error = frame.bitmap().clone();
+    if (clone_or_error.is_error())
+        return frame;
+    auto bitmap = clone_or_error.release_value();
+    apply_script_farbling(*bitmap);
+    return Gfx::DecodedImageFrame { *bitmap, frame.color_space() };
+}
+
+Optional<Gfx::DecodedImageFrame> CanvasHost::farbled_script_frame_from_surface()
+{
+    auto frame = get_frame_from_surface();
+    if (!frame.has_value())
+        return {};
+    return farbled_script_frame(*frame);
 }
 
