 namespace Web::HTML {
@@ -85,12 +88,96 @@ Optional<Gfx::DecodedImageFrame> CanvasHost::get_frame_from_surface()
 
 Optional<Gfx::DecodedImageFrame> CanvasHost::get_frame_for_serialization(Utf16View type)
 {
