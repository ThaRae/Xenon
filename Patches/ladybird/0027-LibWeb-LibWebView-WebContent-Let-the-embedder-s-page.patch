+    if (command.equals_ignoring_ascii_case(Editing::CommandNames::paste) && is_html_document() && !m_inside_exec_command) {
+        auto navigable = this->navigable();
+        if (navigable && navigable->active_document().ptr() == this) {
+            if (auto items = page().client().page_did_request_clipboard_entries_for_script(*this); items.has_value()) {
+                TemporaryChange guard_recursion { m_inside_clipboard_exec_command, true };
