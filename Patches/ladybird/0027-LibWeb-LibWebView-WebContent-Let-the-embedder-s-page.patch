+bool WebContentPage::embedder_allows_clipboard_write(Web::HTML::CrossProcessId document_id)
+{
+    auto endpoint = embedder_bridge_endpoint(document_id);
+    if (!endpoint.has_value())
+        return false;
+    auto const& may_write = url_scheme_bridge(*endpoint->origin().scheme())->may_write_clipboard;
+    return may_write && may_write(*endpoint);
+}
+
+// NB: A renderer copies from script without the user's activation only for a document whose bridge lets it, but the
+//     clipboard item doesn't say which document it's from, so any of the page's documents that may will do.
+bool WebContentPage::hosts_a_document_allowed_to_write_the_clipboard()
+{
+    if (!m_is_open || !m_traversable)
+        return false;
+
+    Vector<Web::HTML::CrossProcessId> document_ids;
+    for_each_hosted_document([&](CanonicalDocument& document) {
+        document_ids.append(document.id());
+        return IterationDecision::Continue;
+    });
+    for (auto document_id : document_ids) {
+        if (embedder_allows_clipboard_write(document_id))
+            return true;
+    }
+    return false;
+}
+
+bool WebContentPage::did_request_embedder_clipboard_write_access(Web::HTML::CrossProcessId document_id)
+{
+    return embedder_allows_clipboard_write(document_id);
+}
+
+Optional<Vector<Web::Clipboard::SystemClipboardItem>> WebContentPage::did_request_embedder_clipboard_entries(Web::HTML::CrossProcessId document_id)
+{
+    auto endpoint = embedder_bridge_endpoint(document_id);
+    if (!endpoint.has_value())
+        return {};
+    auto const& may_read = url_scheme_bridge(*endpoint->origin().scheme())->may_read_clipboard;
+    if (!may_read || !may_read(*endpoint))
+        return {};
+
+    auto read = Core::Promise<Web::Clipboard::SystemClipboardItem>::construct();
+    view().read_clipboard_item([read](Web::Clipboard::SystemClipboardItem item) {
+        read->resolve(move(item));
+    });
+    auto item = read->await();
+
+    Vector<Web::Clipboard::SystemClipboardItem> items;
+    if (!item.is_error() && !item.value().system_clipboard_representations.is_empty())
+        items.append(item.release_value());
+    return items;
+}
