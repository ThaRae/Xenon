diff --git a/Services/WebContent/UserScripts.cpp b/Services/WebContent/UserScripts.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..73c84009f9886491b33ef2b147579300cce20960
--- /dev/null
+++ b/Services/WebContent/UserScripts.cpp
@@ -0,0 +1,203 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibCore/Timer.h>
+#include <LibGC/Function.h>
+#include <LibJS/Runtime/Object.h>
+#include <LibJS/Runtime/PrimitiveString.h>
+#include <LibJS/Runtime/Realm.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/HTML/EventLoop/EventLoop.h>
+#include <LibWeb/HTML/Scripting/ClassicScript.h>
+#include <LibWeb/HTML/Scripting/Environments.h>
+#include <LibWeb/HTML/Scripting/IsolatedWorld.h>
+#include <LibWeb/HTML/Scripting/TemporaryExecutionContext.h>
+#include <WebContent/ConnectionFromClient.h>
+#include <WebContent/UserScripts.h>
+
+namespace WebContent {
+
+using Web::HTML::UserScriptInjectionTime;
+
+// Scripts that run at document idle wait for the document to load, but no longer than this after DOMContentLoaded, as
+// in Chromium.
+static constexpr auto DOCUMENT_IDLE_TIMEOUT = AK::Duration::from_milliseconds(200);
+
+void UserScripts::document_reached(ConnectionFromClient& client, Web::PageId page_id, Web::DOM::Document& document, UserScriptInjectionTime injection_time)
+{
+    auto document_id = document.id();
+
+    if (injection_time == UserScriptInjectionTime::DocumentStart) {
+        if (!client.user_scripts_enabled() || m_documents.contains(document_id))
+            return;
+
+        auto response = client.send_sync_but_allow_failure<Messages::WebContentClient::DidRequestUserScripts>(page_id, document_id);
+        forget_documents_that_are_gone();
+        if (!response)
+            return;
+        auto scripts = response->take_scripts();
+        if (scripts.is_empty())
+            return;
+
+        m_documents.set(document_id, { .document = document, .pending = move(scripts), .reached_document_end = false, .idle_timer = nullptr });
+        run_scripts(client, page_id, document_id, UserScriptInjectionTime::DocumentStart);
+        return;
+    }
+
+    auto scripts = m_documents.get(document_id);
+    if (!scripts.has_value())
+        return;
+
+    if (injection_time == UserScriptInjectionTime::DocumentEnd) {
+        if (scripts->reached_document_end)
+            return;
+        scripts->reached_document_end = true;
+        run_scripts(client, page_id, document_id, UserScriptInjectionTime::DocumentEnd);
+
+        // NB: The scripts that just ran may have changed what's in the map.
+        if (auto remaining_scripts = m_documents.get(document_id); remaining_scripts.has_value()) {
+            remaining_scripts->idle_timer = Core::Timer::create_single_shot(DOCUMENT_IDLE_TIMEOUT, [this, &client, page_id, document_id] {
+                auto scripts = m_documents.get(document_id);
+                if (!scripts.has_value())
+                    return;
+                if (auto document = scripts->document.ptr())
+                    document_reached(client, page_id, *document, UserScriptInjectionTime::DocumentIdle);
+            });
+            remaining_scripts->idle_timer->start();
+        }
+        return;
+    }
+
+    // A document may finish loading without a parser to fire DOMContentLoaded, and document idle never comes first.
+    if (!scripts->reached_document_end)
+        document_reached(client, page_id, document, UserScriptInjectionTime::DocumentEnd);
+    run_scripts(client, page_id, document_id, UserScriptInjectionTime::DocumentIdle);
+    m_documents.remove(document_id);
+}
+
+void UserScripts::run_scripts(ConnectionFromClient& client, Web::PageId page_id, Web::HTML::CrossProcessId document_id, UserScriptInjectionTime injection_time)
+{
+    auto scripts = m_documents.get(document_id);
+    if (!scripts.has_value())
+        return;
+
+    auto document = scripts->document.ptr();
+    if (!document || document->has_been_destroyed()) {
+        m_documents.remove(document_id);
+        return;
+    }
+
+    // NB: A script may make new documents, such as iframes, which ask for scripts of their own, so none of the map is
+    //     held on to while scripts run.
+    Vector<Web::HTML::UserScript> scripts_to_run;
+    scripts->pending.remove_all_matching([&](auto const& script) {
+        if (script.injection_time != injection_time)
+            return false;
+        scripts_to_run.append(script);
+        return true;
+    });
+
+    GC::Ref protected_document = *document;
+    for (auto const& script : scripts_to_run) {
+        if (protected_document->has_been_destroyed())
+            return;
+        run_script(client, page_id, protected_document, script);
+    }
+}
+
+void UserScripts::run_script(ConnectionFromClient& client, Web::PageId page_id, Web::DOM::Document& document, Web::HTML::UserScript const& script)
+{
+    auto source = Utf16String::from_utf8(script.source);
+
+    if (script.world.is_empty()) {
+        // NB: A bridge in the document's own world would be the document's to use as well.
+        if (script.takes_bridge) {
+            dbgln("UserScripts: Not running {}, since only isolated worlds get a bridge", script.url);
+            return;
+        }
+        auto& settings = document.relevant_settings_object();
+        auto classic_script = Web::HTML::ClassicScript::create(script.url.to_byte_string(), source.utf16_view(), settings, script.url);
+        (void)classic_script->run();
+        return;
+    }
+
+    auto world = document.isolated_world(script.world);
+    if (!world)
+        return;
+
+    if (!script.takes_bridge) {
+        (void)world->run_script(source.utf16_view(), script.url);
+        return;
+    }
+
+    // NB: The script is a function body, so that the bridge is a parameter rather than something on the world's global.
+    auto function_source = Utf16String::formatted("(function (bridge) {{\n{}\n}})", source);
+    auto function = world->run_script(function_source.utf16_view(), script.url);
+    if (function.is_abrupt())
+        return;
+
+    auto& realm = world->realm();
+    auto document_id = document.id();
+    auto bridge = JS::Object::create(realm, realm.intrinsics().object_prototype());
+    bridge->define_native_function(realm, "postMessage"_utf16_fly_string, [&client, page_id, document_id, world_name = script.world](JS::VM& vm) -> JS::ThrowCompletionOr<JS::Value> {
+        auto message = TRY(vm.argument(0).to_utf16_string(vm)).to_utf8();
+        client.async_did_post_user_script_message(page_id, document_id, world_name, move(message));
+        return JS::js_undefined(); }, 1, JS::default_attributes);
+
+    m_bridges.ensure(document_id).set(script.world, { .document = document, .world = *world, .object = *bridge });
+    (void)world->call(function.value(), JS::js_undefined(), { { JS::Value { bridge } } });
+}
+
+void UserScripts::deliver_message(Web::HTML::CrossProcessId document_id, String const& world_name, String message)
+{
+    auto bridges = m_bridges.get(document_id);
+    if (!bridges.has_value())
+        return;
+    auto bridge = bridges->get(world_name);
+    if (!bridge.has_value())
+        return;
+
+    auto document = bridge->document.ptr();
+    auto world = bridge->world.ptr();
+    auto object = bridge->object.ptr();
+    if (!document || !world || !object || document->has_been_destroyed()) {
+        bridges->remove(world_name);
+        return;
+    }
+
+    Web::HTML::queue_a_task(Web::HTML::Task::Source::PostedMessage, nullptr, document, GC::create_function(document->heap(), [document = GC::Ref { *document }, world = GC::Ref { *world }, object = GC::Ref { *object }, message = move(message)] {
+        if (document->has_been_destroyed())
+            return;
+
+        JS::Value handler;
+        {
+            Web::HTML::TemporaryExecutionContext execution_context { document->relevant_settings_object() };
+            auto result = object->get("onmessage"_utf16_fly_string);
+            if (result.is_error())
+                return;
+            handler = result.value();
+        }
+        if (!handler.is_function())
+            return;
+
+        auto& vm = world->realm().vm();
+        (void)world->call(handler, object, { { JS::PrimitiveString::create(vm, Utf16String::from_utf8(message)) } });
+    }));
+}
+
+void UserScripts::forget_documents_that_are_gone()
+{
+    auto is_gone = [](GC::Weak<Web::DOM::Document> const& document) {
+        return !document || document->has_been_destroyed();
+    };
+    m_documents.remove_all_matching([&](auto const&, auto const& scripts) { return is_gone(scripts.document); });
+    m_bridges.remove_all_matching([&](auto const&, auto& bridges) {
+        bridges.remove_all_matching([&](auto const&, auto const& bridge) { return is_gone(bridge.document); });
+        return bridges.is_empty();
+    });
+}
+
+}
diff --git a/Services/WebContent/UserScripts.h b/Services/WebContent/UserScripts.h
new file mode 100644
index 0000000000000000000000000000000000000000..8c72a24be7063922adc0de4bef494a22e4605118
--- /dev/null
+++ b/Services/WebContent/UserScripts.h
@@ -0,0 +1,54 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/HashMap.h>
+#include <AK/String.h>
+#include <AK/Vector.h>
+#include <LibCore/Forward.h>
+#include <LibGC/Weak.h>
+#include <LibJS/Forward.h>
+#include <LibWeb/Forward.h>
+#include <LibWebCommon/HTML/CrossProcessId.h>
+#include <LibWebCommon/HTML/Scripting/UserScript.h>
+#include <LibWebCommon/Page/PageId.h>
+#include <WebContent/Forward.h>
+
+namespace WebContent {
+
+// The UI process's user scripts in a page's documents (see Web::HTML::UserScript). A document asks the UI process for
+// its scripts once, as it becomes ready for scripts, if the UI process has any. Each runs at its injection time, in the
+// document's own world or in one of the UI process's isolated worlds, where it may be given the world's bridge to the
+// UI process.
+class UserScripts {
+public:
+    void document_reached(ConnectionFromClient&, Web::PageId, Web::DOM::Document&, Web::HTML::UserScriptInjectionTime);
+    void deliver_message(Web::HTML::CrossProcessId document_id, String const& world, String message);
+
+private:
+    struct DocumentScripts {
+        GC::Weak<Web::DOM::Document> document;
+        Vector<Web::HTML::UserScript> pending;
+        bool reached_document_end { false };
+        RefPtr<Core::Timer> idle_timer;
+    };
+
+    struct Bridge {
+        GC::Weak<Web::DOM::Document> document;
+        GC::Weak<Web::HTML::IsolatedWorld> world;
+        GC::Weak<JS::Object> object;
+    };
+
+    void run_scripts(ConnectionFromClient&, Web::PageId, Web::HTML::CrossProcessId document_id, Web::HTML::UserScriptInjectionTime);
+    void run_script(ConnectionFromClient&, Web::PageId, Web::DOM::Document&, Web::HTML::UserScript const&);
+    void forget_documents_that_are_gone();
+
+    HashMap<Web::HTML::CrossProcessId, DocumentScripts> m_documents;
+    HashMap<Web::HTML::CrossProcessId, HashMap<String, Bridge>> m_bridges;
+};
+
+}
