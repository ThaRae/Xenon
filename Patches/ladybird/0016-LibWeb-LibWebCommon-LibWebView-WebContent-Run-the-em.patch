+GC::Ptr<HTML::IsolatedWorld> Document::isolated_world(String const& name)
+{
+    if (auto world = m_isolated_worlds.get(name); world.has_value())
+        return *world;
+    if (!m_window || !browsing_context() || m_has_been_destroyed)
+        return nullptr;
+
+    auto world = HTML::IsolatedWorld::create(*this);
+    m_isolated_worlds.set(name, world);
+    return world;
+}
