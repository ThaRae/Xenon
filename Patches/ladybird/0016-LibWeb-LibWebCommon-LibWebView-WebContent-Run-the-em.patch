index 0000000000000000000000000000000000000000..9f656bebde35faa99a25cd366d9637d9a0066746
--- /dev/null
+++ b/Libraries/LibWeb/HTML/Scripting/IsolatedWorld.cpp
@@ -0,0 +1,127 @@
+/*
