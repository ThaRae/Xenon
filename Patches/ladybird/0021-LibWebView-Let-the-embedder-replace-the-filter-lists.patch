From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan <ryan@esterlines.com>
Date: Mon, 26 Oct 2026 22:34:25 -0400
Subject: [PATCH] LibWebView: Let the embedder replace the filter lists it
 started with

A browser that ships its own filter lists, and keeps them up to date
itself, needs the new lists to take effect without a restart. Lists
given on the command line are read once at startup, and again when a
content blocking setting changes, always from the same paths.

Application::set_explicit_content_blockers() replaces those paths, for
--content-blocker-list, --trusted-content-blocker-list, and
--content-blocker-resources, and applies the result to every page, as
a settings change does. Pages get the new rules only if they changed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Libraries/LibWebView/Application.cpp | 8 ++++++++
 Libraries/LibWebView/Application.h   | 4 ++++
 2 files changed, 12 insertions(+)

diff --git a/Libraries/LibWebView/Application.cpp b/Libraries/LibWebView/Application.cpp
index 7d610df1e9230e52e146dce8c49b8092ba7d06ea..5a39fb0335ad139ceea2afe5773aca3c03b9ee1b 100644
--- a/Libraries/LibWebView/Application.cpp
+++ b/Libraries/LibWebView/Application.cpp
@@ -829,6 +829,14 @@ Optional<UnixDateTime> Application::content_blocker_list_last_updated_at(StringV
     return {};
 }
 
+void Application::set_explicit_content_blockers(Vector<ByteString> list_paths, Vector<ByteString> trusted_list_paths, Optional<ByteString> resources_path)
+{
+    m_explicit_content_blocker_list_paths = move(list_paths);
+    m_trusted_content_blocker_list_paths = move(trusted_list_paths);
+    m_content_blocker_resources_path = move(resources_path);
+    apply_content_blocker_settings();
+}
+
 void Application::rebuild_content_blocker_list_paths()
 {
     m_browser_options.content_blocker_list_paths = m_explicit_content_blocker_list_paths;
diff --git a/Libraries/LibWebView/Application.h b/Libraries/LibWebView/Application.h
index 80debc6f463577b520f135b94a3be7e6adfe33fc..cb616c194eb2a4a8ceeaa55b2fc3eb0646ba4ae6 100644
--- a/Libraries/LibWebView/Application.h
+++ b/Libraries/LibWebView/Application.h
@@ -215,6 +215,10 @@ public:
     void remove_content_blocker_list(Badge<SettingsUI>, StringView identifier);
     Optional<UnixDateTime> content_blocker_list_last_updated_at(StringView identifier) const;
 
+    // Replaces the lists and resources the browser was started with (--content-blocker-list,
+    // --trusted-content-blocker-list, and --content-blocker-resources), and applies them to every page.
+    void set_explicit_content_blockers(Vector<ByteString> list_paths, Vector<ByteString> trusted_list_paths, Optional<ByteString> resources_path);
+
     static BrowsingSession& default_session() { return *the().m_default_session; }
 
     static NonnullRefPtr<BrowsingSession> session_for_new_view(IsPrivate);
