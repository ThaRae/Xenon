From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Wed, 28 Oct 2026 23:41:45 +0000
Subject: [PATCH] LibWebView: Give the spare process the content blocker when
 it's taken

The spare WebContent process was building the content blocker's engine
as soon as it launched, tens of MiB for a process that has no page.
Leave it without the rules until a tab takes it, and send them then.
---
 Libraries/LibWebView/Application.cpp    | 9 ++++++---
 Libraries/LibWebView/Application.h      | 2 +-
 Libraries/LibWebView/Options.h          | 5 +++++
 Libraries/LibWebView/WebContentClient.h | 3 +++
 4 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/Libraries/LibWebView/Application.cpp b/Libraries/LibWebView/Application.cpp
index 382b2845ca1913a67b9f3544b9437661e15ec0af..925bea4a39b481bb0a7cf3f23b386b94003803fe 100644
--- a/Libraries/LibWebView/Application.cpp
+++ b/Libraries/LibWebView/Application.cpp
@@ -920,7 +920,7 @@ void Application::send_content_blockers(WebContentClient& client) const
 {
     if (!m_content_blocker_list_buffer.has_value() || !m_trusted_content_blocker_list_buffer.has_value() || !m_content_blocker_resources_buffer.has_value())
         return;
-    if (!content_blocking_enabled() || client.enable_content_blocker() == EnableContentBlocker::No) {
+    if (!content_blocking_enabled() || client.enable_content_blocker() == EnableContentBlocker::No || client.content_blocker_rules_deferred()) {
         client.async_set_content_blockers(Core::AnonymousBuffer {}, Core::AnonymousBuffer {}, Core::AnonymousBuffer {});
         return;
     }
@@ -1253,7 +1253,7 @@ void Application::open_bookmark_in_new_window(String const& bookmark_id, IsPriva
         open_url_in_new_window(bookmark->bookmark().url, is_private);
 }
 
-ErrorOr<NonnullRefPtr<WebContentClient>> Application::create_web_content_client(IsPrivate is_private, Web::PageId initial_page_id, Optional<Web::HTML::CrossProcessId> navigable_to_adopt, Optional<Web::HTML::CrossProcessId> initial_document_state_id, Vector<Web::HTML::RemoteNavigableDescriptor> remote_navigables, Optional<Web::HTML::SessionHistoryEntryDescriptor> canonical_initial_history_entry, Web::HTML::VisibilityState system_visibility_state, EnableContentBlocker enable_content_blocker)
+ErrorOr<NonnullRefPtr<WebContentClient>> Application::create_web_content_client(IsPrivate is_private, Web::PageId initial_page_id, Optional<Web::HTML::CrossProcessId> navigable_to_adopt, Optional<Web::HTML::CrossProcessId> initial_document_state_id, Vector<Web::HTML::RemoteNavigableDescriptor> remote_navigables, Optional<Web::HTML::SessionHistoryEntryDescriptor> canonical_initial_history_entry, Web::HTML::VisibilityState system_visibility_state, EnableContentBlocker enable_content_blocker, DeferContentBlockerRules defer_content_blocker_rules)
 {
     // The client's WebContentClient picks up this same session when it is created.
     auto session = session_for_new_view(is_private);
@@ -1301,6 +1301,7 @@ ErrorOr<NonnullRefPtr<WebContentClient>> Application::create_web_content_client(
         webdriver_bidi->push_session_state_for_client(*client);
 
     client->set_enable_content_blocker(enable_content_blocker);
+    client->set_content_blocker_rules_deferred(defer_content_blocker_rules == DeferContentBlockerRules::Yes);
     send_content_blockers(*client);
 
     m_web_content_clients.set(client);
@@ -1756,6 +1757,8 @@ ErrorOr<NonnullRefPtr<WebContentPage>> Application::open_page_for_new_tab(IsPriv
         web_content_client = TRY(create_web_content_client(IsPrivate::Yes, allocate_page_id()));
     } else if (m_spare_web_content_process) {
         web_content_client = m_spare_web_content_process.release_nonnull();
+        web_content_client->set_content_blocker_rules_deferred(false);
+        send_content_blockers(*web_content_client);
         launch_spare_web_content_process();
     } else {
         launch_spare_web_content_process();
@@ -1796,7 +1799,7 @@ void Application::launch_spare_web_content_process()
     Core::deferred_invoke([this]() {
         m_has_queued_task_to_launch_spare_web_content_process = false;
 
-        auto web_content_client = create_web_content_client(IsPrivate::No, allocate_page_id());
+        auto web_content_client = create_web_content_client(IsPrivate::No, allocate_page_id(), {}, {}, {}, {}, Web::HTML::VisibilityState::Hidden, EnableContentBlocker::Yes, DeferContentBlockerRules::Yes);
         if (web_content_client.is_error()) {
             dbgln("Unable to create spare web content client: {}", web_content_client.error());
             return;
diff --git a/Libraries/LibWebView/Application.h b/Libraries/LibWebView/Application.h
index 81863686ffa09fe4076d650fb0b01bc364c38889..61ba80b93c4dba4dbc4e7a9f2540aecd7b8287c4 100644
--- a/Libraries/LibWebView/Application.h
+++ b/Libraries/LibWebView/Application.h
@@ -484,7 +484,7 @@ private:
     ErrorOr<void> create_profile(Optional<StringView> profile_name, Optional<StringView> profile_path, bool force_new_process, bool temporary_profile);
     void create_mach_port_server(ByteString const& profile_identity);
     void update_website_color_scheme();
-    ErrorOr<NonnullRefPtr<WebContentClient>> create_web_content_client(IsPrivate, Web::PageId initial_page_id, Optional<Web::HTML::CrossProcessId> navigable_to_adopt = {}, Optional<Web::HTML::CrossProcessId> initial_document_state_id = {}, Vector<Web::HTML::RemoteNavigableDescriptor> remote_navigables = {}, Optional<Web::HTML::SessionHistoryEntryDescriptor> canonical_initial_history_entry = {}, Web::HTML::VisibilityState system_visibility_state = Web::HTML::VisibilityState::Hidden, EnableContentBlocker = EnableContentBlocker::Yes);
+    ErrorOr<NonnullRefPtr<WebContentClient>> create_web_content_client(IsPrivate, Web::PageId initial_page_id, Optional<Web::HTML::CrossProcessId> navigable_to_adopt = {}, Optional<Web::HTML::CrossProcessId> initial_document_state_id = {}, Vector<Web::HTML::RemoteNavigableDescriptor> remote_navigables = {}, Optional<Web::HTML::SessionHistoryEntryDescriptor> canonical_initial_history_entry = {}, Web::HTML::VisibilityState system_visibility_state = Web::HTML::VisibilityState::Hidden, EnableContentBlocker = EnableContentBlocker::Yes, DeferContentBlockerRules = DeferContentBlockerRules::No);
 
     ErrorOr<void> launch_services();
     void launch_spare_web_content_process();
diff --git a/Libraries/LibWebView/Options.h b/Libraries/LibWebView/Options.h
index be5d20dce7768c596fe862944905e1b523b5c037..6b22dbf2eaf446bc1aa9ca1a9293c81e216125c6 100644
--- a/Libraries/LibWebView/Options.h
+++ b/Libraries/LibWebView/Options.h
@@ -72,6 +72,11 @@ enum class EnableContentBlocker {
     Yes,
 };
 
+enum class DeferContentBlockerRules {
+    No,
+    Yes,
+};
+
 enum class DisableSandbox {
     No,
     Yes,
diff --git a/Libraries/LibWebView/WebContentClient.h b/Libraries/LibWebView/WebContentClient.h
index 3b989346b4f75cff3984aac035015697f8e4dfc3..42fcc359a26f34e6fae1c2bc968fa4683faa6920 100644
--- a/Libraries/LibWebView/WebContentClient.h
+++ b/Libraries/LibWebView/WebContentClient.h
@@ -136,6 +136,8 @@ public:
     void set_hosted_web_ui(String host) { m_hosted_web_ui = move(host); }
     EnableContentBlocker enable_content_blocker() const { return m_enable_content_blocker; }
     void set_enable_content_blocker(EnableContentBlocker enable_content_blocker) { m_enable_content_blocker = enable_content_blocker; }
+    bool content_blocker_rules_deferred() const { return m_content_blocker_rules_deferred; }
+    void set_content_blocker_rules_deferred(bool deferred) { m_content_blocker_rules_deferred = deferred; }
     void register_embedded_page(Web::PageId page_id, CanonicalTraversable&);
     void unregister_embedded_page(Web::PageId page_id);
     Optional<Web::PageId> page_id_for_traversable(CanonicalTraversable const&) const;
@@ -251,6 +253,7 @@ private:
     bool m_has_hosted_local_file_content { false };
     Optional<String> m_hosted_web_ui;
     EnableContentBlocker m_enable_content_blocker { EnableContentBlocker::Yes };
+    bool m_content_blocker_rules_deferred { false };
     Vector<u64> m_crashed_view_ids;
 
     WebContentPage& open_page(Web::PageId, CanonicalTraversable&);
