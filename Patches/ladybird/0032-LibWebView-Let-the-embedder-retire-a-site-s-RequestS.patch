From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan <ryan@esterlines.com>
Date: Wed, 28 Oct 2026 19:39:01 -0400
Subject: [PATCH] LibWebView: Let the embedder retire a site's RequestServer
 once idle

A site's RequestServer stays for a minute after its last client goes, in
case the site is visited again. An embedder that closes a view of a site
it doesn't expect back soon, such as a browser stopping an idle
extension background page, has no use for that minute: the process just
lingers.

RequestServerManager::retire_when_idle() lets the session's
RequestServer of a site go as soon as it has no clients. A client that
connects before then keeps it the usual while.
---
 Libraries/LibWebView/RequestServerManager.cpp | 15 ++++++++++++++-
 Libraries/LibWebView/RequestServerManager.h   |  6 ++++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/Libraries/LibWebView/RequestServerManager.cpp b/Libraries/LibWebView/RequestServerManager.cpp
index af2db8cb4e8370cd420e78a9b31f498fd7607e6f..b9734015f0e5bdfad9d2be79651ef190a96da58a 100644
--- a/Libraries/LibWebView/RequestServerManager.cpp
+++ b/Libraries/LibWebView/RequestServerManager.cpp
@@ -188,6 +188,7 @@ ErrorOr<RequestServerClientConnection> RequestServerManager::connect_new_client(
         if (site_binding == RequestServer::SiteBinding::Bound) {
             instance.m_client_ids.set(client_id);
             instance.m_idle_timer = nullptr;
+            instance.m_retire_when_idle = false;
         }
         return RequestServerClientConnection { .handle = response->take_handle(), .client_id = client_id };
     }
@@ -203,7 +204,8 @@ void RequestServerManager::client_disconnected(RequestServerInstance& instance,
         return;
 
     auto weak_instance = instance.make_weak_ptr();
-    instance.m_idle_timer = Core::Timer::create_single_shot(Application::request_server_options().idle_site_request_server_timeout, [weak_instance] {
+    auto timeout = instance.m_retire_when_idle ? AK::Duration::zero() : Application::request_server_options().idle_site_request_server_timeout;
+    instance.m_idle_timer = Core::Timer::create_single_shot(timeout, [weak_instance] {
         auto instance = weak_instance.strong_ref();
         if (instance && instance->m_client_ids.is_empty())
             the().retire(*instance);
@@ -211,6 +213,17 @@ void RequestServerManager::client_disconnected(RequestServerInstance& instance,
     instance.m_idle_timer->start();
 }
 
+void RequestServerManager::retire_when_idle(BrowsingSession& session, Utf16String const& top_level_site)
+{
+    for (auto& instance : Vector { m_instances }) {
+        if (instance->m_session.ptr() != &session || instance->site() != top_level_site)
+            continue;
+        instance->m_retire_when_idle = true;
+        if (instance->m_client_ids.is_empty())
+            retire(*instance);
+    }
+}
+
 void RequestServerManager::did_lose_process(RequestServerInstance& instance)
 {
     if (Core::EventLoop::current().was_exit_requested())
diff --git a/Libraries/LibWebView/RequestServerManager.h b/Libraries/LibWebView/RequestServerManager.h
index fa3ddd31d0c4dfd8f9fda1cffc6c6a4d14780494..94a3b540593cb522f1779e33f33cab3583797fc2 100644
--- a/Libraries/LibWebView/RequestServerManager.h
+++ b/Libraries/LibWebView/RequestServerManager.h
@@ -63,6 +63,7 @@ private:
     RefPtr<Requests::RequestClient> m_ui_client;
     HashTable<int> m_client_ids;
     RefPtr<Core::Timer> m_idle_timer;
+    bool m_retire_when_idle { false };
     bool m_retired { false };
 
     // As last reported by the RequestServer.
@@ -95,6 +96,11 @@ public:
 
     ErrorOr<RequestServerClientConnection> connect_new_client(RequestServerInstance&, BrowsingSession&, RequestServer::SiteBinding);
 
+    // A site's RequestServer is kept for a while after its last client goes, in case the site is visited again. This
+    // lets the session's RequestServer of a site go as soon as it has no clients instead, as for a view the embedder
+    // closes of a site it doesn't expect back soon. A client that connects before then keeps it the usual while.
+    void retire_when_idle(BrowsingSession&, Utf16String const& top_level_site);
+
     void disk_cache_settings_changed();
     void dns_settings_changed();
 
