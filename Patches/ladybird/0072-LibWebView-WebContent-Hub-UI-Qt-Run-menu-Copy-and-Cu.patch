+void ConnectionFromClient::copy_selection(Web::PageId page_id)
+{
+    if (auto page = this->page(page_id); page.has_value()) {
+        if (auto navigable = page->page().hosted_focused_navigable())
+            (void)navigable->event_handler().perform_copy_action(Web::EventHandler::ClipboardActionTrigger::User);
+    }
+}
+
+void ConnectionFromClient::cut_selection(Web::PageId page_id)
+{
+    if (auto page = this->page(page_id); page.has_value()) {
+        if (auto navigable = page->page().hosted_focused_navigable()) {
+            (void)navigable->event_handler().perform_cut_action(Web::EventHandler::ClipboardActionTrigger::User);
+            update_input_method_state(page_id);
+        }
+    }
+}
