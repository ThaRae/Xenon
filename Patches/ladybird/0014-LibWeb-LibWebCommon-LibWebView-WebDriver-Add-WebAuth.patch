+// NB: With virtual authenticators, as under automation, nobody is there to answer a prompt. The ceremony goes on as if
+//     the user took the default, or gave up when there is nothing left to wait for.
+void WebAuthnCoordinator::Ceremony::answer_prompt_without_a_user()
+{
+    Core::deferred_invoke([weak_self = make_weak_ptr()] {
+        auto self = weak_self.strong_ref();
+        if (!self || self->m_phase == Phase::Ended)
+            return;
+
+        switch (self->m_prompt.state) {
+        case WebAuthnPrompt::State::InsertKey:
+        case WebAuthnPrompt::State::TouchKey:
+            return;
+        case WebAuthnPrompt::State::ChooseAccount:
+            self->user_chose_account(0);
+            return;
+        case WebAuthnPrompt::State::AttestationConsent:
+            self->user_answered_attestation_consent(true);
+            return;
+        case WebAuthnPrompt::State::KeyAlreadyRegistered:
+            self->end({});
+            return;
+        case WebAuthnPrompt::State::EnterPin:
+        case WebAuthnPrompt::State::KeyNotRegistered:
+        case WebAuthnPrompt::State::PinBlocked:
+        case WebAuthnPrompt::State::PinNotSet:
+        case WebAuthnPrompt::State::KeyNotSupported:
+        case WebAuthnPrompt::State::NoPlatformAuthenticator:
+            break;
+        }
+
+        if (any_of(self->m_candidates, [](auto const& candidate) { return candidate.is_busy; }))
+            return;
+        self->end(not_allowed("No authenticator could complete the request"sv));
+    });
+}
