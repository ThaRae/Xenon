+// https://w3c.github.io/webauthn/#sctn-automation
+// The virtual authenticators belong to the browser, which runs every WebAuthn command. Its arguments are the URL's
+// variables after the session ID.
+static ResponsePromise run_web_authn_command(Web::WebDriver::Parameters const& parameters, JsonValue payload, StringView name)
+{
+    auto session = WEBDRIVER_TRY(Session::find_session(parameters[0]));
+    Vector<String> arguments;
+    for (size_t i = 1; i < parameters.size(); ++i)
+        arguments.append(parameters[i]);
+    return session->run_web_authn_command(name, move(payload), move(arguments));
+}
+
+// 11.3 Add Virtual Authenticator, https://w3c.github.io/webauthn/#sctn-automation-add-virtual-authenticator
+// POST /session/{session id}/webauthn/authenticator
+ResponsePromise Client::add_virtual_authenticator(Web::WebDriver::Parameters parameters, JsonValue payload)
+{
+    dbgln_if(WEBDRIVER_DEBUG, "Handling POST /session/<session_id>/webauthn/authenticator");
+    return run_web_authn_command(parameters, move(payload), "add-virtual-authenticator"sv);
+}
+
+// 11.4 Remove Virtual Authenticator, https://w3c.github.io/webauthn/#sctn-automation-remove-virtual-authenticator
+// DELETE /session/{session id}/webauthn/authenticator/{authenticatorId}
+ResponsePromise Client::remove_virtual_authenticator(Web::WebDriver::Parameters parameters, JsonValue payload)
+{
+    dbgln_if(WEBDRIVER_DEBUG, "Handling DELETE /session/<session_id>/webauthn/authenticator/<authenticator_id>");
+    return run_web_authn_command(parameters, move(payload), "remove-virtual-authenticator"sv);
+}
+
+// 11.5 Add Credential, https://w3c.github.io/webauthn/#sctn-automation-add-credential
+// POST /session/{session id}/webauthn/authenticator/{authenticatorId}/credential
+ResponsePromise Client::add_credential(Web::WebDriver::Parameters parameters, JsonValue payload)
+{
+    dbgln_if(WEBDRIVER_DEBUG, "Handling POST /session/<session_id>/webauthn/authenticator/<authenticator_id>/credential");
+    return run_web_authn_command(parameters, move(payload), "add-credential"sv);
+}
+
+// 11.6 Get Credentials, https://w3c.github.io/webauthn/#sctn-automation-get-credentials
+// GET /session/{session id}/webauthn/authenticator/{authenticatorId}/credentials
+ResponsePromise Client::get_credentials(Web::WebDriver::Parameters parameters, JsonValue payload)
+{
+    dbgln_if(WEBDRIVER_DEBUG, "Handling GET /session/<session_id>/webauthn/authenticator/<authenticator_id>/credentials");
+    return run_web_authn_command(parameters, move(payload), "get-credentials"sv);
+}
+
+// 11.7 Remove Credential, https://w3c.github.io/webauthn/#sctn-automation-remove-credential
+// DELETE /session/{session id}/webauthn/authenticator/{authenticatorId}/credentials/{credentialId}
+ResponsePromise Client::remove_credential(Web::WebDriver::Parameters parameters, JsonValue payload)
+{
+    dbgln_if(WEBDRIVER_DEBUG, "Handling DELETE /session/<session_id>/webauthn/authenticator/<authenticator_id>/credentials/<credential_id>");
+    return run_web_authn_command(parameters, move(payload), "remove-credential"sv);
+}
+
+// 11.8 Remove All Credentials, https://w3c.github.io/webauthn/#sctn-automation-remove-all-credentials
+// DELETE /session/{session id}/webauthn/authenticator/{authenticatorId}/credentials
+ResponsePromise Client::remove_all_credentials(Web::WebDriver::Parameters parameters, JsonValue payload)
+{
+    dbgln_if(WEBDRIVER_DEBUG, "Handling DELETE /session/<session_id>/webauthn/authenticator/<authenticator_id>/credentials");
+    return run_web_authn_command(parameters, move(payload), "remove-all-credentials"sv);
+}
+
+// 11.9 Set User Verified, https://w3c.github.io/webauthn/#sctn-automation-set-user-verified
+// POST /session/{session id}/webauthn/authenticator/{authenticatorId}/uv
+ResponsePromise Client::set_user_verified(Web::WebDriver::Parameters parameters, JsonValue payload)
+{
+    dbgln_if(WEBDRIVER_DEBUG, "Handling POST /session/<session_id>/webauthn/authenticator/<authenticator_id>/uv");
+    return run_web_authn_command(parameters, move(payload), "set-user-verified"sv);
+}
+
+// 11.10 Set Credential Properties, https://w3c.github.io/webauthn/#sctn-automation-set-credential-properties
+// POST /session/{session id}/webauthn/authenticator/{authenticatorId}/credentials/{credentialId}/props
+ResponsePromise Client::set_credential_properties(Web::WebDriver::Parameters parameters, JsonValue payload)
+{
+    dbgln_if(WEBDRIVER_DEBUG, "Handling POST /session/<session_id>/webauthn/authenticator/<authenticator_id>/credentials/<credential_id>/props");
+    return run_web_authn_command(parameters, move(payload), "set-credential-properties"sv);
+}
+
 }
