+namespace WebView {
+
+// https://w3c.github.io/webauthn/#sctn-automation-virtual-authenticators
+// A software authenticator for automation and tests, which behaves as WebDriver's virtual authenticators do.
+class WEBVIEW_API VirtualAuthenticator final : public Authenticator {
+public:
+    // https://w3c.github.io/webauthn/#virtual-authenticators-properties
+    enum class Protocol : u8 {
+        CTAP1U2F,
+        CTAP2,
+        CTAP2_1,
+    };
+
+    struct Configuration {
+        Protocol protocol { Protocol::CTAP2 };
+        Web::WebAuthn::AuthenticatorTransport transport { Web::WebAuthn::AuthenticatorTransport::Usb };
+        bool has_resident_key { false };
+        bool has_user_verification { false };
+        bool is_user_consenting { true };
+        bool is_user_verified { false };
+        bool default_backup_eligibility { false };
+        bool default_backup_state { false };
+    };
+
+    // https://w3c.github.io/webauthn/#credential-parameters
+    struct Credential {
+        ByteBuffer id;
+        bool is_resident_credential { false };
+        String rp_id;
+        Crypto::UnsignedBigInteger private_key;
+        Optional<ByteBuffer> user_handle;
+        String user_name;
+        String user_display_name;
+        u32 sign_count { 0 };
+        bool backup_eligibility { false };
+        bool backup_state { false };
+    };
+
+    // An authenticator a test adds for itself is only for its own tab. One that WebDriver adds is for every tab.
+    static NonnullRefPtr<VirtualAuthenticator> create(String id, Configuration, Optional<Web::HTML::CrossProcessId> traversable_id);
+
+    String const& id() const { return m_id; }
+    bool is_available_to(Web::HTML::CrossProcessId traversable_id) const;
+    Configuration& configuration() { return m_configuration; }
+    Vector<Credential>& credentials() { return m_credentials; }
+
+    virtual Info const& info() const override { return m_info; }
+    virtual String const& name() const override { return m_name; }
+    virtual void make_credential(MakeCredentialRequest, Function<void(MakeCredentialResult)>) override;
+    virtual void get_assertion(GetAssertionRequest, Function<void(GetAssertionResult)>) override;
+    virtual void wait_for_touch(Function<void(Optional<Failure>)>) override;
+    virtual void get_pin_retries(Function<void(Optional<u32>)>) override;
+    virtual void cancel() override { }
+
+private:
+    VirtualAuthenticator(String id, Configuration, Optional<Web::HTML::CrossProcessId> traversable_id);
+
+    ErrorOr<MakeCredentialResult> make_credential_impl(MakeCredentialRequest const&);
+    ErrorOr<GetAssertionResult> get_assertion_impl(GetAssertionRequest const&);
+    Optional<Failure> check_user(bool user_verification) const;
+
+    String m_id;
+    String m_name;
+    Configuration m_configuration;
+    Optional<Web::HTML::CrossProcessId> m_traversable_id;
+    Info m_info;
+    Vector<Credential> m_credentials;
+};
+
+// The virtual authenticators WebDriver and tests have added, which ceremonies find as they would security keys.
+class WEBVIEW_API VirtualAuthenticators final : public AuthenticatorSource {
+public:
+    static VirtualAuthenticators& the();
+
+    // Whether a tab has virtual authenticators, which make its ceremonies run without asking the user anything.
+    bool is_enabled_for(CanonicalTraversable const&) const;
+
+    virtual NonnullOwnPtr<Discovery> discover(CanonicalTraversable const&, Function<void(NonnullRefPtr<Authenticator>)> on_authenticator) override;
+
+    // https://w3c.github.io/webauthn/#sctn-automation
+    // Runs one of WebAuthn's WebDriver extension commands. The arguments are the URL's variables after the session
+    // ID, and the payload is the request's body. A test runs them for its own tab only.
+    Web::WebDriver::Response run_command(StringView name, JsonValue const& payload, Vector<String> const& arguments, Optional<Web::HTML::CrossProcessId> traversable_id = {});
+
+private:
+    VirtualAuthenticators() = default;
+
+    class VirtualDiscovery;
+
+    Web::WebDriver::Response add_virtual_authenticator(JsonValue const& parameters, Optional<Web::HTML::CrossProcessId> traversable_id);
+    Web::WebDriver::Response remove_virtual_authenticator(String const& authenticator_id);
+    Web::WebDriver::Response add_credential(VirtualAuthenticator&, JsonValue const& parameters);
+    Web::WebDriver::Response get_credentials(VirtualAuthenticator&);
+    Web::WebDriver::Response remove_credential(VirtualAuthenticator&, String const& credential_id);
+    Web::WebDriver::Response remove_all_credentials(VirtualAuthenticator&);
+    Web::WebDriver::Response set_user_verified(VirtualAuthenticator&, JsonValue const& parameters);
+    Web::WebDriver::Response set_credential_properties(VirtualAuthenticator&, String const& credential_id, JsonValue const& parameters);
+
+    Vector<NonnullRefPtr<VirtualAuthenticator>> m_authenticators;
+    Vector<VirtualDiscovery*> m_discoveries;
+    u64 m_next_authenticator_id { 1 };
+};
+
+}
