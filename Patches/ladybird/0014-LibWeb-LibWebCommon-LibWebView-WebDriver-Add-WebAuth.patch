+<!DOCTYPE html>
+<script>
+window.addEventListener("message", async event => {
+    try {
+        const assertion = await navigator.credentials.get({
+            publicKey: { challenge: new Uint8Array(16), allowCredentials: [{ type: "public-key", id: new Uint8Array(event.data) }] },
