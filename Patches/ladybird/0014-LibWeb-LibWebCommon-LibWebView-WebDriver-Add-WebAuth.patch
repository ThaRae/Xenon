+
+VirtualAuthenticator::VirtualAuthenticator(String id, Configuration configuration, Optional<Web::HTML::CrossProcessId> traversable_id)
+    : m_id(move(id))
+    , m_name(MUST(String::formatted("Virtual authenticator {}", m_id)))
+    , m_configuration(configuration)
+    , m_traversable_id(traversable_id)
+{
+    m_info.algorithms = { COSE_ALGORITHM_ES256 };
+    m_info.supports_resident_keys = configuration.has_resident_key;
+    m_info.has_built_in_user_verification = configuration.has_user_verification;
+    m_info.make_credential_without_user_verification = true;
+    m_info.is_u2f_only = configuration.protocol == Protocol::CTAP1U2F;
+    m_info.transports = { configuration.transport };
+    m_info.attachment = configuration.transport == Web::WebAuthn::AuthenticatorTransport::Internal
+        ? Web::WebAuthn::AuthenticatorAttachment::Platform
+        : Web::WebAuthn::AuthenticatorAttachment::CrossPlatform;
+}
+
+bool VirtualAuthenticator::is_available_to(Web::HTML::CrossProcessId traversable_id) const
+{
+    return !m_traversable_id.has_value() || *m_traversable_id == traversable_id;
+}
+
+static ByteBuffer sha256(ReadonlyBytes bytes)
+{
+    return MUST(ByteBuffer::copy(Crypto::Hash::SHA256::hash(bytes).bytes()));
+}
+
+Optional<Authenticator::Failure> VirtualAuthenticator::check_user(bool user_verification) const
+{
+    // https://w3c.github.io/webauthn/#dom-virtualauthenticatorconfiguration-isuserconsenting
+    // Determines the result of all user consent authorization gestures, and by extension, any test of user presence.
+    if (!m_configuration.is_user_consenting)
+        return Failure { Error::OperationDenied, {} };
+
+    // https://w3c.github.io/webauthn/#dom-virtualauthenticatorconfiguration-isuserverified
+    // Determines the result of user verification performed on the virtual authenticator.
+    if (user_verification) {
+        if (!m_configuration.has_user_verification)
+            return Failure { Error::NotSupported, {} };
+        if (!m_configuration.is_user_verified)
+            return Failure { Error::OperationDenied, {} };
+    }
+    return {};
+}
+
+static u8 flags_for(bool user_verified, bool backup_eligibility, bool backup_state)
+{
+    u8 flags = AuthenticatorData::UserPresent;
+    if (user_verified)
+        flags |= AuthenticatorData::UserVerified;
+    if (backup_eligibility)
+        flags |= AuthenticatorData::BackupEligible;
+    if (backup_state)
+        flags |= AuthenticatorData::BackupState;
+    return flags;
+}
+
+// https://w3c.github.io/webauthn/#sctn-op-make-cred
+ErrorOr<Authenticator::MakeCredentialResult> VirtualAuthenticator::make_credential_impl(MakeCredentialRequest const& request)
+{
+    // If the excludeCredentialDescriptorList names a credential on this authenticator for the RP, and the user
+    // consents, return an error code equivalent to "InvalidStateError".
+    for (auto const& excluded : request.exclude_list) {
+        auto is_excluded = any_of(m_credentials, [&](auto const& credential) { return credential.rp_id == request.rp_id && credential.id == excluded.id; });
+        if (!is_excluded)
+            continue;
+        if (auto failure = check_user(false); failure.has_value())
+            return *failure;
+        return Failure { Error::CredentialExcluded, {} };
+    }
+
+    if (request.algorithm != COSE_ALGORITHM_ES256)
+        return Failure { Error::NotSupported, {} };
+    if (request.resident_key && !m_configuration.has_resident_key)
+        return Failure { Error::NotSupported, {} };
+
+    if (auto failure = check_user(request.user_verification); failure.has_value())
+        return *failure;
+
+    Crypto::Curves::SECP256r1 curve;
+    auto private_key = TRY(curve.generate_private_key());
+    auto public_key = TRY(curve.generate_public_key(private_key));
+
+    Credential credential;
+    credential.id = TRY(ByteBuffer::create_uninitialized(CREDENTIAL_ID_LENGTH));
+    fill_with_random(credential.id.bytes());
+    credential.is_resident_credential = request.resident_key;
+    credential.rp_id = request.rp_id;
+    credential.private_key = private_key;
+    credential.user_handle = request.user_id;
+    credential.user_name = request.user_name;
+    credential.user_display_name = request.user_display_name;
+    credential.backup_eligibility = m_configuration.default_backup_eligibility;
+    credential.backup_state = m_configuration.default_backup_state;
+
+    // A new discoverable credential replaces one the authenticator holds for the same RP and user.
+    if (credential.is_resident_credential) {
+        m_credentials.remove_all_matching([&](auto const& existing) {
+            return existing.is_resident_credential && existing.rp_id == credential.rp_id && existing.user_handle == credential.user_handle;
+        });
+    }
+
+    auto x = TRY(public_key.x_bytes());
+    auto y = TRY(public_key.y_bytes());
+
+    AuthenticatorData authenticator_data;
+    authenticator_data.rp_id_hash = sha256(request.rp_id.bytes());
+    authenticator_data.flags = flags_for(request.user_verification, credential.backup_eligibility, credential.backup_state);
+    authenticator_data.sign_count = 0;
+    authenticator_data.attested_credential_data = AuthenticatorData::AttestedCredentialData {
+        .aaguid = TRY(ByteBuffer::create_zeroed(16)),
+        .credential_id = credential.id,
+        .credential_public_key = cose_key_for_es256(x, y),
+    };
+
+    Registration registration;
+    registration.credential_id = credential.id;
+    registration.authenticator_data = authenticator_data.serialize();
+    registration.attestation_format = "none"_string;
+    registration.attestation_statement = none_attestation_statement();
+    registration.resident_key = credential.is_resident_credential;
+
+    m_credentials.append(move(credential));
+    return registration;
+}
+
+// https://w3c.github.io/webauthn/#sctn-op-get-assertion
+ErrorOr<Authenticator::GetAssertionResult> VirtualAuthenticator::get_assertion_impl(GetAssertionRequest const& request)
+{
+    // Let credentialOptions be the public key credential sources for the RP: those in the allow list if there is one,
+    // and the discoverable ones otherwise. If credentialOptions is empty, return an error code equivalent to
+    // "NotAllowedError".
+    Vector<Credential&> credential_options;
+    for (auto& credential : m_credentials) {
+        if (credential.rp_id != request.rp_id)
+            continue;
+        if (request.allow_list.is_empty() ? !credential.is_resident_credential : !any_of(request.allow_list, [&](auto const& allowed) { return allowed.id == credential.id; }))
+            continue;
+        credential_options.append(credential);
+    }
+    if (credential_options.is_empty())
+        return Failure { Error::NoCredentials, {} };
+
+    if (auto failure = check_user(request.user_verification); failure.has_value())
+        return *failure;
+
+    Vector<Assertion> assertions;
+    for (auto& credential : credential_options) {
+        // Increment the credential's signature counter.
+        ++credential.sign_count;
+
+        AuthenticatorData authenticator_data;
+        authenticator_data.rp_id_hash = sha256(request.rp_id.bytes());
+        authenticator_data.flags = flags_for(request.user_verification, credential.backup_eligibility, credential.backup_state);
+        authenticator_data.sign_count = credential.sign_count;
+        auto serialized_authenticator_data = authenticator_data.serialize();
+
+        // Let signature be the assertion signature of the concatenation authenticatorData || hash.
+        ByteBuffer signed_data;
+        signed_data.append(serialized_authenticator_data);
+        signed_data.append(request.client_data_hash);
+        Crypto::Curves::SECP256r1 curve;
+        auto hash = sha256(signed_data);
+        auto signature = TRY(curve.sign(hash, credential.private_key));
+
+        Assertion assertion;
+        assertion.credential_id = credential.id;
+        assertion.authenticator_data = move(serialized_authenticator_data);
+        assertion.signature = TRY(signature.to_asn());
+
+        // The user handle is returned for discoverable credentials.
+        if (credential.is_resident_credential && credential.user_handle.has_value())
+            assertion.user = UserEntity { *credential.user_handle, credential.user_name, credential.user_display_name };
+
+        assertions.append(move(assertion));
+    }
+    return assertions;
+}
+
+void VirtualAuthenticator::make_credential(MakeCredentialRequest request, Function<void(MakeCredentialResult)> on_complete)
+{
+    auto result = make_credential_impl(request);
+    Core::deferred_invoke([on_complete = move(on_complete), result = move(result)]() mutable {
+        if (result.is_error())
+            on_complete(Failure { Error::Other, {} });
+        else
+            on_complete(result.release_value());
+    });
+}
+
+void VirtualAuthenticator::get_assertion(GetAssertionRequest request, Function<void(GetAssertionResult)> on_complete)
+{
+    auto result = get_assertion_impl(request);
+    Core::deferred_invoke([on_complete = move(on_complete), result = move(result)]() mutable {
+        if (result.is_error())
+            on_complete(Failure { Error::Other, {} });
+        else
+            on_complete(result.release_value());
+    });
+}
+
+void VirtualAuthenticator::wait_for_touch(Function<void(Optional<Failure>)> on_complete)
+{
+    auto failure = check_user(false);
+    Core::deferred_invoke([on_complete = move(on_complete), failure] {
+        on_complete(failure);
+    });
+}
+
+void VirtualAuthenticator::get_pin_retries(Function<void(Optional<u32>)> on_complete)
+{
+    Core::deferred_invoke([on_complete = move(on_complete)] {
+        on_complete({});
+    });
+}
+
+VirtualAuthenticators& VirtualAuthenticators::the()
+{
+    static auto& authenticators = *new VirtualAuthenticators;
+    return authenticators;
+}
+
+class VirtualAuthenticators::VirtualDiscovery final : public AuthenticatorSource::Discovery {
+public:
+    VirtualDiscovery(CanonicalTraversable const& traversable, Function<void(NonnullRefPtr<Authenticator>)> on_authenticator)
+        : m_traversable_id(traversable.id())
+        , on_authenticator(move(on_authenticator))
+    {
+        VirtualAuthenticators::the().m_discoveries.append(this);
+    }
+
+    virtual ~VirtualDiscovery() override
+    {
+        VirtualAuthenticators::the().m_discoveries.remove_first_matching([this](auto* discovery) { return discovery == this; });
+    }
+
+    void report(VirtualAuthenticator& authenticator)
+    {
+        if (authenticator.is_available_to(m_traversable_id))
+            on_authenticator(authenticator);
+    }
+
+private:
+    Web::HTML::CrossProcessId m_traversable_id;
+    Function<void(NonnullRefPtr<Authenticator>)> on_authenticator;
+};
+
+bool VirtualAuthenticators::is_enabled_for(CanonicalTraversable const& traversable) const
+{
+    return any_of(m_authenticators, [&](auto const& authenticator) { return authenticator->is_available_to(traversable.id()); });
+}
+
+NonnullOwnPtr<AuthenticatorSource::Discovery> VirtualAuthenticators::discover(CanonicalTraversable const& traversable, Function<void(NonnullRefPtr<Authenticator>)> on_authenticator)
+{
+    auto discovery = make<VirtualDiscovery>(traversable, move(on_authenticator));
+    for (auto& authenticator : Vector { m_authenticators })
+        discovery->report(authenticator);
+    return discovery;
+}
+
+static Error invalid_argument(StringView message)
+{
+    return Error::from_code(ErrorCode::InvalidArgument, message);
+}
+
+Web::WebDriver::Response VirtualAuthenticators::run_command(StringView name, JsonValue const& payload, Vector<String> const& arguments, Optional<Web::HTML::CrossProcessId> traversable_id)
+{
+    if (name == "add-virtual-authenticator"sv)
+        return add_virtual_authenticator(payload, traversable_id);
+
+    if (arguments.is_empty())
+        return invalid_argument("Missing authenticator ID"sv);
+
+    if (name == "remove-virtual-authenticator"sv)
+        return remove_virtual_authenticator(arguments[0]);
+
+    // If authenticatorId does not match any Virtual Authenticator in the Virtual Authenticator Database, return a
+    // WebDriver error with WebDriver error code invalid argument.
+    auto authenticator = m_authenticators.first_matching([&](auto const& authenticator) { return authenticator->id() == arguments[0]; });
+    if (!authenticator.has_value())
+        return invalid_argument("No such virtual authenticator"sv);
+
+    if (name == "add-credential"sv)
+        return add_credential(**authenticator, payload);
+    if (name == "get-credentials"sv)
+        return get_credentials(**authenticator);
+    if (name == "remove-all-credentials"sv)
+        return remove_all_credentials(**authenticator);
+    if (name == "set-user-verified"sv)
+        return set_user_verified(**authenticator, payload);
+
+    if (arguments.size() < 2)
+        return invalid_argument("Missing credential ID"sv);
+    if (name == "remove-credential"sv)
+        return remove_credential(**authenticator, arguments[1]);
+    if (name == "set-credential-properties"sv)
+        return set_credential_properties(**authenticator, arguments[1], payload);
+
+    return Error::from_code(ErrorCode::UnknownCommand, "Unknown WebAuthn command"sv);
+}
+
+// https://w3c.github.io/webauthn/#sctn-automation-add-virtual-authenticator
+Web::WebDriver::Response VirtualAuthenticators::add_virtual_authenticator(JsonValue const& parameters, Optional<Web::HTML::CrossProcessId> traversable_id)
+{
+    // 1. Let configuration be the request's parameters.
+    // 2. If configuration is not a JSON Object, return a WebDriver error with WebDriver error code invalid argument.
+    if (!parameters.is_object())
+        return invalid_argument("The parameters must be an object"sv);
+    auto const& object = parameters.as_object();
+
+    VirtualAuthenticator::Configuration configuration;
+
+    // 3-4. For each property in the Virtual Authenticator Configuration: if it is required and missing, or of the wrong
+    //      type or value, return a WebDriver error with WebDriver error code invalid argument.
+    auto protocol = object.get_string("protocol"sv);
+    if (!protocol.has_value())
+        return invalid_argument("protocol is required"sv);
+    if (*protocol == "ctap1/u2f"sv)
+        configuration.protocol = VirtualAuthenticator::Protocol::CTAP1U2F;
+    else if (*protocol == "ctap2"sv)
+        configuration.protocol = VirtualAuthenticator::Protocol::CTAP2;
+    else if (*protocol == "ctap2_1"sv)
+        configuration.protocol = VirtualAuthenticator::Protocol::CTAP2_1;
+    else
+        return invalid_argument("Unknown protocol"sv);
+
+    auto transport = object.get_string("transport"sv);
+    if (!transport.has_value())
+        return invalid_argument("transport is required"sv);
+    auto transport_value = Web::WebAuthn::authenticator_transport_from_string(*transport);
+    if (!transport_value.has_value())
+        return invalid_argument("Unknown transport"sv);
+    configuration.transport = *transport_value;
+
+    auto get_bool = [&](StringView key, bool& value) -> Optional<Error> {
+        if (!object.has(key))
+            return {};
+        auto boolean = object.get_bool(key);
+        if (!boolean.has_value())
+            return invalid_argument(MUST(String::formatted("{} must be a boolean", key)));
+        value = *boolean;
+        return {};
+    };
+    if (auto error = get_bool("hasResidentKey"sv, configuration.has_resident_key); error.has_value())
+        return error.release_value();
+    if (auto error = get_bool("hasUserVerification"sv, configuration.has_user_verification); error.has_value())
+        return error.release_value();
+    if (auto error = get_bool("isUserConsenting"sv, configuration.is_user_consenting); error.has_value())
+        return error.release_value();
+    if (auto error = get_bool("isUserVerified"sv, configuration.is_user_verified); error.has_value())
+        return error.release_value();
+    if (auto error = get_bool("defaultBackupEligibility"sv, configuration.default_backup_eligibility); error.has_value())
+        return error.release_value();
+    if (auto error = get_bool("defaultBackupState"sv, configuration.default_backup_state); error.has_value())
+        return error.release_value();
+
+    // 5. For each extension in configuration's extensions, if the endpoint node does not support the extension,
+    //    return a WebDriver error with WebDriver error code unsupported operation.
+    // NB: The extensions Ladybird supports so far are client extensions, which need nothing of authenticators.
+    if (auto extensions = object.get_array("extensions"sv); extensions.has_value() && !extensions->is_empty())
+        return Error::from_code(ErrorCode::UnsupportedOperation, "Virtual authenticators support no extensions"sv);
+
+    // NB: A CTAP1/U2F authenticator has neither discoverable credentials nor user verification.
+    if (configuration.protocol == VirtualAuthenticator::Protocol::CTAP1U2F && (configuration.has_resident_key || configuration.has_user_verification))
+        return invalid_argument("A ctap1/u2f authenticator can't have resident keys or user verification"sv);
+
+    // 6. Generate a valid authenticatorId.
+    // 7-8. Let authenticator be a new Virtual Authenticator with authenticatorId and configuration, and store it in the
+    //      Virtual Authenticator Database.
+    auto id = MUST(String::formatted("{}", m_next_authenticator_id++));
+    auto authenticator = VirtualAuthenticator::create(id, configuration, traversable_id);
+    m_authenticators.append(authenticator);
+    for (auto* discovery : Vector { m_discoveries })
+        discovery->report(authenticator);
+
+    // 9. Return success with data authenticatorId.
+    return JsonValue { id };
+}
+
+// https://w3c.github.io/webauthn/#sctn-automation-remove-virtual-authenticator
+Web::WebDriver::Response VirtualAuthenticators::remove_virtual_authenticator(String const& authenticator_id)
+{
+    // 1. If authenticatorId does not match any Virtual Authenticator in the Virtual Authenticator Database, return a
+    //    WebDriver error with WebDriver error code invalid argument.
+    // 2. Remove the Virtual Authenticator identified by authenticatorId from the Virtual Authenticator Database.
+    auto removed = m_authenticators.remove_first_matching([&](auto const& authenticator) { return authenticator->id() == authenticator_id; });
+    if (!removed)
+        return invalid_argument("No such virtual authenticator"sv);
+
+    // 3. Return success.
+    return JsonValue {};
+}
+
+static ErrorOr<ByteBuffer, Error> decode_base64url_parameter(JsonObject const& object, StringView key)
+{
+    auto value = object.get_string(key);
+    if (!value.has_value())
+        return invalid_argument(MUST(String::formatted("{} must be a string", key)));
+    auto bytes = decode_base64url(*value);
+    if (bytes.is_error())
+        return invalid_argument(MUST(String::formatted("{} must be base64url encoded", key)));
+    return bytes.release_value();
+}
+
+// https://w3c.github.io/webauthn/#sctn-automation-add-credential
+Web::WebDriver::Response VirtualAuthenticators::add_credential(VirtualAuthenticator& authenticator, JsonValue const& parameters)
+{
+    // 1. Let parameters be the parameters argument. 2. If it is not a JSON Object, return invalid argument.
+    if (!parameters.is_object())
+        return invalid_argument("The parameters must be an object"sv);
+    auto const& object = parameters.as_object();
+
+    VirtualAuthenticator::Credential credential;
+
+    // 3. Let credentialId be the result of decoding Base64url Encoding on the parameters' credentialId property.
+    auto credential_id = decode_base64url_parameter(object, "credentialId"sv);
+    if (credential_id.is_error())
+        return credential_id.release_error();
+    credential.id = credential_id.release_value();
+
+    // 4. Let isResidentCredential be the parameters' isResidentCredential property. If it is not defined, return
+    //    invalid argument.
+    auto is_resident_credential = object.get_bool("isResidentCredential"sv);
+    if (!is_resident_credential.has_value())
+        return invalid_argument("isResidentCredential must be a boolean"sv);
+    credential.is_resident_credential = *is_resident_credential;
+
+    // 5. Let rpId be the parameters' rpId property. If it is not a valid RP ID, return invalid argument.
+    auto rp_id = object.get_string("rpId"sv);
+    if (!rp_id.has_value() || rp_id->is_empty())
+        return invalid_argument("rpId must be a string"sv);
+    credential.rp_id = *rp_id;
+
+    // 6. Let privateKey be the result of decoding Base64url Encoding on the parameters' privateKey property. It must
+    //    be an asymmetric key package containing a single private key per [RFC5958].
+    auto private_key_bytes = decode_base64url_parameter(object, "privateKey"sv);
+    if (private_key_bytes.is_error())
+        return private_key_bytes.release_error();
+    Crypto::ASN1::Decoder decoder { private_key_bytes.value() };
+    auto private_key = Crypto::Certificate::parse_private_key_info(decoder);
+    if (private_key.is_error() || private_key.value().ec.d().is_zero())
+        return invalid_argument("privateKey must be a PKCS #8 P-256 private key"sv);
+    credential.private_key = private_key.value().ec.d();
+
+    // 7. Let userHandle be the result of decoding Base64url Encoding on the parameters' userHandle property, or null.
+    if (object.has("userHandle"sv) && !object.get("userHandle"sv)->is_null()) {
+        auto user_handle = decode_base64url_parameter(object, "userHandle"sv);
+        if (user_handle.is_error())
+            return user_handle.release_error();
+        credential.user_handle = user_handle.release_value();
+    }
+
+    // 8. Let signCount be the parameters' signCount property.
+    if (auto sign_count = object.get_u32("signCount"sv); sign_count.has_value())
+        credential.sign_count = *sign_count;
+
+    credential.user_name = object.get_string("userName"sv).value_or({});
+    credential.user_display_name = object.get_string("userDisplayName"sv).value_or({});
+    credential.backup_eligibility = object.get_bool("backupEligibility"sv).value_or(authenticator.configuration().default_backup_eligibility);
+    credential.backup_state = object.get_bool("backupState"sv).value_or(authenticator.configuration().default_backup_state);
+
+    // 11. If isResidentCredential is true and the authenticator's hasResidentKey is false, return invalid argument.
+    if (credential.is_resident_credential && !authenticator.configuration().has_resident_key)
+        return invalid_argument("The authenticator has no resident keys"sv);
+
+    // 13. Store the credential in the authenticator.
+    authenticator.credentials().remove_all_matching([&](auto const& existing) { return existing.id == credential.id; });
+    authenticator.credentials().append(move(credential));
+
+    // 14. Return success.
+    return JsonValue {};
+}
+
+// https://w3c.github.io/webauthn/#sctn-automation-get-credentials
+Web::WebDriver::Response VirtualAuthenticators::get_credentials(VirtualAuthenticator& authenticator)
+{
+    // 1. Let credentialsArray be an empty array.
+    JsonArray credentials;
+
+    // 2. For each Public Key Credential Source credential, managed by authenticator, construct a corresponding
+    //    Credential Parameters JSON object and add it to credentialsArray.
+    for (auto const& credential : authenticator.credentials()) {
+        Crypto::Curves::SECP256r1 curve;
+        auto public_key = curve.generate_public_key(credential.private_key);
+        if (public_key.is_error())
+            continue;
+        Crypto::PK::ECPrivateKey private_key { credential.private_key, P256_SCALAR_SIZE, {}, Crypto::PK::ECPublicKey { public_key.release_value() } };
+        Span<u32 const> parameters = Crypto::ASN1::secp256r1_oid;
+        auto pkcs8 = Crypto::PK::wrap_in_private_key_info(private_key, Crypto::ASN1::ec_public_key_encryption_oid, parameters);
+        if (pkcs8.is_error())
+            continue;
+
+        JsonObject object;
+        object.set("credentialId"sv, MUST(encode_base64url(credential.id, AK::OmitPadding::Yes)));
+        object.set("isResidentCredential"sv, credential.is_resident_credential);
+        object.set("rpId"sv, credential.rp_id);
+        object.set("privateKey"sv, MUST(encode_base64url(pkcs8.value(), AK::OmitPadding::Yes)));
+        if (credential.user_handle.has_value())
+            object.set("userHandle"sv, MUST(encode_base64url(*credential.user_handle, AK::OmitPadding::Yes)));
+        object.set("signCount"sv, credential.sign_count);
+        object.set("backupEligibility"sv, credential.backup_eligibility);
+        object.set("backupState"sv, credential.backup_state);
+        object.set("userName"sv, credential.user_name);
+        object.set("userDisplayName"sv, credential.user_display_name);
+        credentials.must_append(move(object));
+    }
+
+    // 3. Return success with data containing credentialsArray.
+    return JsonValue { move(credentials) };
+}
+
+// https://w3c.github.io/webauthn/#sctn-automation-remove-credential
+Web::WebDriver::Response VirtualAuthenticators::remove_credential(VirtualAuthenticator& authenticator, String const& credential_id)
+{
+    auto id = decode_base64url(credential_id);
+    if (id.is_error())
+        return invalid_argument("The credential ID must be base64url encoded"sv);
+
+    // If credentialId does not match any Public Key Credential Source managed by authenticator, return invalid
+    // argument. Otherwise, remove it.
+    if (!authenticator.credentials().remove_first_matching([&](auto const& credential) { return credential.id == id.value(); }))
+        return invalid_argument("No such credential"sv);
+    return JsonValue {};
+}
+
+// https://w3c.github.io/webauthn/#sctn-automation-remove-all-credentials
+Web::WebDriver::Response VirtualAuthenticators::remove_all_credentials(VirtualAuthenticator& authenticator)
+{
+    authenticator.credentials().clear();
+    return JsonValue {};
+}
+
+// https://w3c.github.io/webauthn/#sctn-automation-set-user-verified
+Web::WebDriver::Response VirtualAuthenticators::set_user_verified(VirtualAuthenticator& authenticator, JsonValue const& parameters)
+{
+    // If parameters is not a JSON Object, or its isUserVerified property is not a boolean, return invalid argument.
+    if (!parameters.is_object())
+        return invalid_argument("The parameters must be an object"sv);
+    auto is_user_verified = parameters.as_object().get_bool("isUserVerified"sv);
+    if (!is_user_verified.has_value())
+        return invalid_argument("isUserVerified must be a boolean"sv);
+
+    authenticator.configuration().is_user_verified = *is_user_verified;
+    return JsonValue {};
+}
+
+// https://w3c.github.io/webauthn/#sctn-automation-set-credential-properties
+Web::WebDriver::Response VirtualAuthenticators::set_credential_properties(VirtualAuthenticator& authenticator, String const& credential_id, JsonValue const& parameters)
+{
+    if (!parameters.is_object())
+        return invalid_argument("The parameters must be an object"sv);
+    auto id = decode_base64url(credential_id);
+    if (id.is_error())
+        return invalid_argument("The credential ID must be base64url encoded"sv);
+
+    auto credential = authenticator.credentials().find_if([&](auto const& credential) { return credential.id == id.value(); });
+    if (credential.is_end())
+        return invalid_argument("No such credential"sv);
+
+    auto const& object = parameters.as_object();
+    if (auto backup_eligibility = object.get_bool("backupEligibility"sv); backup_eligibility.has_value())
+        credential->backup_eligibility = *backup_eligibility;
+    if (auto backup_state = object.get_bool("backupState"sv); backup_state.has_value())
+        credential->backup_state = *backup_state;
+    return JsonValue {};
+}
+
+}
