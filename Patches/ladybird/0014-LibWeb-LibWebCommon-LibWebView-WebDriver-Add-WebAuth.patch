+WebIDL::ExceptionOr<Utf16String> Internals::run_web_authn_command(Utf16String const& name, Utf16String const& payload, Vector<Utf16String> const& arguments)
+{
+    auto json = JsonValue::from_string(payload.to_utf8());
+    if (json.is_error())
+        return WebIDL::SyntaxError::create("The payload is not JSON"_utf16);
+
+    Vector<String> argument_strings;
+    for (auto const& argument : arguments)
+        argument_strings.append(argument.to_utf8());
+
+    auto response = page().client().run_web_authn_command(name.to_utf8(), json.release_value(), argument_strings);
+    if (!response.has_value())
+        return WebIDL::NotSupportedError::create("WebAuthn commands need the UI process's test connection"_utf16);
+    if (response->is_error())
+        return WebIDL::OperationError::create(Utf16String::formatted("{}: {}", response->error().error, response->error().message));
+    return Utf16String::from_utf8(response->value().serialized());
+}
