diff --git a/Tests/LibWeb/Text/input/WebAuthn/argument-checks.html b/Tests/LibWeb/Text/input/WebAuthn/argument-checks.html
new file mode 100644
index 0000000000000000000000000000000000000000..678feab887175166cc6ecad0a96b916eb844b928
--- /dev/null
+++ b/Tests/LibWeb/Text/input/WebAuthn/argument-checks.html
@@ -0,0 +1,40 @@
+<!DOCTYPE html>
+<script src="../include.js"></script>
+<script>
+function creationOptions(overrides = {}) {
+    return {
+        rp: { name: "Test" },
+        user: { id: new Uint8Array([1]), name: "user", displayName: "User" },
+        challenge: new Uint8Array(16),
+        pubKeyCredParams: [{ type: "public-key", alg: -7 }],
+        ...overrides,
+    };
+}
+
+async function outcome(promise) {
+    try {
+        const result = await promise;
+        return `resolved with ${result}`;
+    } catch (e) {
+        return typeof e === "string" ? `rejected with ${e}` : e.name;
+    }
+}
+
+asyncTest(async done => {
+    println(`empty user ID: ${await outcome(navigator.credentials.create({ publicKey: creationOptions({ user: { id: new Uint8Array(0), name: "user", displayName: "User" } }) }))}`);
+    println(`65-byte user ID: ${await outcome(navigator.credentials.create({ publicKey: creationOptions({ user: { id: new Uint8Array(65), name: "user", displayName: "User" } }) }))}`);
+    println(`another site's RP ID: ${await outcome(navigator.credentials.create({ publicKey: creationOptions({ rp: { name: "Test", id: "example.com" } }) }))}`);
+    println(`a public suffix as RP ID: ${await outcome(navigator.credentials.get({ publicKey: { challenge: new Uint8Array(16), rpId: "localhost" } }))}`);
+    println(`only unknown credential types: ${await outcome(navigator.credentials.create({ publicKey: creationOptions({ pubKeyCredParams: [{ type: "bogus", alg: -7 }] }) }))}`);
+    println(`missing challenge: ${await outcome(navigator.credentials.get({ publicKey: {} }))}`);
+    println(`publicKey with password: ${await outcome(navigator.credentials.get({ publicKey: { challenge: new Uint8Array(16) }, password: true }))}`);
+    println(`aborted already: ${await outcome(navigator.credentials.get({ publicKey: { challenge: new Uint8Array(16) }, signal: AbortSignal.abort("reason") }))}`);
+    println(`conditional mediation: ${await outcome(navigator.credentials.get({ publicKey: { challenge: new Uint8Array(16) }, mediation: "conditional" }))}`);
+    println(`appid on another site: ${await outcome(navigator.credentials.get({ publicKey: { challenge: new Uint8Array(16), extensions: { appid: "https://example.com/app-id.json" } } }))}`);
+    println(`isUserVerifyingPlatformAuthenticatorAvailable: ${await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable()}`);
+    println(`isConditionalMediationAvailable: ${await PublicKeyCredential.isConditionalMediationAvailable()}`);
+    println(`bad base64url in JSON: ${await outcome((async () => PublicKeyCredential.parseRequestOptionsFromJSON({ challenge: "*" }))())}`);
+    println(`no authenticators: ${await outcome(navigator.credentials.get({ publicKey: { challenge: new Uint8Array(16) } }))}`);
+    done();
+});
+</script>
diff --git a/Tests/LibWeb/Text/input/WebAuthn/create-and-get.html b/Tests/LibWeb/Text/input/WebAuthn/create-and-get.html
new file mode 100644
index 0000000000000000000000000000000000000000..ea85668930df5b64225f8b5b8865ed258e665889
--- /dev/null
+++ b/Tests/LibWeb/Text/input/WebAuthn/create-and-get.html
@@ -0,0 +1,116 @@
+<!DOCTYPE html>
+<script src="../include.js"></script>
+<script>
+function addVirtualAuthenticator(configuration) {
+    return JSON.parse(internals.runWebAuthnCommand("add-virtual-authenticator", JSON.stringify(configuration)));
+}
+
+function removeVirtualAuthenticator(id) {
+    internals.runWebAuthnCommand("remove-virtual-authenticator", "null", [id]);
+}
+
+function base64url(buffer) {
+    return btoa(String.fromCharCode(...new Uint8Array(buffer))).replaceAll("+", "-").replaceAll("/", "_").replaceAll("=", "");
+}
+
+// WebAuthn signatures are DER, and WebCrypto's ECDSA wants r and s side by side.
+function rawSignatureFromDer(der) {
+    const bytes = new Uint8Array(der);
+    let offset = 2;
+    const integers = [];
+    for (let i = 0; i < 2; ++i) {
+        const length = bytes[offset + 1];
+        let integer = bytes.slice(offset + 2, offset + 2 + length);
+        offset += 2 + length;
+        while (integer.length > 32 && integer[0] === 0)
+            integer = integer.slice(1);
+        const padded = new Uint8Array(32);
+        padded.set(integer, 32 - integer.length);
+        integers.push(padded);
+    }
+    const raw = new Uint8Array(64);
+    raw.set(integers[0], 0);
+    raw.set(integers[1], 32);
+    return raw;
+}
+
+asyncTest(async done => {
+    const authenticator = addVirtualAuthenticator({ protocol: "ctap2", transport: "usb", hasResidentKey: true, hasUserVerification: true, isUserVerified: true });
+
+    const challenge = crypto.getRandomValues(new Uint8Array(32));
+    const credential = await navigator.credentials.create({
+        publicKey: {
+            rp: { name: "Test" },
+            user: { id: new Uint8Array([1, 2, 3, 4]), name: "user@example.com", displayName: "User" },
+            challenge,
+            pubKeyCredParams: [{ type: "public-key", alg: -7 }],
+            extensions: { credProps: true },
+        },
+    });
+
+    println(`credential: ${credential instanceof PublicKeyCredential}, type ${credential.type}, id matches rawId: ${credential.id === base64url(credential.rawId)}`);
+    println(`rawId is the same object: ${credential.rawId === credential.rawId}`);
+    println(`response: ${credential.response instanceof AuthenticatorAttestationResponse}`);
+    println(`authenticatorAttachment: ${credential.authenticatorAttachment}`);
+    println(`transports: ${JSON.stringify(credential.response.getTransports())}`);
+    println(`publicKeyAlgorithm: ${credential.response.getPublicKeyAlgorithm()}`);
+    println(`publicKey bytes: ${credential.response.getPublicKey().byteLength}`);
+    println(`clientExtensionResults: ${JSON.stringify(credential.getClientExtensionResults())}`);
+
+    const clientData = JSON.parse(new TextDecoder().decode(credential.response.clientDataJSON));
+    println(`clientData type: ${clientData.type}, challenge matches: ${clientData.challenge === base64url(challenge)}, origin matches: ${clientData.origin === location.origin}, crossOrigin: ${clientData.crossOrigin}`);
+
+    const flags = new Uint8Array(credential.response.getAuthenticatorData())[32];
+    println(`registration flags: user present ${!!(flags & 0x01)}, user verified ${!!(flags & 0x04)}, attested credential data ${!!(flags & 0x40)}`);
+
+    const json = credential.toJSON();
+    println(`toJSON: id ${json.id === credential.id}, rawId ${json.rawId === credential.id}, type ${json.type}, response keys ${Object.keys(json.response).sort().join(",")}`);
+
+    try {
+        await navigator.credentials.create({
+            publicKey: {
+                rp: { name: "Test" },
+                user: { id: new Uint8Array([1, 2, 3, 4]), name: "user@example.com", displayName: "User" },
+                challenge,
+                pubKeyCredParams: [{ type: "public-key", alg: -7 }],
+                excludeCredentials: [{ type: "public-key", id: credential.rawId }],
+            },
+        });
+        println("excluded credential: created");
+    } catch (e) {
+        println(`excluded credential: ${e.name}`);
+    }
+
+    const assertionChallenge = crypto.getRandomValues(new Uint8Array(32));
+    const assertion = await navigator.credentials.get({
+        publicKey: {
+            challenge: assertionChallenge,
+            allowCredentials: [{ type: "public-key", id: credential.rawId }],
+            userVerification: "required",
+        },
+    });
+    println(`assertion: ${assertion instanceof PublicKeyCredential}, same id: ${assertion.id === credential.id}, response: ${assertion.response instanceof AuthenticatorAssertionResponse}`);
+    println(`userHandle: ${assertion.response.userHandle}`);
+
+    const assertionFlags = new Uint8Array(assertion.response.authenticatorData)[32];
+    const signCount = new DataView(assertion.response.authenticatorData).getUint32(33);
+    println(`assertion flags: user present ${!!(assertionFlags & 0x01)}, user verified ${!!(assertionFlags & 0x04)}, sign count ${signCount}`);
+
+    // The signature is over the authenticator data and the hash of the client data.
+    const publicKey = await crypto.subtle.importKey("spki", credential.response.getPublicKey(), { name: "ECDSA", namedCurve: "P-256" }, false, ["verify"]);
+    const clientDataHash = await crypto.subtle.digest("SHA-256", assertion.response.clientDataJSON);
+    const signedData = new Uint8Array([...new Uint8Array(assertion.response.authenticatorData), ...new Uint8Array(clientDataHash)]);
+    const verified = await crypto.subtle.verify({ name: "ECDSA", hash: "SHA-256" }, publicKey, rawSignatureFromDer(assertion.response.signature), signedData);
+    println(`signature verifies: ${verified}`);
+
+    try {
+        await navigator.credentials.get({ publicKey: { challenge: assertionChallenge, allowCredentials: [{ type: "public-key", id: new Uint8Array(32) }] } });
+        println("unknown credential: resolved");
+    } catch (e) {
+        println(`unknown credential: ${e.name}`);
+    }
+
+    removeVirtualAuthenticator(authenticator);
+    done();
+});
+</script>
diff --git a/Tests/LibWeb/Text/input/WebAuthn/cross-origin-iframe.html b/Tests/LibWeb/Text/input/WebAuthn/cross-origin-iframe.html
new file mode 100644
index 0000000000000000000000000000000000000000..a95963ff324c1ef3682406d4efe2452f2e538782
--- /dev/null
+++ b/Tests/LibWeb/Text/input/WebAuthn/cross-origin-iframe.html
@@ -0,0 +1,56 @@
+<!DOCTYPE html>
+<script src="../include.js"></script>
+<script>
+function nextMessage() {
+    return new Promise(resolve => window.addEventListener("message", event => resolve(event.data), { once: true }));
+}
+
+async function loadFrame(allow) {
+    const frame = document.createElement("iframe");
+    if (allow)
+        frame.allow = allow;
+    const frameHost = `frame-${location.hostname}`;
+    frame.src = `${location.protocol}//${frameHost}:${location.port}/static/Text/data/webauthn-get-in-frame.html`;
+    const ready = nextMessage();
+    document.body.appendChild(frame);
+    const { origin } = await ready;
+    return { frame, origin, host: frameHost };
+}
+
+async function getInFrame(frame, credentialId) {
+    const result = nextMessage();
+    frame.contentWindow.postMessage(credentialId, "*");
+    return await result;
+}
+
+asyncTest(async done => {
+    const authenticator = JSON.parse(internals.runWebAuthnCommand("add-virtual-authenticator", JSON.stringify({ protocol: "ctap2", transport: "usb" })));
+
+    // A credential for the frame's site, as if it had registered earlier.
+    const keyPair = await crypto.subtle.generateKey({ name: "ECDSA", namedCurve: "P-256" }, true, ["sign", "verify"]);
+    const pkcs8 = new Uint8Array(await crypto.subtle.exportKey("pkcs8", keyPair.privateKey));
+    const base64url = bytes => btoa(String.fromCharCode(...bytes)).replaceAll("+", "-").replaceAll("/", "_").replaceAll("=", "");
+    const credentialId = crypto.getRandomValues(new Uint8Array(16));
+
+    const withoutAllow = await loadFrame(null);
+    internals.runWebAuthnCommand("add-credential", JSON.stringify({
+        credentialId: base64url(credentialId),
+        isResidentCredential: false,
+        rpId: withoutAllow.host,
+        privateKey: base64url(pkcs8),
+        signCount: 0,
+    }), [authenticator]);
+
+    const denied = await getInFrame(withoutAllow.frame, credentialId);
+    println(`cross-origin frame without allow: ${denied.result}`);
+
+    const withAllow = await loadFrame("publickey-credentials-get");
+    const allowed = await getInFrame(withAllow.frame, credentialId);
+    println(`cross-origin frame with allow: ${allowed.result}`);
+    const clientData = JSON.parse(allowed.clientData);
+    println(`origin is the frame's: ${clientData.origin === withAllow.origin}, crossOrigin: ${clientData.crossOrigin}, topOrigin is the page's: ${clientData.topOrigin === location.origin}`);
+
+    internals.runWebAuthnCommand("remove-virtual-authenticator", "null", [authenticator]);
+    done();
+});
+</script>
