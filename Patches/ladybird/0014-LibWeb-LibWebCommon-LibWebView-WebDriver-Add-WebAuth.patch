index 0000000000000000000000000000000000000000..2d1008ad015e12f26bf2aa4d5f4d858afd77d839
--- /dev/null
+++ b/Tests/LibWebView/test-webdriver-webauthn.py
@@ -0,0 +1,140 @@
+#!/usr/bin/env python3
+#
+# Copyright (c) 2026-present, the Ladybird developers.
+#
+# SPDX-License-Identifier: BSD-2-Clause
+
+# WebAuthn's WebDriver extension: a virtual authenticator that WebDriver adds registers a credential and signs in with
+# it, as a security key would, and WebDriver can then list, add and remove its credentials.
+# https://w3c.github.io/webauthn/#sctn-automation
+
+import http.server
+import runpy
+import subprocess
+import sys
+import threading
+
+from pathlib import Path
+
+helpers = runpy.run_path(str(Path(__file__).with_name("test-webdriver-delete-session.py")))
+
+PAGE = b"""<!doctype html>
+<title>WebAuthn</title>
+<script>
+function base64url(buffer) {
+    return btoa(String.fromCharCode(...new Uint8Array(buffer))).replaceAll("+", "-").replaceAll("/", "_").replaceAll("=", "");
+}
+
+async function register() {
+    const credential = await navigator.credentials.create({
+        publicKey: {
+            rp: { name: "WebDriver test" },
+            user: { id: new Uint8Array([7, 7, 7]), name: "user", displayName: "User" },
+            challenge: new Uint8Array(32),
+            pubKeyCredParams: [{ type: "public-key", alg: -7 }],
+            authenticatorSelection: { residentKey: "required" },
+        },
+    });
+    return credential.id;
+}
+
+async function signIn() {
+    const assertion = await navigator.credentials.get({ publicKey: { challenge: new Uint8Array(32) } });
+    return { id: assertion.id, userHandle: base64url(assertion.response.userHandle) };
+}
+</script>
+"""
+
+
+class Handler(http.server.BaseHTTPRequestHandler):
+    def do_GET(self):
+        self.send_response(200)
+        self.send_header("Content-Type", "text/html")
+        self.send_header("Cache-Control", "no-store")
+        self.end_headers()
+        self.wfile.write(PAGE)
+
+    def log_message(self, format, *args):
+        pass
+
+
+server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+threading.Thread(target=server.serve_forever, daemon=True).start()
+port = helpers["unused_port"]()
+process = subprocess.Popen([sys.argv[1], "--headless", "-l", "127.0.0.1", "-p", str(port)])
+session = None
+try:
+    helpers["wait_for_port"](port)
+    session = helpers["create_session"](port)
+
+    def command(method, path, body=None):
+        status, payload, raw = helpers["request"](port, method, f"/session/{session}/{path}", body)
+        assert status == 200, f"{method} {path}: {raw}"
+        return payload["value"]
+
+    def run(script):
+        return command("POST", "execute/async", {"script": f"{script}.then(arguments[0], e => arguments[0](e.name))", "args": []})
+
+    # localhost is a secure context with a domain, so it may use WebAuthn.
+    command("POST", "url", {"url": f"http://localhost:{server.server_port}/"})
+
+    authenticator = command(
+        "POST",
+        "webauthn/authenticator",
+        {"protocol": "ctap2", "transport": "usb", "hasResidentKey": True, "hasUserVerification": True, "isUserVerified": True},
+    )
+
+    credential_id = run("register()")
+    credentials = command("GET", f"webauthn/authenticator/{authenticator}/credentials")
+    assert len(credentials) == 1, f"Expected one credential, got {credentials}"
+    assert credentials[0]["credentialId"] == credential_id, f"{credentials[0]['credentialId']} != {credential_id}"
+    assert credentials[0]["rpId"] == "localhost", credentials[0]
+    assert credentials[0]["isResidentCredential"] is True, credentials[0]
+
+    # A discoverable credential signs in without an allow list, and says whose it is.
+    signed_in = run("signIn()")
+    assert signed_in["id"] == credential_id, signed_in
+    assert signed_in["userHandle"] == "BwcH", signed_in
+    credentials = command("GET", f"webauthn/authenticator/{authenticator}/credentials")
+    assert credentials[0]["signCount"] == 1, credentials[0]
+
+    # A credential added through WebDriver, with its private key, signs in as well.
+    command("DELETE", f"webauthn/authenticator/{authenticator}/credentials")
+    command(
+        "POST",
+        f"webauthn/authenticator/{authenticator}/credential",
+        {
+            "credentialId": "AQID",
+            "isResidentCredential": True,
+            "rpId": "localhost",
+            "privateKey": credentials[0]["privateKey"],
+            "userHandle": "CAgI",
+            "signCount": 41,
+        },
+    )
+    signed_in = run("signIn()")
+    assert signed_in == {"id": "AQID", "userHandle": "CAgI"}, signed_in
+
+    # Without user verification, a ceremony that requires it fails.
+    command("POST", f"webauthn/authenticator/{authenticator}/uv", {"isUserVerified": False})
+    result = run("navigator.credentials.get({ publicKey: { challenge: new Uint8Array(32), userVerification: 'required' } })")
+    assert result == "NotAllowedError", result
+
+    command("DELETE", f"webauthn/authenticator/{authenticator}")
+    status, payload, raw = helpers["request"](port, "GET", f"/session/{session}/webauthn/authenticator/{authenticator}/credentials")
+    assert status == 400 and payload["value"]["error"] == "invalid argument", raw
+
+    print("PASS: WebAuthn's WebDriver extension drives a virtual authenticator")
+finally:
+    try:
+        if session is not None:
+            helpers["request"](port, "DELETE", f"/session/{session}")
+    finally:
+        process.terminate()
+        try:
+            process.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+        server.shutdown()
+        server.server_close()
