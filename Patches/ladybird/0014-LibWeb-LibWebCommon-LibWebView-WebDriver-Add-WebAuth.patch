+NonnullRefPtr<VirtualAuthenticator> VirtualAuthenticator::create(String id, Configuration configuration, Optional<Web::HTML::CrossProcessId> traversable_id)
+{
+    return adopt_ref(*new VirtualAuthenticator(move(id), configuration, traversable_id));
