From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan <ryan@esterlines.com>
Date: Mon, 26 Oct 2026 19:05:04 -0400
Subject: [PATCH] LibWebCommon: Add the publickey-credentials-create and -get
 features

WebAuthn defines two policy-controlled features, whose default
allowlists are 'self', for navigator.credentials.create() and get() with
publicKey. Adding them lets an embedding page grant them to a
cross-origin frame with <iframe allow="publickey-credentials-get">.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../LibWebCommon/PermissionsPolicy/PermissionsPolicy.cpp   | 7 +++++++
 .../LibWebCommon/PermissionsPolicy/PermissionsPolicy.h     | 2 ++
 2 files changed, 9 insertions(+)

diff --git a/Libraries/LibWebCommon/PermissionsPolicy/PermissionsPolicy.cpp b/Libraries/LibWebCommon/PermissionsPolicy/PermissionsPolicy.cpp
index 1298ad270bd5580ba8949714048fdcbf7bb8ec73..a18c66eacdab63d050b8df12e4fcfd9a0cc72039 100644
--- a/Libraries/LibWebCommon/PermissionsPolicy/PermissionsPolicy.cpp
+++ b/Libraries/LibWebCommon/PermissionsPolicy/PermissionsPolicy.cpp
@@ -36,6 +36,10 @@ StringView policy_controlled_feature_token(PolicyControlledFeature feature)
         return "microphone"sv;
     case PolicyControlledFeature::PictureInPicture:
         return "picture-in-picture"sv;
+    case PolicyControlledFeature::PublicKeyCredentialsCreate:
+        return "publickey-credentials-create"sv;
+    case PolicyControlledFeature::PublicKeyCredentialsGet:
+        return "publickey-credentials-get"sv;
     case PolicyControlledFeature::WindowManagement:
         return "window-management"sv;
     }
@@ -71,6 +75,9 @@ DefaultAllowlist default_allowlist(PolicyControlledFeature feature)
     case PolicyControlledFeature::Geolocation:
     // https://w3c.github.io/mediacapture-main/#permissions-policy-integration
     case PolicyControlledFeature::Microphone:
+    // https://w3c.github.io/webauthn/#sctn-permissions-policy
+    case PolicyControlledFeature::PublicKeyCredentialsCreate:
+    case PolicyControlledFeature::PublicKeyCredentialsGet:
     // https://w3c.github.io/window-management/#api-permission-policy-integration
     case PolicyControlledFeature::WindowManagement:
         return DefaultAllowlist::Self;
diff --git a/Libraries/LibWebCommon/PermissionsPolicy/PermissionsPolicy.h b/Libraries/LibWebCommon/PermissionsPolicy/PermissionsPolicy.h
index d8a01defc970d26e95e826ff88e9b14ca3ce9b8f..26daa2aa55c965dfd39a634dfe9a052ce33ea93e 100644
--- a/Libraries/LibWebCommon/PermissionsPolicy/PermissionsPolicy.h
+++ b/Libraries/LibWebCommon/PermissionsPolicy/PermissionsPolicy.h
@@ -32,6 +32,8 @@ enum class PolicyControlledFeature : u8 {
     Geolocation,
     Microphone,
     PictureInPicture,
+    PublicKeyCredentialsCreate,
+    PublicKeyCredentialsGet,
     WindowManagement,
 };
 
