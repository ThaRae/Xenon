 Libraries/LibWebView/Application.h          |  4 ++--
 Libraries/LibWebView/HeadlessWebView.cpp    |  8 ++++----
 Libraries/LibWebView/HeadlessWebView.h      |  4 ++--
 Libraries/LibWebView/ViewImplementation.cpp |  5 +++--
