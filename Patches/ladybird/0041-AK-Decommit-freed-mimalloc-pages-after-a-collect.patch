From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xenon <xenon@localhost>
Date: Thu, 29 Oct 2026 02:42:03 -0400
Subject: [PATCH] AK: Decommit freed mimalloc pages after a collect

ak_kmalloc_collect() only resets pages (MADV_FREE on Linux), so they
stay in RSS until the kernel is short of memory. ak_kmalloc_decommit_free_pages()
turns on purge-decommits for one collect, then restores the default.
Use it after building the content blocker, when the process is not about
to allocate that much again.
---
 AK/kmalloc.cpp                               | 15 +++++++++++++++
 AK/kmalloc.h                                 |  1 +
 Libraries/LibWeb/Fingerprinting/Farbling.cpp | 19 ++++++++++++-------
 Libraries/LibWeb/Loader/ContentBlocker.cpp   |  4 +++-
 Libraries/LibWebView/Application.cpp         |  4 ++++
 Libraries/LibWebView/Options.h               |  8 ++++++++
 Services/WebContent/ConnectionFromClient.cpp | 19 +++++++++++++++++++
 Services/WebContent/ConnectionFromClient.h   |  6 ++++++
 Services/WebContent/PageClient.cpp           |  1 +
 9 files changed, 69 insertions(+), 8 deletions(-)

diff --git a/AK/kmalloc.cpp b/AK/kmalloc.cpp
index 70ad04dd5f48514f48d50befc8948d4a8e396a1e..fe0a9016983ecdf6d200145892d3287cd263cc01 100644
--- a/AK/kmalloc.cpp
+++ b/AK/kmalloc.cpp
@@ -85,6 +85,10 @@ void ak_kmalloc_collect()
 {
 }
 
+void ak_kmalloc_decommit_free_pages()
+{
+}
+
 #else
 
 #    if defined(AK_OS_LINUX) || defined(AK_OS_MACOS)
@@ -188,4 +192,15 @@ void ak_kmalloc_collect()
     mi_collect(true);
 }
 
+void ak_kmalloc_decommit_free_pages()
+{
+    // A purge only resets pages by default (MADV_FREE on Linux), which keeps them in RSS until the kernel is short of
+    // memory, so ak_kmalloc_collect() alone does not give a process's memory back. Decommit for this collect instead,
+    // so that freed pages leave the process's RSS and PSS. Later reuse faults them in again, so this is for a moment
+    // when the process is not about to allocate much, not for every collect.
+    mi_option_set(mi_option_purge_decommits, 1);
+    ak_kmalloc_collect();
+    mi_option_set(mi_option_purge_decommits, 0);
+}
+
 #endif
diff --git a/AK/kmalloc.h b/AK/kmalloc.h
index 9517b892c27c40571d68ebc48b0a4ad5cca9fd35..38c10f16087dc7bb8b86be574c7240344cbba16a 100644
--- a/AK/kmalloc.h
+++ b/AK/kmalloc.h
@@ -31,6 +31,7 @@ void ak_kfree(void* ptr);
 [[nodiscard]] void* ak_krealloc(HeapPartition, void* ptr, size_t size);
 [[nodiscard]] size_t ak_kmalloc_usable_size(void const* ptr);
 void ak_kmalloc_collect();
+void ak_kmalloc_decommit_free_pages();
 
 [[nodiscard]] inline void* kcalloc(size_t count, size_t size)
 {
diff --git a/Libraries/LibWeb/Fingerprinting/Farbling.cpp b/Libraries/LibWeb/Fingerprinting/Farbling.cpp
index 175334e7065b89902297758b59af35a712454fc6..d38c71c7d2b7bdd06ce89b1fbce5e283ab855a01 100644
--- a/Libraries/LibWeb/Fingerprinting/Farbling.cpp
+++ b/Libraries/LibWeb/Fingerprinting/Farbling.cpp
@@ -93,20 +93,25 @@ u64 lfsr_next(u64 value)
     return value;
 }
 
-// Hashes the pixels eight bytes at a time, which keeps it cheap next to encoding the image.
+// Hashes the pixels eight bytes at a time. Only a bounded, evenly spread sample of the words is read: the hash exists
+// to give different images unrelated patterns, not to be a content fingerprint, and walking a multi-megabyte canvas on
+// every read costs far more than the perturbation itself.
 static u64 hash_pixels(ReadonlyBytes pixels)
 {
-    u64 hash = 0;
-    size_t offset = 0;
-    for (; offset + sizeof(u64) <= pixels.size(); offset += sizeof(u64)) {
+    static constexpr size_t max_sampled_words = 512;
+
+    u64 hash = pixels.size();
+    auto word_count = pixels.size() / sizeof(u64);
+    auto stride = max<size_t>(word_count / max_sampled_words, 1);
+    for (size_t word_index = 0; word_index < word_count; word_index += stride) {
         u64 word;
-        __builtin_memcpy(&word, pixels.offset_pointer(offset), sizeof(word));
+        __builtin_memcpy(&word, pixels.offset_pointer(word_index * sizeof(u64)), sizeof(word));
         hash ^= word;
         hash = ((hash << 31) | (hash >> 33)) * 0x9E3779B97F4A7C15ull;
     }
-    for (; offset < pixels.size(); ++offset)
+    for (size_t offset = word_count * sizeof(u64); offset < pixels.size(); ++offset)
         hash = (hash ^ pixels[offset]) * 0x100000001B3ull;
-    return mix64(hash ^ pixels.size());
+    return mix64(hash);
 }
 
 void perturb_pixels(Bytes rgba, u64 seed, PixelsHaveAlpha has_alpha)
diff --git a/Libraries/LibWeb/Loader/ContentBlocker.cpp b/Libraries/LibWeb/Loader/ContentBlocker.cpp
index ba8a962a5e630f20240caa4cb9b0f782b5390ddb..16cbd756f35a1e2656aaac362ba41c335222cfa3 100644
--- a/Libraries/LibWeb/Loader/ContentBlocker.cpp
+++ b/Libraries/LibWeb/Loader/ContentBlocker.cpp
@@ -162,7 +162,9 @@ ErrorOr<void> ContentBlocker::set_rules_from_bytes(ReadonlyBytes rules_bytes, Re
 {
     // NB: Building an engine allocates several times what the engine keeps, on this thread, whose heap nothing else
     //     collects. Give that memory back, and an old engine's, rather than keeping it for the life of the process.
-    ScopeGuard collect_memory = [] { ak_kmalloc_collect(); };
+    //     A plain collect only resets the freed pages (mimalloc's MADV_FREE default on Linux), which keeps them in RSS,
+    //     so decommit them: this runs once, after the page has loaded, and nothing collects them again.
+    ScopeGuard collect_memory = [] { ak_kmalloc_decommit_free_pages(); };
 
     // OPTIMIZATION: Building an engine costs the same tokenizing and flatbuffer work whether or not there are any
     //               rules to put in it, and every caller already treats a missing engine as "nothing is blocked".
