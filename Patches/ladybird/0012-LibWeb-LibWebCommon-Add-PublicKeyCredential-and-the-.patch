+Optional<u64> Page::request_web_authn_create(HTML::CrossProcessId navigable_id, HTML::CrossProcessId document_id, WebAuthn::CreateRequest request, WebAuthnCallback callback)
+{
+    auto request_id = m_next_web_authn_request_id++;
+    if (!client().page_did_request_web_authn_create(request_id, navigable_id, document_id, request))
+        return {};
+    m_pending_web_authn_requests.set(request_id, callback);
+    return request_id;
+}
+
+Optional<u64> Page::request_web_authn_get(HTML::CrossProcessId navigable_id, HTML::CrossProcessId document_id, WebAuthn::GetRequest request, WebAuthnCallback callback)
+{
+    auto request_id = m_next_web_authn_request_id++;
+    if (!client().page_did_request_web_authn_get(request_id, navigable_id, document_id, request))
+        return {};
+    m_pending_web_authn_requests.set(request_id, callback);
+    return request_id;
+}
+
+void Page::cancel_web_authn_request(u64 request_id)
+{
+    if (m_pending_web_authn_requests.remove(request_id))
+        client().page_did_cancel_web_authn_request(request_id);
+}
+
+void Page::web_authn_request_completed(u64 request_id, WebAuthn::Result result)
+{
+    if (auto callback = m_pending_web_authn_requests.take(request_id); callback.has_value())
+        callback.value()->function()(move(result));
+}
