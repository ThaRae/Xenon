@@ -0,0 +1,70 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibWebCommon/WebAuthn/WebAuthn.h>
+
+namespace Web::WebAuthn {
+
+StringView authenticator_transport_to_string(AuthenticatorTransport transport)
+{
+    switch (transport) {
+    case AuthenticatorTransport::Usb:
+        return "usb"sv;
+    case AuthenticatorTransport::Nfc:
+        return "nfc"sv;
+    case AuthenticatorTransport::Ble:
+        return "ble"sv;
+    case AuthenticatorTransport::SmartCard:
+        return "smart-card"sv;
+    case AuthenticatorTransport::Hybrid:
+        return "hybrid"sv;
+    case AuthenticatorTransport::Internal:
+        return "internal"sv;
+    }
+    VERIFY_NOT_REACHED();
+}
+
+Optional<AuthenticatorTransport> authenticator_transport_from_string(StringView string)
+{
+    for (auto transport : { AuthenticatorTransport::Usb, AuthenticatorTransport::Nfc, AuthenticatorTransport::Ble, AuthenticatorTransport::SmartCard, AuthenticatorTransport::Hybrid, AuthenticatorTransport::Internal }) {
+        if (authenticator_transport_to_string(transport) == string)
+            return transport;
+    }
+    return {};
+}
+
+StringView authenticator_attachment_to_string(AuthenticatorAttachment attachment)
+{
+    switch (attachment) {
+    case AuthenticatorAttachment::Platform:
+        return "platform"sv;
+    case AuthenticatorAttachment::CrossPlatform:
+        return "cross-platform"sv;
+    }
+    VERIFY_NOT_REACHED();
+}
+
+Optional<AuthenticatorAttachment> authenticator_attachment_from_string(StringView string)
+{
+    if (string == "platform"sv)
+        return AuthenticatorAttachment::Platform;
+    if (string == "cross-platform"sv)
+        return AuthenticatorAttachment::CrossPlatform;
+    return {};
+}
+
+Optional<UserVerificationRequirement> user_verification_requirement_from_string(StringView string)
+{
+    if (string == "required"sv)
+        return UserVerificationRequirement::Required;
+    if (string == "preferred"sv)
+        return UserVerificationRequirement::Preferred;
+    if (string == "discouraged"sv)
+        return UserVerificationRequirement::Discouraged;
+    return {};
+}
+
+}
diff --git a/Libraries/LibWebCommon/WebAuthn/WebAuthn.h b/Libraries/LibWebCommon/WebAuthn/WebAuthn.h
