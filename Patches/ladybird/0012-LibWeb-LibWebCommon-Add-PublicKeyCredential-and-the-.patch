 };
 
+// https://w3c.github.io/webauthn/#sctn-PublicKeyCredential-credential-type-registry
+static constexpr CredentialTypeRegistryEntry s_public_key_entry {
+    .type = CredentialType::PublicKey,
+    .type_string = "public-key"sv,
+    .get_permissions_policy = PermissionsPolicy::PolicyControlledFeature::PublicKeyCredentialsGet,
+    .create_permissions_policy = PermissionsPolicy::PolicyControlledFeature::PublicKeyCredentialsCreate,
+    .type_allowed_in_the_same_get_request = {},
