+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteBuffer.h>
+#include <AK/Optional.h>
+#include <AK/String.h>
+#include <AK/Variant.h>
+#include <AK/Vector.h>
+#include <LibWebCommon/Export.h>
+
+// The authenticator part of a WebAuthn ceremony runs in the browser process, which has access to authenticators and
+// knows the requesting document's origin and ancestors. These are the requests a renderer makes for it, and the
+// results it gets back.
+namespace Web::WebAuthn {
+
+// https://w3c.github.io/webauthn/#enum-transport
+enum class AuthenticatorTransport : u8 {
+    Usb,
+    Nfc,
+    Ble,
+    SmartCard,
+    Hybrid,
+    Internal,
+};
+
+WEBCOMMON_API StringView authenticator_transport_to_string(AuthenticatorTransport);
+WEBCOMMON_API Optional<AuthenticatorTransport> authenticator_transport_from_string(StringView);
+
+// https://w3c.github.io/webauthn/#enum-attachment
+enum class AuthenticatorAttachment : u8 {
+    Platform,
+    CrossPlatform,
+};
+
+WEBCOMMON_API StringView authenticator_attachment_to_string(AuthenticatorAttachment);
+WEBCOMMON_API Optional<AuthenticatorAttachment> authenticator_attachment_from_string(StringView);
+
+// https://w3c.github.io/webauthn/#enum-residentKeyRequirement
+enum class ResidentKeyRequirement : u8 {
+    Discouraged,
+    Preferred,
+    Required,
+};
+
+// https://w3c.github.io/webauthn/#enum-userVerificationRequirement
+enum class UserVerificationRequirement : u8 {
+    Required,
+    Preferred,
+    Discouraged,
+};
+
+WEBCOMMON_API Optional<UserVerificationRequirement> user_verification_requirement_from_string(StringView);
+
+// https://w3c.github.io/webauthn/#enum-attestation-convey
+enum class AttestationConveyancePreference : u8 {
+    None,
+    Indirect,
+    Direct,
+    Enterprise,
+};
+
+// https://w3c.github.io/webauthn/#dictdef-publickeycredentialdescriptor
+struct WEBCOMMON_API PublicKeyCredentialDescriptor {
+    ByteBuffer id;
+    Vector<AuthenticatorTransport> transports;
+};
+
+// The authenticator part of PublicKeyCredential's [[Create]], once the renderer has processed its arguments. The
+// browser process works out the caller's origin and ancestors itself.
+struct WEBCOMMON_API CreateRequest {
+    String rp_id;
+    String rp_name;
+    ByteBuffer user_id;
+    String user_name;
+    String user_display_name;
+    ByteBuffer challenge;
+
+    // The COSEAlgorithmIdentifiers of credTypesAndPubKeyAlgs, in order of preference.
+    Vector<i32> public_key_algorithms;
+
+    // lifetimeTimer, in milliseconds.
+    u32 timeout { 0 };
+
+    Vector<PublicKeyCredentialDescriptor> exclude_credentials;
+    Optional<AuthenticatorAttachment> authenticator_attachment;
+    ResidentKeyRequirement resident_key { ResidentKeyRequirement::Discouraged };
+    UserVerificationRequirement user_verification { UserVerificationRequirement::Preferred };
+    AttestationConveyancePreference attestation { AttestationConveyancePreference::None };
+    Vector<String> hints;
+
+    // https://w3c.github.io/webauthn/#sctn-authenticator-credential-properties-extension
+    bool credential_properties { false };
+};
+
+// The authenticator part of PublicKeyCredential's [[DiscoverFromExternalSource]].
+struct WEBCOMMON_API GetRequest {
+    String rp_id;
+    ByteBuffer challenge;
+
+    // lifetimeTimer, in milliseconds.
+    u32 timeout { 0 };
+
+    Vector<PublicKeyCredentialDescriptor> allow_credentials;
+    UserVerificationRequirement user_verification { UserVerificationRequirement::Preferred };
+    Vector<String> hints;
+
+    // https://w3c.github.io/webauthn/#sctn-appid-extension
+    Optional<String> app_id;
+};
+
+// What constructCredentialAlg needs for a new credential, and the AuthenticatorAttestationResponse's convenience
+// methods' values, so that renderers don't have to parse the attestation object.
+struct WEBCOMMON_API RegistrationResponse {
+    ByteBuffer credential_id;
+    ByteBuffer client_data_json;
+    ByteBuffer attestation_object;
+    ByteBuffer authenticator_data;
+
+    // The credential public key as a SubjectPublicKeyInfo, if it uses an algorithm that getPublicKey() supports.
+    Optional<ByteBuffer> public_key;
+    i32 public_key_algorithm { 0 };
+
+    Vector<AuthenticatorTransport> transports;
+    Optional<AuthenticatorAttachment> authenticator_attachment;
+
+    // The credProps extension's output, if the request asked for it.
+    Optional<bool> resident_key;
+};
+
+// What constructAssertionAlg needs for an assertion.
+struct WEBCOMMON_API AssertionResponse {
+    ByteBuffer credential_id;
+    ByteBuffer client_data_json;
+    ByteBuffer authenticator_data;
+    ByteBuffer signature;
+    Optional<ByteBuffer> user_handle;
+    Optional<AuthenticatorAttachment> authenticator_attachment;
+
+    // The appid extension's output, if the request asked for it.
+    Optional<bool> used_app_id;
+};
+
+// The DOMException a ceremony fails with.
+enum class ErrorName : u8 {
+    NotAllowedError,
+    InvalidStateError,
+    NotSupportedError,
+    SecurityError,
+    ConstraintError,
+    UnknownError,
+};
+
+struct WEBCOMMON_API Error {
+    ErrorName name { ErrorName::NotAllowedError };
+    String message;
+};
+
+using Result = Variant<RegistrationResponse, AssertionResponse, Error>;
+
+}
+
+#include <LibWebCommon/WebAuthn/WebAuthnCodecs.h>
