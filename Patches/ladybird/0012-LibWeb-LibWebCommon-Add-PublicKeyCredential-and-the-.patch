-    [[maybe_unused]] auto same_origin_with_ancestors = is_same_origin_with_its_ancestors(settings);
+    auto same_origin_with_ancestors = is_same_origin_with_its_ancestors(settings);
 
     // 7. Let interfaces be the set of options’ relevant credential interface objects.
     auto interfaces = relevant_credential_interface_objects(options);
@@ -501,6 +521,13 @@ void CredentialsContainer::create(JS::Realm& realm, CredentialCreationOptions co
     case CredentialType::Federated:
         settle_in_a_task(realm, promise, create_a_federated_credential(origin, options), options.mediation);
         return;
+    case CredentialType::PublicKey: {
