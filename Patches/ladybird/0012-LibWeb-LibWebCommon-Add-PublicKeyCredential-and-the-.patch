+    Optional<Web::WebAuthn::AuthenticatorAttachment> authenticator_attachment;
+    Web::WebAuthn::ResidentKeyRequirement resident_key;
+    Web::WebAuthn::UserVerificationRequirement user_verification;
+    Web::WebAuthn::AttestationConveyancePreference attestation;
