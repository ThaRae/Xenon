+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <LibGC/Function.h>
+#include <LibJS/Runtime/ArrayBuffer.h>
+#include <LibURL/Origin.h>
+#include <LibWeb/Bindings/PublicKeyCredential.h>
+#include <LibWeb/CredentialManagement/Credential.h>
+#include <LibWeb/CredentialManagement/CredentialsContainer.h>
+#include <LibWeb/WebAuthn/AuthenticatorResponse.h>
+#include <LibWeb/WebIDL/ExceptionOr.h>
+#include <LibWebCommon/WebAuthn/WebAuthn.h>
+
+namespace Web::WebAuthn {
+
+// The outcome of [[Create]] or [[DiscoverFromExternalSource]], once it has finished in parallel.
+using OnCredentialOperationComplete = GC::Ref<GC::Function<void(WebIDL::ExceptionOr<GC::Ptr<CredentialManagement::Credential>>)>>;
+
+// https://w3c.github.io/webauthn/#publickeycredential
+class PublicKeyCredential final : public CredentialManagement::Credential {
+    WEB_WRAPPABLE(PublicKeyCredential, CredentialManagement::Credential);
+    GC_DECLARE_ALLOCATOR(PublicKeyCredential);
+
+public:
+    [[nodiscard]] static GC::Ref<PublicKeyCredential> create(JS::Realm&, RegistrationResponse const&);
+    [[nodiscard]] static GC::Ref<PublicKeyCredential> create(JS::Realm&, AssertionResponse const&);
+
+    virtual ~PublicKeyCredential() override;
+
+    GC::Ref<JS::ArrayBuffer> raw_id() const { return m_raw_id; }
+    GC::Ref<AuthenticatorResponse> response() const { return m_response; }
+    Optional<String> authenticator_attachment() const;
+    Bindings::AuthenticationExtensionsClientOutputs get_client_extension_results() const;
+    GC::Ref<JS::Object> to_json(JS::Realm&) const;
+
+    static GC::Ref<WebIDL::Promise> is_conditional_mediation_available_impl(JS::VM&);
+    static GC::Ref<WebIDL::Promise> is_user_verifying_platform_authenticator_available(JS::VM&);
+    static GC::Ref<WebIDL::Promise> get_client_capabilities(JS::VM&);
+    static WebIDL::ExceptionOr<Bindings::PublicKeyCredentialCreationOptions> parse_creation_options_from_json(JS::Realm&, Bindings::PublicKeyCredentialCreationOptionsJSON const&);
+    static WebIDL::ExceptionOr<Bindings::PublicKeyCredentialRequestOptions> parse_request_options_from_json(JS::Realm&, Bindings::PublicKeyCredentialRequestOptionsJSON const&);
+
+    virtual Utf16FlyString const& type() const override;
+
+    // https://w3c.github.io/webauthn/#sctn-createCredential
+    static void create_a_new_credential(JS::Realm&, URL::Origin const&, CredentialManagement::CredentialCreationOptions const&, bool same_origin_with_ancestors, OnCredentialOperationComplete);
+
+    // https://w3c.github.io/webauthn/#sctn-discover-from-external-source
+    static void discover_from_external_source(JS::Realm&, URL::Origin const&, CredentialManagement::CredentialRequestOptions const&, bool same_origin_with_ancestors, OnCredentialOperationComplete);
+
+private:
+    // The client extension outputs, for the extensions Ladybird supports.
+    struct ClientExtensionResults {
+        Optional<bool> app_id;
+        Optional<bool> resident_key;
+    };
+
+    PublicKeyCredential(ByteBuffer const& raw_id, GC::Ref<JS::ArrayBuffer>, GC::Ref<AuthenticatorResponse>, Optional<AuthenticatorAttachment>, ClientExtensionResults);
+
+    virtual void visit_edges(Cell::Visitor&) override;
+
+    ByteBuffer m_raw_id_bytes;
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-rawid
+    GC::Ref<JS::ArrayBuffer> m_raw_id;
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-response
+    GC::Ref<AuthenticatorResponse> m_response;
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-authenticatorattachment
+    Optional<AuthenticatorAttachment> m_authenticator_attachment;
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-clientextensionsresults-slot
+    ClientExtensionResults m_client_extension_results;
+};
+
+}
