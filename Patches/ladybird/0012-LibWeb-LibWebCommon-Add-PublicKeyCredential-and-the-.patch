+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/Base64.h>
+#include <LibGC/Heap.h>
+#include <LibJS/Runtime/Array.h>
+#include <LibJS/Runtime/Object.h>
+#include <LibJS/Runtime/PrimitiveString.h>
+#include <LibJS/Runtime/Realm.h>
+#include <LibURL/Parser.h>
+#include <LibWeb/Bindings/WrapperWorld.h>
+#include <LibWeb/DOM/AbortSignal.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/HTML/LocalNavigable.h>
+#include <LibWeb/HTML/Scripting/Environments.h>
+#include <LibWeb/HTML/Window.h>
+#include <LibWeb/Page/Page.h>
+#include <LibWeb/WebAuthn/AuthenticatorAssertionResponse.h>
+#include <LibWeb/WebAuthn/AuthenticatorAttestationResponse.h>
+#include <LibWeb/WebAuthn/PublicKeyCredential.h>
+#include <LibWeb/WebIDL/AbstractOperations.h>
+#include <LibWeb/WebIDL/Buffers.h>
+#include <LibWeb/WebIDL/DOMException.h>
+#include <LibWeb/WebIDL/Promise.h>
+
+namespace Web::WebAuthn {
+
+GC_DEFINE_ALLOCATOR(PublicKeyCredential);
+
+// https://w3c.github.io/webauthn/#sctn-alg-identifier
+static constexpr i32 COSE_ALGORITHM_ES256 = -7;
+static constexpr i32 COSE_ALGORITHM_RS256 = -257;
+
+// https://w3c.github.io/webauthn/#recommended-range-and-default-for-a-webauthn-ceremony-timeout
+static constexpr u32 MINIMUM_CEREMONY_TIMEOUT = 300'000;
+static constexpr u32 MAXIMUM_CEREMONY_TIMEOUT = 600'000;
+static constexpr u32 DEFAULT_CEREMONY_TIMEOUT = 300'000;
+
+static Utf16String base64url_encode(ReadonlyBytes bytes)
+{
+    return MUST(encode_base64url_to_utf16(bytes, AK::OmitPadding::Yes));
+}
+
+static WebIDL::ExceptionOr<GC::Ref<JS::ArrayBuffer>> base64url_decode(JS::Realm& realm, Utf16String const& string)
+{
+    auto bytes = decode_base64url(string.to_utf8());
+    if (bytes.is_error())
+        return WebIDL::EncodingError::create(realm, "Invalid base64url string"_utf16);
+    return JS::ArrayBuffer::create(realm, bytes.release_value());
+}
+
+static WebIDL::ExceptionOr<ByteBuffer> copy_of_buffer_source(WebIDL::BufferSourceVariant const& buffer_source)
+{
+    auto bytes = WebIDL::get_buffer_source_copy(WebIDL::BufferSource { buffer_source });
+    if (bytes.is_error())
+        return WebIDL::SimpleException { WebIDL::SimpleExceptionType::RangeError, "Failed to copy a buffer"_utf16 };
+    return bytes.release_value();
+}
+
+GC::Ref<PublicKeyCredential> PublicKeyCredential::create(JS::Realm& realm, RegistrationResponse const& registration)
+{
+    // https://w3c.github.io/webauthn/#sctn-createCredential, constructCredentialAlg:
+    // 1. Let pubKeyCred be a new PublicKeyCredential object associated with global whose fields are:
+    //    [[identifier]]: A new DOMString containing the base64url encoding of credentialCreationData.attestationObjectResult.credentialId.
+    //    authenticatorAttachment: The AuthenticatorAttachment value matching the current authenticator attachment
+    //                             modality of authenticator.
+    //    response: A new AuthenticatorAttestationResponse object associated with global whose fields are:
+    //        clientDataJSON: A new ArrayBuffer, created using global’s %ArrayBuffer%, containing the bytes of
+    //                        credentialCreationData.clientDataJSONResult.
+    //        attestationObject: A new ArrayBuffer, created using global’s %ArrayBuffer%, containing the bytes of
+    //                           credentialCreationData.attestationObjectResult’s value.
+    //        [[transports]]: A sequence of zero or more unique DOMStrings, in lexicographical order, that the
+    //                        authenticator is believed to support.
+    //    [[clientExtensionsResults]]: A new ArrayBuffer, created using global’s %ArrayBuffer%, containing the bytes of
+    //                                 credentialCreationData.clientExtensionResults.
+    // NB: The browser process has applied the attestation conveyance preference to the attestation object already.
+    auto raw_id = JS::ArrayBuffer::create(realm, registration.credential_id);
+    auto response = AuthenticatorAttestationResponse::create(realm, registration);
+    ClientExtensionResults client_extension_results;
+    client_extension_results.resident_key = registration.resident_key;
+    return GC::Heap::the().allocate<PublicKeyCredential>(registration.credential_id, raw_id, response, registration.authenticator_attachment, client_extension_results);
+}
+
+GC::Ref<PublicKeyCredential> PublicKeyCredential::create(JS::Realm& realm, AssertionResponse const& assertion)
+{
+    // https://w3c.github.io/webauthn/#sctn-getAssertion, constructAssertionAlg:
+    // 1. Let pubKeyCred be a new PublicKeyCredential object associated with global whose fields are:
+    //    [[identifier]]: A new DOMString containing the base64url encoding of the credential ID.
+    //    authenticatorAttachment: The AuthenticatorAttachment value matching the current authenticator attachment
+    //                             modality of authenticator.
+    //    response: A new AuthenticatorAssertionResponse object associated with global, with clientDataJSON,
+    //              authenticatorData, signature and userHandle.
+    //    [[clientExtensionsResults]]: assertionCreationData.clientExtensionResults.
+    auto raw_id = JS::ArrayBuffer::create(realm, assertion.credential_id);
+    auto response = AuthenticatorAssertionResponse::create(realm, assertion);
+    ClientExtensionResults client_extension_results;
+    client_extension_results.app_id = assertion.used_app_id;
+    return GC::Heap::the().allocate<PublicKeyCredential>(assertion.credential_id, raw_id, response, assertion.authenticator_attachment, client_extension_results);
+}
+
+PublicKeyCredential::PublicKeyCredential(ByteBuffer const& raw_id_bytes, GC::Ref<JS::ArrayBuffer> raw_id, GC::Ref<AuthenticatorResponse> response, Optional<AuthenticatorAttachment> authenticator_attachment, ClientExtensionResults client_extension_results)
+    : Credential(base64url_encode(raw_id_bytes))
+    , m_raw_id_bytes(raw_id_bytes)
+    , m_raw_id(raw_id)
+    , m_response(response)
+    , m_authenticator_attachment(authenticator_attachment)
+    , m_client_extension_results(client_extension_results)
+{
+}
+
+PublicKeyCredential::~PublicKeyCredential() = default;
+
+void PublicKeyCredential::visit_edges(Cell::Visitor& visitor)
+{
+    Base::visit_edges(visitor);
+    visitor.visit(m_raw_id);
+    visitor.visit(m_response);
+}
+
+Utf16FlyString const& PublicKeyCredential::type() const
+{
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-type-slot
+    static Utf16FlyString const& type = *new Utf16FlyString("public-key"_utf16_fly_string);
+    return type;
+}
+
+// https://w3c.github.io/webauthn/#dom-publickeycredential-authenticatorattachment
+Optional<String> PublicKeyCredential::authenticator_attachment() const
+{
+    if (!m_authenticator_attachment.has_value())
+        return {};
+    return MUST(String::from_utf8(authenticator_attachment_to_string(*m_authenticator_attachment)));
+}
+
+// https://w3c.github.io/webauthn/#dom-publickeycredential-getclientextensionresults
+Bindings::AuthenticationExtensionsClientOutputs PublicKeyCredential::get_client_extension_results() const
+{
+    // This operation returns the value of [[clientExtensionsResults]], which is a map containing extension identifier
+    // → client extension output entries produced by the extension’s client extension processing.
+    Bindings::AuthenticationExtensionsClientOutputs outputs;
+    outputs.appid = m_client_extension_results.app_id;
+    if (m_client_extension_results.resident_key.has_value())
+        outputs.cred_props = Bindings::CredentialPropertiesOutput { .rk = m_client_extension_results.resident_key };
+    return outputs;
+}
+
+static GC::Ref<JS::Object> client_extension_results_to_json(JS::Realm& realm, Bindings::AuthenticationExtensionsClientOutputs const& outputs)
+{
+    auto object = JS::Object::create(realm, realm.intrinsics().object_prototype());
+    if (outputs.appid.has_value())
+        MUST(object->create_data_property("appid"_utf16_fly_string, JS::Value(*outputs.appid)));
+    if (outputs.cred_props.has_value()) {
+        auto cred_props = JS::Object::create(realm, realm.intrinsics().object_prototype());
+        if (outputs.cred_props->rk.has_value())
+            MUST(cred_props->create_data_property("rk"_utf16_fly_string, JS::Value(*outputs.cred_props->rk)));
+        MUST(object->create_data_property("credProps"_utf16_fly_string, cred_props));
+    }
+    return object;
+}
+
+static JS::Value base64url_value(JS::Realm& realm, ReadonlyBytes bytes)
+{
+    return JS::PrimitiveString::create(realm.vm(), base64url_encode(bytes));
+}
+
+static JS::Value base64url_value(JS::Realm& realm, JS::ArrayBuffer const& buffer)
+{
+    // NB: The buffers of a PublicKeyCredential are never detached or resized: nothing hands them to script that could.
+    auto bytes = MUST(buffer.copy_to_byte_buffer());
+    return base64url_value(realm, bytes.bytes());
+}
+
+// https://w3c.github.io/webauthn/#dom-publickeycredential-tojson
+GC::Ref<JS::Object> PublicKeyCredential::to_json(JS::Realm& realm) const
+{
+    auto& vm = realm.vm();
+    auto json = JS::Object::create(realm, realm.intrinsics().object_prototype());
+    auto response = JS::Object::create(realm, realm.intrinsics().object_prototype());
+
+    // 1. Let encodedResponse be the result of encoding this.response as RegistrationResponseJSON or
+    //    AuthenticationResponseJSON, whose ArrayBuffer members are base64url encoded.
+    MUST(response->create_data_property("clientDataJSON"_utf16_fly_string, base64url_value(realm, m_response->client_data_json())));
+    if (auto const* attestation = m_response->fast_as<AuthenticatorAttestationResponse>()) {
+        // https://w3c.github.io/webauthn/#dictdef-authenticatorattestationresponsejson
+        MUST(response->create_data_property("authenticatorData"_utf16_fly_string, base64url_value(realm, attestation->authenticator_data())));
+        auto transports = attestation->get_transports();
+        auto transports_array = JS::Array::create_from<String>(realm, transports.span(), [&](String const& transport) -> JS::Value {
+            return JS::PrimitiveString::create(vm, Utf16String::from_utf8(transport));
+        });
+        MUST(response->create_data_property("transports"_utf16_fly_string, transports_array));
+        if (attestation->public_key().has_value())
+            MUST(response->create_data_property("publicKey"_utf16_fly_string, base64url_value(realm, *attestation->public_key())));
+        MUST(response->create_data_property("publicKeyAlgorithm"_utf16_fly_string, JS::Value(attestation->get_public_key_algorithm())));
+        MUST(response->create_data_property("attestationObject"_utf16_fly_string, base64url_value(realm, attestation->attestation_object())));
+    } else {
+        // https://w3c.github.io/webauthn/#dictdef-authenticatorassertionresponsejson
+        auto const& assertion = as<AuthenticatorAssertionResponse>(*m_response);
+        MUST(response->create_data_property("authenticatorData"_utf16_fly_string, base64url_value(realm, assertion.authenticator_data())));
+        MUST(response->create_data_property("signature"_utf16_fly_string, base64url_value(realm, assertion.signature())));
+        if (assertion.user_handle())
+            MUST(response->create_data_property("userHandle"_utf16_fly_string, base64url_value(realm, *assertion.user_handle())));
+    }
+
+    MUST(json->create_data_property("id"_utf16_fly_string, JS::PrimitiveString::create(vm, id())));
+    MUST(json->create_data_property("rawId"_utf16_fly_string, base64url_value(realm, m_raw_id_bytes)));
+    MUST(json->create_data_property("response"_utf16_fly_string, response));
+    if (auto attachment = authenticator_attachment(); attachment.has_value())
+        MUST(json->create_data_property("authenticatorAttachment"_utf16_fly_string, JS::PrimitiveString::create(vm, Utf16String::from_utf8(*attachment))));
+    MUST(json->create_data_property("clientExtensionResults"_utf16_fly_string, client_extension_results_to_json(realm, get_client_extension_results())));
+    MUST(json->create_data_property("type"_utf16_fly_string, JS::PrimitiveString::create(vm, type())));
+
+    // 2. Return encodedResponse.
+    return json;
+}
+
+// https://w3c.github.io/webauthn/#dom-publickeycredential-isconditionalmediationavailable
+GC::Ref<WebIDL::Promise> PublicKeyCredential::is_conditional_mediation_available_impl(JS::VM& vm)
+{
+    // NB: Conditional mediation needs an autofill UI for discoverable credentials, which Ladybird doesn't have yet.
+    return WebIDL::create_resolved_promise(*vm.current_realm(), JS::Value(false));
+}
+
+// https://w3c.github.io/webauthn/#dom-publickeycredential-isuserverifyingplatformauthenticatoravailable
+GC::Ref<WebIDL::Promise> PublicKeyCredential::is_user_verifying_platform_authenticator_available(JS::VM& vm)
+{
+    // NB: The browser process only knows of roaming authenticators so far.
+    return WebIDL::create_resolved_promise(*vm.current_realm(), JS::Value(false));
+}
+
+// https://w3c.github.io/webauthn/#dom-publickeycredential-getclientcapabilities
+GC::Ref<WebIDL::Promise> PublicKeyCredential::get_client_capabilities(JS::VM& vm)
+{
+    auto& realm = *vm.current_realm();
+
+    // 1. Let p be a new promise.
+    // 2. Let capabilities be an empty record<DOMString, boolean>.
+    auto capabilities = JS::Object::create(realm, realm.intrinsics().object_prototype());
+
+    // 3. Each ClientCapability, and each WebAuthn extension the client supports as "extension:" followed by its
+    //    extension identifier, is set to whether the client supports it.
+    auto set = [&](StringView key, bool value) {
+        MUST(capabilities->create_data_property(Utf16FlyString::from_utf8(key), JS::Value(value)));
+    };
+    set("conditionalCreate"sv, false);
+    set("conditionalGet"sv, false);
+    set("hybridTransport"sv, false);
+    set("passkeyPlatformAuthenticator"sv, false);
+    set("userVerifyingPlatformAuthenticator"sv, false);
+    set("relatedOrigins"sv, false);
+    set("signalAllAcceptedCredentials"sv, false);
+    set("signalCurrentUserDetails"sv, false);
+    set("signalUnknownCredential"sv, false);
+    set("extension:appid"sv, true);
+    set("extension:credProps"sv, true);
+
+    // 4. Resolve p with capabilities.
+    return WebIDL::create_resolved_promise(realm, capabilities);
+}
+
+static WebIDL::ExceptionOr<Vector<Bindings::PublicKeyCredentialDescriptor>> parse_descriptors_from_json(JS::Realm& realm, Vector<Bindings::PublicKeyCredentialDescriptorJSON> const& descriptors)
+{
+    Vector<Bindings::PublicKeyCredentialDescriptor> result;
+    for (auto const& descriptor : descriptors) {
+        result.append(Bindings::PublicKeyCredentialDescriptor {
+            .id = TRY(base64url_decode(realm, descriptor.id)),
+            .transports = descriptor.transports,
+            .type = descriptor.type,
+        });
+    }
+    return result;
+}
+
+static Optional<Bindings::AuthenticationExtensionsClientInputs> parse_extensions_from_json(Optional<Bindings::AuthenticationExtensionsClientInputsJSON> const& extensions)
+{
+    if (!extensions.has_value())
+        return {};
+    return Bindings::AuthenticationExtensionsClientInputs {
+        .appid = extensions->appid,
+        .cred_props = extensions->cred_props,
+    };
+}
+
+// https://w3c.github.io/webauthn/#dom-publickeycredential-parsecreationoptionsfromjson
+WebIDL::ExceptionOr<Bindings::PublicKeyCredentialCreationOptions> PublicKeyCredential::parse_creation_options_from_json(JS::Realm& realm, Bindings::PublicKeyCredentialCreationOptionsJSON const& options)
+{
+    // Each Base64URLString member is base64url decoded into an ArrayBuffer, and an "EncodingError" DOMException is
+    // thrown if decoding fails.
+    Bindings::PublicKeyCredentialUserEntity user {
+        { options.user.name },
+        options.user.display_name,
+        TRY(base64url_decode(realm, options.user.id)),
+    };
+
+    return Bindings::PublicKeyCredentialCreationOptions {
+        options.attestation,
+        options.attestation_formats,
+        options.authenticator_selection,
+        TRY(base64url_decode(realm, options.challenge)),
+        TRY(parse_descriptors_from_json(realm, options.exclude_credentials)),
+        parse_extensions_from_json(options.extensions),
+        options.hints,
+        options.pub_key_cred_params,
+        options.rp,
+        options.timeout,
+        move(user),
+    };
+}
+
+// https://w3c.github.io/webauthn/#dom-publickeycredential-parserequestoptionsfromjson
+WebIDL::ExceptionOr<Bindings::PublicKeyCredentialRequestOptions> PublicKeyCredential::parse_request_options_from_json(JS::Realm& realm, Bindings::PublicKeyCredentialRequestOptionsJSON const& options)
+{
+    return Bindings::PublicKeyCredentialRequestOptions {
+        TRY(parse_descriptors_from_json(realm, options.allow_credentials)),
+        TRY(base64url_decode(realm, options.challenge)),
+        parse_extensions_from_json(options.extensions),
+        options.hints,
+        options.rp_id,
+        options.timeout,
+        options.user_verification,
+    };
+}
+
+static u32 adjusted_timeout(Optional<WebIDL::UnsignedLong> timeout)
+{
+    // If timeout is present, check if its value lies within a reasonable range as defined by the client and if not,
+    // correct it to the closest value lying within that range. If timeout is not present, use a client-specific
+    // default.
+    if (!timeout.has_value())
+        return DEFAULT_CEREMONY_TIMEOUT;
+    return clamp(*timeout, MINIMUM_CEREMONY_TIMEOUT, MAXIMUM_CEREMONY_TIMEOUT);
+}
+
+static Vector<String> hints_from(Vector<Utf16String> const& hints)
+{
+    // https://w3c.github.io/webauthn/#enum-hints
+    Vector<String> result;
+    for (auto const& hint : hints) {
+        if (hint.is_one_of("security-key"sv, "client-device"sv, "hybrid"sv))
+            result.append(hint.to_utf8());
+    }
+    return result;
+}
+
+static WebIDL::ExceptionOr<Vector<PublicKeyCredentialDescriptor>> descriptors_from(Vector<Bindings::PublicKeyCredentialDescriptor> const& descriptors)
+{
+    Vector<PublicKeyCredentialDescriptor> result;
+    for (auto const& descriptor : descriptors) {
+        // Client platforms MUST ignore any PublicKeyCredentialDescriptor with an unknown type.
+        if (descriptor.type != "public-key"sv)
+            continue;
+
+        PublicKeyCredentialDescriptor entry;
+        entry.id = TRY(copy_of_buffer_source(descriptor.id));
+        if (descriptor.transports.has_value()) {
+            for (auto const& transport : *descriptor.transports) {
+                if (auto value = authenticator_transport_from_string(transport.to_utf8()); value.has_value())
+                    entry.transports.append(*value);
+            }
+        }
+        result.append(move(entry));
+    }
+    return result;
+}
+
+// Whether a host is a valid domain, as WebAuthn requires of an effective domain.
+static bool is_a_valid_domain(Optional<URL::Host> const& host)
+{
+    return host.has_value() && host->is_domain() && !host->get<String>().is_empty();
+}
+
+// https://w3c.github.io/webauthn/#rp-id, steps shared by [[Create]] and [[DiscoverFromExternalSource]]
+static WebIDL::ExceptionOr<String> determine_rp_id(URL::Origin const& caller_origin, Optional<Utf16String> const& requested_rp_id)
+{
+    // Let callerOrigin be origin. If callerOrigin is an opaque origin, throw a "NotAllowedError" DOMException.
+    if (caller_origin.is_opaque())
+        return WebIDL::NotAllowedError::create("Opaque origins can't use WebAuthn"_utf16);
+
+    // Let effectiveDomain be the callerOrigin’s effective domain. If effective domain is not a valid domain, then
+    // throw a "SecurityError" DOMException.
+    auto effective_domain = caller_origin.effective_domain();
+    if (!is_a_valid_domain(effective_domain))
+        return WebIDL::SecurityError::create("The caller's origin has no valid domain"_utf16);
+
+    // If rpId is present:
+    if (requested_rp_id.has_value()) {
+        // If rpId is not a registrable domain suffix of and is not equal to effectiveDomain, and if the client does
+        // not support related origin requests, throw a "SecurityError" DOMException.
+        if (!DOM::is_a_registrable_domain_suffix_of_or_is_equal_to(*requested_rp_id, *effective_domain))
+            return WebIDL::SecurityError::create("The RP ID is not a registrable domain suffix of the caller's domain"_utf16);
+        return requested_rp_id->to_utf8();
+    }
+
+    // Otherwise, set rpId to effectiveDomain.
+    return effective_domain->serialize();
+}
+
+static GC::Ref<WebIDL::DOMException> dom_exception_for(Error const& error)
+{
+    auto message = Utf16String::from_utf8(error.message);
+    switch (error.name) {
+    case ErrorName::NotAllowedError:
+        return WebIDL::NotAllowedError::create(message);
+    case ErrorName::InvalidStateError:
+        return WebIDL::InvalidStateError::create(message);
+    case ErrorName::NotSupportedError:
+        return WebIDL::NotSupportedError::create(message);
+    case ErrorName::SecurityError:
+        return WebIDL::SecurityError::create(message);
+    case ErrorName::ConstraintError:
+        return WebIDL::ConstraintError::create(message);
+    case ErrorName::UnknownError:
+        return WebIDL::UnknownError::create(message);
+    }
+    VERIFY_NOT_REACHED();
+}
+
+// What a ceremony running in the browser process needs to remember, until it completes.
+class CeremonyState final : public GC::Cell {
+    GC_CELL(CeremonyState, GC::Cell);
+    GC_DECLARE_ALLOCATOR(CeremonyState);
+
+public:
+    GC::Ptr<DOM::AbortSignal> signal;
+    Optional<DOM::AbortSignal::AbortAlgorithmID> abort_algorithm_id;
+    Optional<u64> request_id;
+    bool is_complete { false };
+
+private:
+    virtual void visit_edges(Visitor& visitor) override
+    {
+        Base::visit_edges(visitor);
+        visitor.visit(signal);
+    }
+};
+
+GC_DEFINE_ALLOCATOR(CeremonyState);
+
+// Hands the authenticator part of a ceremony to the browser process, and completes the ceremony with what it returns,
+// or with the abort reason if options.signal is aborted first.
+template<typename Request>
+static void run_the_ceremony_in_the_browser_process(JS::Realm& realm, DOM::Document& document, GC::Ptr<DOM::AbortSignal> signal, Request request, OnCredentialOperationComplete on_complete)
+{
+    auto& page = document.page();
+    auto state = realm.heap().allocate<CeremonyState>();
+    state->signal = signal;
+
+    auto complete = [state, on_complete](WebIDL::ExceptionOr<GC::Ptr<CredentialManagement::Credential>> result) {
+        if (state->is_complete)
+            return;
+        state->is_complete = true;
+        if (state->signal && state->abort_algorithm_id.has_value())
+            state->signal->remove_abort_algorithm(*state->abort_algorithm_id);
+        on_complete->function()(move(result));
+    };
+
+    auto on_result = GC::create_function(realm.heap(), [realm = GC::Ref { realm }, complete](Result result) mutable {
+        result.visit(
+            [&](RegistrationResponse const& registration) {
+                complete(GC::Ptr<CredentialManagement::Credential> { PublicKeyCredential::create(realm, registration) });
+            },
+            [&](AssertionResponse const& assertion) {
+                complete(GC::Ptr<CredentialManagement::Credential> { PublicKeyCredential::create(realm, assertion) });
+            },
+            [&](Error const& error) {
+                complete(WebIDL::Exception { dom_exception_for(error) });
+            });
+    });
+
+    Optional<u64> request_id;
+    auto navigable_id = document.navigable()->id();
+    auto document_id = document.id();
+    if constexpr (IsSame<Request, CreateRequest>)
+        request_id = page.request_web_authn_create(navigable_id, document_id, move(request), on_result);
+    else
+        request_id = page.request_web_authn_get(navigable_id, document_id, move(request), on_result);
+
+    // NB: An embedder that can't run ceremonies has no authenticators, and the user can never complete one.
+    if (!request_id.has_value()) {
+        complete(WebIDL::Exception { WebIDL::NotAllowedError::create("No authenticators are available"_utf16) });
+        return;
+    }
+    state->request_id = request_id;
+
+    // https://w3c.github.io/webauthn/#sctn-abortoperation
+    // If options.signal is aborted, cancel the authenticator operations and throw the options.signal’s abort reason.
+    if (signal) {
+        state->abort_algorithm_id = signal->add_abort_algorithm([state, complete, page = GC::Ref { page }]() mutable {
+            if (state->is_complete)
+                return;
+            page->cancel_web_authn_request(*state->request_id);
+            complete(WebIDL::Exception { JS::throw_completion(state->signal->reason()) });
+        });
+    }
+}
+
+// https://w3c.github.io/webauthn/#sctn-createCredential
+void PublicKeyCredential::create_a_new_credential(JS::Realm& realm, URL::Origin const& origin, CredentialManagement::CredentialCreationOptions const& options, bool same_origin_with_ancestors, OnCredentialOperationComplete on_complete)
+{
+    auto fail = [&](WebIDL::Exception exception) {
+        on_complete->function()(move(exception));
+    };
+
+    auto* window = HTML::window_from_global_object(realm.global_object());
+    VERIFY(window);
+
+    // 1. Assert: options.publicKey is present.
+    VERIFY(options.public_key.has_value());
+
+    // 2. If sameOriginWithAncestors is false:
+    if (!same_origin_with_ancestors) {
+        // 1. If options.mediation is present with the value conditional, throw a "NotAllowedError" DOMException.
+        if (options.mediation == Bindings::CredentialMediationRequirement::Conditional)
+            return fail(WebIDL::NotAllowedError::create("Conditional creation is not allowed in a cross-origin frame"_utf16));
+
+        // 2. If the relevant global object, as determined by the calling create() implementation, does not have
+        //    transient activation, throw a "NotAllowedError" DOMException.
+        if (!window->has_transient_activation())
+            return fail(WebIDL::NotAllowedError::create("A cross-origin frame needs user activation to create a credential"_utf16));
+
+        // 3. Consume user activation of the relevant global object.
+        window->consume_user_activation();
+
+        // 4. If the origin that is creating a credential is different from the top-level origin of the relevant
+        //    global object, the client SHOULD make this fact clear to the user.
+        // NB: The browser process names both in its prompt.
+    }
+
+    // 3. Let pkOptions be the value of options.publicKey.
+    auto const& pk_options = *options.public_key;
+
+    // 4. If pkOptions.timeout is present, check if its value lies within a reasonable range as defined by the client
+    //    and if not, correct it to the closest value lying within that range. Set a timer lifetimeTimer to this
+    //    adjusted value. If pkOptions.timeout is not present, then set lifetimeTimer to a client-specific default.
+    CreateRequest request;
+    request.timeout = adjusted_timeout(pk_options.timeout);
+
+    // 5. If the length of pkOptions.user.id is not between 1 and 64 bytes (inclusive) then throw a TypeError.
+    // NB: All BufferSource objects used in this algorithm MUST be snapshotted when the algorithm begins.
+    auto user_id = copy_of_buffer_source(pk_options.user.id);
+    if (user_id.is_error())
+        return fail(user_id.release_error());
+    request.user_id = user_id.release_value();
+    if (request.user_id.is_empty() || request.user_id.size() > 64)
+        return fail(WebIDL::SimpleException { WebIDL::SimpleExceptionType::TypeError, "The user ID must be between 1 and 64 bytes long"_utf16 });
+
+    auto challenge = copy_of_buffer_source(pk_options.challenge);
+    if (challenge.is_error())
+        return fail(challenge.release_error());
+    request.challenge = challenge.release_value();
+
+    // 6. Let callerOrigin be origin. If callerOrigin is an opaque origin, throw a "NotAllowedError" DOMException.
+    // 7. Let effectiveDomain be the callerOrigin’s effective domain. If effective domain is not a valid domain, then
+    //    throw a "SecurityError" DOMException.
+    // 8. If pkOptions.rp.id is present, and is not a registrable domain suffix of and is not equal to
+    //    effectiveDomain, throw a "SecurityError" DOMException. If it is not present, set pkOptions.rp.id to
+    //    effectiveDomain.
+    auto rp_id = determine_rp_id(origin, pk_options.rp.id);
+    if (rp_id.is_error())
+        return fail(rp_id.release_error());
+    request.rp_id = rp_id.release_value();
+    request.rp_name = pk_options.rp.name.to_well_formed_utf8();
+    request.user_name = pk_options.user.name.to_well_formed_utf8();
+    request.user_display_name = pk_options.user.display_name.to_well_formed_utf8();
+
+    // 9. Let credTypesAndPubKeyAlgs be a new list whose items are pairs of PublicKeyCredentialType and a
+    //    COSEAlgorithmIdentifier.
+    // 10. If pkOptions.pubKeyCredParams’s size is zero, append ("public-key", -7) and ("public-key", -257).
+    //     Otherwise, for each current of pkOptions.pubKeyCredParams, append (current.type, current.alg) if
+    //     current.type is a PublicKeyCredentialType this implementation supports. If credTypesAndPubKeyAlgs is empty,
+    //     throw a "NotSupportedError" DOMException.
+    if (pk_options.pub_key_cred_params.is_empty()) {
+        request.public_key_algorithms = { COSE_ALGORITHM_ES256, COSE_ALGORITHM_RS256 };
+    } else {
+        for (auto const& parameters : pk_options.pub_key_cred_params) {
+            if (parameters.type != "public-key"sv)
+                continue;
+            request.public_key_algorithms.append(parameters.alg);
+        }
+        if (request.public_key_algorithms.is_empty())
+            return fail(WebIDL::NotSupportedError::create("None of the requested credential types is supported"_utf16));
+    }
+
+    auto exclude_credentials = descriptors_from(pk_options.exclude_credentials);
+    if (exclude_credentials.is_error())
+        return fail(exclude_credentials.release_error());
+    request.exclude_credentials = exclude_credentials.release_value();
+
+    // https://w3c.github.io/webauthn/#dictionary-authenticatorSelection
+    if (pk_options.authenticator_selection.has_value()) {
+        auto const& selection = *pk_options.authenticator_selection;
+        if (selection.authenticator_attachment.has_value())
+            request.authenticator_attachment = authenticator_attachment_from_string(selection.authenticator_attachment->to_utf8());
+
+        // residentKey: if it is present and set to a value that is a member of ResidentKeyRequirement, use it.
+        // Otherwise, requireResidentKey true means "required", and false (the default) "discouraged".
+        Optional<ResidentKeyRequirement> resident_key;
+        if (selection.resident_key.has_value()) {
+            if (*selection.resident_key == "discouraged"sv)
+                resident_key = ResidentKeyRequirement::Discouraged;
+            else if (*selection.resident_key == "preferred"sv)
+                resident_key = ResidentKeyRequirement::Preferred;
+            else if (*selection.resident_key == "required"sv)
+                resident_key = ResidentKeyRequirement::Required;
+        }
+        if (!resident_key.has_value())
+            resident_key = selection.require_resident_key ? ResidentKeyRequirement::Required : ResidentKeyRequirement::Discouraged;
+        request.resident_key = *resident_key;
+
+        request.user_verification = user_verification_requirement_from_string(selection.user_verification.to_utf8()).value_or(UserVerificationRequirement::Preferred);
+    }
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredentialcreationoptions-attestation
+    // Its value SHOULD be a member of AttestationConveyancePreference. Unknown values fall back to "none".
+    if (pk_options.attestation == "indirect"sv)
+        request.attestation = AttestationConveyancePreference::Indirect;
+    else if (pk_options.attestation == "direct"sv)
+        request.attestation = AttestationConveyancePreference::Direct;
+    else if (pk_options.attestation == "enterprise"sv)
+        request.attestation = AttestationConveyancePreference::Enterprise;
+
+    request.hints = hints_from(pk_options.hints);
+
+    // 11. Let clientExtensions be a new map and let authenticatorExtensions be a new map.
+    // 12. If pkOptions.extensions is present, then for each extensionId → clientExtensionInput of
+    //     pkOptions.extensions, if extensionId is supported by this client platform and is a registration extension,
+    //     set clientExtensions[extensionId] to clientExtensionInput.
+    // https://w3c.github.io/webauthn/#sctn-authenticator-credential-properties-extension
+    if (pk_options.extensions.has_value() && pk_options.extensions->cred_props == true)
+        request.credential_properties = true;
+
+    // 13. Let collectedClientData be a new CollectedClientData instance, and 14. let clientDataJSON be its
+    //     JSON-compatible serialization, and 15. let clientDataHash be its hash.
+    // NB: The browser process builds the client data, from its own record of the caller's origin and ancestors.
+
+    // 16. If options.signal is present and aborted, throw the options.signal’s abort reason.
+    if (options.signal && options.signal->aborted())
+        return fail(JS::throw_completion(options.signal->reason()));
+
+    // 17-22. Find authenticators, issue authenticatorMakeCredential to them, and wait for one to succeed, for the user
+    //        to cancel, for lifetimeTimer to expire, or for options.signal to be aborted.
+    run_the_ceremony_in_the_browser_process(realm, window->associated_document(), options.signal, move(request), on_complete);
+}
+
+// https://fidoalliance.org/specs/fido-v2.0-id-20180227/fido-appid-and-facets-v2.0-id-20180227.html#determining-if-a-caller-s-facetid-is-authorized-for-an-appid
+static bool is_a_caller_s_facet_id_authorized_for_an_app_id(URL::Origin const& caller_origin, String const& app_id)
+{
+    // NB: Like other browsers, this allows an AppID on the caller's own site without fetching its trusted facet list.
+    auto app_id_url = URL::Parser::basic_parse(app_id);
+    if (!app_id_url.has_value() || app_id_url->scheme() != "https"sv || !app_id_url->host().has_value())
+        return false;
+    if (caller_origin.is_opaque() || caller_origin.scheme().value_or({}) != "https"sv)
+        return false;
+
+    auto const& caller_host = caller_origin.host();
+    auto const& app_id_host = *app_id_url->host();
+    if (caller_host == app_id_host)
+        return true;
+
+    auto caller_registrable_domain = caller_host.registrable_domain();
+    auto app_id_registrable_domain = app_id_host.registrable_domain();
+    return caller_registrable_domain.has_value() && caller_registrable_domain == app_id_registrable_domain;
+}
+
+// https://w3c.github.io/webauthn/#sctn-discover-from-external-source
+void PublicKeyCredential::discover_from_external_source(JS::Realm& realm, URL::Origin const& origin, CredentialManagement::CredentialRequestOptions const& options, bool, OnCredentialOperationComplete on_complete)
+{
+    auto fail = [&](WebIDL::Exception exception) {
+        on_complete->function()(move(exception));
+    };
+
+    auto* window = HTML::window_from_global_object(realm.global_object());
+    VERIFY(window);
+
+    // 1. Assert: options.publicKey is present.
+    VERIFY(options.public_key.has_value());
+
+    // 2. Let pkOptions be the value of options.publicKey.
+    auto const& pk_options = *options.public_key;
+
+    // 3. If options.mediation is present with the value conditional, ...
+    // NB: CredentialsContainer rejects conditional requests, since PublicKeyCredential doesn't support conditional
+    //     user mediation yet.
+    VERIFY(options.mediation != Bindings::CredentialMediationRequirement::Conditional);
+
+    // 4. Otherwise: if pkOptions.timeout is present, check if its value lies within a reasonable range as defined by
+    //    the client and if not, correct it to the closest value lying within that range. Set a timer lifetimeTimer to
+    //    this adjusted value. If pkOptions.timeout is not present, then set lifetimeTimer to a client-specific default.
+    GetRequest request;
+    request.timeout = adjusted_timeout(pk_options.timeout);
+
+    auto challenge = copy_of_buffer_source(pk_options.challenge);
+    if (challenge.is_error())
+        return fail(challenge.release_error());
+    request.challenge = challenge.release_value();
+
+    // 5. Let callerOrigin be origin. If callerOrigin is an opaque origin, throw a "NotAllowedError" DOMException.
+    // 6. Let effectiveDomain be the callerOrigin’s effective domain. If effective domain is not a valid domain, then
+    //    throw a "SecurityError" DOMException.
+    // 7. If pkOptions.rpId is present, and is not a registrable domain suffix of and is not equal to effectiveDomain,
+    //    throw a "SecurityError" DOMException. If it is not present, set pkOptions.rpId to effectiveDomain.
+    auto rp_id = determine_rp_id(origin, pk_options.rp_id);
+    if (rp_id.is_error())
+        return fail(rp_id.release_error());
+    request.rp_id = rp_id.release_value();
+
+    auto allow_credentials = descriptors_from(pk_options.allow_credentials);
+    if (allow_credentials.is_error())
+        return fail(allow_credentials.release_error());
+    request.allow_credentials = allow_credentials.release_value();
+    request.user_verification = user_verification_requirement_from_string(pk_options.user_verification.to_utf8()).value_or(UserVerificationRequirement::Preferred);
+    request.hints = hints_from(pk_options.hints);
+
+    // 8. Let clientExtensions be a new map and let authenticatorExtensions be a new map.
+    // 9. If pkOptions.extensions is present, then for each extensionId → clientExtensionInput of
+    //    pkOptions.extensions, if extensionId is supported by this client platform and is an authentication
+    //    extension, set clientExtensions[extensionId] to clientExtensionInput.
+    // https://w3c.github.io/webauthn/#sctn-appid-extension
+    if (pk_options.extensions.has_value() && pk_options.extensions->appid.has_value()) {
+        // 1. Let facetId be the result of passing the caller’s origin to the FIDO algorithm for determining the
+        //    FacetID of a calling application.
+        // 2. Let appId be the extension input.
+        auto app_id = pk_options.extensions->appid->to_utf8();
+
+        // 3. Pass facetId and appId to the FIDO algorithm for determining if a caller’s FacetID is authorized for an
+        //    AppID. If that algorithm rejects appId then return a "SecurityError" DOMException.
+        if (!is_a_caller_s_facet_id_authorized_for_an_app_id(origin, app_id))
+            return fail(WebIDL::SecurityError::create("The caller isn't authorized for this AppID"_utf16));
+
+        // 4-7. The browser process retries with the AppID when a credential isn't found under the RP ID, and reports
+        //      which one the assertion used.
+        request.app_id = move(app_id);
+    }
+
+    // 10. Let collectedClientData be a new CollectedClientData instance, and 11. let clientDataJSON be its
+    //     JSON-compatible serialization, and 12. let clientDataHash be its hash.
+    // NB: The browser process builds the client data, from its own record of the caller's origin and ancestors.
+
+    // 13. If options.signal is present and aborted, throw the options.signal’s abort reason.
+    if (options.signal && options.signal->aborted())
+        return fail(JS::throw_completion(options.signal->reason()));
+
+    // 14-21. Find authenticators, issue authenticatorGetAssertion to them, and wait for one to succeed, for the user
+    //        to cancel, for lifetimeTimer to expire, or for options.signal to be aborted.
+    run_the_ceremony_in_the_browser_process(realm, window->associated_document(), options.signal, move(request), on_complete);
+}
+
+}
