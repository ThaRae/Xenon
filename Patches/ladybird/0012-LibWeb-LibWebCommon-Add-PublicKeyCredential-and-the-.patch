+ */
+
+#pragma once
+
+#include <AK/ByteBuffer.h>
+#include <LibWeb/WebAuthn/AuthenticatorResponse.h>
+#include <LibWebCommon/WebAuthn/WebAuthn.h>
+
+namespace Web::WebAuthn {
+
+// https://w3c.github.io/webauthn/#authenticatorattestationresponse
+class AuthenticatorAttestationResponse final : public AuthenticatorResponse {
+    WEB_WRAPPABLE(AuthenticatorAttestationResponse, AuthenticatorResponse);
+    GC_DECLARE_ALLOCATOR(AuthenticatorAttestationResponse);
+
+public:
+    [[nodiscard]] static GC::Ref<AuthenticatorAttestationResponse> create(JS::Realm&, RegistrationResponse const&);
+
+    virtual ~AuthenticatorAttestationResponse() override;
+
+    GC::Ref<JS::ArrayBuffer> attestation_object() const { return m_attestation_object; }
+
+    Vector<String> get_transports() const;
+    GC::Ref<JS::ArrayBuffer> get_authenticator_data(JS::Realm&) const;
+    GC::Ptr<JS::ArrayBuffer> get_public_key(JS::Realm&) const;
+    i32 get_public_key_algorithm() const { return m_public_key_algorithm; }
+
+    Vector<AuthenticatorTransport> const& transports() const { return m_transports; }
+    ReadonlyBytes authenticator_data() const { return m_authenticator_data; }
+    Optional<ByteBuffer> const& public_key() const { return m_public_key; }
+
+private:
+    AuthenticatorAttestationResponse(GC::Ref<JS::ArrayBuffer> client_data_json, GC::Ref<JS::ArrayBuffer> attestation_object, RegistrationResponse const&);
+
+    virtual void visit_edges(Cell::Visitor&) override;
+
+    // https://w3c.github.io/webauthn/#dom-authenticatorattestationresponse-attestationobject
+    GC::Ref<JS::ArrayBuffer> m_attestation_object;
+
+    // https://w3c.github.io/webauthn/#dom-authenticatorattestationresponse-transports-slot
+    Vector<AuthenticatorTransport> m_transports;
+
+    // NB: These come with the response, so that this process need not parse the attestation object.
+    ByteBuffer m_authenticator_data;
+    Optional<ByteBuffer> m_public_key;
+    i32 m_public_key_algorithm { 0 };
+};
+
+}
