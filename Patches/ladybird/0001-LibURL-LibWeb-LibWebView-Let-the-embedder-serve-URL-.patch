+void ConnectionFromClient::request_embedder_resource(Web::PageId page_id, Web::EmbedderResourceRequest request)
+{
+    i32 const id = last_id++;
+
+    auto url = request.url;
+    m_requested_embedder_resources.set(id, move(request));
+
+    async_did_request_embedder_resource(page_id, move(url), id);
+}
+
+void ConnectionFromClient::handle_embedder_resource_return(Web::PageId, i32 error, Optional<IPC::File> file, Vector<HTTP::Header> headers, i32 request_id)
+{
+    auto request = m_requested_embedder_resources.take(request_id);
+    VERIFY(request.has_value());
+
+    if (error != 0 || !file.has_value()) {
+        request->on_complete(Error::from_errno(error != 0 ? error : ENOENT));
+        return;
+    }
+    request->on_complete(Web::EmbedderResource { .fd = file->take_fd(), .headers = move(headers) });
+}
