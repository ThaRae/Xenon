+template<typename ResourceHandler, typename ErrorHandler>
+void ResourceLoader::handle_embedder_scheme_load_request(LoadRequest& request, ResourceHandler on_resource, ErrorHandler on_error)
+{
+    auto page = request.page();
+    if (!page) {
+        on_error(ByteString("INTERNAL ERROR: No Page for embedder scheme request"sv));
+        return;
+    }
+
+    // NB: The UI process decides what the URL holds and who may read it, and answers with the file to read and the
+    //     response's headers, including its Content-Type.
+    page->client().request_embedder_resource({
+        .url = request.url().value(),
+        .on_complete = [on_resource, on_error](ErrorOr<EmbedderResource> resource_or_error) mutable {
+            if (resource_or_error.is_error()) {
+                on_error(ByteString::formatted("{}", resource_or_error.error()));
+                return;
+            }
+            auto resource = resource_or_error.release_value();
+
+            auto file = Core::File::adopt_fd(resource.fd, Core::File::OpenMode::Read);
+            if (file.is_error()) {
+                on_error(ByteString::formatted("{}", file.error()));
+                return;
+            }
+            auto data = file.value()->read_until_eof();
+            if (data.is_error()) {
+                on_error(ByteString::formatted("{}", data.error()));
+                return;
+            }
+
+            FileLoadResult load_result {
+                .data = data.value().bytes(),
+                .response_headers = HTTP::HeaderList::create(move(resource.headers)),
+            };
+            on_resource(load_result);
+        },
+    });
+}
+
