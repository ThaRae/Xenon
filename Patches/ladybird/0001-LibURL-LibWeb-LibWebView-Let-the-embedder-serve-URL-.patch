+    // embedder scheme processes of its own, so this tells a page's own requests from those of pages that embed it.
+    bool from_same_origin_process { false };
+
+    // Whether this fetches the document of a navigation. Navigations are fetched in the process of the document they
+    // start from, so the asking process says nothing about who wants the URL; the navigation's initiator does.
+    bool is_navigation { false };
+    // The origin of the document that started the navigation, or none if the user started it from the browser's UI.
+    Optional<URL::Origin> navigation_initiator;
+};
+
+struct URLSchemeResponse {
+    IPC::File file;
+    // Including the Content-Type, which the renderer doesn't guess.
+    Vector<HTTP::Header> headers;
+};
+
+using URLSchemeHandler = Function<ErrorOr<URLSchemeResponse>(URLSchemeRequest const&)>;
+
+// Serves a URL scheme from the UI process, as a browser serves its extension pages. The scheme's URLs get tuple origins
+// and are potentially trustworthy (see URL::register_embedder_scheme()). Register every scheme before the first
+// renderer starts, since renderers learn the schemes when they launch. A handler that fails makes a network error.
+WEBVIEW_API void register_url_scheme(String scheme, URLSchemeHandler);
+URLSchemeHandler* url_scheme_handler(StringView scheme);
+
+}
