@@ -0,0 +1,43 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/NeverDestroyed.h>
+#include <AK/Vector.h>
+#include <LibURL/EmbedderSchemes.h>
+
+namespace URL {
+
+static Vector<String>& registered_schemes()
+{
+    static NeverDestroyed<Vector<String>> schemes;
+    return *schemes;
+}
+
+void register_embedder_scheme(String scheme)
+{
+    VERIFY(!scheme.is_empty() && scheme == scheme.to_ascii_lowercase());
+    if (!is_embedder_scheme(scheme))
+        registered_schemes().append(move(scheme));
+}
+
+bool is_embedder_scheme(StringView scheme)
+{
+    return registered_schemes().contains_slow(scheme);
+}
+
+ReadonlySpan<String> embedder_schemes()
+{
+    return registered_schemes().span();
+}
+
+extern "C" bool url_rust_is_embedder_scheme(u8 const* scheme, size_t scheme_length);
+
+extern "C" bool url_rust_is_embedder_scheme(u8 const* scheme, size_t scheme_length)
+{
+    return is_embedder_scheme({ scheme, scheme_length });
+}
+
+}
