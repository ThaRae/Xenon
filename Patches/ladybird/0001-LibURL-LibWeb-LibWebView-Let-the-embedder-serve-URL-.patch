+void WorkerProcessManager::worker_did_request_embedder_resource(Web::HTML::WorkerAgentId agent_id, URL::URL url, i32 request_id)
+{
+    auto maybe_agent = m_agents.find(agent_id);
+    if (maybe_agent == m_agents.end())
+        return;
+
+    auto& agent = maybe_agent->value;
+    auto* handler = url_scheme_handler(url.scheme());
+    if (!handler) {
+        agent.client->async_handle_embedder_resource_return(ENOENT, {}, {}, request_id);
+        return;
+    }
+
+    // A worker process hosts the one worker, so the worker's origin is the process's.
+    URLSchemeRequest request {
+        .url = url,
+        .from_same_origin_process = agent.inside_settings->origin().is_same_origin(url.origin()),
+        .is_navigation = false,
+        .navigation_initiator = {},
+    };
+    auto response = (*handler)(request);
+    if (response.is_error()) {
+        agent.client->async_handle_embedder_resource_return(response.error().is_errno() ? response.error().code() : ENOENT, {}, {}, request_id);
+        return;
+    }
+    agent.client->async_handle_embedder_resource_return(0, move(response.value().file), move(response.value().headers), request_id);
+}
