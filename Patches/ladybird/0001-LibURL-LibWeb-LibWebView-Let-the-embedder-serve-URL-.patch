@@ -0,0 +1,40 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/NeverDestroyed.h>
+#include <LibURL/EmbedderSchemes.h>
+#include <LibWebView/URLSchemeHandler.h>
+
+namespace WebView {
+
+struct RegisteredScheme {
+    String scheme;
+    URLSchemeHandler handler;
+};
+
+static Vector<RegisteredScheme>& registered_schemes()
+{
+    static NeverDestroyed<Vector<RegisteredScheme>> schemes;
+    return *schemes;
+}
+
+void register_url_scheme(String scheme, URLSchemeHandler handler)
+{
+    VERIFY(!url_scheme_handler(scheme));
+    URL::register_embedder_scheme(scheme);
+    registered_schemes().append({ move(scheme), move(handler) });
+}
+
+URLSchemeHandler* url_scheme_handler(StringView scheme)
+{
+    for (auto& registered : registered_schemes()) {
+        if (registered.scheme == scheme)
+            return &registered.handler;
+    }
+    return nullptr;
+}
+
+}
