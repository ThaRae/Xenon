+namespace URL {
+
+// Schemes that the embedder serves itself (see WebView::Application::register_url_scheme()), such as a browser's
+// extension pages. Their URLs have tuple origins of (scheme, host, port), as http(s) URLs do, are potentially
+// trustworthy, and are fetched by asking the UI process for them. Every process registers the same schemes at startup,
+// before it parses its first URL.
+void register_embedder_scheme(String scheme);
+bool is_embedder_scheme(StringView scheme);
+ReadonlySpan<String> embedder_schemes();
+
