+void WebContentPage::did_request_embedder_resource(URL::URL url, i32 request_id)
+{
+    auto* handler = url_scheme_handler(url.scheme());
+    if (!handler) {
+        client().did_misbehave("did_request_embedder_resource"sv, "not an embedder scheme"sv);
+        return;
+    }
+
+    auto response = (*handler)({ .url = url, .from_same_origin_process = client().hosts_a_document_of_origin(url.origin()) });
+    if (response.is_error()) {
+        async_handle_embedder_resource_return(response.error().is_errno() ? response.error().code() : ENOENT, {}, {}, request_id);
+        return;
+    }
+    async_handle_embedder_resource_return(0, move(response.value().file), move(response.value().headers), request_id);
+}
