From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan <ryan@esterlines.com>
Date: Mon, 2 Nov 2026 20:49:52 -0500
Subject: [PATCH] LibWebView: Let a navigation's host report its download

A download is reported by the process that populates the response,
which for a navigation to another site is the new host of the page
rather than the population worker that fetched the response. The
handler only looked the navigable up as that worker, so every download
that arrived with a process swap was rejected, and a link to an
attachment or a non-renderable response on another site did nothing at
all.

Resolve the navigable from the navigation the download names when this
page is its host. The response body identifiers still have to match, so
only the navigation that received the response can claim it.
---
 Libraries/LibWebView/WebContentPage.cpp | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/Libraries/LibWebView/WebContentPage.cpp b/Libraries/LibWebView/WebContentPage.cpp
index 1f7c7ac639a7dab87f4af314f6b3b3014d047b82..1d2ec3cf91ca6bd8e0eae59e32807d37c64f5978 100644
--- a/Libraries/LibWebView/WebContentPage.cpp
+++ b/Libraries/LibWebView/WebContentPage.cpp
@@ -2906,7 +2906,19 @@ Messages::WebContentClient::DidStartDownloadResponse WebContentPage::did_start_d
     // received that response may claim it, and only while its population is in flight.
     FileDownloader::ResponseFinished on_response_finished;
     bool matches_in_flight_navigation = false;
-    if (auto navigable = population_worker_navigable(navigable_id); navigable.has_value()) {
+
+    // A navigation that hands its response body to another process populates, and downloads, there, so the host
+    // reports its download rather than its worker.
+    auto navigable = population_worker_navigable(navigable_id);
+    if (!navigable.has_value() && navigation_id.has_value()) {
+        if (auto candidate = traversable().top_level_traversable().find(navigable_id); candidate.has_value()) {
+            auto navigation = candidate->navigation_with_id(*navigation_id);
+            if (navigation && navigation->host() == this)
+                navigable = candidate;
+        }
+    }
+
+    if (navigable.has_value()) {
         if (auto* bidi = WebDriverBiDi::the();
             bidi && network_response.is_object()) {
             on_response_finished = [weak_bidi = bidi->make_weak_ptr(),
