+test("legacy caller looks through call, apply and Reflect.apply", () => {
+    function getCaller() {
+        return getCaller.caller;
+    }
+
+    function viaCall() {
+        return getCaller.call(this);
+    }
+
+    function viaApply() {
+        return getCaller.apply(this, []);
+    }
+
+    function viaReflectApply() {
+        return Reflect.apply(getCaller, this, []);
+    }
+
+    function viaCallOfCall() {
+        return Function.prototype.call.call(getCaller, this);
+    }
+
+    function strictViaApply() {
+        "use strict";
+        return getCaller.apply(this, []);
+    }
+
+    expect(viaCall()).toBe(viaCall);
+    expect(viaApply()).toBe(viaApply);
+    expect(viaReflectApply()).toBe(viaReflectApply);
+    expect(viaCallOfCall()).toBe(viaCallOfCall);
+    expect(strictViaApply()).toBeNull();
+    expect(getCaller.apply(this, [])).toBeNull();
+
+    function callOverridden() {
+        return callOverridden.caller.caller;
+    }
+
+    function callParent() {
+        return callOverridden.apply(this, arguments);
+    }
+
+    function overridingMethod() {
+        return callParent();
+    }
+
+    expect(overridingMethod()).toBe(overridingMethod);
+});
+
 test("legacy arguments property exposes the active arguments object", () => {
