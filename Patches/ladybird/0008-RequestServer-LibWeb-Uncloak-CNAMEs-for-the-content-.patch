+bool ContentBlocker::is_uncloaked_request_filtered(URL::URL const& url, StringView alias_target, URL::URL const& source_url, ResourceType resource_type) const
+{
+    if (!has_rules())
+        return false;
+
+    auto url_string = serialized_url_for_matching(url);
+    auto source_url_string = serialized_url_for_matching(source_url_for_matching(source_url));
+    auto request_type = resource_type_to_adblock_request_type(resource_type);
+    MutexLocker locker(m_mutex);
+    auto* engine = m_engine.load();
+    if (!engine)
+        return false;
+    return ContentBlocking::FFI::rust_content_blocker_matches_uncloaked(engine, url_string.bytes(), alias_target.bytes(), source_url_string.bytes(), request_type.bytes());
+}
