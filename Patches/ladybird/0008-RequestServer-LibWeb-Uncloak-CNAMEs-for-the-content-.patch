+static ErrorOr<Socket::ResolvedHost> resolve_host_with_flags(ByteString const& host, Socket::SocketType type, Socket::AddressFamily address_family, int flags)
 {
+    using SocketType = Socket::SocketType;
+    using AddressFamily = Socket::AddressFamily;
+
     int socket_type;
     switch (type) {
     case SocketType::Stream:
@@ -81,12 +84,15 @@ ErrorOr<Vector<Variant<IPv4Address, IPv6Address>>> Socket::resolve_host(ByteStri
     struct addrinfo hints = {};
     hints.ai_family = ai_family;
     hints.ai_socktype = socket_type;
-    hints.ai_flags = 0;
+    hints.ai_flags = flags;
     hints.ai_protocol = 0;
 
     auto const results = TRY(Core::System::getaddrinfo(host.characters(), nullptr, hints));
 
     Vector<Variant<IPv4Address, IPv6Address>> addresses;
+    Optional<ByteString> canonical_name;
+    if (!results.addresses().is_empty() && results.addresses().first().ai_canonname)
+        canonical_name = ByteString { results.addresses().first().ai_canonname };
 
     for (auto const& result : results.addresses()) {
         if (result.ai_family == AF_INET6) {
@@ -105,7 +111,17 @@ ErrorOr<Vector<Variant<IPv4Address, IPv6Address>>> Socket::resolve_host(ByteStri
     if (addresses.is_empty())
         return Error::from_string_literal("Could not resolve to IPv4 or IPv6 address");
 
-    return addresses;
+    return Socket::ResolvedHost { move(addresses), move(canonical_name) };
+}
+
+ErrorOr<Vector<Variant<IPv4Address, IPv6Address>>> Socket::resolve_host(ByteString const& host, SocketType type, AddressFamily address_family)
+{
+    return TRY(resolve_host_with_flags(host, type, address_family, 0)).addresses;
+}
+
+ErrorOr<Socket::ResolvedHost> Socket::resolve_host_and_canonical_name(ByteString const& host, SocketType type, AddressFamily address_family)
+{
+    return resolve_host_with_flags(host, type, address_family, AI_CANONNAME);
