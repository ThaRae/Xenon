+void RequestClient::request_resolved_alias(u64 request_id, ByteString alias_target)
+{
+    if (auto request = m_requests.get(request_id); request.has_value() && (*request)->on_resolved_alias) {
+        (*request)->on_resolved_alias(**request, alias_target);
+        return;
+    }
+    async_continue_request_after_alias_check(request_id, false);
