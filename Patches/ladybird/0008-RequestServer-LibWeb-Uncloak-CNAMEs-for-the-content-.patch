+// The name the request's host is an alias (CNAME) of, if the client asked to check it and DNS showed one.
+Optional<ByteString> Request::resolved_alias_target() const
+{
+    if (!m_check_resolved_alias || !m_dns_result || connect_host() != m_url.serialized_host())
+        return {};
+
+    auto cname_records = m_dns_result->records(DNS::Messages::ResourceType::CNAME);
+    if (cname_records.is_empty())
+        return {};
+
+    auto host = DNS::Messages::DomainName::from_string(connect_host()).to_canonical_string();
+    auto name = host;
+    // Follow the chain from the host to its end, staying clear of loops.
+    for (size_t i = 0; i < cname_records.size(); ++i) {
+        auto next = cname_records.first_matching([&](auto const& record) {
+            return record.name.to_canonical_string() == name;
+        });
+        if (!next.has_value())
+            break;
+        name = next->record.template get<DNS::Messages::Records::CNAME>().names.to_canonical_string();
+    }
+
+    auto target = name.trim("."sv, TrimMode::Right);
+    if (target.is_empty() || target == host.trim("."sv, TrimMode::Right))
+        return {};
+    return ByteString { target };
+}
+
+void Request::continue_after_alias_check(bool block)
+{
+    if (!m_waiting_for_alias_check)
+        return;
+    m_waiting_for_alias_check = false;
+
+    if (block) {
+        m_network_error = Requests::NetworkError::BlockedByContentBlocker;
+        transition_to_state(State::Error);
+        return;
+    }
+    continue_after_dns_lookup();
+}
