+
+bool ViewImplementation::page_response_watch_is_suspended() const
+{
+    if (m_is_loading || m_page_has_open_dialog || m_debugger_paused || m_crash_state.has_value() || !m_top_level_traversable)
+        return true;
+    return traversable().system_visibility_state() != Web::HTML::VisibilityState::Visible;
+}
+
+void ViewImplementation::update_page_response_watchdog()
+{
+    auto now = MonotonicTime::now();
+    auto suspended = page_response_watch_is_suspended();
+    if (m_page_response_watch_was_suspended && !suspended)
+        m_page_response_watch_resumed_at = now;
+    m_page_response_watch_was_suspended = suspended;
+
+    Optional<MonotonicTime> oldest_input_time;
+    for (auto const& pending : m_pending_input_events) {
+        if (pending.watches_page_response && (!oldest_input_time.has_value() || pending.enqueued_at < *oldest_input_time))
+            oldest_input_time = pending.enqueued_at;
+    }
+
+    auto unresponsive = m_page_unresponsive && oldest_input_time.has_value();
+    m_page_response_timer->stop();
+    if (oldest_input_time.has_value() && !unresponsive && !suspended) {
+        auto deadline = max(*oldest_input_time, m_page_response_watch_resumed_at) + page_response_timeout;
+        if (deadline <= now)
+            unresponsive = true;
+        else
+            m_page_response_timer->restart(deadline - now);
+    }
+
+    if (m_page_unresponsive == unresponsive)
+        return;
+    m_page_unresponsive = unresponsive;
+    if (on_page_unresponsive_changed)
+        on_page_unresponsive_changed(unresponsive);
+}
+
+void ViewImplementation::stop_watching_page_response()
+{
+    for (auto& pending : m_pending_input_events)
+        pending.watches_page_response = false;
+    update_page_response_watchdog();
+}
+
+void ViewImplementation::keep_waiting_for_unresponsive_page()
+{
+    if (!m_page_unresponsive)
+        return;
+    m_page_unresponsive = false;
+    m_page_response_watch_resumed_at = MonotonicTime::now();
+    if (on_page_unresponsive_changed)
+        on_page_unresponsive_changed(false);
+    update_page_response_watchdog();
+}
+
+void ViewImplementation::terminate_unresponsive_page()
+{
+    if (!m_page_unresponsive)
+        return;
+    auto index = m_pending_input_events.find_first_index_if([](auto const& pending) { return pending.watches_page_response; });
+    auto& endpoint = index.has_value() ? *m_pending_input_events[*index].endpoint : page();
+    Application::process_manager().force_exit_after_timeout(endpoint.client().child_id(), 0);
+}
+
+void ViewImplementation::did_open_page_dialog()
+{
+    m_page_has_open_dialog = true;
+    stop_watching_page_response();
+}
+
+void ViewImplementation::did_close_page_dialog()
+{
+    m_page_has_open_dialog = false;
+    update_page_response_watchdog();
 }
 
