+#include <LibWebCommon/HTML/CrossProcessId.h>
 #include <LibWebView/Export.h>
+#include <LibWebView/Forward.h>
 
 namespace WebView {
 
@@ -41,10 +44,44 @@ struct URLSchemeResponse {
 
 using URLSchemeHandler = Function<ErrorOr<URLSchemeResponse>(URLSchemeRequest const&)>;
 
+// A document with a script bridge to the UI process, as the UI process knows it: its URL and origin come from the UI
+// process's own records, never from the renderer.
+class WEBVIEW_API ScriptBridgeEndpoint {
+public:
+    ScriptBridgeEndpoint(WebContentPage&, Web::HTML::CrossProcessId document_id, URL::URL, URL::Origin);
+
+    Web::HTML::CrossProcessId document_id() const { return m_document_id; }
+    URL::URL const& url() const { return m_url; }
+    URL::Origin const& origin() const { return m_origin; }
+
+    // Whether the document is still around. Messages to a document that's gone are dropped.
+    bool is_open() const;
+    // The view showing the document, which is the top-level traversable's.
+    Optional<u64> view_id() const;
+    void post_message(String) const;
+
+    bool operator==(ScriptBridgeEndpoint const&) const;
+
+private:
+    WeakPtr<WebContentPage> m_page;
+    Web::HTML::CrossProcessId m_document_id;
+    URL::URL m_url;
+    URL::Origin m_origin;
+};
+
+// A script bridge between the UI process and the scheme's documents. Before a document's own scripts run, its bootstrap
+// script runs as the body of a function given the bridge: an object whose postMessage(string) calls on_message, and
+// whose onmessage, if the script sets it, receives what ScriptBridgeEndpoint::post_message() sends.
+struct URLSchemeBridge {
+    Function<Optional<String>(ScriptBridgeEndpoint const&)> bootstrap_script;
+    Function<void(ScriptBridgeEndpoint const&, String message)> on_message;
+};
+
 // Serves a URL scheme from the UI process, as a browser serves its extension pages. The scheme's URLs get tuple origins
 // and are potentially trustworthy (see URL::register_embedder_scheme()). Register every scheme before the first
 // renderer starts, since renderers learn the schemes when they launch. A handler that fails makes a network error.
-WEBVIEW_API void register_url_scheme(String scheme, URLSchemeHandler);
+WEBVIEW_API void register_url_scheme(String scheme, URLSchemeHandler, Optional<URLSchemeBridge> = {});
 URLSchemeHandler* url_scheme_handler(StringView scheme);
+URLSchemeBridge* url_scheme_bridge(StringView scheme);
 
 }
