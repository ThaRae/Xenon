From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan <ryan@esterlines.com>
Date: Thu, 29 Oct 2026 09:40:57 -0400
Subject: [PATCH] LibMediaClient+LibWebView+AudioServer: Retire idle media
 servers

A renderer gives up its MediaServer once it has had no media stream,
playback session, or decode request for a while. Shorten that from 30
to 15 seconds, which still covers a pause between two playback
requests; a playing or paused media element keeps its session.

The AudioServer only ever exited when the Browser dropped its control
connection, which the Browser held for the renderer's whole life, so a
page that had finished playing kept one for good. Have it exit 15
seconds after its last client goes. The Browser already launches and
initializes a new one when a page next asks for a client, retrying
once when the request finds the server gone just before it arrived.
Have a worker's request retry the same way.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Libraries/LibMediaClient/Client.cpp      |  2 +-
 Libraries/LibWebView/WebWorkerClient.cpp | 10 ++++++++--
 Services/AudioServer/Tabs.cpp            | 20 ++++++++++++++++++++
 Services/AudioServer/Tabs.h              |  3 +++
 4 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/Libraries/LibMediaClient/Client.cpp b/Libraries/LibMediaClient/Client.cpp
index e57a7113283fed6a2ddcc292671031f7f854772e..1216abc5665015cc6fa9729c021b6c279468dad8 100644
--- a/Libraries/LibMediaClient/Client.cpp
+++ b/Libraries/LibMediaClient/Client.cpp
@@ -13,7 +13,7 @@
 
 namespace MediaClient {
 
-static constexpr int IDLE_EXIT_DELAY_MS = 30'000;
+static constexpr int IDLE_EXIT_DELAY_MS = 15'000;
 
 static NeverDestroyed<Client::TransportFactory> s_transport_factory;
 static NeverDestroyed<RefPtr<Client>> s_client;
diff --git a/Libraries/LibWebView/WebWorkerClient.cpp b/Libraries/LibWebView/WebWorkerClient.cpp
index a9e7a856132464e102899af3a4fee2310e74ff2c..0cf74314594bcb5da3bd2900b962d577dd4d0d2f 100644
--- a/Libraries/LibWebView/WebWorkerClient.cpp
+++ b/Libraries/LibWebView/WebWorkerClient.cpp
@@ -197,8 +197,14 @@ Messages::WebWorkerClient::RequestMediaServerConnectionResponse WebWorkerClient:
         auto self = weak_self.strong_ref();
         if (!self)
             return Error::from_string_literal("The worker process is gone");
-        TRY(ensure_audio_server_is_running(self->m_audio_server_client, self->child_id()));
-        return connect_new_audio_server_client(*self->m_audio_server_client, self->m_audio_tab_id);
+        auto connect = [&]() -> ErrorOr<IPC::TransportHandle> {
+            TRY(ensure_audio_server_is_running(self->m_audio_server_client, self->child_id()));
+            return connect_new_audio_server_client(*self->m_audio_server_client, self->m_audio_tab_id);
+        };
+        auto handle = connect();
+        if (handle.is_error())
+            handle = connect();
+        return handle;
     });
     if (connection.is_error()) {
         warnln("Unable to connect a MediaServer client: {}", connection.error());
diff --git a/Services/AudioServer/Tabs.cpp b/Services/AudioServer/Tabs.cpp
index fe5163b244f57917d8f4bcb3f7cd5061ef46af4e..f5524a36599e97e7bdc21ebaf533cc5f3bce4f5c 100644
--- a/Services/AudioServer/Tabs.cpp
+++ b/Services/AudioServer/Tabs.cpp
@@ -13,6 +13,8 @@
 #include <LibAudio/PlaybackStream.h>
 #include <LibAudio/RecordStream.h>
 #include <LibCore/EventLoop.h>
+#include <LibCore/Process.h>
+#include <LibCore/Timer.h>
 #include <LibIPC/Transport.h>
 
 namespace AudioServer {
@@ -20,6 +22,7 @@ namespace AudioServer {
 // The device never underruns, since the mix is silence where no client has frames, so its own buffer can stay well
 // below the lookahead the clients keep in their rings.
 static constexpr u32 DEVICE_TARGET_LATENCY_MS = 40;
+static constexpr int IDLE_EXIT_DELAY_MS = 15'000;
 
 Tabs& Tabs::the()
 {
@@ -105,6 +108,9 @@ Audio::CaptureDevices& Tabs::capture_devices()
 
 ErrorOr<IPC::TransportHandle> Tabs::connect_client(u64 tab_id)
 {
+    if (m_idle_exit_timer)
+        m_idle_exit_timer->stop();
+
     auto paired_transports = TRY(IPC::Transport::create_paired());
     auto handle = move(paired_transports.remote_handle);
 
@@ -203,6 +209,20 @@ void Tabs::connection_died(u64 tab_id, int client_id)
         return;
     tab->mixer->report_every_group_inaudible();
     m_tabs.remove(tab_id);
+    if (m_tabs.is_empty())
+        schedule_idle_exit();
+}
+
+void Tabs::schedule_idle_exit()
+{
+    if (!m_idle_exit_timer) {
+        m_idle_exit_timer = Core::Timer::create_single_shot(AK::Duration::from_milliseconds(IDLE_EXIT_DELAY_MS), [] {
+            if (!Tabs::the().m_tabs.is_empty())
+                return;
+            Core::Process::terminate_immediately(0);
+        });
+    }
+    m_idle_exit_timer->restart();
 }
 
 }
diff --git a/Services/AudioServer/Tabs.h b/Services/AudioServer/Tabs.h
index d84cb55afb02ff09a904e6fae553d5687be65419..487b6c5ce08077d8960f43ab8fac6157fc841ee4 100644
--- a/Services/AudioServer/Tabs.h
+++ b/Services/AudioServer/Tabs.h
@@ -18,6 +18,7 @@
 #include <AudioServer/ServerConnection.h>
 #include <LibAudio/AudioOutput.h>
 #include <LibAudio/PlaybackGroupId.h>
+#include <LibCore/Forward.h>
 #include <LibIPC/TransportHandle.h>
 
 namespace AudioServer {
@@ -53,6 +54,7 @@ private:
     };
 
     Tab& tab_for(u64 tab_id);
+    void schedule_idle_exit();
     Audio::CaptureDevices& capture_devices();
     void connection_died(u64 tab_id, int client_id);
     void request_capture_permission(u64 tab_id, ByteString const& device_id, Function<void(bool)> on_decided);
@@ -65,6 +67,7 @@ private:
     int m_next_client_id { 1 };
     Audio::AudioOutput m_audio_output { Audio::AudioOutput::Platform };
 
+    RefPtr<Core::Timer> m_idle_exit_timer;
     WeakPtr<ControlConnection> m_control_connection;
     HashMap<u64, Function<void(bool)>> m_pending_capture_decisions;
     u64 m_next_capture_request_id { 1 };
