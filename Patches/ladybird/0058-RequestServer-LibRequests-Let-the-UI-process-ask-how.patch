+NonnullRefPtr<Core::Promise<Optional<SecureConnection>>> RequestControlClient::retrieve_secure_connection(ByteString host, u16 port)
+{
+    auto promise = Core::Promise<Optional<SecureConnection>>::construct();
+
+    auto secure_connection_request_id = m_next_secure_connection_request_id++;
+    m_pending_secure_connection_requests.set(secure_connection_request_id, promise);
+
+    async_retrieve_secure_connection(secure_connection_request_id, move(host), port);
+    return promise;
+}
+
+void RequestControlClient::retrieved_secure_connection(u64 secure_connection_request_id, Optional<SecureConnection> connection)
+{
+    if (auto promise = m_pending_secure_connection_requests.take(secure_connection_request_id); promise.has_value())
+        (*promise)->resolve(move(connection));
+}
+
 void RequestControlClient::network_usage(Vector<NetworkUsage> usage, u64 interval_microseconds)
 {
     if (on_network_usage)
