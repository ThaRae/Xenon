diff --git a/Libraries/LibRequests/SecureConnection.cpp b/Libraries/LibRequests/SecureConnection.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4cd7d6d70d5b0edcc0c8aad872e13708ea34bb1c
--- /dev/null
+++ b/Libraries/LibRequests/SecureConnection.cpp
@@ -0,0 +1,35 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibIPC/Decoder.h>
+#include <LibIPC/Encoder.h>
+#include <LibRequests/SecureConnection.h>
+
+namespace IPC {
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, Requests::SecureConnection const& connection)
+{
+    TRY(encoder.encode(connection.protocol));
+    TRY(encoder.encode(connection.cipher));
+    TRY(encoder.encode(connection.uses_certificate_exception));
+    TRY(encoder.encode(connection.certificate_chain));
+
+    return {};
+}
+
+template<>
+ErrorOr<Requests::SecureConnection> decode(Decoder& decoder)
+{
+    auto protocol = TRY(decoder.decode<ByteString>());
+    auto cipher = TRY(decoder.decode<ByteString>());
+    auto uses_certificate_exception = TRY(decoder.decode<bool>());
+    auto certificate_chain = TRY(decoder.decode<Vector<ByteBuffer>>());
+
+    return Requests::SecureConnection { move(protocol), move(cipher), uses_certificate_exception, move(certificate_chain) };
+}
+
+}
