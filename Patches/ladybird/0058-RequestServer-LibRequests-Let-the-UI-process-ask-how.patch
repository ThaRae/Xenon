diff --git a/Services/RequestServer/SecureConnections.cpp b/Services/RequestServer/SecureConnections.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..700ffdcc1d640a6bb8fcb2635407885a013fe775
--- /dev/null
+++ b/Services/RequestServer/SecureConnections.cpp
@@ -0,0 +1,160 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/NeverDestroyed.h>
+#include <AK/NonnullOwnPtr.h>
+#include <AK/ScopeGuard.h>
+#include <AK/Vector.h>
+#include <AK/kmalloc.h>
+#include <LibURL/URL.h>
+#include <RequestServer/SecureConnections.h>
+#include <curl/curl.h>
+#include <openssl/ssl.h>
+#include <openssl/x509.h>
+#include <string.h>
+
+namespace RequestServer {
+
+using X509Chain = STACK_OF(X509);
+
+static constexpr size_t MAX_REMEMBERED_SECURE_CONNECTIONS = 128;
+
+class RememberedSecureConnection {
+    AK_MAKE_NONCOPYABLE(RememberedSecureConnection);
+    AK_MAKE_NONMOVABLE(RememberedSecureConnection);
+
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    RememberedSecureConnection(ByteString host, u16 port, StringView protocol, StringView cipher, bool uses_certificate_exception, X509Chain* certificate_chain)
+        : m_host(move(host))
+        , m_port(port)
+        , m_protocol(protocol)
+        , m_cipher(cipher)
+        , m_uses_certificate_exception(uses_certificate_exception)
+        , m_certificate_chain(certificate_chain)
+    {
+    }
+
+    ~RememberedSecureConnection()
+    {
+        sk_X509_pop_free(m_certificate_chain, X509_free);
+    }
+
+    bool is_for(StringView host, u16 port) const { return m_port == port && m_host == host; }
+
+    Requests::SecureConnection to_secure_connection() const
+    {
+        Requests::SecureConnection connection;
+        connection.protocol = m_protocol;
+        connection.cipher = m_cipher;
+        connection.uses_certificate_exception = m_uses_certificate_exception;
+
+        for (int i = 0; i < sk_X509_num(m_certificate_chain); ++i) {
+            unsigned char* der = nullptr;
+            auto der_size = i2d_X509(sk_X509_value(m_certificate_chain, i), &der);
+            if (der_size <= 0)
+                break;
+            ScopeGuard free_der = [&] { OPENSSL_free(der); };
+
+            auto certificate = ByteBuffer::copy(der, static_cast<size_t>(der_size));
+            if (certificate.is_error())
+                break;
+            connection.certificate_chain.append(certificate.release_value());
+        }
+        return connection;
+    }
+
+private:
+    ByteString m_host;
+    u16 m_port { 0 };
+    ByteString m_protocol;
+    ByteString m_cipher;
+    bool m_uses_certificate_exception { false };
+    X509Chain* m_certificate_chain { nullptr };
+};
+
+static Vector<NonnullOwnPtr<RememberedSecureConnection>>& remembered_secure_connections()
+{
+    static NeverDestroyed<Vector<NonnullOwnPtr<RememberedSecureConnection>>> connections;
+    return *connections;
+}
+
+static Optional<size_t> index_of_secure_connection(StringView host, u16 port)
+{
+    auto& connections = remembered_secure_connections();
+    for (size_t i = 0; i < connections.size(); ++i) {
+        if (connections[i]->is_for(host, port))
+            return i;
+    }
+    return {};
+}
+
+static X509Chain* peer_certificate_chain(SSL const* ssl)
+{
+    if (auto* chain = SSL_get_peer_cert_chain(ssl); chain && sk_X509_num(chain) > 0)
+        return X509_chain_up_ref(chain);
+
+    auto* certificate = SSL_get0_peer_certificate(ssl);
+    if (!certificate)
+        return nullptr;
+
+    auto* chain = sk_X509_new_null();
+    if (!chain)
+        return nullptr;
+    if (X509_up_ref(certificate) != 1 || sk_X509_push(chain, certificate) <= 0) {
+        sk_X509_pop_free(chain, X509_free);
+        return nullptr;
+    }
+    return chain;
+}
+
+void remember_secure_connection(CURL* handle, URL::URL const& url, bool uses_certificate_exception)
+{
+    if (url.scheme() != "https"sv || !url.host().has_value())
+        return;
+
+    auto const& host = url.serialized_host();
+    auto port = url.port_or_default();
+    auto existing_index = index_of_secure_connection(host, port);
+
+    long new_connections = 0;
+    if (curl_easy_getinfo(handle, CURLINFO_NUM_CONNECTS, &new_connections) != CURLE_OK)
+        return;
+    if (new_connections == 0 && existing_index.has_value())
+        return;
+
+    curl_tlssessioninfo* session = nullptr;
+    if (curl_easy_getinfo(handle, CURLINFO_TLS_SSL_PTR, &session) != CURLE_OK || !session || session->backend != CURLSSLBACKEND_OPENSSL || !session->internals)
+        return;
+
+    auto const* ssl = static_cast<SSL const*>(session->internals);
+    auto* certificate_chain = peer_certificate_chain(ssl);
+    if (!certificate_chain)
+        return;
+
+    StringView protocol { SSL_get_version(ssl), strlen(SSL_get_version(ssl)) };
+    auto const* cipher_name = SSL_get_cipher_name(ssl);
+    StringView cipher = cipher_name ? StringView { cipher_name, strlen(cipher_name) } : StringView {};
+
+    auto& connections = remembered_secure_connections();
+    if (existing_index.has_value())
+        connections.remove(*existing_index);
+    else if (connections.size() >= MAX_REMEMBERED_SECURE_CONNECTIONS)
+        connections.remove(0);
+
+    connections.append(make<RememberedSecureConnection>(ByteString { host }, port, protocol, cipher, uses_certificate_exception, certificate_chain));
+}
+
+Optional<Requests::SecureConnection> secure_connection_for(StringView host, u16 port)
+{
+    auto index = index_of_secure_connection(host, port);
+    if (!index.has_value())
+        return {};
+    return remembered_secure_connections()[*index]->to_secure_connection();
+}
+
+}
