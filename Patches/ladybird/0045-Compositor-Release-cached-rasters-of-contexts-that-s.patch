+void SkiaBackendContext::purge_unlocked_scratch_resources()
+{
+    // A texture that nothing refers to any more stays in the resource cache for reuse, and only a flush trims the
+    // cache, so a context with nothing to draw would keep it until its next frame.
+    if (auto* context = sk_context())
+        context->purgeUnlockedResources(GrPurgeResourceOptions::kScratchResourcesOnly);
+}
