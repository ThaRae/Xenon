 // https://html.spec.whatwg.org/multipage/media.html#media-data
+GC::Ptr<HTMLCanvasElement> HTMLMediaElement::canvas_capture_source() const
+{
+    auto const* stream = m_assigned_media_provider_object.get_pointer<GC::Ref<MediaCapture::MediaStream>>();
+    if (!stream)
+        return {};
+    for (auto const& track : (*stream)->get_video_tracks()) {
+        if (auto canvas = track->canvas_capture_source())
+            return canvas;
+    }
+    return {};
+}
