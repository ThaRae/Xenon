+// https://html.spec.whatwg.org/multipage/canvas.html#dom-canvas-capturestream
+GC::Ref<MediaCapture::MediaStream> HTMLCanvasElement::capture_stream(Optional<double>)
+{
+    // 1. Let stream be a new MediaStream.
+    auto stream = MediaCapture::MediaStream::create();
+
+    // 2. Let track be the result of creating a CanvasCaptureMediaStreamTrack with this as its canvas and frameRate as
+    //    its frame rate.
+    auto track = MediaCapture::MediaStreamTrack::create_for_canvas_capture(GC::Ref(*this));
+
+    // 3. Add track to stream.
+    stream->append_track(track);
+
+    // 4. Return stream.
+    return stream;
+}
