diff --git a/Tests/LibWeb/Text/input/canvas/capture-stream.html b/Tests/LibWeb/Text/input/canvas/capture-stream.html
new file mode 100644
index 0000000000000000000000000000000000000000..193f75807dab149900a38619680ee451bf125cf1
--- /dev/null
+++ b/Tests/LibWeb/Text/input/canvas/capture-stream.html
@@ -0,0 +1,48 @@
+<!DOCTYPE html>
+<script src="../include.js"></script>
+<script>
+promiseTest(async () => {
+    let canvas = document.createElement("canvas");
+    canvas.width = 4;
+    canvas.height = 2;
+    let context = canvas.getContext("2d");
+    context.fillStyle = "rgb(255, 0, 0)";
+    context.fillRect(0, 0, 4, 2);
+
+    let stream = canvas.captureStream(30);
+    let tracks = stream.getVideoTracks();
+
+    let video = document.createElement("video");
+    video.muted = true;
+    video.srcObject = stream;
+    await waitForCondition(() => video.readyState >= 2);
+
+    context.fillStyle = "rgb(255, 0, 0)";
+    context.fillRect(0, 0, 4, 2);
+    let target = document.createElement("canvas");
+    target.width = 4;
+    target.height = 2;
+    let target_context = target.getContext("2d");
+    target_context.drawImage(video, 0, 0);
+    let pixel = Array.from(target_context.getImageData(0, 0, 1, 1).data).join(",");
+
+    println(`tracks: ${tracks.length}`);
+    println(`kind: ${tracks[0].kind}`);
+    println(`state: ${tracks[0].readyState}`);
+    println(`stream active: ${stream.active}`);
+    println(`size: ${video.videoWidth}x${video.videoHeight}`);
+    println(`pixel: ${pixel}`);
+
+    let callback_fired = false;
+    await new Promise(resolve => {
+        video.requestVideoFrameCallback(() => {
+            callback_fired = true;
+            resolve();
+        });
+    });
+    println(`frame callback: ${callback_fired}`);
+
+    tracks[0].stop();
+    println(`state after stop: ${tracks[0].readyState}`);
+});
+</script>
