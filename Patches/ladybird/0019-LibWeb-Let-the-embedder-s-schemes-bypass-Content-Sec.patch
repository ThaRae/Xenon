From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan <ryan@esterlines.com>
Date: Mon, 26 Oct 2026 22:05:27 -0400
Subject: [PATCH] LibWeb: Let the embedder's schemes bypass Content Security
 Policy

A browser's extensions put frames of their own pages into the pages they
work on, such as a password manager's autofill menu and its bar that
offers to save a login. Sites with a strict policy, like frame-src
'self', would block them. Blink lets extension resources bypass a page's
policy
(WebSecurityPolicy::RegisterURLSchemeAsBypassingContentSecurityPolicy),
which is why these frames work on such sites in Chrome.

Requests, responses, and navigations to URLs of the embedder's own
schemes are no longer checked against the page's policy, nor reported
under a report-only one. The embedder still decides which pages may
load them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../ContentSecurityPolicy/BlockingAlgorithms.cpp       |  4 ++++
 .../LibWeb/ContentSecurityPolicy/FetchIntegration.cpp  | 10 ++++++++++
 2 files changed, 14 insertions(+)

diff --git a/Libraries/LibWeb/ContentSecurityPolicy/BlockingAlgorithms.cpp b/Libraries/LibWeb/ContentSecurityPolicy/BlockingAlgorithms.cpp
index 58db5dacdc61cf0a2105b946bc3a286e8c4884e8..d610c6f885705d16215d0a27d6fe121401a324fc 100644
--- a/Libraries/LibWeb/ContentSecurityPolicy/BlockingAlgorithms.cpp
+++ b/Libraries/LibWeb/ContentSecurityPolicy/BlockingAlgorithms.cpp
@@ -6,6 +6,7 @@
  */
 
 #include <AK/AnyOf.h>
+#include <LibURL/EmbedderSchemes.h>
 #include <LibWeb/Bindings/PrincipalHostDefined.h>
 #include <LibWeb/ContentSecurityPolicy/BlockingAlgorithms.h>
 #include <LibWeb/ContentSecurityPolicy/Directives/DirectiveOperations.h>
@@ -124,6 +125,9 @@ void report_a_violation_found_in_another_process(HTML::EnvironmentSettingsObject
 // https://w3c.github.io/webappsec-csp/#should-block-navigation-request
 Directives::Directive::Result should_navigation_request_of_type_be_blocked_by_content_security_policy(NonnullRefPtr<Fetch::Infrastructure::Request> navigation_request, Directives::Directive::NavigationType navigation_type, Page& page)
 {
+    if (URL::is_embedder_scheme(navigation_request->current_url().scheme()))
+        return Directives::Directive::Result::Allowed;
+
     // 1. Let result be "Allowed".
     auto result = Directives::Directive::Result::Allowed;
 
diff --git a/Libraries/LibWeb/ContentSecurityPolicy/FetchIntegration.cpp b/Libraries/LibWeb/ContentSecurityPolicy/FetchIntegration.cpp
index f3efd21e81fb262c984be77b99bfd36c992c32b9..7dc86d203f98e4db032507d31477b0880fede132 100644
--- a/Libraries/LibWeb/ContentSecurityPolicy/FetchIntegration.cpp
+++ b/Libraries/LibWeb/ContentSecurityPolicy/FetchIntegration.cpp
@@ -6,6 +6,7 @@
  * SPDX-License-Identifier: BSD-2-Clause
  */
 
+#include <LibURL/EmbedderSchemes.h>
 #include <LibWeb/ContentSecurityPolicy/Directives/FetchIntegration.h>
 #include <LibWeb/ContentSecurityPolicy/FetchIntegration.h>
 #include <LibWeb/ContentSecurityPolicy/PolicyList.h>
@@ -71,6 +72,9 @@ namespace Web::ContentSecurityPolicy {
 // https://w3c.github.io/webappsec-csp/#report-for-request
 void report_content_security_policy_violations_for_request(Fetch::Infrastructure::Request const& request, ViolationReporter const& report_violation)
 {
+    if (URL::is_embedder_scheme(request.current_url().scheme()))
+        return;
+
     // 1. Let CSP list be request’s policy container's CSP list.
     auto const& csp_list = request.policy_container().get<NonnullRefPtr<HTML::PolicyContainer const>>()->csp_list;
 
@@ -93,6 +97,9 @@ void report_content_security_policy_violations_for_request(Fetch::Infrastructure
 // https://w3c.github.io/webappsec-csp/#should-block-request
 Directives::Directive::Result should_request_be_blocked_by_content_security_policy(Fetch::Infrastructure::Request const& request, ViolationReporter const& report_violation)
 {
+    if (URL::is_embedder_scheme(request.current_url().scheme()))
+        return Directives::Directive::Result::Allowed;
+
     // 1. Let CSP list be request’s policy container's CSP list.
     auto const& csp_list = request.policy_container().get<NonnullRefPtr<HTML::PolicyContainer const>>()->csp_list;
 
@@ -126,6 +133,9 @@ Directives::Directive::Result should_request_be_blocked_by_content_security_poli
 // https://w3c.github.io/webappsec-csp/#should-block-response
 Directives::Directive::Result should_response_to_request_be_blocked_by_content_security_policy(Fetch::Infrastructure::Response const& response, Fetch::Infrastructure::Request const& request, ViolationReporter const& report_violation)
 {
+    if (URL::is_embedder_scheme(request.current_url().scheme()))
+        return Directives::Directive::Result::Allowed;
+
     // 1. Let CSP list be request’s policy container's CSP list.
     auto const& csp_list = request.policy_container().get<NonnullRefPtr<HTML::PolicyContainer const>>()->csp_list;
 
