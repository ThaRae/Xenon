index 0000000000000000000000000000000000000000..175334e7065b89902297758b59af35a712454fc6
--- /dev/null
+++ b/Libraries/LibWeb/Fingerprinting/Farbling.cpp
@@ -0,0 +1,185 @@
+/*
+ * Copyright (c) 2026, Ryan E <76752281+ThaRae@users.noreply.github.com>
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+// Independent reimplementation inspired by Brave's farbling. See Farbling.h.
+
+#include <AK/Random.h>
+#include <AK/StdLibExtras.h>
+#include <LibURL/Origin.h>
+#include <LibWeb/Fingerprinting/Farbling.h>
+#include <LibWeb/HTML/Scripting/Environments.h>
+#include <LibWeb/Loader/LoaderConfig.h>
+
+namespace Web::Fingerprinting {
+
+// SplitMix64 finalizer, used as a strong 64-bit mixing function.
+static constexpr u64 mix64(u64 value)
+{
+    value += 0x9E3779B97F4A7C15ull;
+    value = (value ^ (value >> 30)) * 0xBF58476D1CE4E5B9ull;
+    value = (value ^ (value >> 27)) * 0x94D049BB133111EBull;
+    return value ^ (value >> 31);
+}
+
+static u64 nonzero(u64 value)
+{
+    return value == 0 ? 0x2545F4914F6CDD1Dull : value;
+}
+
+u64 session_secret()
+{
+    // The browser sends every WebContent and WebWorker process the same secret, so that a site gets the same values
+    // in all the processes that host it. Were each process to make up its own, a site could open a few and combine
+    // their readings to see through the noise.
+    if (auto secret = current_loader_config()->config.fingerprinting_session_secret; secret != 0)
+        return secret;
+
+    // Function-local static initialization is thread-safe.
+    static u64 const fallback_secret = [] {
+        u64 value = 0;
+        while (value == 0)
+            fill_with_random({ &value, sizeof(value) });
+        return value;
+    }();
+    return fallback_secret;
+}
+
+u64 seed_for_host(StringView host)
+{
+    u64 state = mix64(session_secret());
+    // FNV-1a over the host bytes, keyed by the session secret, then finalized.
+    u64 hash = 0xCBF29CE484222325ull ^ state;
+    for (auto byte : host.bytes()) {
+        hash ^= byte;
+        hash *= 0x100000001B3ull;
+    }
+    return nonzero(mix64(hash ^ mix64(state ^ host.length())));
+}
+
+static u64 seed_for_origin(URL::Origin const& origin)
+{
+    if (origin.is_opaque())
+        return seed_for_host({});
+    auto host = origin.host().serialize();
+    return seed_for_host(host);
+}
+
+u64 seed_for_relevant_global(JS::Object const& object)
+{
+    return seed_for_origin(HTML::relevant_settings_object(object).origin());
+}
+
+u64 seed_for_current_settings_object()
+{
+    return seed_for_origin(HTML::current_settings_object().origin());
+}
+
+u64 seed_for_key(u64 seed, FarbleKey key)
+{
+    return nonzero(mix64(seed ^ (static_cast<u64>(to_underlying(key)) + 1) * 0xD6E8FEB86659FD93ull));
+}
+
+u64 lfsr_next(u64 value)
+{
+    // Galois LFSR with taps 64, 63, 61, 60 (maximal length).
+    value = nonzero(value);
+    auto lsb = value & 1;
+    value >>= 1;
+    if (lsb)
+        value ^= 0xD800000000000000ull;
+    return value;
+}
+
+// Hashes the pixels eight bytes at a time, which keeps it cheap next to encoding the image.
+static u64 hash_pixels(ReadonlyBytes pixels)
+{
+    u64 hash = 0;
+    size_t offset = 0;
+    for (; offset + sizeof(u64) <= pixels.size(); offset += sizeof(u64)) {
+        u64 word;
+        __builtin_memcpy(&word, pixels.offset_pointer(offset), sizeof(word));
+        hash ^= word;
+        hash = ((hash << 31) | (hash >> 33)) * 0x9E3779B97F4A7C15ull;
+    }
+    for (; offset < pixels.size(); ++offset)
+        hash = (hash ^ pixels[offset]) * 0x100000001B3ull;
+    return mix64(hash ^ pixels.size());
+}
+
+void perturb_pixels(Bytes rgba, u64 seed, PixelsHaveAlpha has_alpha)
+{
+    if (rgba.size() < 4)
+        return;
+
+    // The pixels are part of the key. With the seed alone, every image on a site would get the same pattern, so a
+    // script could read it off an image it drew itself and undo it on any other. Reading the same image again still
+    // gives the same result.
+    auto key = seed_for_key(seed ^ hash_pixels(rgba), FarbleKey::Canvas);
+    auto lfsr = nonzero(mix64(key));
+    auto pixel_count = rgba.size() / 4;
+
+    // Walk the buffer touching roughly one pixel in eight; the key bits decide which channel's LSB flips.
+    size_t index = static_cast<size_t>(lfsr % 8);
+    while (index < pixel_count) {
+        lfsr = lfsr_next(lfsr);
+        auto channel = static_cast<size_t>((key >> (lfsr & 63)) & 1) + static_cast<size_t>(lfsr & 1); // 0, 1, or 2
+        u8 alpha = has_alpha == PixelsHaveAlpha::Yes ? rgba[index * 4 + 3] : 255;
+        auto& value = rgba[index * 4 + channel];
+        // Flipping the low bit moves the value by one; when that would push it above alpha, move down instead.
+        if (alpha != 0) {
+            u8 flipped = value ^ 1;
+            value = flipped > alpha ? static_cast<u8>(value - 1) : flipped;
+        }
+        index += 1 + static_cast<size_t>((lfsr >> 8) % 15);
+    }
+}
+
+void farble_audio(Span<float> samples, u64 seed)
+{
+    auto key = seed_for_key(seed, FarbleKey::Audio);
+    // Map 53 bits to [0, 1), then into [0.99, 1.0).
+    double unit = static_cast<double>(key >> 11) * (1.0 / 9007199254740992.0);
+    auto fudge = static_cast<float>(0.99 + unit * 0.01);
+    if (fudge >= 1.0f)
+        fudge = 0.99999f;
+    for (auto& sample : samples)
+        sample *= fudge;
+}
+
+int farbled_hardware_concurrency(unsigned true_value, u64 seed)
+{
+    if (true_value <= 2)
+        return static_cast<int>(max(true_value, 1u));
+
+    auto key = seed_for_key(seed, FarbleKey::HardwareConcurrency);
+    unsigned lower = true_value < 4 ? 2 : 4;
+    unsigned upper = min(8u, true_value);
+    if (upper <= lower)
+        return static_cast<int>(upper);
+    return static_cast<int>(lower + key % (upper - lower + 1));
+}
+
+double farbled_device_memory_gib(double true_rounded_gib, u64 seed)
+{
+    static constexpr double choices[] = { 1.0, 2.0, 4.0 };
+    size_t available = 0;
+    for (auto choice : choices) {
+        if (choice <= true_rounded_gib)
+            ++available;
+    }
+    if (available == 0)
+        return true_rounded_gib;
+
+    auto key = seed_for_key(seed, FarbleKey::DeviceMemory);
+    return choices[key % available];
+}
+
+bool protection_enabled()
+{
+    return current_loader_config()->config.enable_fingerprinting_protection;
+}
+
+}
diff --git a/Libraries/LibWeb/Fingerprinting/Farbling.h b/Libraries/LibWeb/Fingerprinting/Farbling.h
new file mode 100644
index 0000000000000000000000000000000000000000..a6b190a362366a4954e65f6bc5ac07fdb07b018a
--- /dev/null
+++ b/Libraries/LibWeb/Fingerprinting/Farbling.h
@@ -0,0 +1,71 @@
+/*
+ * Copyright (c) 2026, Ryan E <76752281+ThaRae@users.noreply.github.com>
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Span.h>
+#include <AK/StringView.h>
+#include <AK/Types.h>
+#include <LibJS/Forward.h>
+
+// Fingerprinting protection by "farbling": small, per-session and per-site deterministic randomization of values that
+// scripts commonly read to fingerprint a user (canvas pixels, audio samples, hardware concurrency, device memory).
+//
+// The design is inspired by Brave's farbling (https://brave.com/privacy-updates/4-fingerprinting-defenses-2.0/ and
+// brave-core's farbling_audio / canvas perturbation). This is an independent reimplementation; no Brave code is used.
+
+namespace Web::Fingerprinting {
+
+enum class FarbleKey : u8 {
+    HardwareConcurrency,
+    DeviceMemory,
+    Canvas,
+    Audio,
+};
+
+// The browser session's secret (LoaderConfig::fingerprinting_session_secret), or, until the browser has sent one, a
+// process-local secret generated once from the system CSPRNG.
+u64 session_secret();
+
+// Mixes the session secret with the given host. An empty host yields a seed derived from the session secret alone.
+u64 seed_for_host(StringView host);
+
+// Seed for the host of the relevant settings object's origin of the given object (empty host if opaque).
+u64 seed_for_relevant_global(JS::Object const&);
+
+// Seed for the host of the current settings object's origin, for getters with no object of their own.
+u64 seed_for_current_settings_object();
+
+// Derives a per-feature seed so that different APIs do not share a random stream.
+u64 seed_for_key(u64 seed, FarbleKey);
+
+// One step of a 64-bit Galois LFSR (never returns 0 for a non-zero input).
+u64 lfsr_next(u64 value);
+
+enum class PixelsHaveAlpha : u8 {
+    No,
+    Yes,
+};
+
+// XORs the least significant bit of a subset of color channels in a 4-byte-per-pixel buffer (RGBA8, BGRA8, or their x
+// variants; the 4th byte is alpha when PixelsHaveAlpha::Yes). The subset is decided by the seed and the pixels
+// together, so the same image always comes out the same and different images get unrelated subsets. With alpha, fully
+// transparent pixels are left alone and channel values never exceed alpha, so premultiplied data stays valid.
+void perturb_pixels(Bytes rgba, u64 seed, PixelsHaveAlpha = PixelsHaveAlpha::Yes);
+
+// Multiplies every sample by a fudge factor in [0.99, 1.0).
+void farble_audio(Span<float> samples, u64 seed);
+
+// Brave "balanced" behavior: a value in [2, true_value] when true_value is small, else in [4, min(8, true_value)].
+int farbled_hardware_concurrency(unsigned true_value, u64 seed);
+
+// Picks a value from {1, 2, 4} (GiB) that does not exceed the true rounded value.
+double farbled_device_memory_gib(double true_rounded_gib, u64 seed);
+
+// Reads LoaderConfig::enable_fingerprinting_protection from the current loader config.
+bool protection_enabled();
+
+}
