+        let vm = cx.vm();
+
+        // 1. Let settings be the current settings object.
+        let settings = current_settings_object(vm);
+
+        // 2. Assert: settings is a secure context.
+        assert!(settings.is_secure_context());
+
+        // 3. Let document be settings’s relevant global object’s associated Document.
+        let document = associated_document(&settings);
+
+        // 4. If document is not fully active, then return a promise rejected with an "InvalidStateError" DOMException.
+        if !document.is_fully_active() {
+            return reject(vm, promise, dom_exception("InvalidStateError", "Document is not fully active"));
+        }
+
+        // 5. If options.signal is aborted, then return a promise rejected with options.signal’s abort reason.
+        if let Some(signal) = options.signal.filter(|signal| signal.aborted()) {
+            reject_promise(vm, promise, signal.reason());
+            return Ok(());
+        }
+
+        // 6. Let interfaces be options’s relevant credential interface objects.
+        let interfaces = relevant_credential_interface_objects_of_request(&options);
+
+        // 7. If interfaces is empty, then return a promise rejected with a "NotSupportedError" DOMException.
+        if interfaces.is_empty() {
+            return reject(vm, promise, dom_exception("NotSupportedError", "No credential types were requested"));
+        }
+
+        // 8. For each interface1 of interfaces:
+        for &type1 in &interfaces {
+            // 1. Let type1 be interface1’s [[type]].
+            // 2. For each interface2 of interfaces:
+            for &type2 in &interfaces {
+                // 1. Let type2 be interface2’s [[type]].
+                // 2. If type1 equals type2, then continue.
+                if type1 == type2 {
+                    continue;
+                }
+
+                // 3. If type1’s types allowed in the same get() request doesn’t contain type2, then return a promise
+                //    rejected with a "NotSupportedError" DOMException.
+                if type1.registry_entry().type_allowed_in_the_same_get_request != Some(type2) {
+                    return reject(
+                        vm,
+                        promise,
+                        dom_exception("NotSupportedError", "These credential types can't be requested together"),
+                    );
+                }
+            }
+        }
+
+        // 9. Let origin be settings’ origin.
+        let origin = settings.origin();
+
+        // 10. For each interface of interfaces:
+        for credential_type in &interfaces {
+            // 1. If instances of interface are origin bound and origin is an opaque origin, then return a promise
+            //    rejected with a "SecurityError" DOMException.
+            if credential_type.registry_entry().is_origin_bound && origin.is_opaque() {
+                return reject(
+                    vm,
+                    promise,
+                    dom_exception("SecurityError", "Credentials are not available to an opaque origin"),
+                );
+            }
+        }
+
+        // 11. For each interface of interfaces:
+        let mut active_credential_types = this.active_credential_types.get();
+        for &credential_type in &interfaces {
+            // 1. If options.mediation is conditional and interface does not support conditional user mediation, return
+            //    a promise rejected with a TypeError.
+            if matches!(options.mediation, CredentialMediationRequirement::Conditional)
+                && !credential_type.registry_entry().supports_conditional_user_mediation
+            {
+                return reject(
+                    vm,
+                    promise,
+                    Exception::type_error("Conditional mediation is not supported for this credential type"),
+                );
+            }
+
+            // FIXME: 2. If options.uiMode is immediate and interface does not support immediate user mediation, return
+            //           a promise rejected with a TypeError.
+
+            // 3. If settings’ active credential types contains interface’s [[type]], return a promise rejected with a
+            //    "NotAllowedError" DOMException.
+            if active_credential_types.contains(credential_type) {
+                return reject(
+                    vm,
+                    promise,
+                    dom_exception("NotAllowedError", "A request for this credential type is already pending"),
+                );
+            }
+
+            // 4. Append interface’s [[type]] to settings’ active credential types.
+            active_credential_types = active_credential_types.union(CredentialTypeSet::of(&[credential_type]));
+        }
+
+        // 12. Let sameOriginWithAncestors be true if settings is same-origin with its ancestors, and false otherwise.
+        let _same_origin_with_ancestors = is_same_origin_with_its_ancestors(&settings);
+
+        // 13. For each interface in options’ relevant credential interface objects:
+        for credential_type in &interfaces {
+            // 1. Let permission be the interface’s [[type]] Get Permissions Policy.
+            // 2. If permission is null, continue.
+            let Some(permission) = credential_type.registry_entry().get_permissions_policy else {
+                continue;
+            };
+
+            // 3. If document is not allowed to use permission, return a promise rejected with a "NotAllowedError"
+            //    DOMException.
+            if !document.is_allowed_to_use_feature(permission) {
+                return reject(
+                    vm,
+                    promise,
+                    dom_exception("NotAllowedError", "The permissions policy does not allow this request"),
+                );
+            }
+        }
+        this.active_credential_types.set(active_credential_types);
+
+        // 14. Let p be a new promise.
+        // 16. React to p: for each interface in interfaces, remove interface’s [[type]] from settings’ active credential
+        //     types.
+        Self::remove_active_credential_types_when_settled(this, vm, promise, CredentialTypeSet::of(&interfaces));
+
+        // 15. Run the following steps in parallel:
+        // 1. Let credentials be the result of collecting Credentials from the credential store, given origin, options,
+        //    and sameOriginWithAncestors.
+        // 2. If credentials is an exception, reject p with credentials.
+        // 3. If all of the following statements are true, resolve p with credentials[0] and skip the remaining steps:
+        //    credentials’ size is 1, origin does not require user mediation, options is matchable a priori,
+        //    options.mediation is not "required", and options.mediation is not "conditional".
+        // NB: Ladybird has no credential store, so collecting credentials from it finds none.
+
+        // 4. If options’ mediation is "silent", resolve p with null, and skip the remaining steps.
+        if matches!(options.mediation, CredentialMediationRequirement::Silent) {
+            settle_in_a_task(vm, cx.realm(), promise, Ok(None), options.mediation);
+            return Ok(());
+        }
+
+        // 5. Let result be the result of asking the user to choose a Credential, given options and credentials.
+        // NB: With no credentials to choose from, the user can only choose an interface whose [[discovery]] is "remote",
+        //     and there is at most one of those.
+        let remote_interface = interfaces
+            .iter()
+            .copied()
+            .find(|credential_type| credential_type.registry_entry().discovery == CredentialDiscovery::Remote);
+
+        // 6. If result is an interface object:
+        //    1. Set result to the result of executing result’s [[DiscoverFromExternalSource]](origin, options,
+        //       sameOriginWithAncestors), given origin, options, and sameOriginWithAncestors.
+        //    2. If that threw an exception, queue a task on global’s DOM manipulation task source to reject p with it.
+        // 7. Assert: result is null, or a Credential.
+        // 8. If result is a Credential, resolve p with result.
+        // 9. If result is null and options.mediation is not conditional, resolve p with result.
+        assert!(remote_interface.is_none());
+        settle_in_a_task(vm, cx.realm(), promise, Ok(None), options.mediation);
         Ok(())
     }
 
