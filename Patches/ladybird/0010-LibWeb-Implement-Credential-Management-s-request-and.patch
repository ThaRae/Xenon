+/// Settles the promise with the result of an operation that ran in parallel, from a task queued on the global's DOM
+/// manipulation task source. A null result leaves the promise pending if mediation is "conditional".
+pub(crate) fn settle_in_a_task(
+    vm: &Vm,
+    realm: Gc<Realm>,
+    promise: WebIdlPromise,
+    result: WebIdlResult<Option<CreatedCredential>>,
+    mediation: CredentialMediationRequirement,
+) {
+    let settlement = match result {
+        Err(exception) => Settlement::Reject(exception_value(vm, realm, exception)),
+        Ok(Some(credential)) => Settlement::Resolve(credential.wrap(&CallContext::new(vm, realm))),
+        Ok(None) if matches!(mediation, CredentialMediationRequirement::Conditional) => Settlement::StayPending,
+        Ok(None) => Settlement::Resolve(Value::NULL),
+    };
+    queue_a_global_task(
+        vm,
+        realm.global_object(),
+        TaskSource::DOMManipulation,
+        (promise, settlement),
+        |vm, (promise, settlement)| {
+            with_temporary_execution_context(promise_realm(promise), || match settlement {
+                Settlement::Resolve(value) => resolve_promise(vm, promise, value),
+                Settlement::Reject(reason) => reject_promise(vm, promise, reason),
+                Settlement::StayPending => {}
+            });
+        },
+    );
 }
 
