+
+#pragma once
+
+#include <AK/Optional.h>
+#include <AK/StringView.h>
+#include <AK/Utf16FlyString.h>
+#include <LibWebCommon/PermissionsPolicy/PermissionsPolicy.h>
+
+namespace Web::CredentialManagement {
+
+// https://w3c.github.io/webappsec-credential-management/#credential-type-registry
+enum class CredentialType : u8 {
+    Federated,
+    Password,
+};
+
+// https://w3c.github.io/webappsec-credential-management/#dom-credential-discovery-slot
+enum class CredentialDiscovery : u8 {
+    CredentialStore,
+    Remote,
+};
+
+struct CredentialTypeRegistryEntry {
+    CredentialType type;
+
+    StringView type_string;
+
+    Optional<PermissionsPolicy::PolicyControlledFeature> get_permissions_policy;
+    Optional<PermissionsPolicy::PolicyControlledFeature> create_permissions_policy;
+
+    Optional<CredentialType> type_allowed_in_the_same_get_request;
+
+    // https://w3c.github.io/webappsec-credential-management/#credential-origin-bound
+    bool is_origin_bound { false };
+
+    CredentialDiscovery discovery { CredentialDiscovery::CredentialStore };
+
+    // https://w3c.github.io/webappsec-credential-management/#credential-supports-conditional-user-mediation
+    bool supports_conditional_user_mediation { false };
+};
+
+CredentialTypeRegistryEntry const& credential_type_registry_entry(CredentialType);
+Optional<CredentialType> credential_type_from_string(Utf16FlyString const&);
+
+}
