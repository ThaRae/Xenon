+    // 4. If credential is origin bound and settings’ origin is an opaque origin, return a promise rejected with a
+    //    "SecurityError" DOMException.
+    if (credential_type_registry_entry(*type).is_origin_bound && settings.origin().is_opaque()) {
+        WebIDL::reject_promise(realm, promise, WebIDL::SecurityError::create("Credentials are not available to an opaque origin"_utf16));
+        return;
+    }
+
+    // 5. Let sameOriginWithAncestors be true if the current settings object is same-origin with its ancestors, and
+    //    false otherwise.
+    auto same_origin_with_ancestors = is_same_origin_with_its_ancestors(settings);
+
+    // 6. Let p be a new promise.
+    // 7. If settings’ active credential types contains credential’s [[type]], return a promise rejected with a
+    //    "NotAllowedError" DOMException.
+    if (m_active_credential_types.contains(*type)) {
+        WebIDL::reject_promise(realm, promise, WebIDL::NotAllowedError::create("A request for this credential type is already pending"_utf16));
+        return;
+    }
+
+    // 8. Append credential’s [[type]] to settings’ active credential types.
+    m_active_credential_types.set(*type);
+
+    // 10. React to p: remove credential’s [[type]] from settings’ active credential types.
+    remove_active_credential_types_when_settled(realm, promise, { *type });
+
+    // 9. Run the following steps in parallel:
