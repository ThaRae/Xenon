+// https://w3c.github.io/webappsec-credential-management/#federatedcredential-create-origin-options-sameoriginwithancestors
+fn create_a_federated_credential(
+    vm: &Vm,
+    origin: liburl_rust::origin::Origin,
+    options: CredentialCreationOptions,
+) -> WebIdlResult<CreatedCredential> {
+    // 1. Assert: options["federated"] exists, and sameOriginWithAncestors is unused.
+    let init = options.federated.expect("options[\"federated\"] exists");
+
+    // 2. Set options["federated"]’s origin member’s value to origin’s value.
+    // 3. Return the result of executing Create a FederatedCredential from FederatedCredentialInit given
+    //    options["federated"]. If that threw an exception, then rethrow that exception.
+    if init.parent.id.as_utf16_string().is_empty() {
+        return Err(Exception::type_error("'id' must not be empty."));
+    }
+    if init.provider.as_utf16_string().is_empty() {
+        return Err(Exception::type_error("'provider' must not be empty."));
+    }
+    Ok(CreatedCredential::Federated(
+        super::federated_credential_operations::create_federated_credential(vm, init, origin),
+    ))
+}
