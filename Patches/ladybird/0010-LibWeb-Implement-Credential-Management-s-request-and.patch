+#include <LibWeb/CredentialManagement/CredentialTypeRegistry.h>
+
+namespace Web::CredentialManagement {
+
+// https://w3c.github.io/webappsec-credential-management/#credential-type-registry-appropriate-interface-object
+static constexpr CredentialTypeRegistryEntry s_federated_entry {
+    .type = CredentialType::Federated,
+    .type_string = "federated"sv,
+    .get_permissions_policy = {},
+    .create_permissions_policy = {},
+    .type_allowed_in_the_same_get_request = CredentialType::Password,
+    .is_origin_bound = true,
+    .discovery = CredentialDiscovery::CredentialStore,
+    .supports_conditional_user_mediation = false,
+};
+
+static constexpr CredentialTypeRegistryEntry s_password_entry {
+    .type = CredentialType::Password,
+    .type_string = "password"sv,
+    .get_permissions_policy = {},
+    .create_permissions_policy = {},
+    .type_allowed_in_the_same_get_request = CredentialType::Federated,
+    .is_origin_bound = true,
+    .discovery = CredentialDiscovery::CredentialStore,
+    .supports_conditional_user_mediation = false,
+};
+
+CredentialTypeRegistryEntry const& credential_type_registry_entry(CredentialType type)
+{
+    switch (type) {
+    case CredentialType::Federated:
+        return s_federated_entry;
+    case CredentialType::Password:
+        return s_password_entry;
+    }
+    VERIFY_NOT_REACHED();
+}
+
+Optional<CredentialType> credential_type_from_string(Utf16FlyString const& type_string)
+{
+    for (auto type : { CredentialType::Federated, CredentialType::Password }) {
+        if (type_string == credential_type_registry_entry(type).type_string)
+            return type;
+    }
+    return {};
+}
+
+}
