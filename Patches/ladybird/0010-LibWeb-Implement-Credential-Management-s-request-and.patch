-static void reject_not_implemented_promise(GC::Ref<WebIDL::Promise> promise, StringView operation)
+// https://w3c.github.io/webappsec-credential-management/#same-origin-with-its-ancestors
+bool is_same_origin_with_its_ancestors(HTML::EnvironmentSettingsObject const& settings)
+{
+    // 1. If settings’s relevant global object has no associated Document, return false.
+    auto const* window = HTML::window_from_global_object(settings.global_object());
+    if (!window)
+        return false;
+
+    // 2. Let document be settings’ relevant global object’s associated Document.
+    auto const& document = window->associated_document();
+
+    // 3. If document has no browsing context, return false.
+    if (!document.browsing_context())
+        return false;
+
+    // 4. Let origin be settings’ origin.
+    auto origin = settings.origin();
+
+    // 5. Let navigable be document’s node navigable.
+    GC::Ptr<HTML::Navigable> navigable = document.navigable();
+    if (!navigable)
+        return false;
+
+    // 6. While navigable has a non-null parent:
+    while (navigable->parent()) {
+        // 1. Set navigable to navigable’s parent.
+        navigable = navigable->parent();
+
+        // 2. If navigable’s active document’s origin is not same origin with origin, return false.
+        auto active_document_origin = navigable->active_document_origin();
+        if (!active_document_origin.has_value() || !active_document_origin->is_same_origin(origin))
+            return false;
+    }
+
+    // 7. Return true.
+    return true;
+}
+
+// https://w3c.github.io/webappsec-credential-management/#credentialrequestoptions-relevant-credential-interface-objects
+static Vector<CredentialType> relevant_credential_interface_objects(CredentialRequestOptions const& options)
+{
+    Vector<CredentialType> interfaces;
+    if (options.federated.has_value())
+        interfaces.append(CredentialType::Federated);
+
+    if (options.password)
+        interfaces.append(CredentialType::Password);
+
+    return interfaces;
+}
+
+// https://w3c.github.io/webappsec-credential-management/#credentialrequestoptions-relevant-credential-interface-objects
+static Vector<CredentialType> relevant_credential_interface_objects(CredentialCreationOptions const& options)
+{
+    Vector<CredentialType> interfaces;
+    if (options.federated.has_value())
+        interfaces.append(CredentialType::Federated);
+    if (options.password.has_value())
+        interfaces.append(CredentialType::Password);
+    return interfaces;
+}
+
+static DOM::Document& associated_document(HTML::EnvironmentSettingsObject& settings)
+{
+    auto* window = HTML::window_from_global_object(settings.global_object());
+    VERIFY(window);
+    return window->associated_document();
+}
+
+static void settle_in_a_task(JS::Realm& realm, GC::Ref<WebIDL::Promise> promise, CredentialOperationResult result, Bindings::CredentialMediationRequirement mediation)
+{
+    auto& global = realm.global_object();
+    HTML::queue_global_task(HTML::Task::Source::DOMManipulation, global, GC::create_function(realm.heap(), [realm = GC::Ref { realm }, promise, result = move(result), mediation]() mutable {
+        HTML::TemporaryExecutionContext execution_context { realm, HTML::TemporaryExecutionContext::CallbacksEnabled::Yes };
+
+        if (result.is_exception()) {
+            WebIDL::reject_promise_with_exception(realm, promise, result.release_error());
+            return;
+        }
+
+        auto credential = result.release_value();
+        if (credential) {
+            WebIDL::resolve_promise(realm, promise, Bindings::wrap(Bindings::host_defined_wrapper_world(realm), realm, GC::Ref<Bindings::Wrappable> { *credential }));
+            return;
+        }
+
+        if (mediation != Bindings::CredentialMediationRequirement::Conditional)
+            WebIDL::resolve_promise(realm, promise, JS::js_null());
+    }));
+}
+
+void CredentialsContainer::remove_active_credential_types_when_settled(JS::Realm& realm, WebIDL::Promise const& promise, Vector<CredentialType> types)
+{
+    auto remove_types = [&] {
+        return [self = GC::Ref { *this }, types](JS::Value) -> WebIDL::ExceptionOr<JS::Value> {
+            for (auto type : types)
+                self->m_active_credential_types.remove(type);
+            return JS::js_undefined();
+        };
+    };
+    auto on_fulfilled = GC::create_function(realm.heap(), remove_types());
+    auto on_rejected = GC::create_function(realm.heap(), remove_types());
+    WebIDL::react_to_promise(promise, on_fulfilled, on_rejected);
+}
+
+// https://w3c.github.io/webappsec-credential-management/#abstract-opdef-request-a-credential
+void CredentialsContainer::get(JS::Realm& realm, CredentialRequestOptions const& options, GC::Ref<WebIDL::Promise> promise)
+{
+    // 1. Let settings be the current settings object.
+    auto& settings = HTML::principal_realm_settings_object(realm);
+
+    // 2. Assert: settings is a secure context.
+    VERIFY(HTML::is_secure_context(settings));
+
+    // 3. Let document be settings’s relevant global object’s associated Document.
+    auto& document = associated_document(settings);
+
+    // 4. If document is not fully active, then return a promise rejected with an "InvalidStateError" DOMException.
+    if (!document.is_fully_active()) {
+        WebIDL::reject_promise(realm, promise, WebIDL::InvalidStateError::create("Document is not fully active"_utf16));
+        return;
+    }
+
+    // 5. If options.signal is aborted, then return a promise rejected with options.signal’s abort reason.
+    if (options.signal && options.signal->aborted()) {
+        WebIDL::reject_promise(realm, promise, options.signal->reason());
+        return;
+    }
+
+    // 6. Let interfaces be options’s relevant credential interface objects.
+    auto interfaces = relevant_credential_interface_objects(options);
+
+    // 7. If interfaces is empty, then return a promise rejected with a "NotSupportedError" DOMException.
+    if (interfaces.is_empty()) {
+        WebIDL::reject_promise(realm, promise, WebIDL::NotSupportedError::create("No credential types were requested"_utf16));
+        return;
+    }
+
+    // 8. For each interface1 of interfaces:
+    for (auto type1 : interfaces) {
+        // 1. Let type1 be interface1’s [[type]].
+        // 2. For each interface2 of interfaces:
+        for (auto type2 : interfaces) {
+            // 1. Let type2 be interface2’s [[type]].
+            // 2. If type1 equals type2, then continue.
+            if (type1 == type2)
+                continue;
+
+            // 3. If type1’s types allowed in the same get() request doesn’t contain type2, then return a promise
+            //    rejected with a "NotSupportedError" DOMException.
+            if (credential_type_registry_entry(type1).type_allowed_in_the_same_get_request != type2) {
+                WebIDL::reject_promise(realm, promise, WebIDL::NotSupportedError::create("These credential types can't be requested together"_utf16));
+                return;
+            }
+        }
+    }
+
+    // 9. Let origin be settings’ origin.
+    auto origin = settings.origin();
+
+    // 10. For each interface of interfaces:
+    for (auto type : interfaces) {
+        // 1. If instances of interface are origin bound and origin is an opaque origin, then return a promise rejected
+        //    with a "SecurityError" DOMException.
+        if (credential_type_registry_entry(type).is_origin_bound && origin.is_opaque()) {
+            WebIDL::reject_promise(realm, promise, WebIDL::SecurityError::create("Credentials are not available to an opaque origin"_utf16));
+            return;
+        }
+    }
+
+    // 11. For each interface of interfaces:
+    for (auto type : interfaces) {
+        // 1. If options.mediation is conditional and interface does not support conditional user mediation, return a
+        //    promise rejected with a TypeError.
+        if (options.mediation == Bindings::CredentialMediationRequirement::Conditional && !credential_type_registry_entry(type).supports_conditional_user_mediation) {
+            WebIDL::reject_promise_with_exception(realm, promise, WebIDL::SimpleException { WebIDL::SimpleExceptionType::TypeError, "Conditional mediation is not supported for this credential type"_utf16 });
+            return;
+        }
+
+        // 3. If settings’ active credential types contains interface’s [[type]], return a promise rejected with a
+        //    "NotAllowedError" DOMException.
+        if (m_active_credential_types.contains(type)) {
+            WebIDL::reject_promise(realm, promise, WebIDL::NotAllowedError::create("A request for this credential type is already pending"_utf16));
+            return;
+        }
+
+        // 4. Append interface’s [[type]] to settings’ active credential types.
+        m_active_credential_types.set(type);
+    }
+
+    // 12. Let sameOriginWithAncestors be true if settings is same-origin with its ancestors, and false otherwise.
+    [[maybe_unused]] auto same_origin_with_ancestors = is_same_origin_with_its_ancestors(settings);
+
+    // 13. For each interface in options’ relevant credential interface objects:
+    for (auto type : interfaces) {
+        // 1. Let permission be the interface’s [[type]] Get Permissions Policy.
+        auto permission = credential_type_registry_entry(type).get_permissions_policy;
+
+        // 2. If permission is null, continue.
+        if (!permission.has_value())
+            continue;
+
+        // 3. If document is not allowed to use permission, return a promise rejected with a "NotAllowedError"
+        //    DOMException.
+        if (!document.is_allowed_to_use_feature(*permission)) {
+            for (auto active_type : interfaces)
+                m_active_credential_types.remove(active_type);
+            WebIDL::reject_promise(realm, promise, WebIDL::NotAllowedError::create("The permissions policy does not allow this request"_utf16));
+            return;
+        }
+    }
+
+    // 14. Let p be a new promise.
+    // 16. React to p: for each interface in interfaces, remove interface’s [[type]] from settings’ active credential types.
+    remove_active_credential_types_when_settled(realm, promise, interfaces);
+
+    // 15. Run the following steps in parallel:
+    // 1. Let credentials be the result of collecting Credentials from the credential store, given origin, options,
+    //    and sameOriginWithAncestors.
+    // 2. If credentials is an exception, reject p with credentials.
+    // 3. If all of the following statements are true, resolve p with credentials[0] and skip the remaining steps:
+    //    credentials’ size is 1, origin does not require user mediation, options is matchable a priori,
+    //    options.mediation is not "required", and options.mediation is not "conditional".
+
+    // 4. If options’ mediation is "silent", resolve p with null, and skip the remaining steps.
+    if (options.mediation == Bindings::CredentialMediationRequirement::Silent) {
+        settle_in_a_task(realm, promise, GC::Ptr<Credential> {}, options.mediation);
+        return;
+    }
+
+    // 5. Let result be the result of asking the user to choose a Credential, given options and credentials.
+    Optional<CredentialType> remote_interface;
+    for (auto type : interfaces) {
+        if (credential_type_registry_entry(type).discovery == CredentialDiscovery::Remote)
+            remote_interface = type;
+    }
+
+    // 6. If result is an interface object:
+    //    1. Set result to the result of executing result’s [[DiscoverFromExternalSource]](origin, options,
+    //       sameOriginWithAncestors), given origin, options, and sameOriginWithAncestors.
+    //    2. If that threw an exception, queue a task on global’s DOM manipulation task source to reject p with it.
+    // 7. Assert: result is null, or a Credential.
+    // 8. If result is a Credential, resolve p with result.
+    // 9. If result is null and options.mediation is not conditional, resolve p with result.
+    VERIFY(!remote_interface.has_value());
+    settle_in_a_task(realm, promise, GC::Ptr<Credential> {}, options.mediation);
+}
+
+// https://w3c.github.io/webappsec-credential-management/#abstract-opdef-store-a-credential
+void CredentialsContainer::store(JS::Realm& realm, Credential const& credential, GC::Ref<WebIDL::Promise> promise)
 {
-    auto& realm = WebIDL::promise_realm(promise);
