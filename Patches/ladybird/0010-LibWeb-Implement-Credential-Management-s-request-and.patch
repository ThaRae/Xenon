+//! The credential type registry, https://w3c.github.io/webappsec-credential-management/#credential-type-registry
+
+use libjs_rust::api::{Trace, Visitor};
+
+use crate::permissions_policy::permissions_policy::PolicyControlledFeature;
+
+/// https://w3c.github.io/webappsec-credential-management/#credential-type-registry
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum CredentialType {
+    Federated,
+    Password,
+}
+
+/// https://w3c.github.io/webappsec-credential-management/#dom-credential-discovery-slot
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum CredentialDiscovery {
+    CredentialStore,
+    Remote,
+}
+
+/// https://w3c.github.io/webappsec-credential-management/#credential-type-registry
+pub(crate) struct CredentialTypeRegistryEntry {
+    pub(crate) type_string: &'static str,
+    pub(crate) get_permissions_policy: Option<PolicyControlledFeature>,
+    pub(crate) create_permissions_policy: Option<PolicyControlledFeature>,
+    pub(crate) type_allowed_in_the_same_get_request: Option<CredentialType>,
+    // https://w3c.github.io/webappsec-credential-management/#credential-origin-bound
+    pub(crate) is_origin_bound: bool,
+    // https://w3c.github.io/webappsec-credential-management/#dom-credential-discovery-slot
+    pub(crate) discovery: CredentialDiscovery,
+    // https://w3c.github.io/webappsec-credential-management/#credential-supports-conditional-user-mediation
+    pub(crate) supports_conditional_user_mediation: bool,
+}
+
+// https://w3c.github.io/webappsec-credential-management/#credential-type-registry-appropriate-interface-object
+const FEDERATED_ENTRY: CredentialTypeRegistryEntry = CredentialTypeRegistryEntry {
+    type_string: "federated",
+    get_permissions_policy: None,
+    create_permissions_policy: None,
+    type_allowed_in_the_same_get_request: Some(CredentialType::Password),
+    is_origin_bound: true,
+    discovery: CredentialDiscovery::CredentialStore,
+    supports_conditional_user_mediation: false,
+};
+
+const PASSWORD_ENTRY: CredentialTypeRegistryEntry = CredentialTypeRegistryEntry {
+    type_string: "password",
+    get_permissions_policy: None,
+    create_permissions_policy: None,
+    type_allowed_in_the_same_get_request: Some(CredentialType::Federated),
+    is_origin_bound: true,
+    discovery: CredentialDiscovery::CredentialStore,
+    supports_conditional_user_mediation: false,
+};
+
+const ALL_TYPES: [CredentialType; 2] = [CredentialType::Federated, CredentialType::Password];
+
+impl CredentialType {
+    pub(crate) fn registry_entry(self) -> &'static CredentialTypeRegistryEntry {
+        match self {
+            Self::Federated => &FEDERATED_ENTRY,
+            Self::Password => &PASSWORD_ENTRY,
+        }
+    }
+
+    pub(crate) fn from_type_string(type_string: &str) -> Option<Self> {
+        ALL_TYPES
+            .into_iter()
+            .find(|credential_type| credential_type.registry_entry().type_string == type_string)
+    }
+
+    fn bit(self) -> u8 {
+        1 << (self as u8)
+    }
+}
+
+/// https://w3c.github.io/webappsec-credential-management/#environment-settings-object-active-credential-types
+#[derive(Clone, Copy, Default, PartialEq, Eq)]
+pub(crate) struct CredentialTypeSet(u8);
+
+// SAFETY: A set of credential types holds no cells.
+unsafe impl Trace for CredentialTypeSet {
+    fn trace(&self, _: &mut Visitor) {}
+}
+
+impl CredentialTypeSet {
+    pub(crate) fn of(types: &[CredentialType]) -> Self {
+        Self(types.iter().fold(0, |bits, credential_type| bits | credential_type.bit()))
+    }
+
+    pub(crate) fn contains(self, credential_type: CredentialType) -> bool {
+        self.0 & credential_type.bit() != 0
+    }
+
+    pub(crate) fn union(self, other: Self) -> Self {
+        Self(self.0 | other.0)
+    }
+
+    pub(crate) fn difference(self, other: Self) -> Self {
+        Self(self.0 & !other.0)
+    }
+}
