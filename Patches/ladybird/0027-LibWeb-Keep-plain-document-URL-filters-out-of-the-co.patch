+
+fn document_url_filter_pattern(line: &str) -> Option<(&str, bool)> {
+    let (pattern, options) = line.strip_prefix("||")?.rsplit_once('$')?;
+    let mut is_document = false;
+    let mut is_badfilter = false;
+    for option in options.split(',') {
+        match option {
+            "document" | "doc" => is_document = true,
+            "badfilter" => is_badfilter = true,
+            _ => return None,
+        }
+    }
+    let pattern = pattern.strip_suffix('^')?;
+    let (host, path) = pattern.split_at(pattern.find('/').unwrap_or(pattern.len()));
+    let is_plain_host = !host.is_empty()
+        && !host.starts_with('.')
+        && !host.ends_with('.')
+        && host
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'.' | b'-' | b'_'));
+    let is_plain_path = path
+        .bytes()
+        .all(|byte| byte.is_ascii_graphic() && !matches!(byte, b'*' | b'^' | b'|' | b'$'));
+    (is_document && is_plain_host && is_plain_path).then_some((pattern, is_badfilter))
+}
+
+fn document_url_filter_hash(pattern: &[u8]) -> u64 {
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    for byte in pattern {
+        hasher.write_u8(byte.to_ascii_lowercase());
+    }
+    hasher.finish()
+}
+
+fn is_url_separator(byte: u8) -> bool {
+    byte.is_ascii() && !byte.is_ascii_alphanumeric() && !matches!(byte, b'_' | b'.' | b'%' | b'-')
+}
+
+#[derive(Default)]
+struct DocumentUrlFilters {
+    hashes: Vec<u64>,
+}
+
+impl DocumentUrlFilters {
+    fn new(mut hashes: Vec<u64>, badfilters: &[u64]) -> Self {
+        let badfilters: HashSet<u64> = badfilters.iter().copied().collect();
+        hashes.retain(|hash| !badfilters.contains(hash));
+        hashes.sort_unstable();
+        hashes.dedup();
+        hashes.shrink_to_fit();
+        Self { hashes }
+    }
+
+    fn contains(&self, pattern: &[u8]) -> bool {
+        self.hashes.binary_search(&document_url_filter_hash(pattern)).is_ok()
+    }
+
+    fn matches(&self, url: &str, hostname: &str) -> bool {
+        if self.hashes.is_empty() || hostname.is_empty() {
+            return false;
+        }
+        let url = url.to_ascii_lowercase();
+        let hostname = hostname.to_ascii_lowercase();
+
+        let bare_hostname = hostname.strip_suffix('.').unwrap_or(&hostname);
+        let label_starts: Vec<usize> = std::iter::once(0)
+            .chain(bare_hostname.match_indices('.').map(|(index, _)| index + 1))
+            .collect();
+        if label_starts
+            .iter()
+            .any(|&start| self.contains(&bare_hostname.as_bytes()[start..]))
+        {
+            return true;
+        }
+
+        let label_ends: Vec<usize> = hostname
+            .match_indices('.')
+            .map(|(index, _)| index)
+            .chain(std::iter::once(hostname.len()))
+            .collect();
+        for &start in &label_starts {
+            for &end in label_ends.iter().filter(|&&end| end > start) {
+                let filter_host = &hostname[start..end];
+                if hostname.find(filter_host) != Some(start) {
+                    continue;
+                }
+                let Some(host_start) = url.find(filter_host) else {
+                    continue;
+                };
+                let path_start = host_start + filter_host.len();
+                let path = &url.as_bytes()[path_start..];
+                if !path.starts_with(b"/") {
+                    continue;
+                }
+                let matches_up_to = |length: usize| self.contains(&url.as_bytes()[host_start..path_start + length]);
+                if (1..path.len()).any(|length| is_url_separator(path[length]) && matches_up_to(length))
+                    || matches_up_to(path.len())
+                {
+                    return true;
+                }
+            }
+        }
+        false
+    }
 }
 
