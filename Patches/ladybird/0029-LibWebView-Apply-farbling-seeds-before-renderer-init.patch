         }
         auto& loader = *changing_navigable->population_loader;
         endpoint->owe_reply({ OwedReply::Kind::ChangingJob, operation_id, navigable_id });
+        if (changing_navigable->navigable().is_top_level_traversable())
+            endpoint->apply_farbling_seed_for_url(changing_navigable->target_entry->url);
         endpoint->async_continue_history_navigation_population(operation_id, changing_navigable->target_entry_descriptor(), operation->algorithm->navigation_type(),
             changing_navigable->navigable().ongoing_navigation().has<CanonicalNavigable::Traversal>(), Web::HTML::HistoryNavigationPopulation { loader.request(), loader.take_result() });
     };
@@ -1457,6 +1459,8 @@ bool CanonicalTraversable::run_changing_navigable_history_step_job(ApplyHistoryS
             changing_navigable.populated_document = populated_document->document;
     }
     endpoint->owe_reply({ OwedReply::Kind::ChangingJob, operation.operation_id, navigable_id });
+    if (navigable.is_top_level_traversable())
+        endpoint->apply_farbling_seed_for_url(changing_navigable.target_entry->url);
     endpoint->async_run_changing_navigable_history_job(
         operation.operation_id, navigable_id,
         changing_navigable.target_entry_descriptor(), run.user_involvement(),
diff --git a/Libraries/LibWebView/WebContentPage.cpp b/Libraries/LibWebView/WebContentPage.cpp
index 64bdd91b788ee9a0f2659668cc9fa2bf5b569199..497b4c1d644ca8fa1022562c824157208febb591 100644
--- a/Libraries/LibWebView/WebContentPage.cpp
+++ b/Libraries/LibWebView/WebContentPage.cpp
@@ -375,6 +375,8 @@ bool WebContentPage::continue_navigation_population_in_selected_process(Web::HTM
         // 5. Queue a global task on the navigation and traversal task source, given navigable's active window, to run
         //    these steps:
         // NB: The page to host the document runs the task.
+        if (navigable->is_top_level_traversable())
+            host->apply_farbling_seed_for_url(weak_loader->request().history_entry.url);
         host->async_populate_navigation(weak_loader->request(), weak_loader->take_result());
     };
     // Wait for the destination RequestServer to acknowledge the import before the host adopts it.
@@ -478,6 +480,12 @@ void WebContentPage::begin_top_level_load(URL::URL const& url)
     }
 }
 
+void WebContentPage::apply_farbling_seed_for_url(URL::URL const& url)
+{
+    auto seed = Application::farbling_seed_store().effective_seed(url, view().is_private());
+    async_set_farbling_seed(to_underlying(seed.level), seed.high, seed.low);
+}
+
 void WebContentPage::request_close()
 {
     // The frontend may destroy the view immediately after this for pages that cannot prompt during beforeunload.
@@ -2333,6 +2341,9 @@ void WebContentPage::did_request_navigation_start(Web::HTML::CrossProcessId navi
     if (start_request.has_value())
         start_request->initiator_origin = initiator_origin.release_value();
 
+    if (target_navigable->is_top_level_traversable())
+        apply_farbling_seed_for_url(url);
+
     if (!start_request.has_value()) {
         if (url.scheme() != "javascript"sv) {
             client().did_misbehave("did_request_navigation_start"sv, "navigation without a start request is not to a javascript: URL"sv);
@@ -2394,6 +2405,8 @@ void WebContentPage::did_complete_navigation_unload_check(Web::HTML::CrossProces
     population_request.target_snapshot_params.sandboxing_flags |= navigable->snapshot_target_snapshot_params().sandboxing_flags;
     ongoing_navigation->history_entry = MUST(CanonicalSessionHistoryEntry::create_from_descriptor(Web::HTML::create_session_history_entry_descriptor(population_request.history_entry, 0)));
     ongoing_navigation->state = CanonicalNavigation::CreatingNavigationParams { NavigationLoader::create(client().is_private(), move(population_request)) };
+    if (navigable->is_top_level_traversable())
+        apply_farbling_seed_for_url(ongoing_navigation->url);
     async_create_navigation_params(ongoing_navigation->loader()->request());
 
     // Requesting navigation params starts the fetch, so a view's top-level population begins its recorded
diff --git a/Libraries/LibWebView/WebContentPage.h b/Libraries/LibWebView/WebContentPage.h
