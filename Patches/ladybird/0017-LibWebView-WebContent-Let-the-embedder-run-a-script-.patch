+void UserScripts::run_on_request(ConnectionFromClient& client, Web::PageId page_id, Web::HTML::CrossProcessId navigable_id, Web::HTML::CrossProcessId document_id, Web::HTML::UserScript script, u64 request_id)
+{
+    auto navigable = Web::HTML::local_navigable_with_id(navigable_id);
+    auto document = navigable ? navigable->active_document() : nullptr;
+    if (!document || document->id() != document_id || document->has_been_destroyed()) {
+        client.async_did_run_user_script(page_id, request_id, false, {});
+        return;
+    }
+
+    auto readiness = document->readiness();
+    auto injection_time = script.injection_time;
+    m_requested_scripts.set(request_id, { .document = *document, .script = move(script), .idle_timer = nullptr });
+
+    switch (injection_time) {
+    case UserScriptInjectionTime::DocumentStart:
+        run_requested_script(client, page_id, request_id);
+        break;
+    case UserScriptInjectionTime::DocumentEnd:
+        if (readiness != Web::HTML::DocumentReadyState::Loading)
+            run_requested_script(client, page_id, request_id);
+        break;
+    case UserScriptInjectionTime::DocumentIdle:
+        if (readiness == Web::HTML::DocumentReadyState::Complete)
+            run_requested_script(client, page_id, request_id);
+        else if (readiness == Web::HTML::DocumentReadyState::Interactive)
+            start_idle_timer_for_requested_script(client, page_id, request_id);
+        break;
+    }
+}
+
+void UserScripts::start_idle_timer_for_requested_script(ConnectionFromClient& client, Web::PageId page_id, u64 request_id)
+{
+    auto requested = m_requested_scripts.get(request_id);
