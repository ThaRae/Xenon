+Vector<ScriptBridgeEndpoint> ViewImplementation::frame_document_endpoints() const
+{
+    Vector<ScriptBridgeEndpoint> endpoints;
+    if (!has_traversable())
+        return endpoints;
+
+    auto const& traversable = this->traversable();
+    traversable.for_each_in_inclusive_subtree([&](CanonicalNavigable const& navigable) {
+        if (auto page = traversable.page_hosting(navigable)) {
+            if (auto endpoint = page->hosted_document_endpoint(navigable.active_document().id()); endpoint.has_value())
+                endpoints.append(endpoint.release_value());
+        }
+        return IterationDecision::Continue;
+    });
+    return endpoints;
+}
