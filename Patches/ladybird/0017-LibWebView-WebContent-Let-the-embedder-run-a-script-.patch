+void ScriptBridgeEndpoint::run_user_script(Web::HTML::UserScript script, Function<void(UserScriptResult)> on_result) const
+{
+    auto page = m_page.strong_ref();
+    if (!page) {
+        on_result({});
+        return;
+    }
+    page->run_user_script(m_navigable.id, m_document_id, move(script), move(on_result));
+}
