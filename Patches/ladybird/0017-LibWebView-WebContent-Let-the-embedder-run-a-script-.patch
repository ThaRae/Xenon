+// A script's completion value as JSON, or none for undefined and for values JSON can't carry.
+static Optional<String> serialize_result(Web::DOM::Document& document, JS::Value value)
+{
+    if (value.is_undefined())
+        return {};
+
+    Web::HTML::TemporaryExecutionContext execution_context { document.relevant_settings_object() };
+    auto json = JS::JSONObject::stringify_impl(document.vm(), value, JS::js_undefined(), JS::js_undefined());
+    if (json.is_error() || !json.value().has_value())
+        return {};
+    return json.value()->to_utf8();
+}
