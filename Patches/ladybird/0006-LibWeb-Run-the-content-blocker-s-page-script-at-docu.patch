From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan <ryan@esterlines.com>
Date: Mon, 26 Oct 2026 14:29:18 -0400
Subject: [PATCH] LibWeb: Run the content blocker's page script at document
 start

uBlock Origin's scriptlets (##+js) must run before a page's own scripts,
and its procedural cosmetic filters (##...:has-text(), :remove(), ...)
need script to evaluate. The content blocker's page script carries both,
and now runs in every new document right before scripts may run for it:
next to where WebDriver BiDi runs its preload scripts, for navigated
documents, for child navigables' first about:blank documents (which ads
are often written into), and for popups' first documents.

A Window that outlives its initial about:blank document runs it once.
---
 Libraries/LibWeb/DOM/Document.cpp                   | 2 ++
 Libraries/LibWeb/HTML/LocalNavigable.cpp            | 4 ++++
 Libraries/LibWeb/HTML/LocalTraversableNavigable.cpp | 3 +++
 3 files changed, 9 insertions(+)

diff --git a/Libraries/LibWeb/DOM/Document.cpp b/Libraries/LibWeb/DOM/Document.cpp
index e132bc9307de9017e6ffe4d3bb4e2f6781b5c7f2..d440329603e80b36c071baf4cafb4f07e1f9b538 100644
--- a/Libraries/LibWeb/DOM/Document.cpp
+++ b/Libraries/LibWeb/DOM/Document.cpp
@@ -8066,6 +8066,8 @@ void Document::update_for_history_step_application(NonnullRefPtr<HTML::SessionHi
         if (!scrolling_blocked_in_new_document)
             try_to_scroll_to_the_fragment(allow_text_directive_scroll);
 
+        ContentBlocker::the().run_page_script(*this);
+
         // 4. At this point scripts may run for the newly-created document document.
         set_ready_to_run_scripts();
     }
diff --git a/Libraries/LibWeb/HTML/LocalNavigable.cpp b/Libraries/LibWeb/HTML/LocalNavigable.cpp
index 7d0fcb876d3da2014711f3e37c1df4de6b0af7d7..11c6b3e167811b1712303be202a833f398402b94 100644
--- a/Libraries/LibWeb/HTML/LocalNavigable.cpp
+++ b/Libraries/LibWeb/HTML/LocalNavigable.cpp
@@ -85,6 +85,7 @@
 #include <LibWeb/Layout/Node.h>
 #include <LibWeb/Layout/NodeArena.h>
 #include <LibWeb/Layout/Viewport.h>
+#include <LibWeb/Loader/ContentBlocker.h>
 #include <LibWeb/Loader/GeneratedPagesLoader.h>
 #include <LibWeb/Page/Page.h>
 #include <LibWeb/Page/RenderingStats.h>
@@ -1173,6 +1174,9 @@ void LocalNavigable::initialize_navigable(NonnullRefPtr<DocumentState> document_
     //         top-level traversable by the window handle it gets once it is created, so it does that once it has one.
     if (WebDriver::BiDi::is_active() && !is_top_level_traversable() && !is_stand_in)
         WebDriver::BiDi::document_is_ready_for_scripts(document);
+
+    if (!is_top_level_traversable() && !is_stand_in)
+        ContentBlocker::the().run_page_script(document);
 }
 
 // AD-HOC: The debug settings and the compositor tree are per page, so a child navigable starts from its parent's. A
diff --git a/Libraries/LibWeb/HTML/LocalTraversableNavigable.cpp b/Libraries/LibWeb/HTML/LocalTraversableNavigable.cpp
index d855e13c0e383bc11eb268f7732ecd0de5041de2..8f0d6ba86470f4c95bfb37ec9263d1cb9faeb2be 100644
--- a/Libraries/LibWeb/HTML/LocalTraversableNavigable.cpp
+++ b/Libraries/LibWeb/HTML/LocalTraversableNavigable.cpp
@@ -26,6 +26,7 @@
 #include <LibWeb/HTML/SourceSnapshotParams.h>
 #include <LibWeb/HTML/Window.h>
 #include <LibWeb/Layout/Viewport.h>
+#include <LibWeb/Loader/ContentBlocker.h>
 #include <LibWeb/Page/Page.h>
 #include <LibWeb/Platform/EventLoopPlugin.h>
 #include <LibWeb/WebDriver/BiDi/BiDi.h>
@@ -134,6 +135,8 @@ GC::Ref<LocalTraversableNavigable> LocalTraversableNavigable::create_for_new_web
     if (WebDriver::BiDi::is_active())
         WebDriver::BiDi::document_is_ready_for_scripts(*traversable->active_document());
 
+    ContentBlocker::the().run_page_script(*traversable->active_document());
+
     return traversable;
 }
 
