From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Theo Slater <theoslater1@gmail.com>
Date: Sat, 10 Oct 2026 14:25:02 +0100
Subject: [PATCH] LibWebView: Check that a resumed page still answers

When a hidden tab is shown again, ask its WebContent process to answer
a lightweight responsiveness check over IPC, and report the page as
unresponsive if the answer does not come within 8 seconds. A page with
no input waiting would otherwise only be found unresponsive once the
user tried to use it again.

The check is dropped when the view navigates or its process crashes,
and it does not report a page that is loading, showing a dialog or
paused in the debugger by the time it runs out.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Libraries/LibWebView/ViewImplementation.cpp  | 57 +++++++++++++++++---
 Libraries/LibWebView/ViewImplementation.h    |  9 ++++
 Libraries/LibWebView/WebContentPage.cpp      |  5 ++
 Libraries/LibWebView/WebContentPage.h        |  1 +
 Services/WebContent/ConnectionFromClient.cpp |  5 ++
 Services/WebContent/ConnectionFromClient.h   |  1 +
 Services/WebContent/WebContentClient.ipc     |  1 +
 Services/WebContent/WebContentServer.ipc     |  1 +
 8 files changed, 74 insertions(+), 6 deletions(-)

diff --git a/Libraries/LibWebView/ViewImplementation.cpp b/Libraries/LibWebView/ViewImplementation.cpp
index 24d332fd817d5de9befa3d94c364618a9ca1b3ca..cf648005588f8dbaabef2f5bc69442349ad0da97 100644
--- a/Libraries/LibWebView/ViewImplementation.cpp
+++ b/Libraries/LibWebView/ViewImplementation.cpp
@@ -130,6 +130,14 @@ ViewImplementation::ViewImplementation(IsPrivate is_private, EnableContentBlocke
     m_page_response_timer = Core::Timer::create_single_shot(AK::Duration::zero(), [this] {
         update_page_response_watchdog();
     });
+
+    m_page_responsiveness_check_timer = Core::Timer::create_single_shot(page_response_timeout, [this] {
+        m_pending_page_responsiveness_check_id.clear();
+        if (page_response_watch_is_suspended())
+            return;
+        m_check_page_unresponsive = true;
+        update_page_unresponsive_state();
+    });
 }
 
 ViewImplementation::~ViewImplementation()
@@ -466,6 +474,13 @@ void ViewImplementation::server_did_paint(Badge<WebContentPage>, i32 bitmap_id,
         on_ready_to_paint();
 }
 
+void ViewImplementation::did_respond_to_page_responsiveness_check(Badge<WebContentPage>, u64 request_id)
+{
+    if (m_pending_page_responsiveness_check_id != request_id && !m_check_page_unresponsive)
+        return;
+    stop_page_responsiveness_check();
+}
+
 void ViewImplementation::release_backing_store(i32 bitmap_id)
 {
     page().release_presented_bitmap(bitmap_id);
@@ -495,6 +510,10 @@ void ViewImplementation::set_system_visibility_state(Web::HTML::VisibilityState
     traversable().set_system_visibility_state(visibility_state);
     Application::the().update_compositor_context_visibility(page().compositor_context_id(), visibility_state);
     report_permission_presence();
+    if (visibility_state == Web::HTML::VisibilityState::Visible)
+        start_page_responsiveness_check();
+    else
+        m_page_responsiveness_check_timer->stop();
     update_page_response_watchdog();
 }
 
@@ -1522,16 +1541,21 @@ void ViewImplementation::update_page_response_watchdog()
             oldest_input_time = pending.enqueued_at;
     }
 
-    auto unresponsive = m_page_unresponsive && oldest_input_time.has_value();
+    m_input_page_unresponsive = m_input_page_unresponsive && oldest_input_time.has_value();
     m_page_response_timer->stop();
-    if (oldest_input_time.has_value() && !unresponsive && !suspended) {
+    if (oldest_input_time.has_value() && !m_input_page_unresponsive && !suspended) {
         auto deadline = max(*oldest_input_time, m_page_response_watch_resumed_at) + page_response_timeout;
         if (deadline <= now)
-            unresponsive = true;
+            m_input_page_unresponsive = true;
         else
             m_page_response_timer->restart(deadline - now);
     }
+    update_page_unresponsive_state();
+}
 
+void ViewImplementation::update_page_unresponsive_state()
+{
+    auto unresponsive = m_input_page_unresponsive || m_check_page_unresponsive;
     if (m_page_unresponsive == unresponsive)
         return;
     m_page_unresponsive = unresponsive;
@@ -1543,17 +1567,37 @@ void ViewImplementation::stop_watching_page_response()
 {
     for (auto& pending : m_pending_input_events)
         pending.watches_page_response = false;
+    stop_page_responsiveness_check();
     update_page_response_watchdog();
 }
 
+void ViewImplementation::start_page_responsiveness_check()
+{
+    auto request_id = m_next_page_responsiveness_check_id++;
+    m_pending_page_responsiveness_check_id = request_id;
+    page().async_check_page_responsiveness(request_id);
+    m_page_responsiveness_check_timer->restart();
+}
+
+void ViewImplementation::stop_page_responsiveness_check()
+{
+    m_page_responsiveness_check_timer->stop();
+    m_pending_page_responsiveness_check_id.clear();
+    m_check_page_unresponsive = false;
+    update_page_unresponsive_state();
+}
+
 void ViewImplementation::keep_waiting_for_unresponsive_page()
 {
     if (!m_page_unresponsive)
         return;
-    m_page_unresponsive = false;
+    auto was_checking = m_check_page_unresponsive;
+    m_input_page_unresponsive = false;
+    m_check_page_unresponsive = false;
     m_page_response_watch_resumed_at = MonotonicTime::now();
-    if (on_page_unresponsive_changed)
-        on_page_unresponsive_changed(false);
+    update_page_unresponsive_state();
+    if (was_checking)
+        start_page_responsiveness_check();
     update_page_response_watchdog();
 }
 
@@ -4425,6 +4469,7 @@ void ViewImplementation::handle_web_content_process_crash()
     // for this tab are stale once its tree is abandoned or restored.
     m_pending_input_events.clear();
     m_page_has_open_dialog = false;
+    stop_page_responsiveness_check();
     update_page_response_watchdog();
 
     set_loading_state(false);
