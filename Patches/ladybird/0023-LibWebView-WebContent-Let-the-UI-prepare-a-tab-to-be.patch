     reject_requests(m_pending_select_word_for_dictionary_lookup_requests);
     reject_requests(m_pending_cut_selected_text_requests);
+
+    auto pending_discard_preparations = move(m_pending_discard_preparations);
+    for (auto& preparation : pending_discard_preparations)
+        preparation.value->reject(Error::from_string_literal("WebContent was replaced before preparing for a discard"));
 }
 
