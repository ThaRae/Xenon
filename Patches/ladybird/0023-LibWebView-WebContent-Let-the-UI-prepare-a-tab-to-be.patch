+static bool has_unsubmitted_input(Web::DOM::Document& document)
+{
+    auto has_input = false;
+    document.for_each_in_inclusive_subtree_of_type<Web::HTML::HTMLInputElement>([&](auto& input) {
+        has_input = input.has_selectable_text() && !input.value().is_empty() && input.value() != input.default_value();
+        return has_input ? Web::TraversalDecision::Break : Web::TraversalDecision::Continue;
+    });
+    if (has_input)
+        return true;
+    document.for_each_in_inclusive_subtree_of_type<Web::HTML::HTMLTextAreaElement>([&](auto& text_area) {
+        has_input = !text_area.value().is_empty() && text_area.value() != text_area.default_value();
+        return has_input ? Web::TraversalDecision::Break : Web::TraversalDecision::Continue;
+    });
+    return has_input;
+}
+
+void ConnectionFromClient::prepare_for_discard(Web::PageId page_id, u64 request_id)
+{
+    Optional<Web::HTML::SessionHistoryEntryPersistedState> persisted_state;
+    auto has_input = false;
+
+    if (auto page = this->page(page_id); page.has_value() && page->page().has_local_traversable()) {
+        auto traversable = page->page().local_traversable();
+        traversable->save_persisted_state_to_active_session_history_entry();
+        if (auto entry = traversable->active_session_history_entry())
+            persisted_state = Web::HTML::create_session_history_entry_persisted_state(*entry);
+
+        for (auto& navigable : traversable->hosted_inclusive_descendant_navigables()) {
+            if (auto document = navigable->active_document(); document && has_unsubmitted_input(*document)) {
+                has_input = true;
+                break;
+            }
+        }
+    }
+
+    async_did_prepare_for_discard(page_id, request_id, move(persisted_state), has_input);
+}
