+NonnullRefPtr<Core::Promise<ViewImplementation::DiscardPreparation>> ViewImplementation::prepare_for_discard()
+{
+    auto promise = Core::Promise<DiscardPreparation>::construct();
+    auto request_id = m_next_discard_preparation_request_id++;
+    m_pending_discard_preparations.set(request_id, promise);
+    page().async_prepare_for_discard(request_id);
+    return promise;
+}
+
+void ViewImplementation::did_prepare_for_discard(Badge<WebContentPage>, u64 request_id, Optional<Web::HTML::SessionHistoryEntryPersistedState> persisted_state, bool has_unsubmitted_input)
+{
+    auto promise = m_pending_discard_preparations.take(request_id);
+    if (!promise.has_value())
+        return;
+
+    if (persisted_state.has_value())
+        traversable().update_session_history_entry_persisted_state(traversable(), *persisted_state);
+    promise.value()->resolve(DiscardPreparation { .has_unsubmitted_input = has_unsubmitted_input });
+}
+
