new file mode 100644
index 0000000000000000000000000000000000000000..8ab0d0ac5feee8bbdc258825722bd91f135001a4
--- /dev/null
+++ b/Libraries/LibWeb/HTML/Scripting/IsolatedWorld.h
@@ -0,0 +1,57 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/NonnullOwnPtr.h>
+#include <AK/Utf16View.h>
+#include <LibGC/Ptr.h>
+#include <LibJS/Forward.h>
+#include <LibJS/Heap/Cell.h>
+#include <LibJS/Runtime/Completion.h>
+#include <LibURL/URL.h>
+#include <LibWeb/Export.h>
+#include <LibWeb/Forward.h>
+
+namespace Web::HTML {
+
+// A world of the embedder's own in a document, for scripts such as browser extensions' content scripts: a realm whose
+// global wraps the document's Window, with a WindowProxy of its own. It shares the document's DOM, but every DOM object
+// has a wrapper of its own in it (see Bindings::WrapperWorld), so the world and the document's own scripts never see
+// each other's JavaScript objects, expando properties, or changes to builtins.
+class WEB_API IsolatedWorld final : public JS::Cell {
+    GC_CELL(IsolatedWorld, JS::Cell);
+    GC_DECLARE_ALLOCATOR(IsolatedWorld);
+
+public:
+    // Makes a world in a document that has a Window and a browsing context.
+    static GC::Ref<IsolatedWorld> create(DOM::Document&);
+    virtual ~IsolatedWorld() override;
+
+    static bool is_isolated_world_realm(JS::Realm const&);
+
+    JS::Realm& realm() const;
+
+    // Runs a classic script in the world. Its errors go to the console rather than to the document's error handlers,
+    // which would get the world's objects.
+    JS::Completion run_script(Utf16View source, URL::URL const&);
+    // Calls a function of the world as a callback, with its errors going where run_script() sends them.
+    JS::Completion call(JS::Value function, JS::Value this_value, ReadonlySpan<JS::Value> arguments);
+
+    // Drops the world's wrappers of the document's objects, as the document goes away.
+    void detach();
+
+private:
+    IsolatedWorld(DOM::Document&, GC::Ref<Bindings::WrapperWorld>, NonnullOwnPtr<JS::ExecutionContext>);
+
+    virtual void visit_edges(Cell::Visitor&) override;
+
+    GC::Ref<DOM::Document> m_document;
+    GC::Ref<Bindings::WrapperWorld> m_wrapper_world;
+    NonnullOwnPtr<JS::ExecutionContext> m_realm_execution_context;
+};
+
