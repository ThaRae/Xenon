+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/NonnullOwnPtr.h>
+#include <AK/Utf16View.h>
+#include <LibGC/Ptr.h>
+#include <LibJS/Forward.h>
+#include <LibJS/Heap/Cell.h>
+#include <LibJS/Runtime/Completion.h>
+#include <LibURL/URL.h>
+#include <LibWeb/Export.h>
+#include <LibWeb/Forward.h>
+
+namespace Web::HTML {
+
+class WEB_API IsolatedWorld final : public JS::Cell {
+    GC_CELL(IsolatedWorld, JS::Cell);
+    GC_DECLARE_ALLOCATOR(IsolatedWorld);
+
+public:
+    static GC::Ref<IsolatedWorld> create(DOM::Document&);
+    virtual ~IsolatedWorld() override;
+
+    static bool is_isolated_world_realm(JS::Realm const&);
+
+    JS::Realm& realm() const;
+
+    JS::Completion run_script(Utf16View source, URL::URL const&);
+    JS::Completion call(JS::Value function, JS::Value this_value, ReadonlySpan<JS::Value> arguments);
+
+    void detach();
+
+private:
+    IsolatedWorld(DOM::Document&, GC::Ref<Bindings::WrapperWorld>, NonnullOwnPtr<JS::ExecutionContext>);
+
+    virtual void visit_edges(Cell::Visitor&) override;
+
+    GC::Ref<DOM::Document> m_document;
+    GC::Ref<Bindings::WrapperWorld> m_wrapper_world;
+    NonnullOwnPtr<JS::ExecutionContext> m_realm_execution_context;
+};
+
+}
