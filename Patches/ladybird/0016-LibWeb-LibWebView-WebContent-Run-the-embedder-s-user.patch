+Optional<ScriptBridgeEndpoint> WebContentPage::user_script_endpoint(Web::HTML::CrossProcessId document_id, String const& world)
+{
+    auto worlds = m_bridged_user_script_worlds.get(document_id);
+    if (!worlds.has_value() || !worlds->contains(world))
+        return {};
+    return hosted_document_endpoint(document_id, world);
+}
+
+Vector<Web::HTML::UserScript> WebContentPage::did_request_user_scripts(Web::HTML::CrossProcessId document_id)
+{
+    auto* handler = Application::the().user_script_handler();
+    if (!handler)
+        return {};
+
+    m_bridged_user_script_worlds.remove_all_matching([&](auto const& id, auto const&) {
+        return !hosted_document_endpoint(id).has_value();
+    });
+
+    auto endpoint = hosted_document_endpoint(document_id);
+    if (!endpoint.has_value())
+        return {};
+
+    auto scripts = handler->scripts_for_document(*endpoint);
+    for (auto const& script : scripts) {
+        if (script.takes_bridge && !script.world.is_empty())
+            m_bridged_user_script_worlds.ensure(document_id).set(script.world);
+    }
+    return scripts;
+}
+
+void WebContentPage::did_post_user_script_message(Web::HTML::CrossProcessId document_id, String world, String message)
+{
+    auto endpoint = user_script_endpoint(document_id, world);
+    if (!endpoint.has_value())
+        return;
+    if (auto* handler = Application::the().user_script_handler())
+        handler->on_message(*endpoint, move(message));
+}
