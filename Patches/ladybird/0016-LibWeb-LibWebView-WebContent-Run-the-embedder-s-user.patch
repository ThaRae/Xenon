@@ -0,0 +1,50 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/HashMap.h>
+#include <AK/String.h>
+#include <AK/Vector.h>
+#include <LibCore/Forward.h>
+#include <LibGC/Weak.h>
+#include <LibJS/Forward.h>
+#include <LibWeb/Forward.h>
+#include <LibWebCommon/HTML/CrossProcessId.h>
+#include <LibWebCommon/HTML/Scripting/UserScript.h>
+#include <LibWebCommon/Page/PageId.h>
+#include <WebContent/Forward.h>
+
+namespace WebContent {
+
+class UserScripts {
+public:
+    void document_reached(ConnectionFromClient&, Web::PageId, Web::DOM::Document&, Web::HTML::UserScriptInjectionTime);
+    void deliver_message(Web::HTML::CrossProcessId document_id, String const& world, String message);
+
+private:
+    struct DocumentScripts {
+        GC::Weak<Web::DOM::Document> document;
+        Vector<Web::HTML::UserScript> pending;
+        bool reached_document_end { false };
+        RefPtr<Core::Timer> idle_timer;
+    };
+
+    struct Bridge {
+        GC::Weak<Web::DOM::Document> document;
+        GC::Weak<Web::HTML::IsolatedWorld> world;
+        GC::Weak<JS::Object> object;
+    };
+
+    void run_scripts(ConnectionFromClient&, Web::PageId, Web::HTML::CrossProcessId document_id, Web::HTML::UserScriptInjectionTime);
+    void run_script(ConnectionFromClient&, Web::PageId, Web::DOM::Document&, Web::HTML::UserScript const&);
+    void forget_documents_that_are_gone();
+
+    HashMap<Web::HTML::CrossProcessId, DocumentScripts> m_documents;
+    HashMap<Web::HTML::CrossProcessId, HashMap<String, Bridge>> m_bridges;
+};
+
+}
