+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/String.h>
+#include <LibURL/URL.h>
+
+namespace Web::HTML {
+
+// When a user script runs in its document, as WebKit's WKUserScriptInjectionTime and browser extensions' run_at.
+enum class UserScriptInjectionTime : u8 {
+    // Before any script of the document's own.
+    DocumentStart,
+    // Once the document has been parsed, and DOMContentLoaded has fired.
+    DocumentEnd,
+    // Once the document has loaded, or soon after DocumentEnd if loading takes a while.
+    DocumentIdle,
+};
+
+// A script the embedder runs in a document, as WebKit's WKUserScript: in the document's own world, or in an isolated
+// world of the embedder's, which shares the document's DOM but none of its JavaScript objects (see IsolatedWorld).
+struct UserScript {
+    // The isolated world to run in, by the embedder's name for it, or the document's own world if empty.
+    String world;
+    String source;
+    // Where the script came from, for error messages and stack traces.
+    URL::URL url;
+    UserScriptInjectionTime injection_time { UserScriptInjectionTime::DocumentIdle };
+    // Whether the source is the body of a function given the world's script bridge to the UI process: an object whose
+    // postMessage(string) reaches the UI process, and whose onmessage, if set, receives the UI process's messages. Only
+    // isolated worlds get a bridge, which the document's own scripts can't reach.
+    bool takes_bridge { false };
+};
+
+}
