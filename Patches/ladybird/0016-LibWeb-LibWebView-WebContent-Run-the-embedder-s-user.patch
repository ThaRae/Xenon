+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibJS/Runtime/AbstractOperations.h>
+#include <LibJS/Runtime/Error.h>
+#include <LibJS/Script.h>
+#include <LibWeb/Bindings/HostDefined.h>
+#include <LibWeb/Bindings/Intrinsics.h>
+#include <LibWeb/Bindings/MainThreadVM.h>
+#include <LibWeb/Bindings/Wrappable.h>
+#include <LibWeb/Bindings/WrapperWorld.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/HTML/BrowsingContext.h>
+#include <LibWeb/HTML/Scripting/Environments.h>
+#include <LibWeb/HTML/Scripting/ExceptionReporter.h>
+#include <LibWeb/HTML/Scripting/IsolatedWorld.h>
+#include <LibWeb/HTML/Window.h>
+#include <LibWeb/HTML/WindowProxy.h>
+
+namespace Web::HTML {
+
+GC_DEFINE_ALLOCATOR(IsolatedWorld);
+
+GC::Ref<IsolatedWorld> IsolatedWorld::create(DOM::Document& document)
+{
+    auto window = GC::Ref { *document.window() };
+    auto browsing_context = GC::Ref { *document.browsing_context() };
+    auto& vm = Bindings::main_thread_vm();
+
+    // A realm like the window's own, whose global wraps the same Window, but in a wrapper world of its own and with a
+    // WindowProxy of its own. It runs with the window's settings object, by way of the window's realm as its principal
+    // realm.
+    auto wrapper_world = vm.heap().allocate<Bindings::WrapperWorld>(Bindings::WrapperWorld::Type::Extension);
+    auto realm_execution_context = Bindings::create_a_new_javascript_realm(
+        vm,
+        document.relevant_settings_object().agent_cluster_cross_origin_isolation_mode(),
+        [&](JS::Realm& realm) -> GC::Ref<JS::Object> {
+            return Bindings::create_global_object_wrapper(realm, window);
+        },
+        [&](JS::Realm& realm) -> GC::Ref<JS::Object> {
+            return browsing_context->window_proxy_for(*wrapper_world, realm)->object();
+        });
+
+    auto& realm = *realm_execution_context->realm;
+    auto intrinsics = realm.create<Bindings::Intrinsics>(realm);
+    realm.set_host_defined(realm.heap().allocate<Bindings::HostDefined>(intrinsics, wrapper_world, window->principal_realm()));
+    Bindings::cache_global_object_wrapper(realm);
+    MUST(Bindings::initialize_window_web_interfaces(*window, realm));
+
+    return vm.heap().allocate<IsolatedWorld>(document, wrapper_world, move(realm_execution_context));
+}
+
+IsolatedWorld::IsolatedWorld(DOM::Document& document, GC::Ref<Bindings::WrapperWorld> wrapper_world, NonnullOwnPtr<JS::ExecutionContext> realm_execution_context)
+    : m_document(document)
+    , m_wrapper_world(wrapper_world)
+    , m_realm_execution_context(move(realm_execution_context))
+{
+}
+
+IsolatedWorld::~IsolatedWorld() = default;
+
+bool IsolatedWorld::is_isolated_world_realm(JS::Realm const& realm)
+{
+    return realm.host_defined() && Bindings::host_defined_wrapper_world(realm).type() == Bindings::WrapperWorld::Type::Extension;
+}
+
+JS::Realm& IsolatedWorld::realm() const
+{
+    return *m_realm_execution_context->realm;
+}
+
+JS::Completion IsolatedWorld::run_script(Utf16View source, URL::URL const& url)
+{
+    auto& realm = this->realm();
+    auto script = JS::Script::parse(source, realm, url.to_byte_string());
+    if (script.is_error()) {
+        auto error = JS::SyntaxError::create(realm, script.error().first().to_utf16_string());
+        report_exception_to_console(error, realm, ErrorInPromise::No);
+        return JS::throw_completion(error);
+    }
+
+    auto& settings = m_document->relevant_settings_object();
+    prepare_to_run_script(settings);
+    JS::Completion result = realm.vm().run(script.value());
+    if (result.is_abrupt())
+        report_exception_to_console(result.value(), realm, ErrorInPromise::No);
+    clean_up_after_running_script(settings);
+    return result;
+}
+
+JS::Completion IsolatedWorld::call(JS::Value function, JS::Value this_value, ReadonlySpan<JS::Value> arguments)
+{
+    auto& realm = this->realm();
+    auto& settings = m_document->relevant_settings_object();
+    prepare_to_run_script(settings);
+    prepare_to_run_callback(settings);
+
+    JS::Completion result = JS::js_undefined();
+    if (auto call_result = JS::call(realm.vm(), function, this_value, arguments); call_result.is_error()) {
+        report_exception_to_console(call_result.error_value(), realm, ErrorInPromise::No);
+        result = JS::throw_completion(call_result.error_value());
+    } else {
+        result = call_result.value();
+    }
+
+    clean_up_after_running_callback(settings);
+    clean_up_after_running_script(settings);
+    return result;
+}
+
+void IsolatedWorld::detach()
+{
+    m_wrapper_world->detach();
+}
+
+void IsolatedWorld::visit_edges(Cell::Visitor& visitor)
+{
+    Base::visit_edges(visitor);
+    visitor.visit(m_document);
+    visitor.visit(m_wrapper_world);
+    m_realm_execution_context->visit_edges(visitor);
+}
+
+}
