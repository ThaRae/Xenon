 #include <LibWeb/WebIDL/Promise.h>
diff --git a/Libraries/LibWeb/Internals/Internals.cpp b/Libraries/LibWeb/Internals/Internals.cpp
index 84f34902548257496fd3d0f79dc005f11026a50a..1b8b1924f8c314105c0f38b382f687ce9944333b 100644
--- a/Libraries/LibWeb/Internals/Internals.cpp
+++ b/Libraries/LibWeb/Internals/Internals.cpp
@@ -1401,6 +1401,12 @@ void Internals::set_user_agent(Utf16String const& user_agent)
     Web::update_loader_config([&](auto& config) { config.user_agent = user_agent.to_utf8(); });
 }
 
+// Test mode forces fingerprinting protection off so output stays deterministic. Tests of farbling turn it back on.
+void Internals::set_fingerprinting_protection(bool enabled)
+{
+    Web::update_loader_config([&](auto& config) { config.enable_fingerprinting_protection = enabled; });
+}
+
 void Internals::set_content_blocking_enabled(bool enabled)
 {
     page().set_content_blocking_policy(enabled, {});
diff --git a/Libraries/LibWeb/Internals/Internals.h b/Libraries/LibWeb/Internals/Internals.h
index 8d9df67e6fa8473fb3247f38870a7d8c38e0972a..338a61effa14ada82598302e3acaeaae4f3941e8 100644
--- a/Libraries/LibWeb/Internals/Internals.h
+++ b/Libraries/LibWeb/Internals/Internals.h
@@ -171,6 +171,7 @@ public:
     WebIDL::ExceptionOr<void> set_content_blockers(Utf16String const& patterns);
     WebIDL::ExceptionOr<void> set_site_compatibility_data(Utf16String const& source);
     void set_user_agent(Utf16String const& user_agent);
+    void set_fingerprinting_protection(bool enabled);
     void set_content_blocking_enabled(bool enabled);
     Optional<String> cosmetic_filter_for_element(DOM::Element&);
     WebIDL::UnsignedLongLong partial_layout_count();
diff --git a/Libraries/LibWeb/Internals/Internals.idl b/Libraries/LibWeb/Internals/Internals.idl
index 089003b4e1b46ce50ed357a39d37c360607a090a..9ca6124aa6b32574238f26dafab4ea8909208bc4 100644
--- a/Libraries/LibWeb/Internals/Internals.idl
+++ b/Libraries/LibWeb/Internals/Internals.idl
@@ -169,6 +169,7 @@ interface Internals {
     undefined setContentBlockers(DOMString patterns);
     undefined setSiteCompatibilityData(DOMString source);
     undefined setUserAgent(DOMString userAgent);
+    undefined setFingerprintingProtection(boolean enabled);
     undefined setContentBlockingEnabled(boolean enabled);
     DOMString? cosmeticFilterForElement(Element element);
     unsigned long long partialLayoutCount();
diff --git a/Libraries/LibWeb/WebAudio/AudioBuffer.cpp b/Libraries/LibWeb/WebAudio/AudioBuffer.cpp
index c4af9f1bedf1587d5e6c957ab2242c455d7acab8..5fe0717028cb2cc4066746bd8760a2fa67ca7cc7 100644
--- a/Libraries/LibWeb/WebAudio/AudioBuffer.cpp
+++ b/Libraries/LibWeb/WebAudio/AudioBuffer.cpp
@@ -332,6 +332,13 @@ WebIDL::ExceptionOr<void> AudioBuffer::copy_to_channel(GC::Root<JS::Float32Array
         bytes.copy_to({ reinterpret_cast<u8*>(channel_data.data() + buffer_offset), bytes.size() });
     });
 
+    // Fingerprinting protection: a live getChannelData() view already saw farbled samples, so newly written
+    // samples are farbled too. Unfarbled channels stay clean until the next read.
+    if (channel.farbled && Fingerprinting::protection_enabled()) {
+        Fingerprinting::farble_audio({ channel_data.data() + buffer_offset, count },
+            Fingerprinting::seed_for_relevant_global(*source));
+    }
+
     return {};
 }
 
diff --git a/Tests/LibWeb/Text/expected/Fingerprinting/protection.txt b/Tests/LibWeb/Text/expected/Fingerprinting/protection.txt
