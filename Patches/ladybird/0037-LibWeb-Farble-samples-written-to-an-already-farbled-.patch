diff --git a/Tests/LibWeb/Text/input/Fingerprinting/protection.html b/Tests/LibWeb/Text/input/Fingerprinting/protection.html
new file mode 100644
index 0000000000000000000000000000000000000000..cba8b5bb83506aaca65aa02bf0409ec02094b69b
--- /dev/null
+++ b/Tests/LibWeb/Text/input/Fingerprinting/protection.html
@@ -0,0 +1,106 @@
+<!DOCTYPE html>
+<script src="../include.js"></script>
+<script>
+    function imageDataEqual(a, b)
+    {
+        if (a.width !== b.width || a.height !== b.height || a.data.length !== b.data.length)
+            return false;
+        for (let i = 0; i < a.data.length; i++) {
+            if (a.data[i] !== b.data[i])
+                return false;
+        }
+        return true;
+    }
+
+    function allEqual(samples)
+    {
+        return samples.length > 0 && samples.every(sample => sample === samples[0]);
+    }
+
+    test(() => {
+        try {
+            println(`webdriver is false: ${navigator.webdriver === false ? "PASS" : `FAIL (${navigator.webdriver})`}`);
+
+            const chromeShaped = /^Mozilla\/5\.0 \([^)]*\) AppleWebKit\/537\.36 \(KHTML, like Gecko\) Chrome\/\d+\.0\.0\.0 Safari\/537\.36$/.test(navigator.userAgent);
+            println(`user agent is chrome-shaped: ${chromeShaped ? "PASS" : `FAIL (${navigator.userAgent})`}`);
+            println(`user agent has no Ladybird token: ${navigator.userAgent.includes("Ladybird") ? `FAIL (${navigator.userAgent})` : "PASS"}`);
+            println(`vendor is Google Inc.: ${navigator.vendor === "Google Inc." ? "PASS" : `FAIL (${navigator.vendor})`}`);
+
+            const canvas = document.createElement("canvas");
+            canvas.width = 64;
+            canvas.height = 64;
+            const context = canvas.getContext("2d");
+            context.fillStyle = "#000000";
+            context.fillRect(0, 0, 64, 64);
+
+            internals.setFingerprintingProtection(false);
+            const exactPixels = context.getImageData(0, 0, 64, 64);
+            const exactPixel = exactPixels.data;
+            println(`canvas readback is exact with protection off: ${exactPixel[0] === 0 && exactPixel[1] === 0 && exactPixel[2] === 0 && exactPixel[3] === 255 ? "PASS" : `FAIL (${exactPixel[0]},${exactPixel[1]},${exactPixel[2]},${exactPixel[3]})`}`);
+            const exactUrl = canvas.toDataURL();
+
+            internals.setFingerprintingProtection(true);
+            const farbledPixels = context.getImageData(0, 0, 64, 64);
+            const farbledPixelsAgain = context.getImageData(0, 0, 64, 64);
+            const farbledUrl = canvas.toDataURL();
+            const farbledUrlAgain = canvas.toDataURL();
+
+            println(`canvas getImageData is stable: ${imageDataEqual(farbledPixels, farbledPixelsAgain) ? "PASS" : "FAIL"}`);
+            println(`canvas getImageData differs when farbled: ${imageDataEqual(exactPixels, farbledPixels) ? "FAIL" : "PASS"}`);
+            println(`canvas toDataURL is stable: ${farbledUrl === farbledUrlAgain ? "PASS" : "FAIL"}`);
+            println(`canvas toDataURL differs when farbled: ${exactUrl === farbledUrl ? "FAIL" : "PASS"}`);
+
+            // An image drawn to learn which bits get flipped says nothing about another image: one grey pixel in the last
+            // row changes the pattern everywhere else too.
+            const other = document.createElement("canvas");
+            other.width = 64;
+            other.height = 64;
+            const otherContext = other.getContext("2d");
+            otherContext.fillStyle = "#000000";
+            otherContext.fillRect(0, 0, 64, 64);
+            otherContext.fillStyle = "#808080";
+            otherContext.fillRect(63, 63, 1, 1);
+            const otherPixels = otherContext.getImageData(0, 0, 64, 64);
+            let samePattern = true;
+            for (let i = 0; i < 63 * 64 * 4; i++) {
+                if (otherPixels.data[i] !== farbledPixels.data[i]) {
+                    samePattern = false;
+                    break;
+                }
+            }
+            println(`canvas pattern depends on the image: ${samePattern ? "FAIL" : "PASS"}`);
+
+            const buffer = new AudioBuffer({ length: 128, sampleRate: 44100 });
+            buffer.copyToChannel(new Float32Array(128).fill(1), 0);
+            const channel = buffer.getChannelData(0);
+            println(`audio getChannelData scales in [0.99, 1): ${allEqual(channel) && channel[0] >= 0.99 && channel[0] < 1 ? "PASS" : `FAIL (${channel[0]})`}`);
+
+            // Playing the buffer acquires its content, and getChannelData() then hands back a copy of samples that were
+            // already scaled. They mustn't be scaled again.
+            const audioContext = new OfflineAudioContext(1, 128, 8000);
+            const played = audioContext.createBuffer(1, 128, 8000);
+            played.copyToChannel(new Float32Array(128).fill(1), 0);
+            const firstRead = played.getChannelData(0)[0];
+            const source = new AudioBufferSourceNode(audioContext);
+            source.buffer = played;
+            source.start();
+            const secondRead = played.getChannelData(0)[0];
+            println(`audio is scaled once across an acquire: ${secondRead === firstRead ? "PASS" : `FAIL (${firstRead}, ${secondRead})`}`);
+
+            const unread = new AudioBuffer({ length: 128, sampleRate: 44100 });
+            unread.copyToChannel(new Float32Array(128).fill(1), 0);
+            const copied = new Float32Array(128);
+            unread.copyFromChannel(copied, 0);
+            println(`audio copyFromChannel scales in [0.99, 1): ${allEqual(copied) && copied[0] >= 0.99 && copied[0] < 1 ? "PASS" : `FAIL (${copied[0]})`}`);
+
+            const concurrency = navigator.hardwareConcurrency;
+            println(`hardwareConcurrency is in range: ${Number.isInteger(concurrency) && concurrency >= 1 && concurrency <= 8 ? "PASS" : `FAIL (${concurrency})`}`);
+            println(`deviceMemory is 1, 2, or 4: ${[1, 2, 4].includes(navigator.deviceMemory) ? "PASS" : `FAIL (${navigator.deviceMemory})`}`);
+
+            internals.setFingerprintingProtection(false);
+        } catch (error) {
+            println(`FAIL: ${error}`);
+            internals.setFingerprintingProtection(false);
+        }
+    });
+</script>
