@@ -0,0 +1,45 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/NeverDestroyed.h>
+#include <LibURL/URL.h>
+#include <LibWebCommon/Fetch/Infrastructure/OriginAccessAllowList.h>
+
+namespace Web::Fetch::Infrastructure {
+
+static Vector<OriginAccessAllowListEntry>& origin_access_allow_list()
+{
+    static NeverDestroyed<Vector<OriginAccessAllowListEntry>> allow_list;
+    return *allow_list;
+}
+
+bool OriginAccessAllowListEntry::allows(URL::Origin const& source_origin, URL::URL const& destination) const
+{
+    if (source_origin.is_opaque() || !this->source_origin.is_same_origin(source_origin))
+        return false;
+    if (destination.scheme() != destination_scheme || !destination.host().has_value())
+        return false;
+    if (destination_host.is_empty())
+        return true;
+
+    auto host = destination.serialized_host();
+    if (host == destination_host)
+        return true;
+    return allow_destination_subdomains && host.length() > destination_host.bytes().size()
+        && host.ends_with(destination_host) && host[host.length() - destination_host.bytes().size() - 1] == '.';
+}
+
+void set_origin_access_allow_list(Vector<OriginAccessAllowListEntry> allow_list)
+{
+    origin_access_allow_list() = move(allow_list);
+}
+
+bool is_allowed_by_origin_access_allow_list(URL::Origin const& source_origin, URL::URL const& destination)
+{
+    return any_of(origin_access_allow_list(), [&](auto const& entry) { return entry.allows(source_origin, destination); });
+}
+
+}
