@@ -0,0 +1,35 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/String.h>
+#include <AK/Vector.h>
+#include <LibURL/Origin.h>
+#include <LibWebCommon/Export.h>
+
+namespace Web::Fetch::Infrastructure {
+
+// The embedder may let an origin fetch from some others as if they were the same origin: with no CORS, and with the
+// credentials of a same-origin request. Blink and WebKit keep such allowlists for browser extensions, which reach the
+// hosts their users granted them this way. A destination is a scheme and a host, on any port; an empty host is any
+// host.
+struct WEBCOMMON_API OriginAccessAllowListEntry {
+    URL::Origin source_origin;
+    String destination_scheme;
+    String destination_host;
+    bool allow_destination_subdomains { false };
+
+    bool allows(URL::Origin const& source_origin, URL::URL const& destination) const;
+};
+
+// Each process keeps the allowlist the embedder last gave it.
+WEBCOMMON_API void set_origin_access_allow_list(Vector<OriginAccessAllowListEntry>);
+WEBCOMMON_API bool is_allowed_by_origin_access_allow_list(URL::Origin const& source_origin, URL::URL const& destination);
+
+}
+
+#include <LibWebCommon/Fetch/Infrastructure/OriginAccessAllowListCodecs.h>
