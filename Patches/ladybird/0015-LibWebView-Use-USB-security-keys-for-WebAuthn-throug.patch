+// A security key on USB, which speaks CTAP2 or CTAP1/U2F over HID, through libfido2. libfido2 blocks while the key
+// waits for a touch, so each operation runs on a thread of its own, which opens the key, makes its request, and closes
+// it again. The key is closed in between, for other programs to use.
+class WEBVIEW_API HIDAuthenticator final : public Authenticator {
+public:
+    // Opens the key at a HID path and asks what it supports. Blocks; it runs on a discovery thread.
+    static RefPtr<HIDAuthenticator> probe(ByteString path, String name);
+
+    virtual ~HIDAuthenticator() override;
+
+    ByteString const& path() const { return m_path; }
+
+    virtual Info const& info() const override { return m_info; }
+    virtual String const& name() const override { return m_name; }
+    virtual void make_credential(MakeCredentialRequest, Function<void(MakeCredentialResult)>) override;
+    virtual void get_assertion(GetAssertionRequest, Function<void(GetAssertionResult)>) override;
+    virtual void wait_for_touch(Function<void(Optional<Failure>)>) override;
+    virtual void get_pin_retries(Function<void(Optional<u32>)>) override;
+    virtual void cancel() override;
+
+private:
+    HIDAuthenticator(ByteString path, String name, Info);
+
+    // Runs an operation on its own thread, with the key open, and hands its result to the calling thread's event loop.
+    template<typename Result>
+    void run_operation(StringView thread_name, Function<Result(fido_dev*)> operation, Function<void(Result)> on_complete);
+
+    ByteString m_path;
+    String m_name;
+    Info m_info;
+
+    // The key an operation has open, for cancel() to reach from the main thread.
+    Mutex m_device_lock;
+    fido_dev* m_open_device { nullptr };
+    Atomic<bool> m_cancelled { false };
+};
+
+// Finds security keys on USB, by polling for HID devices that speak FIDO while a ceremony waits.
+class WEBVIEW_API HIDAuthenticators final : public AuthenticatorSource {
+public:
+    static HIDAuthenticators& the();
+
+    virtual NonnullOwnPtr<Discovery> discover(CanonicalTraversable const&, Function<void(NonnullRefPtr<Authenticator>)> on_authenticator) override;
+
+private:
+    class HIDDiscovery;
+
+    HIDAuthenticators();
+};
+
+}
