+namespace WebView {
+
+// How often discovery looks for security keys that have been plugged in or taken out.
+static constexpr auto DISCOVERY_INTERVAL = AK::Duration::from_milliseconds(500);
+
+// Enough for every key a person has plugged in at once.
+static constexpr size_t MAXIMUM_DEVICE_COUNT = 64;
+
+static Authenticator::Error error_for_fido_result(int result)
+{
+    switch (result) {
+    case FIDO_ERR_NO_CREDENTIALS:
+        return Authenticator::Error::NoCredentials;
+    case FIDO_ERR_CREDENTIAL_EXCLUDED:
+        return Authenticator::Error::CredentialExcluded;
+    case FIDO_ERR_PIN_REQUIRED:
+        return Authenticator::Error::PinRequired;
+    case FIDO_ERR_PIN_INVALID:
+    case FIDO_ERR_UV_INVALID:
+        return Authenticator::Error::PinInvalid;
+    case FIDO_ERR_PIN_BLOCKED:
+    case FIDO_ERR_PIN_AUTH_BLOCKED:
+    case FIDO_ERR_UV_BLOCKED:
+        return Authenticator::Error::PinBlocked;
+    case FIDO_ERR_PIN_NOT_SET:
+        return Authenticator::Error::PinNotSet;
+    case FIDO_ERR_UNSUPPORTED_ALGORITHM:
+    case FIDO_ERR_UNSUPPORTED_OPTION:
+        return Authenticator::Error::NotSupported;
+    case FIDO_ERR_OPERATION_DENIED:
+        return Authenticator::Error::OperationDenied;
+    case FIDO_ERR_USER_ACTION_TIMEOUT:
+    case FIDO_ERR_ACTION_TIMEOUT:
+        return Authenticator::Error::Timeout;
+    case FIDO_ERR_KEEPALIVE_CANCEL:
+        return Authenticator::Error::Cancelled;
+    case FIDO_ERR_TX:
+    case FIDO_ERR_RX:
+        return Authenticator::Error::Removed;
+    default:
+        return Authenticator::Error::Other;
+    }
+}
+
+static ByteBuffer copy_bytes(unsigned char const* data, size_t length)
+{
+    if (!data || length == 0)
+        return {};
+    return MUST(ByteBuffer::copy(data, length));
+}
+
+static String string_or_empty(char const* string)
+{
+    if (!string)
+        return {};
+    return String::from_utf8(StringView { string, strlen(string) }).value_or({});
+}
+
+RefPtr<HIDAuthenticator> HIDAuthenticator::probe(ByteString path, String name)
+{
+    auto* device = fido_dev_new();
+    if (!device)
+        return nullptr;
+    ScopeGuard free_device = [&] { fido_dev_free(&device); };
+
+    if (fido_dev_open(device, path.characters()) != FIDO_OK)
+        return nullptr;
+    ScopeGuard close_device = [&] { fido_dev_close(device); };
+
+    Info info;
+    info.transports = { Web::WebAuthn::AuthenticatorTransport::Usb };
+    info.attachment = Web::WebAuthn::AuthenticatorAttachment::CrossPlatform;
+    info.is_u2f_only = !fido_dev_is_fido2(device);
+
+    // https://fidoalliance.org/specs/fido-v2.1-ps-20210615/fido-client-to-authenticator-protocol-v2.1-ps-errata-20220621.html#authenticatorGetInfo
+    if (info.is_u2f_only) {
+        info.algorithms = { COSE_ES256 };
+    } else {
+        info.supports_client_pin = fido_dev_supports_pin(device);
+        info.has_client_pin = fido_dev_has_pin(device);
+        info.has_built_in_user_verification = fido_dev_has_uv(device);
+
+        auto* cbor_info = fido_cbor_info_new();
+        if (cbor_info && fido_dev_get_cbor_info(device, cbor_info) == FIDO_OK) {
+            auto** option_names = fido_cbor_info_options_name_ptr(cbor_info);
+            auto const* option_values = fido_cbor_info_options_value_ptr(cbor_info);
+            for (size_t i = 0; i < fido_cbor_info_options_len(cbor_info); ++i) {
+                auto option = StringView { option_names[i], strlen(option_names[i]) };
+                if (option == "rk"sv)
+                    info.supports_resident_keys = option_values[i];
+                else if (option == "makeCredUvNotRqd"sv)
+                    info.make_credential_without_user_verification = option_values[i];
+            }
+            for (size_t i = 0; i < fido_cbor_info_algorithm_count(cbor_info); ++i)
+                info.algorithms.append(fido_cbor_info_algorithm_cose(cbor_info, i));
+        }
+        fido_cbor_info_free(&cbor_info);
+    }
+
+    return adopt_ref(*new HIDAuthenticator(move(path), move(name), move(info)));
+}
+
+HIDAuthenticator::HIDAuthenticator(ByteString path, String name, Info info)
+    : m_path(move(path))
+    , m_name(move(name))
+    , m_info(move(info))
+{
+}
+
+HIDAuthenticator::~HIDAuthenticator() = default;
+
+template<typename Result>
+void HIDAuthenticator::run_operation(StringView thread_name, Function<Result(fido_dev*)> operation, Function<void(Result)> on_complete)
+{
+    m_cancelled = false;
+
+    auto thread = Threading::Thread::construct(thread_name,
+        [self = NonnullRefPtr { *this }, operation = move(operation), on_complete = move(on_complete), event_loop = Core::EventLoop::current_weak()]() mutable -> intptr_t {
+            auto result = [&] -> Result {
+                auto* device = fido_dev_new();
+                if (!device)
+                    return operation(nullptr);
+                ScopeGuard free_device = [&] { fido_dev_free(&device); };
+
+                if (fido_dev_open(device, self->m_path.characters()) != FIDO_OK)
+                    return operation(nullptr);
+
+                {
+                    MutexLocker locker(self->m_device_lock);
+                    self->m_open_device = device;
+                }
+
+                // NB: A cancel() that came before the key was open is honored here.
+                auto result = self->m_cancelled ? operation(nullptr) : operation(device);
+
+                {
+                    MutexLocker locker(self->m_device_lock);
+                    self->m_open_device = nullptr;
+                }
+                fido_dev_close(device);
+                return result;
+            }();
+
+            auto strong_event_loop = event_loop->take();
+            if (!strong_event_loop)
+                return 0;
+            strong_event_loop->deferred_invoke([on_complete = move(on_complete), result = move(result)]() mutable {
+                on_complete(move(result));
+            });
+            return 0;
+        });
+    thread->start();
+    thread->detach();
+}
+
+void HIDAuthenticator::cancel()
+{
+    // https://fidoalliance.org/specs/fido-v2.1-ps-20210615/fido-client-to-authenticator-protocol-v2.1-ps-errata-20220621.html#usb-hid-cancel
+    m_cancelled = true;
+    MutexLocker locker(m_device_lock);
+    if (m_open_device)
+        fido_dev_cancel(m_open_device);
+}
+
+void HIDAuthenticator::make_credential(MakeCredentialRequest request, Function<void(MakeCredentialResult)> on_complete)
+{
+    run_operation<MakeCredentialResult>("WebAuthn create"sv, [this, request = move(request)](fido_dev* device) -> MakeCredentialResult {
+        if (!device)
+            return Failure { m_cancelled ? Error::Cancelled : Error::Removed, {} };
+
+        auto* credential = fido_cred_new();
+        if (!credential)
+            return Failure { Error::Other, {} };
+        ScopeGuard free_credential = [&] { fido_cred_free(&credential); };
+
+        auto user_name = request.user_name.to_byte_string();
+        auto user_display_name = request.user_display_name.to_byte_string();
+        auto rp_id = request.rp_id.to_byte_string();
+        auto rp_name = request.rp_name.to_byte_string();
+
+        int result = fido_cred_set_type(credential, request.algorithm);
+        if (result == FIDO_OK)
+            result = fido_cred_set_clientdata_hash(credential, request.client_data_hash.data(), request.client_data_hash.size());
+        if (result == FIDO_OK)
+            result = fido_cred_set_rp(credential, rp_id.characters(), rp_name.characters());
+        if (result == FIDO_OK)
+            result = fido_cred_set_user(credential, request.user_id.data(), request.user_id.size(), user_name.characters(), user_display_name.characters(), nullptr);
+        for (auto const& excluded : request.exclude_list) {
+            if (result == FIDO_OK)
+                result = fido_cred_exclude(credential, excluded.id.data(), excluded.id.size());
+        }
+        if (result == FIDO_OK)
+            result = fido_cred_set_rk(credential, request.resident_key ? FIDO_OPT_TRUE : FIDO_OPT_OMIT);
+        // NB: With a PIN, user verification comes from the PIN, and the uv option must not be set as well.
+        if (result == FIDO_OK && !request.pin.has_value())
+            result = fido_cred_set_uv(credential, request.user_verification ? FIDO_OPT_TRUE : FIDO_OPT_OMIT);
+        if (result != FIDO_OK)
+            return Failure { Error::Other, {} };
+
+        auto pin = request.pin.has_value() ? request.pin->to_byte_string() : ByteString {};
+        result = fido_dev_make_cred(device, credential, request.pin.has_value() ? pin.characters() : nullptr);
+        if (result != FIDO_OK)
+            return Failure { error_for_fido_result(result), {} };
+
+        Registration registration;
+        registration.credential_id = copy_bytes(fido_cred_id_ptr(credential), fido_cred_id_len(credential));
+        registration.authenticator_data = copy_bytes(fido_cred_authdata_raw_ptr(credential), fido_cred_authdata_raw_len(credential));
+        registration.attestation_format = string_or_empty(fido_cred_fmt(credential));
+        registration.attestation_statement = copy_bytes(fido_cred_attstmt_ptr(credential), fido_cred_attstmt_len(credential));
+        registration.resident_key = request.resident_key;
+        return registration; }, move(on_complete));
+}
+
+void HIDAuthenticator::get_assertion(GetAssertionRequest request, Function<void(GetAssertionResult)> on_complete)
+{
+    run_operation<GetAssertionResult>("WebAuthn get"sv, [this, request = move(request)](fido_dev* device) -> GetAssertionResult {
+        if (!device)
+            return Failure { m_cancelled ? Error::Cancelled : Error::Removed, {} };
+
+        auto* assertion = fido_assert_new();
+        if (!assertion)
+            return Failure { Error::Other, {} };
+        ScopeGuard free_assertion = [&] { fido_assert_free(&assertion); };
+
+        auto rp_id = request.rp_id.to_byte_string();
+        int result = fido_assert_set_clientdata_hash(assertion, request.client_data_hash.data(), request.client_data_hash.size());
+        if (result == FIDO_OK)
+            result = fido_assert_set_rp(assertion, rp_id.characters());
+        for (auto const& allowed : request.allow_list) {
+            if (result == FIDO_OK)
+                result = fido_assert_allow_cred(assertion, allowed.id.data(), allowed.id.size());
+        }
+        if (result == FIDO_OK && !request.pin.has_value())
+            result = fido_assert_set_uv(assertion, request.user_verification ? FIDO_OPT_TRUE : FIDO_OPT_OMIT);
+        if (result != FIDO_OK)
+            return Failure { Error::Other, {} };
+
+        auto pin = request.pin.has_value() ? request.pin->to_byte_string() : ByteString {};
+        result = fido_dev_get_assert(device, assertion, request.pin.has_value() ? pin.characters() : nullptr);
+        if (result != FIDO_OK)
+            return Failure { error_for_fido_result(result), {} };
+
+        Vector<Assertion> assertions;
+        for (size_t i = 0; i < fido_assert_count(assertion); ++i) {
+            Assertion entry;
+            entry.credential_id = copy_bytes(fido_assert_id_ptr(assertion, i), fido_assert_id_len(assertion, i));
+            entry.authenticator_data = copy_bytes(fido_assert_authdata_raw_ptr(assertion, i), fido_assert_authdata_raw_len(assertion, i));
+            entry.signature = copy_bytes(fido_assert_sig_ptr(assertion, i), fido_assert_sig_len(assertion, i));
+            auto user_id = copy_bytes(fido_assert_user_id_ptr(assertion, i), fido_assert_user_id_len(assertion, i));
+            if (!user_id.is_empty())
+                entry.user = UserEntity { move(user_id), string_or_empty(fido_assert_user_name(assertion, i)), string_or_empty(fido_assert_user_display_name(assertion, i)) };
+            assertions.append(move(entry));
+        }
+        return assertions; }, move(on_complete));
+}
+
+void HIDAuthenticator::wait_for_touch(Function<void(Optional<Failure>)> on_complete)
+{
+    run_operation<Optional<Failure>>("WebAuthn touch"sv, [this](fido_dev* device) -> Optional<Failure> {
+        if (!device)
+            return Failure { m_cancelled ? Error::Cancelled : Error::Removed, {} };
+
+        // https://fidoalliance.org/specs/fido-v2.1-ps-20210615/fido-client-to-authenticator-protocol-v2.1-ps-errata-20220621.html#authenticatorSelection
+        int result = fido_dev_get_touch_begin(device);
+        if (result != FIDO_OK)
+            return Failure { error_for_fido_result(result), {} };
+
+        while (!m_cancelled) {
+            int touched = 0;
+            result = fido_dev_get_touch_status(device, &touched, 200);
+            if (result != FIDO_OK)
+                return Failure { error_for_fido_result(result), {} };
+            if (touched)
+                return {};
+        }
+        return Failure { Error::Cancelled, {} }; }, move(on_complete));
+}
+
+void HIDAuthenticator::get_pin_retries(Function<void(Optional<u32>)> on_complete)
+{
+    run_operation<Optional<u32>>("WebAuthn PIN retries"sv, [](fido_dev* device) -> Optional<u32> {
+        if (!device)
+            return {};
+        int retries = 0;
+        if (fido_dev_get_retry_count(device, &retries) != FIDO_OK || retries < 0)
+            return {};
+        return static_cast<u32>(retries); }, move(on_complete));
+}
+
+// Polls for FIDO HID devices on a thread of its own, and reports each new one, once it has asked it what it supports,
+// to the event loop that started the discovery.
+class HIDAuthenticators::HIDDiscovery final : public AuthenticatorSource::Discovery {
+public:
+    explicit HIDDiscovery(Function<void(NonnullRefPtr<Authenticator>)> on_authenticator)
+        : m_state(adopt_ref(*new State))
+    {
+        m_state->on_authenticator = move(on_authenticator);
+
+        auto thread = Threading::Thread::construct("WebAuthn discovery"sv, [state = m_state, event_loop = Core::EventLoop::current_weak()] -> intptr_t {
+            HashTable<ByteString> present_paths;
+            while (!state->is_stopped) {
+                HashTable<ByteString> paths;
+                Vector<NonnullRefPtr<HIDAuthenticator>> new_authenticators;
+
+                auto* device_list = fido_dev_info_new(MAXIMUM_DEVICE_COUNT);
+                size_t device_count = 0;
+                if (device_list && fido_dev_info_manifest(device_list, MAXIMUM_DEVICE_COUNT, &device_count) == FIDO_OK) {
+                    for (size_t i = 0; i < device_count; ++i) {
+                        auto const* device_info = fido_dev_info_ptr(device_list, i);
+                        auto const* path = fido_dev_info_path(device_info);
+                        if (!path)
+                            continue;
+                        ByteString device_path { path, strlen(path) };
+                        if (present_paths.contains(device_path)) {
+                            paths.set(device_path);
+                            continue;
+                        }
+
+                        // NB: A key that can't be opened yet, being busy with another program, is tried again on the
+                        //     next poll.
+                        auto product = string_or_empty(fido_dev_info_product_string(device_info));
+                        if (product.is_empty())
+                            product = "Security key"_string;
+                        if (auto authenticator = HIDAuthenticator::probe(device_path, product)) {
+                            paths.set(device_path);
+                            new_authenticators.append(authenticator.release_nonnull());
+                        }
+                    }
+                }
+                fido_dev_info_free(&device_list, MAXIMUM_DEVICE_COUNT);
+
+                // A key that was taken out is new again when it comes back.
+                present_paths = move(paths);
+
+                if (!new_authenticators.is_empty()) {
+                    auto strong_event_loop = event_loop->take();
+                    if (!strong_event_loop)
+                        return 0;
+                    strong_event_loop->deferred_invoke([state, new_authenticators = move(new_authenticators)] {
+                        if (state->is_stopped)
+                            return;
+                        for (auto const& authenticator : new_authenticators)
+                            state->on_authenticator(authenticator);
+                    });
+                }
+
+                for (auto waited = AK::Duration::zero(); waited < DISCOVERY_INTERVAL && !state->is_stopped; waited += AK::Duration::from_milliseconds(50))
+                    usleep(50'000);
+            }
+            return 0;
+        });
+        thread->start();
+        thread->detach();
+    }
+
+    virtual ~HIDDiscovery() override
+    {
+        m_state->is_stopped = true;
+    }
+
+private:
+    // Shared with the discovery thread, which may outlive the discovery for up to one poll.
+    struct State : public AtomicRefCounted<State> {
+        Atomic<bool> is_stopped { false };
+        Function<void(NonnullRefPtr<Authenticator>)> on_authenticator;
+    };
+
+    NonnullRefPtr<State> m_state;
+};
+
+HIDAuthenticators& HIDAuthenticators::the()
+{
+    static auto& authenticators = *new HIDAuthenticators;
+    return authenticators;
+}
+
+HIDAuthenticators::HIDAuthenticators()
+{
+    fido_init(0);
+}
+
+NonnullOwnPtr<AuthenticatorSource::Discovery> HIDAuthenticators::discover(CanonicalTraversable const&, Function<void(NonnullRefPtr<Authenticator>)> on_authenticator)
+{
+    return make<HIDDiscovery>(move(on_authenticator));
+}
+
+}
