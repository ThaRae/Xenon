 Libraries/LibWebCommon/WebView/Utilities.cpp | 13 +++++++++++
 Libraries/LibWebCommon/WebView/Utilities.h   |  6 +++++
 Libraries/LibWebView/CrashReportStore.cpp    |  3 ++-
 Libraries/LibWebView/Profile.cpp             | 11 +++++----
 Tests/LibWebView/TestProfile.cpp             | 24 ++++++++++++++++++++
 6 files changed, 53 insertions(+), 7 deletions(-)

diff --git a/Libraries/LibDevTools/FirefoxClient.cpp b/Libraries/LibDevTools/FirefoxClient.cpp
index d84b9989978cca42c8747c2f2a53e870036069b0..973b4c80edb282f532ff0248b5ed9ae1a8e6b5cd 100644
