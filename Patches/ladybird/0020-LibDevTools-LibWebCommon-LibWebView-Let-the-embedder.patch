 #include <LibWebView/CookieJar.h>
 #include <LibWebView/FaviconStore.h>
 #include <LibWebView/HSTSStore.h>
@@ -131,6 +132,29 @@ TEST_CASE(legacy_layout)
     remove_test_root();
 }
 
+TEST_CASE(embedder_application_name)
+{
+    remove_test_root();
+    auto profile_roots = roots();
+    WebView::set_application_name("Embedder");
+
+    auto profile = MUST(WebView::Profile::create({}, profile_roots));
+    auto profile_path = LexicalPath::join("Embedder/Profiles"sv, WebView::DEFAULT_PROFILE_NAME).string();
+    EXPECT_EQ(profile.paths().config, LexicalPath::join(profile_roots.config, profile_path).string());
+    EXPECT_EQ(profile.paths().data, LexicalPath::join(profile_roots.data, profile_path).string());
+    EXPECT_EQ(profile.paths().cache, LexicalPath::join(profile_roots.cache, profile_path).string());
+    EXPECT_EQ(profile.paths().runtime, LexicalPath::join(profile_roots.runtime, profile_path).string());
+    EXPECT(!FileSystem::exists(LexicalPath::join(profile_roots.config, "Ladybird"sv).string()));
+    EXPECT(!FileSystem::exists(LexicalPath::join(profile_roots.data, "Ladybird"sv).string()));
+    EXPECT(!FileSystem::exists(LexicalPath::join(profile_roots.cache, "Ladybird"sv).string()));
+
+    auto legacy_profile = MUST(WebView::Profile::create_legacy(profile_roots));
+    EXPECT_EQ(legacy_profile.paths().config, LexicalPath::join(profile_roots.config, "Embedder"sv).string());
+
+    WebView::set_application_name("Ladybird");
+    remove_test_root();
+}
+
 TEST_CASE(invalid_selection)
 {
     remove_test_root();
