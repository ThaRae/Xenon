@@ -20,6 +20,7 @@
 #    include <LibDevTools/LaunchApplicationMacOS.h>
 #endif
 #include <LibFileSystem/FileSystem.h>
+#include <LibWebCommon/WebView/Utilities.h>
 
 #if !defined(AK_OS_WINDOWS)
 #    include <unistd.h>
@@ -60,7 +61,7 @@ static constexpr auto USER_CHROME_CSS = R"~~~(
 
 static LexicalPath const& profile_directory()
 {
-    static NeverDestroyed<LexicalPath> path = LexicalPath::join(Core::StandardPaths::user_data_directory(), "Ladybird"sv, "DevTools"sv, "firefox-profile"sv);
+    static NeverDestroyed<LexicalPath> path = LexicalPath::join(Core::StandardPaths::user_data_directory(), WebView::application_name(), "DevTools"sv, "firefox-profile"sv);
     return *path;
 }
 
diff --git a/Libraries/LibWebCommon/WebView/Utilities.cpp b/Libraries/LibWebCommon/WebView/Utilities.cpp
index aee32f1e715f84c2f48a50636a7c862b03a12dc7..a6059447d24c45b1ccc3ddab8eb0771d199ba00c 100644
--- a/Libraries/LibWebCommon/WebView/Utilities.cpp
+++ b/Libraries/LibWebCommon/WebView/Utilities.cpp
@@ -48,6 +48,19 @@ ByteString mach_server_name_for_process(StringView process_name, pid_t pid)
     return ByteString::formatted("org.ladybird.{}.helper.{}", process_name, pid);
 }
 
+static auto& s_application_name = *new ByteString { "Ladybird"sv };
+
+StringView application_name()
+{
+    return s_application_name;
+}
+
+void set_application_name(ByteString name)
+{
+    VERIFY(!name.is_empty());
+    s_application_name = move(name);
+}
+
 static ErrorOr<ByteString> application_directory()
 {
     if (s_ladybird_binary_path.has_value())
diff --git a/Libraries/LibWebCommon/WebView/Utilities.h b/Libraries/LibWebCommon/WebView/Utilities.h
index 11e98a45b5b8a85c7923961409147ce975c2dd60..f02847aae132ed832cd1fe816ad7fa8c4e9aaccb 100644
--- a/Libraries/LibWebCommon/WebView/Utilities.h
+++ b/Libraries/LibWebCommon/WebView/Utilities.h
@@ -35,4 +35,10 @@ WEBCOMMON_API ErrorOr<void> handle_attached_debugger();
 
 WEBCOMMON_API String host_for_settings(URL::URL const&);
 
+// The name of the directory the browser keeps its profiles and crash reports in, under each of the platform's config,
+// data, cache, and runtime directories. It defaults to "Ladybird". Other browsers built on LibWebView set their own name
+// before creating their Application, so that their data stays apart from Ladybird's.
+WEBCOMMON_API StringView application_name();
+WEBCOMMON_API void set_application_name(ByteString);
+
 }
diff --git a/Libraries/LibWebView/CrashReportStore.cpp b/Libraries/LibWebView/CrashReportStore.cpp
index bf91716b6e81a8b3faa03a250d09945d44d2042e..5ab0323ce1e90aca5a8f06c56714efc97f669d94 100644
