+
+namespace Web::Farbling {
+
+static String ascii_lower(StringView text)
+{
+    StringBuilder builder;
+    for (auto c : text)
+        builder.append(static_cast<char>(AK::to_ascii_lowercase(c)));
+    return MUST(builder.to_string());
+}
+
+static StringView language_prefix(StringView language)
+{
+    size_t n = 0;
+    while (n < language.length() && n < 2 && AK::is_ascii_alpha(language[n]))
+        ++n;
+    return language.substring_view(0, n);
+}
+
+static bool names_contain(Span<StringView const> names, StringView lowered)
+{
+    for (auto name : names) {
+        if (name == lowered)
+            return true;
+    }
+    return false;
+}
+
+// Why each entry is here is in the comment above the group.
+static bool is_whitelisted_lowercased(StringView family, StringView language)
+{
+    // CSS generic families and UA aliases. These are keywords, not installed files, but pages name them.
+    static constexpr StringView generics[] = {
+        "serif"sv,
+        "sans-serif"sv,
+        "monospace"sv,
+        "cursive"sv,
+        "fantasy"sv,
+        "system-ui"sv,
+        "ui-serif"sv,
+        "ui-sans-serif"sv,
+        "ui-monospace"sv,
+        "ui-rounded"sv,
+        "emoji"sv,
+        "math"sv,
+        "fangsong"sv,
+        "-apple-system"sv,
+        "-apple-system-font"sv,
+        "-webkit-system-font"sv,
+    };
+    if (names_contain(generics, family))
+        return true;
+
+    // Families Xenon/Ladybird ship in resource://fonts (layout tests and last-resort UI).
+    static constexpr StringView bundled[] = {
+        "serenitysans"sv,
+        "noto emoji"sv,
+        "notoemoji"sv,
+    };
+    if (names_contain(bundled, family))
+        return true;
+
+    // Names FontPlugin searches when resolving generic families (W3 examples plus Android).
+    // Generic `sans-serif` looks these up by name, so they must stay allowed.
+    static constexpr StringView platform_defaults[] = {
+        "comic sans ms"sv,
+        "comic sans"sv,
+        "apple chancery"sv,
+        "bradley hand"sv,
+        "brush script mt"sv,
+        "snell roundhand"sv,
+        "urw chancery l"sv,
+        "dancing script"sv,
+        "impact"sv,
+        "luminari"sv,
+        "chalkduster"sv,
+        "jazz let"sv,
+        "blippo"sv,
+        "stencil std"sv,
+        "marker felt"sv,
+        "trattatello"sv,
+        "coming soon"sv,
+        "andale mono"sv,
+        "courier new"sv,
+        "courier"sv,
+        "freemono"sv,
+        "ocr a std"sv,
+        "noto sans mono"sv,
+        "dejavu sans mono"sv,
+        "droid sans mono"sv,
+        "liberation mono"sv,
+        "arial"sv,
+        "helvetica"sv,
+        "verdana"sv,
+        "trebuchet ms"sv,
+        "gill sans"sv,
+        "noto sans"sv,
+        "avantgarde"sv,
+        "optima"sv,
+        "arial narrow"sv,
+        "liberation sans"sv,
+        "roboto"sv,
+        "times"sv,
+        "times new roman"sv,
+        "didot"sv,
+        "georgia"sv,
+        "palatino"sv,
+        "bookman"sv,
+        "new century schoolbook"sv,
+        "american typewriter"sv,
+        "liberation serif"sv,
+        "roman"sv,
+        "noto serif"sv,
+    };
+    if (names_contain(platform_defaults, family))
+        return true;
+
+    // Small per-language extras, keyed by the first two letters of the document language.
+    auto prefix = language_prefix(language);
+    if (prefix == "zh"sv) {
+        static constexpr StringView zh[] = { "simsun"sv, "microsoft yahei"sv, "noto sans cjk sc"sv, "source han sans sc"sv };
+        if (names_contain(zh, family))
+            return true;
+    } else if (prefix == "ja"sv) {
+        static constexpr StringView ja[] = { "yu gothic"sv, "meiryo"sv, "noto sans cjk jp"sv, "hiragino sans"sv };
+        if (names_contain(ja, family))
+            return true;
+    } else if (prefix == "ko"sv) {
+        static constexpr StringView ko[] = { "malgun gothic"sv, "apple sd gothic neo"sv, "noto sans cjk kr"sv };
+        if (names_contain(ko, family))
+            return true;
+    } else if (prefix == "ar"sv) {
+        static constexpr StringView ar[] = { "tahoma"sv, "noto naskh arabic"sv, "traditional arabic"sv };
+        if (names_contain(ar, family))
+            return true;
+    }
+
+    return false;
+}
+
+bool is_whitelisted_font_family(StringView family, StringView language)
+{
+    return is_whitelisted_lowercased(ascii_lower(family), language);
+}
+
+bool allow_font_family(Seed const& seed, StringView family, StringView language)
+{
+    if (!seed.enabled())
+        return true;
+
+    auto lowered = ascii_lower(family);
+    if (is_whitelisted_lowercased(lowered, language))
+        return true;
+
+    // Stable 1-in-20 extra set, keyed by (seed, lowercased family). Same site always agrees.
+    return RNG(seed).integer(lowered) % 20 == 0;
+}
+
+}
