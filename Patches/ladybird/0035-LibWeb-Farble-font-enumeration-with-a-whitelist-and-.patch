+Farbling::FontFarblingQuery FontComputer::font_farbling_query() const
+{
+    Farbling::FontFarblingQuery query;
+    auto* settings = m_environment_settings_object.ptr();
+    if (!settings && m_document)
+        settings = &m_document->relevant_settings_object();
+    if (settings)
+        query.seed = settings->farbling_seed();
+
+    query.language = "en"_string;
+    if (!m_document)
+        return query;
+
+    Optional<Utf16String> lang;
+    if (auto* root = m_document->document_element())
+        lang = root->lang();
+    if (!lang.has_value())
+        lang = m_document->http_content_language();
+    if (!lang.has_value())
+        lang = m_document->pragma_set_default_language();
+    if (lang.has_value() && !lang->is_empty()) {
+        auto utf8 = lang->to_utf8_but_should_be_ported_to_utf16();
+        auto view = utf8.bytes_as_string_view();
+        auto n = min(view.length(), 2ul);
+        if (n > 0)
+            query.language = MUST(String::from_utf8(view.substring_view(0, n)));
+    }
+    m_font_cascade_memo->set_farbling_query(query);
+    return query;
+}
