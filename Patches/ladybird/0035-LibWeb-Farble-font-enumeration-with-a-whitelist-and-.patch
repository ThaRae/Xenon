+        Farbling::FontFarblingQuery query { settings.farbling_seed(), "en"_string };
+        if (auto* window = HTML::window_from_global_object(settings.global_object())) {
+            query = window->associated_document().font_computer().font_farbling_query();
+        }
+        bool allowed_installed = false;
+        bool rejected_installed = false;
+        for (auto const& font_family : font_family_list.values()) {
+            if (font_family->is_keyword())
+                continue;
+            auto name = MUST(string_from_style_value(font_family).view().to_utf8());
+            bool installed = false;
+            if (auto fly = FlyString::from_utf8(name.bytes_as_string_view()); !fly.is_error()) {
+                Gfx::FontDatabase::the().for_each_typeface_with_family_name(fly.release_value(), [&](Gfx::Typeface const&) {
+                    installed = true;
+                });
+            }
+            if (!installed)
+                continue;
+            if (Farbling::allow_font_family(query, name))
+                allowed_installed = true;
+            else
+                rejected_installed = true;
+        }
+        // A rejected installed family behaves as missing for fingerprinting, but a truly missing family still
+        // returns true (css-font-loading: empty list => true), which FontFaceSet-check.html requires.
+        if (rejected_installed && !allowed_installed)
+            return false;
         return true;
