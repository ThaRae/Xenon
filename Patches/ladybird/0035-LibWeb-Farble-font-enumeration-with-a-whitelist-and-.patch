+++ b/Tests/LibWeb/TestFontAllow.cpp
@@ -0,0 +1,54 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/String.h>
+#include <LibTest/TestCase.h>
+#include <LibWeb/Farbling/FontAllow.h>
+
+TEST_CASE(off_allows_all)
+{
+    Web::Farbling::Seed off {};
+    EXPECT(Web::Farbling::allow_font_family(off, "Comic Sans MS"sv, "en"sv));
+    EXPECT(Web::Farbling::allow_font_family(off, "Definitely Not A Font"sv, "en"sv));
+}
+
+TEST_CASE(whitelist_is_always_allowed)
+{
+    Web::Farbling::Seed seed { .level = Web::Farbling::Level::Standard, .high = 1, .low = 2 };
+    EXPECT(Web::Farbling::allow_font_family(seed, "serif"sv, "en"sv));
+    EXPECT(Web::Farbling::allow_font_family(seed, "Liberation Sans"sv, "en"sv));
+    EXPECT(Web::Farbling::allow_font_family(seed, "SerenitySans"sv, "en"sv));
+    EXPECT(Web::Farbling::allow_font_family(seed, "Arial"sv, "en"sv));
+    EXPECT(Web::Farbling::is_whitelisted_font_family("Times New Roman"sv, "en"sv));
+}
+
+TEST_CASE(language_extras_are_allowed)
+{
+    EXPECT(Web::Farbling::is_whitelisted_font_family("Microsoft YaHei"sv, "zh"sv));
+    EXPECT(!Web::Farbling::is_whitelisted_font_family("Microsoft YaHei"sv, "en"sv));
+}
+
+TEST_CASE(same_seed_is_deterministic)
+{
+    Web::Farbling::Seed seed { .level = Web::Farbling::Level::Standard, .high = 9, .low = 8 };
+    auto first = Web::Farbling::allow_font_family(seed, "Some Obscure Font"sv, "en"sv);
+    auto second = Web::Farbling::allow_font_family(seed, "Some Obscure Font"sv, "en"sv);
+    EXPECT_EQ(first, second);
+}
+
+TEST_CASE(roughly_one_in_twenty_of_synthetic_names)
+{
+    Web::Farbling::Seed seed { .level = Web::Farbling::Level::Standard, .high = 0x111, .low = 0x222 };
+    int allowed = 0;
+    int const n = 1000;
+    for (int i = 0; i < n; ++i) {
+        auto name = MUST(String::formatted("SyntheticFamily{}", i));
+        if (Web::Farbling::allow_font_family(seed, name, "en"sv))
+            ++allowed;
+    }
+    EXPECT(allowed >= 20);
+    EXPECT(allowed <= 80);
+}
