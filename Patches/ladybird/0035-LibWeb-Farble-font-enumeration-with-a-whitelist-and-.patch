+void FontCascadeMemo::set_farbling_query(Farbling::FontFarblingQuery query) const
+{
+    MutexLocker locker(m_mutex);
+    if (m_farbling.seed == query.seed && m_farbling.language == query.language)
+        return;
+    m_farbling = move(query);
+    m_cascades.remove_all_matching([&](auto const&, auto const& font_list) {
+        m_retired.append(font_list);
+        return true;
+    });
+}
+
+Farbling::FontFarblingQuery FontCascadeMemo::farbling_query() const
+{
+    MutexLocker locker(m_mutex);
+    return m_farbling;
+}
