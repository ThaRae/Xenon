+
+#pragma once
+
+#include <AK/String.h>
+#include <AK/StringView.h>
+#include <LibWeb/Export.h>
+#include <LibWebCommon/Farbling/FarblingSeed.h>
+
+namespace Web::Farbling {
+
+struct FontFarblingQuery {
+    Seed seed {};
+    String language { "en"_string };
+};
+
+// Off: allow every family. Standard/Strict: whitelist, then a stable 1-in-20 extra from the seed.
+WEB_API bool allow_font_family(Seed const& seed, StringView family, StringView language);
+
+inline bool allow_font_family(FontFarblingQuery const& query, StringView family)
+{
+    return allow_font_family(query.seed, family, query.language);
+}
+
+WEB_API bool is_whitelisted_font_family(StringView family, StringView language);
+
+}
