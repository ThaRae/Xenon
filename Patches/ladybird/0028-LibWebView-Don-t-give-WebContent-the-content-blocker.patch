From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan <ryan@esterlines.com>
Date: Wed, 28 Oct 2026 14:55:04 -0400
Subject: [PATCH] LibWebView: Don't give WebContent the content blocker's rules
 while off

Every WebContent process builds its own engine from the rules it gets,
right away, whether or not anything is blocked. With large lists that
takes tens of MiB in each process, and several times that while it is
being built, for nothing when content blocking is turned off.

Send each process empty rules while blocking is off, which drops the
engine it has, and send the rules again when blocking is turned back on.
---
 Libraries/LibWebView/Application.cpp | 10 ++++++++++
 Libraries/LibWebView/Application.h   |  2 ++
 2 files changed, 12 insertions(+)

diff --git a/Libraries/LibWebView/Application.cpp b/Libraries/LibWebView/Application.cpp
index 4b5e86371465f4eb7704d9c0c01d6d29cb777f18..6eca46bf7bd6bfe4b2c8e6df1faf77baf971c685 100644
--- a/Libraries/LibWebView/Application.cpp
+++ b/Libraries/LibWebView/Application.cpp
@@ -699,6 +699,7 @@ ErrorOr<void> Application::initialize(Main::Arguments const& arguments)
         warnln("\033[31;1mUnable to load all content blocker lists:\033[0m {}", result.error());
         warnln("    Configured lists: {}", m_browser_options.content_blocker_list_paths);
     }
+    m_content_blocking_was_enabled = content_blocking_enabled();
 
     if (!m_event_loop)
         m_event_loop = &create_platform_event_loop();
@@ -889,6 +890,11 @@ void Application::send_content_blockers(WebContentClient& client) const
 {
     if (!m_content_blocker_list_buffer.has_value() || !m_trusted_content_blocker_list_buffer.has_value() || !m_content_blocker_resources_buffer.has_value())
         return;
+    // Each process builds an engine from the rules, which can take tens of MiB, so while blocking is off it gets none.
+    if (!content_blocking_enabled()) {
+        client.async_set_content_blockers(Core::AnonymousBuffer {}, Core::AnonymousBuffer {}, Core::AnonymousBuffer {});
+        return;
+    }
     client.async_set_content_blockers(*m_content_blocker_list_buffer, *m_trusted_content_blocker_list_buffer, *m_content_blocker_resources_buffer);
 }
 
@@ -2885,7 +2891,11 @@ void Application::apply_content_blocker_settings()
     else
         rules_changed = result.release_value();
 
+    // Turning blocking on or off gives or takes the rules (see send_content_blockers()).
     auto enabled = content_blocking_enabled();
+    if (exchange(m_content_blocking_was_enabled, enabled) != enabled)
+        rules_changed = true;
+
     auto disabled_sites = m_settings->content_blocker_disabled_sites().values();
 
     WebContentClient::for_each_client([&](WebContentClient& client) {
diff --git a/Libraries/LibWebView/Application.h b/Libraries/LibWebView/Application.h
index 94e9be046a2b4cadb628e2f7fe538098e3fa9f53..bc1371dd81f71ceaa131fc573882402fbdc4734f 100644
--- a/Libraries/LibWebView/Application.h
+++ b/Libraries/LibWebView/Application.h
@@ -602,6 +602,8 @@ private:
     Optional<Core::AnonymousBuffer> m_content_blocker_list_buffer;
     Optional<Core::AnonymousBuffer> m_trusted_content_blocker_list_buffer;
     Optional<Core::AnonymousBuffer> m_content_blocker_resources_buffer;
+    // Whether content blocking was on when every process last got the rules, which it only has while it is.
+    bool m_content_blocking_was_enabled { false };
     RefPtr<Core::Timer> m_content_blocker_list_update_timer;
     struct PendingContentBlockerListUpdate {
         String identifier;
