+ */
+
+#pragma once
+
+#include <AK/StringView.h>
+#include <AK/Types.h>
+#include <LibWeb/Export.h>
+#include <LibWebCommon/Farbling/FarblingSeed.h>
+
+namespace Web::Farbling {
+
+// Brave's WebGL2 Balanced MAX_* set. Shared WebGL1 pnames are none of these; WebGL1 getParameter of them is invalid.
+WEB_API bool is_farbled_webgl_max_pname(u32 pname);
+
+// Standard: real, or real-1 with probability 1/2 from a per-pname PRNG stream. Strict: 0. Off / non-positive: real.
+WEB_API i32 farble_webgl_max_i32(Seed const&, u32 pname, i32 real);
+WEB_API i64 farble_webgl_max_i64(Seed const&, u32 pname, i64 real);
+
+// One pair of strings for every Xenon user, not per-site.
+WEB_API StringView generic_unmasked_vendor();
+WEB_API StringView generic_unmasked_renderer();
+
+}
