+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/String.h>
+#include <LibWeb/Farbling/FarblingRNG.h>
+#include <LibWeb/Farbling/WebGLFarbling.h>
+
+namespace Web::Farbling {
+
+// GLES3 / WebGL2RenderingContextBase.idl
+static constexpr u32 GL_MAX_VERTEX_UNIFORM_BLOCKS = 0x8A2B;
+static constexpr u32 GL_MAX_FRAGMENT_UNIFORM_BLOCKS = 0x8A2D;
+static constexpr u32 GL_MAX_COMBINED_UNIFORM_BLOCKS = 0x8A2E;
+static constexpr u32 GL_MAX_UNIFORM_BUFFER_BINDINGS = 0x8A2F;
+static constexpr u32 GL_MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS = 0x8A31;
+static constexpr u32 GL_MAX_COMBINED_FRAGMENT_UNIFORM_COMPONENTS = 0x8A33;
+static constexpr u32 GL_MAX_FRAGMENT_UNIFORM_COMPONENTS = 0x8B49;
+static constexpr u32 GL_MAX_VERTEX_UNIFORM_COMPONENTS = 0x8B4A;
+static constexpr u32 GL_MAX_VARYING_COMPONENTS = 0x8B4B;
+static constexpr u32 GL_MAX_TRANSFORM_FEEDBACK_INTERLEAVED_COMPONENTS = 0x8C8A;
+static constexpr u32 GL_MAX_VERTEX_OUTPUT_COMPONENTS = 0x9122;
+static constexpr u32 GL_MAX_FRAGMENT_INPUT_COMPONENTS = 0x9125;
+
+bool is_farbled_webgl_max_pname(u32 pname)
+{
+    switch (pname) {
+    case GL_MAX_VERTEX_UNIFORM_COMPONENTS:
+    case GL_MAX_VERTEX_UNIFORM_BLOCKS:
+    case GL_MAX_VERTEX_OUTPUT_COMPONENTS:
+    case GL_MAX_VARYING_COMPONENTS:
+    case GL_MAX_TRANSFORM_FEEDBACK_INTERLEAVED_COMPONENTS:
+    case GL_MAX_FRAGMENT_UNIFORM_COMPONENTS:
+    case GL_MAX_FRAGMENT_UNIFORM_BLOCKS:
+    case GL_MAX_FRAGMENT_INPUT_COMPONENTS:
+    case GL_MAX_UNIFORM_BUFFER_BINDINGS:
+    case GL_MAX_COMBINED_UNIFORM_BLOCKS:
+    case GL_MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS:
+    case GL_MAX_COMBINED_FRAGMENT_UNIFORM_COMPONENTS:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool subtract_one(Seed const& seed, u32 pname)
+{
+    auto key = MUST(String::formatted("webgl:{:08x}", pname));
+    return (RNG(seed).integer(key) & 1u) != 0;
+}
+
+i32 farble_webgl_max_i32(Seed const& seed, u32 pname, i32 real)
+{
+    if (!is_farbled_webgl_max_pname(pname) || !seed.enabled() || real <= 0)
+        return real;
+    if (seed.level == Level::Strict)
+        return 0;
+    return subtract_one(seed, pname) ? real - 1 : real;
+}
+
+i64 farble_webgl_max_i64(Seed const& seed, u32 pname, i64 real)
+{
+    if (!is_farbled_webgl_max_pname(pname) || !seed.enabled() || real <= 0)
+        return real;
+    if (seed.level == Level::Strict)
+        return 0;
+    return subtract_one(seed, pname) ? real - 1 : real;
+}
+
+StringView generic_unmasked_vendor()
+{
+    return "Xenon"sv;
+}
+
+StringView generic_unmasked_renderer()
+{
+    return "Xenon Generic Renderer"sv;
+}
+
+}
