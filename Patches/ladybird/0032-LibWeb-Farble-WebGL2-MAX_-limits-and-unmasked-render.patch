+static Web::Farbling::Seed farbling_seed_for_canvas_host(void* canvas_host)
+{
+    if (!canvas_host)
+        return {};
+    auto& settings = HTML::relevant_settings_object(static_cast<HTML::CanvasHost*>(canvas_host)->canvas_relevant_global_object());
+    if (settings.origin().is_opaque())
+        return {};
+    return settings.farbling_seed();
+}
+
+u8 web_webgl_farbling_level(void* canvas_host)
+{
+    return to_underlying(farbling_seed_for_canvas_host(canvas_host).level);
+}
+
+i32 web_webgl_farble_max_i32(void* canvas_host, u32 pname, i32 real)
+{
+    return Farbling::farble_webgl_max_i32(farbling_seed_for_canvas_host(canvas_host), pname, real);
+}
+
+i64 web_webgl_farble_max_i64(void* canvas_host, u32 pname, i64 real)
+{
+    return Farbling::farble_webgl_max_i64(farbling_seed_for_canvas_host(canvas_host), pname, real);
+}
