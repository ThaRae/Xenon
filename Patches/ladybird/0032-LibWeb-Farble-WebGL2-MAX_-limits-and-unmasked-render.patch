+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibTest/TestCase.h>
+#include <LibWeb/Farbling/WebGLFarbling.h>
+
+static constexpr u32 MAX_VERTEX_UNIFORM_COMPONENTS = 0x8B4A;
+static constexpr u32 MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS = 0x8A31;
+static constexpr u32 MAX_TEXTURE_SIZE = 0x0D33;
+
+TEST_CASE(farbled_pnames_are_the_brave_webgl2_set)
+{
+    EXPECT(Web::Farbling::is_farbled_webgl_max_pname(MAX_VERTEX_UNIFORM_COMPONENTS));
+    EXPECT(Web::Farbling::is_farbled_webgl_max_pname(MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS));
+    EXPECT(!Web::Farbling::is_farbled_webgl_max_pname(MAX_TEXTURE_SIZE));
+}
+
+TEST_CASE(off_leaves_the_real_value)
+{
+    Web::Farbling::Seed off {};
+    EXPECT_EQ(Web::Farbling::farble_webgl_max_i32(off, MAX_VERTEX_UNIFORM_COMPONENTS, 1024), 1024);
+    EXPECT_EQ(Web::Farbling::farble_webgl_max_i64(off, MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS, 4096), 4096);
+}
+
+TEST_CASE(standard_is_real_or_real_minus_one)
+{
+    Web::Farbling::Seed seed { .level = Web::Farbling::Level::Standard, .high = 1, .low = 2 };
+    auto value = Web::Farbling::farble_webgl_max_i32(seed, MAX_VERTEX_UNIFORM_COMPONENTS, 1024);
+    EXPECT(value == 1024 || value == 1023);
+}
+
+TEST_CASE(same_seed_is_deterministic)
+{
+    Web::Farbling::Seed seed { .level = Web::Farbling::Level::Standard, .high = 9, .low = 8 };
+    auto first = Web::Farbling::farble_webgl_max_i32(seed, MAX_VERTEX_UNIFORM_COMPONENTS, 1024);
+    auto second = Web::Farbling::farble_webgl_max_i32(seed, MAX_VERTEX_UNIFORM_COMPONENTS, 1024);
+    EXPECT_EQ(first, second);
+}
+
+TEST_CASE(different_pnames_are_independent_streams)
+{
+    bool found_difference = false;
+    for (u64 n = 1; n <= 64 && !found_difference; ++n) {
+        Web::Farbling::Seed trial { .level = Web::Farbling::Level::Standard, .high = n, .low = n * 7 };
+        auto a = Web::Farbling::farble_webgl_max_i32(trial, MAX_VERTEX_UNIFORM_COMPONENTS, 100);
+        auto b = Web::Farbling::farble_webgl_max_i32(trial, 0x8A2B, 100);
+        if (a != b)
+            found_difference = true;
+    }
+    EXPECT(found_difference);
+}
+
+TEST_CASE(strict_returns_zero)
+{
+    Web::Farbling::Seed seed { .level = Web::Farbling::Level::Strict, .high = 1, .low = 2 };
+    EXPECT_EQ(Web::Farbling::farble_webgl_max_i32(seed, MAX_VERTEX_UNIFORM_COMPONENTS, 1024), 0);
+    EXPECT_EQ(Web::Farbling::farble_webgl_max_i64(seed, MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS, 4096), 0);
+}
+
+TEST_CASE(non_positive_stays_non_positive)
+{
+    Web::Farbling::Seed seed { .level = Web::Farbling::Level::Standard, .high = 1, .low = 2 };
+    EXPECT_EQ(Web::Farbling::farble_webgl_max_i32(seed, MAX_VERTEX_UNIFORM_COMPONENTS, 0), 0);
+    EXPECT_EQ(Web::Farbling::farble_webgl_max_i32(seed, MAX_VERTEX_UNIFORM_COMPONENTS, -4), -4);
+}
+
+TEST_CASE(vendor_and_renderer_are_the_generic_strings)
+{
+    EXPECT_EQ(Web::Farbling::generic_unmasked_vendor(), "Xenon"sv);
+    EXPECT_EQ(Web::Farbling::generic_unmasked_renderer(), "Xenon Generic Renderer"sv);
+}
