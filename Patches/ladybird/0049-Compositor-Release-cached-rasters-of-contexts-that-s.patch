diff --git a/Services/Compositor/DisplayListRasterCache.cpp b/Services/Compositor/DisplayListRasterCache.cpp
index 2948ebce231bcb3742bbf99cb25fa605f5ea6437..5f41562de1bd7f1457a8b2a119be7ba515704780 100644
