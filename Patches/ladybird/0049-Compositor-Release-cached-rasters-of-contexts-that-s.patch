 DisplayListRasterCache::DisplayListRasterCache() = default;
 DisplayListRasterCache::~DisplayListRasterCache() = default;
 
+bool DisplayListRasterCache::has_cached_rasters(KeepTextBlobs keep_text_blobs) const
+{
+    if (!m_repeated_tile_rasters.is_empty() || !m_nested_display_list_rasters.is_empty())
+        return true;
+    return keep_text_blobs == KeepTextBlobs::No && (!m_text_blobs.is_empty() || !m_clip_paths.is_empty() || !m_clip_paths_from_last_frame.is_empty());
+}
+
+DisplayListRasterCache::ReleasedBytes DisplayListRasterCache::release_cached_rasters(KeepTextBlobs keep_text_blobs)
+{
+    ReleasedBytes released_bytes;
+    released_bytes.repeated_tiles = m_repeated_tile_raster_bytes;
+    m_repeated_tile_rasters.clear();
+    m_repeated_tile_raster_bytes = 0;
+    for (auto const& it : m_nested_display_list_rasters)
+        released_bytes.nested_display_lists += it.value->total_byte_size();
+    m_nested_display_list_rasters.clear();
+    if (keep_text_blobs == KeepTextBlobs::No) {
+        released_bytes.text_blobs = m_text_blob_cache_bytes;
+        m_text_blobs.clear();
+        m_text_blob_cache_bytes = 0;
+        m_clip_paths.clear();
+        m_clip_paths_from_last_frame.clear();
+    }
+    m_was_released_since_last_paint = true;
+    return released_bytes;
+}
+
+void DisplayListRasterCache::did_paint()
+{
+    m_last_painted = MonotonicTime::now();
+    m_was_released_since_last_paint = false;
+}
