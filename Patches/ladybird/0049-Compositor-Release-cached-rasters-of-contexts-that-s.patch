@@ -1094,6 +1255,9 @@ void CompositorState::present_frame(Web::CompositorContextId context_id, Context
         });
     });
     context.presenter().did_submit_prepared_frame(pending_frame.viewport_rect);
+    if (idle_memory_release_is_logged())
+        dbgln("COMPOSITOR-FRAME context={} prepare_us={} after_release={}", context_id, preparation_time.to_microseconds(), repaints_released_rasters);
+    schedule_idle_memory_release_for(context);
 #ifdef AK_OS_MACOS
     // The window server's reads of an IOSurface wait for GPU work that is already scheduled to write it. Handing the
     // frame to the client before that work finishes keeps it ahead of the window server's deadline for the next refresh.
@@ -1295,8 +1459,12 @@ bool CompositorState::request_screenshot(Web::CompositorContextId context_id, Gf
         return false;
 
     auto composited_context_resolver = resolver_for(context_id);
+    auto repaints_released_rasters = context->raster_cache().was_released_since_last_paint();
     if (auto scrollbar_fade_frame = context->paint_screenshot(*m_display_list_player, target_bitmap, &composited_context_resolver); scrollbar_fade_frame.has_value())
         schedule_present_frame(context_id, *context, *scrollbar_fade_frame);
+    if (idle_memory_release_is_logged())
+        dbgln("COMPOSITOR-SCREENSHOT context={} after_release={}", context_id, repaints_released_rasters);
+    schedule_idle_memory_release_for(*context);
     return true;
 }
 
