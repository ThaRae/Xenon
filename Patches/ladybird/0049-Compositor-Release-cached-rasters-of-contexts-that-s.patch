 namespace Compositor {
 
 static constexpr int gpu_completion_check_interval_ms = 1;
 
+// A context's cached rasters only save work while it paints. A hidden context paints nothing until it is shown again,
+// so its rasters go soon after. A visible one may be read for a while and then scrolled, so it keeps them for longer,
+// and keeps its text blobs, which are small and which every scroll uses.
+static constexpr auto hidden_context_raster_release_delay = AK::Duration::from_seconds(4);
+static constexpr auto visible_context_raster_release_delay = AK::Duration::from_seconds(30);
+// Giving free pages back walks the heaps, so it is done at most this often.
+static constexpr auto free_page_release_interval = AK::Duration::from_seconds(4);
+// Skia can only purge a texture once the GPU work that reads it is done.
+static constexpr auto gpu_work_retry_delay = AK::Duration::from_milliseconds(100);
+
+static bool idle_memory_release_is_enabled()
+{
+    static auto const enabled = Core::Environment::get("LADYBIRD_COMPOSITOR_IDLE_RELEASE"sv).value_or("1"sv) != "0"sv;
+    return enabled;
+}
+
+static bool idle_memory_release_is_logged()
+{
+    static bool const logged = [] {
+        auto value = Core::Environment::get("LADYBIRD_COMPOSITOR_IDLE_RELEASE_LOG"sv);
+        return value.has_value() && !value->is_empty() && *value != "0"sv;
+    }();
+    return logged;
+}
