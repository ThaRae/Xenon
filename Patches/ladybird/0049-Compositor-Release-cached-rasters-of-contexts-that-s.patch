 {
     return adopt_ref(*new CompositorState(move(skia_backend_context)));
@@ -31,12 +65,134 @@ CompositorState::CompositorState(RefPtr<Gfx::SkiaBackendContext> skia_backend_co
 
 CompositorState::~CompositorState()
 {
+    if (m_heap_trim_thread && m_heap_trim_thread->needs_to_be_joined())
+        (void)m_heap_trim_thread->join();
     if (!m_gpu_completion_timer)
         return;
     m_gpu_completion_timer->on_timeout = {};
     m_gpu_completion_timer->stop();
 }
 
+void CompositorState::schedule_idle_memory_release(MonotonicTime release_time)
+{
+    if (!idle_memory_release_is_enabled())
+        return;
+    if (!m_idle_memory_release_timer)
+        m_idle_memory_release_timer = Core::Timer::create_single_shot(AK::Duration::zero(), [this] { release_idle_memory(); });
+    // Only an earlier time moves the timer, so a context that paints every frame does not re-arm it every frame.
+    if (m_idle_memory_release_timer->is_active() && m_idle_memory_release_time <= release_time)
+        return;
+    m_idle_memory_release_time = release_time;
+    auto delay = release_time - MonotonicTime::now();
+    m_idle_memory_release_timer->restart(delay.is_negative() ? AK::Duration::zero() : delay);
+}
+
+void CompositorState::schedule_idle_memory_release_for(ContextState const& context)
+{
+    auto release_delay = context_is_effectively_visible(context) ? visible_context_raster_release_delay : hidden_context_raster_release_delay;
+    schedule_idle_memory_release(MonotonicTime::now() + release_delay);
+}
+
+// Each context's rasters go once that context has painted nothing for a while, whatever the others paint.
+void CompositorState::release_idle_memory()
+{
+    auto now = MonotonicTime::now();
+    if (!m_pending_async_presents.is_empty()) {
+        schedule_idle_memory_release(now + gpu_work_retry_delay);
+        return;
+    }
+
+    auto logged = idle_memory_release_is_logged();
+    Optional<MonotonicTime> next_release_time;
+    auto release_no_later_than = [&](MonotonicTime release_time) {
+        if (!next_release_time.has_value() || release_time < *next_release_time)
+            next_release_time = release_time;
+    };
+
+    for (auto& context_entry : m_contexts) {
+        auto& context = *context_entry.value;
+        auto is_visible = context_is_effectively_visible(context);
+        auto keep_text_blobs = is_visible ? DisplayListRasterCache::KeepTextBlobs::Yes : DisplayListRasterCache::KeepTextBlobs::No;
+        auto& raster_cache = context.raster_cache();
+        if (!raster_cache.has_cached_rasters(keep_text_blobs))
+            continue;
+
+        auto idle_time = now - raster_cache.last_painted();
+        auto release_delay = is_visible ? visible_context_raster_release_delay : hidden_context_raster_release_delay;
+        if (idle_time < release_delay) {
+            release_no_later_than(raster_cache.last_painted() + release_delay);
+            if (logged)
+                dbgln("COMPOSITOR-IDLE-KEEP context={} nested={} visible={} idle_ms={}", context_entry.key, context.parent_context_id().has_value(), is_visible, idle_time.to_milliseconds());
+            continue;
+        }
+
+        auto released_bytes = raster_cache.release_cached_rasters(keep_text_blobs);
+        m_free_page_release_is_pending = true;
+        if (logged) {
+            dbgln("COMPOSITOR-IDLE-RELEASE context={} nested={} visible={} idle_ms={} tiles={} nested_lists={} text={}",
+                context_entry.key, context.parent_context_id().has_value(), is_visible, idle_time.to_milliseconds(),
+                released_bytes.repeated_tiles, released_bytes.nested_display_lists, released_bytes.text_blobs);
+        }
+    }
+
+    if (m_free_page_release_is_pending) {
+        if (!m_last_free_page_release_time.has_value() || now - *m_last_free_page_release_time >= free_page_release_interval)
+            release_free_pages();
+        else
+            release_no_later_than(*m_last_free_page_release_time + free_page_release_interval);
+    }
+
+    if (next_release_time.has_value())
+        schedule_idle_memory_release(*next_release_time);
+}
+
+void CompositorState::release_free_pages()
+{
+    m_free_page_release_is_pending = false;
+    m_last_free_page_release_time = MonotonicTime::now();
+    auto logged = idle_memory_release_is_logged();
+
+    // Skia keeps the textures of dropped GPU rasters for reuse until a flush trims its cache, which a context that paints
+    // nothing never does.
+    auto start_time = MonotonicTime::now();
+    if (m_skia_backend_context)
+        m_skia_backend_context->purge_unlocked_scratch_resources();
+    auto skia_purge_end_time = MonotonicTime::now();
+
+    // AK allocates through mimalloc, whose purge on Linux only resets freed pages, which keeps them in the process.
+    ak_kmalloc_decommit_free_pages();
+    auto mimalloc_end_time = MonotonicTime::now();
+
+#if defined(AK_OS_MACOS)
+    // Skia and the GPU driver allocate through the C library.
+    (void)malloc_zone_pressure_relief(nullptr, 0);
+#endif
+
+    if (logged) {
+        dbgln("COMPOSITOR-IDLE-RELEASE free pages: skia_purge_us={} mimalloc_us={} libc_us={}",
+            (skia_purge_end_time - start_time).to_microseconds(), (mimalloc_end_time - skia_purge_end_time).to_microseconds(),
+            (MonotonicTime::now() - mimalloc_end_time).to_microseconds());
+    }
+
+#if defined(__GLIBC__)
+    // Skia and the GPU driver allocate through the C library. glibc's trim walks every arena, which can take a while on a
+    // large heap, so it runs beside the main thread, which may have frames to paint and input to route.
+    if (m_heap_trim_thread) {
+        if (!m_heap_trim_thread->has_exited())
+            return;
+        (void)m_heap_trim_thread->join();
+    }
+    m_heap_trim_thread = Threading::Thread::construct("HeapTrim"sv, [logged] {
+        auto start_time = MonotonicTime::now();
+        malloc_trim(0);
+        if (logged)
+            dbgln("COMPOSITOR-IDLE-RELEASE malloc_trim_us={}", (MonotonicTime::now() - start_time).to_microseconds());
+        return static_cast<intptr_t>(0);
+    });
+    m_heap_trim_thread->start();
+#endif
+}
