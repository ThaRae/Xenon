diff --git a/Libraries/LibWeb/Platform/RemoteImageCodecPlugin.cpp b/Libraries/LibWeb/Platform/RemoteImageCodecPlugin.cpp
index 33c261b5c9cf2c2885f347587f23db5540ef186c..53daee2b0463b5fed678d9ee65c76c0cfcd661e5 100644
--- a/Libraries/LibWeb/Platform/RemoteImageCodecPlugin.cpp
