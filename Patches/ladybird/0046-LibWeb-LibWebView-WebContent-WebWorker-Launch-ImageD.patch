+    // A process that installs this without a client uses this to get one when an image needs decoding. It must
+    // install a client before it returns, or the image fails to decode.
+    void set_client_needed_handler(Function<void()> handler);
+
     void set_client(NonnullRefPtr<ImageDecoderClient::Client>);
 
 private:
     void setup_client_callbacks();
+    void finished_decode();
+    void maybe_start_idle_timer();
 
     RefPtr<ImageDecoderClient::Client> m_client;
+    Function<void()> m_client_needed_handler;
+    RefPtr<Core::Timer> m_idle_timer;
+    size_t m_pending_decodes { 0 };
+
+    // Each decoder numbers its animation sessions from 1, so the session IDs handed out here are this plugin's own,
+    // mapped to the decoder's. That way the sessions of a decoder that died can be forgotten without their IDs ever
+    // naming a new decoder's sessions.
+    HashMap<i64, i64> m_decoder_session_ids;
+    HashMap<i64, i64> m_session_ids_by_decoder_session_id;
+    i64 m_next_session_id { 1 };
 };
 
 }
