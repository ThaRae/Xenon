@@ -11,12 +11,24 @@
 
 namespace Web::Platform {
 
+// A decoder is a process of its own with an IPC connection. An image's frames are all decoded within a moment of the
+// page asking for it, so a decoder that has had nothing to do for this long is closed, and the next image starts a new
+// one, which costs that image the decoder's startup.
+static constexpr auto IDLE_TIMEOUT = AK::Duration::from_seconds(15);
+
+RemoteImageCodecPlugin::RemoteImageCodecPlugin() = default;
+
 RemoteImageCodecPlugin::RemoteImageCodecPlugin(NonnullRefPtr<ImageDecoderClient::Client> client)
     : m_client(move(client))
 {
     setup_client_callbacks();
 }
 
+void RemoteImageCodecPlugin::set_client_needed_handler(Function<void()> handler)
+{
+    m_client_needed_handler = move(handler);
+}
+
 void RemoteImageCodecPlugin::set_client(NonnullRefPtr<ImageDecoderClient::Client> client)
 {
     m_client = move(client);
@@ -27,14 +39,19 @@ void RemoteImageCodecPlugin::setup_client_callbacks()
 {
     m_client->on_death = [this] {
         m_client = nullptr;
+        // The sessions were the dead decoder's, so no decoder can send their frames.
+        m_decoder_session_ids.clear();
+        m_session_ids_by_decoder_session_id.clear();
     };
-    m_client->on_animation_frames_decoded = [this](i64 session_id, Vector<NonnullRefPtr<Gfx::Bitmap>> bitmaps) {
-        if (on_animation_frames_decoded)
-            on_animation_frames_decoded(session_id, move(bitmaps));
+    m_client->on_animation_frames_decoded = [this](i64 decoder_session_id, Vector<NonnullRefPtr<Gfx::Bitmap>> bitmaps) {
+        auto session_id = m_session_ids_by_decoder_session_id.get(decoder_session_id);
+        if (session_id.has_value() && on_animation_frames_decoded)
+            on_animation_frames_decoded(*session_id, move(bitmaps));
     };
-    m_client->on_animation_decode_failed = [this](i64 session_id, String) {
-        if (on_animation_decode_failed)
-            on_animation_decode_failed(session_id);
+    m_client->on_animation_decode_failed = [this](i64 decoder_session_id, String) {
+        auto session_id = m_session_ids_by_decoder_session_id.get(decoder_session_id);
+        if (session_id.has_value() && on_animation_decode_failed)
+            on_animation_decode_failed(*session_id);
     };
 }
 
@@ -48,29 +65,42 @@ NonnullRefPtr<Core::Promise<DecodedImage>> RemoteImageCodecPlugin::decode_image(
     if (on_rejected)
         promise->on_rejection = move(on_rejected);
 
+    if (!m_client && m_client_needed_handler)
+        m_client_needed_handler();
+
     if (!m_client) {
         promise->reject(Error::from_string_literal("ImageDecoderClient is disconnected"));
         return promise;
     }
 
+    if (m_idle_timer)
+        m_idle_timer->stop();
+    ++m_pending_decodes;
+
     auto image_decoder_promise = m_client->decode_image(
         bytes,
-        [promise](ImageDecoderClient::DecodedImage& result) -> ErrorOr<void> {
+        [this, promise](ImageDecoderClient::DecodedImage& result) -> ErrorOr<void> {
             // FIXME: Remove this codec plugin and just use the ImageDecoderClient directly to avoid these copies
             DecodedImage decoded_image;
             decoded_image.is_animated = result.is_animated;
             decoded_image.loop_count = result.loop_count;
             decoded_image.frame_count = result.frame_count;
-            decoded_image.session_id = result.session_id;
+            if (result.session_id != 0) {
+                decoded_image.session_id = m_next_session_id++;
+                m_decoder_session_ids.set(decoded_image.session_id, result.session_id);
+                m_session_ids_by_decoder_session_id.set(result.session_id, decoded_image.session_id);
+            }
             decoded_image.all_durations = move(result.all_durations);
             for (auto& frame : result.frames) {
                 decoded_image.frames.empend(move(frame.bitmap), frame.duration);
             }
             decoded_image.color_space = move(result.color_space);
+            finished_decode();
             promise->resolve(move(decoded_image));
             return {};
         },
-        [promise](auto& error) {
+        [this, promise](auto& error) {
+            finished_decode();
             promise->reject(Error::copy(error));
         });
 
@@ -79,14 +109,47 @@ NonnullRefPtr<Core::Promise<DecodedImage>> RemoteImageCodecPlugin::decode_image(
 
 void RemoteImageCodecPlugin::request_animation_frames(i64 session_id, u32 start_frame_index, u32 count)
 {
-    if (m_client)
-        m_client->request_animation_frames(session_id, start_frame_index, count);
+    auto decoder_session_id = m_decoder_session_ids.get(session_id);
+    if (!m_client || !decoder_session_id.has_value())
+        return;
+    m_client->request_animation_frames(*decoder_session_id, start_frame_index, count);
 }
 
 void RemoteImageCodecPlugin::stop_animation_decode(i64 session_id)
 {
-    if (m_client)
-        m_client->stop_animation_decode(session_id);
+    if (auto decoder_session_id = m_decoder_session_ids.take(session_id); decoder_session_id.has_value()) {
+        m_session_ids_by_decoder_session_id.remove(*decoder_session_id);
+        if (m_client)
+            m_client->stop_animation_decode(*decoder_session_id);
+    }
+    maybe_start_idle_timer();
+}
+
+void RemoteImageCodecPlugin::finished_decode()
+{
+    VERIFY(m_pending_decodes > 0);
+    --m_pending_decodes;
+    maybe_start_idle_timer();
+}
+
+void RemoteImageCodecPlugin::maybe_start_idle_timer()
+{
+    // Without a way to get a new decoder, a client that is dropped can never be replaced, so the eager embedders
+    // (Android) keep theirs for the life of the process.
+    if (!m_client_needed_handler || !m_client || m_pending_decodes > 0 || !m_decoder_session_ids.is_empty())
+        return;
+
+    if (!m_idle_timer) {
+        m_idle_timer = Core::Timer::create_single_shot(IDLE_TIMEOUT, [this] {
+            if (!m_client || m_pending_decodes > 0 || !m_decoder_session_ids.is_empty())
+                return;
+            // Dropping the client closes the decoder's transport, and it exits once it has no client. The next image
+            // asks the Browser for a new one. Should the old client still be told of its death, it's no longer ours.
+            m_client->on_death = nullptr;
+            m_client = nullptr;
+        });
+    }
+    m_idle_timer->restart();
 }
 
 }
