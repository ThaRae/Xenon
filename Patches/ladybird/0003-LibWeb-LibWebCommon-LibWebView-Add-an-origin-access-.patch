+void Application::set_origin_access_allow_list(Vector<Web::Fetch::Infrastructure::OriginAccessAllowListEntry> allow_list)
+{
+    m_origin_access_allow_list = move(allow_list);
+
+    WebContentClient::for_each_client([&](auto& client) {
+        client.async_set_origin_access_allow_list(m_origin_access_allow_list);
+        return IterationDecision::Continue;
+    });
+    WorkerProcessManager::the().update_origin_access_allow_list(m_origin_access_allow_list);
