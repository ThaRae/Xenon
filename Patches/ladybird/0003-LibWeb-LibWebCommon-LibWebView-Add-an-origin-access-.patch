index 0000000000000000000000000000000000000000..689fc089f622be6509f3a67e8a99554f466ee5fc
--- /dev/null
+++ b/Libraries/LibWebCommon/Fetch/Infrastructure/OriginAccessAllowList.cpp
@@ -0,0 +1,48 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/MutexProtected.h>
+#include <AK/NeverDestroyed.h>
+#include <LibURL/URL.h>
+#include <LibWebCommon/Fetch/Infrastructure/OriginAccessAllowList.h>
+
+namespace Web::Fetch::Infrastructure {
+
+static MutexProtected<Vector<OriginAccessAllowListEntry>>& origin_access_allow_list()
+{
+    static NeverDestroyed<MutexProtected<Vector<OriginAccessAllowListEntry>>> allow_list;
+    return *allow_list;
+}
+
+bool OriginAccessAllowListEntry::allows(URL::Origin const& source_origin, URL::URL const& destination) const
+{
+    if (source_origin.is_opaque() || !this->source_origin.is_same_origin(source_origin))
+        return false;
+    if (destination.scheme() != destination_scheme || !destination.host().has_value())
+        return false;
+    if (destination_host.is_empty())
+        return true;
+
+    auto host = destination.serialized_host();
+    if (host == destination_host)
+        return true;
+    return allow_destination_subdomains && host.length() > destination_host.bytes().size()
+        && host.ends_with(destination_host) && host[host.length() - destination_host.bytes().size() - 1] == '.';
+}
+
+void set_origin_access_allow_list(Vector<OriginAccessAllowListEntry> allow_list)
+{
+    origin_access_allow_list().with_locked([&](auto& list) { list = move(allow_list); });
+}
+
+bool is_allowed_by_origin_access_allow_list(URL::Origin const& source_origin, URL::URL const& destination)
+{
+    return origin_access_allow_list().with_locked([&](auto const& list) {
+        return any_of(list, [&](auto const& entry) { return entry.allows(source_origin, destination); });
+    });
+}
+
+}
diff --git a/Libraries/LibWebCommon/Fetch/Infrastructure/OriginAccessAllowList.h b/Libraries/LibWebCommon/Fetch/Infrastructure/OriginAccessAllowList.h
new file mode 100644
index 0000000000000000000000000000000000000000..55b69d034aec1efac337f6ca034c5192df1f2a91
--- /dev/null
+++ b/Libraries/LibWebCommon/Fetch/Infrastructure/OriginAccessAllowList.h
@@ -0,0 +1,35 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/String.h>
+#include <AK/Vector.h>
+#include <LibURL/Origin.h>
+#include <LibWebCommon/Export.h>
+
+namespace Web::Fetch::Infrastructure {
+
+// The embedder may let an origin fetch from some others as if they were the same origin: with no CORS, and with the
+// credentials of a same-origin request. Blink and WebKit keep such allowlists for browser extensions, which reach the
+// hosts their users granted them this way. A destination is a scheme and a host, on any port; an empty host is any
+// host.
+struct WEBCOMMON_API OriginAccessAllowListEntry {
+    URL::Origin source_origin;
+    String destination_scheme;
+    String destination_host;
+    bool allow_destination_subdomains { false };
+
+    bool allows(URL::Origin const& source_origin, URL::URL const& destination) const;
+};
+
+// Each process keeps the allowlist the embedder last gave it.
+WEBCOMMON_API void set_origin_access_allow_list(Vector<OriginAccessAllowListEntry>);
+WEBCOMMON_API bool is_allowed_by_origin_access_allow_list(URL::Origin const& source_origin, URL::URL const& destination);
+
+}
+
+#include <LibWebCommon/Fetch/Infrastructure/OriginAccessAllowListCodecs.h>
