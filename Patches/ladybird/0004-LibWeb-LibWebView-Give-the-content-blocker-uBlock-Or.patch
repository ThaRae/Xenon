+/// The script to run in a document at `url` before its own scripts: the page's scriptlets, and the runtime for its
+/// procedural and action cosmetic filters. Empty when there are none.
+fn page_script_for_url(engine: &ContentBlockerEngine, url: &str) -> String {
+    let resources = engine.engine.url_cosmetic_resources(url);
+    let mut script = String::new();
+
+    if !resources.injected_script.is_empty() {
+        // uBlock Origin's scriptlets share state through `scriptletGlobals` and must not leak names into the page.
+        script.push_str("(function() {\nconst scriptletGlobals = {};\n");
+        script.push_str(&resources.injected_script);
+        script.push_str("\n})();\n");
+    }
+
+    // Filters that plain CSS expresses are in the cosmetic style sheet already (see cosmetic_css_for_url).
+    let mut procedural_filters: Vec<&String> = resources
+        .procedural_actions
+        .iter()
+        .filter(|action| {
+            serde_json::from_str::<adblock::cosmetic_filter_cache::ProceduralOrActionFilter>(action)
+                .is_ok_and(|filter| filter.as_css().is_none())
+        })
+        .collect();
+    if !procedural_filters.is_empty() {
+        procedural_filters.sort_unstable();
+        script.push_str(PROCEDURAL_FILTERING_SCRIPT);
+        script.push_str("([");
+        for (index, filter) in procedural_filters.iter().enumerate() {
+            if index != 0 {
+                script.push(',');
+            }
+            script.push_str(filter);
+        }
+        script.push_str("]);\n");
+    }
+
+    script
+}
+
+/// C++ frees the returned string with `rust_content_blocker_free_string`.
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_content_blocker_page_script(
+    engine: Option<&ContentBlockerEngine>,
+    url: ak::Span<'_, u8>,
+) -> ContentBlockerString {
+    abort_on_panic(|| {
+        let (Some(engine), Some(url)) = (engine, as_str(url)) else {
+            return string_to_ffi(String::new());
+        };
+        string_to_ffi(page_script_for_url(engine, url))
+    })
+}
