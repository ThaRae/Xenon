+    switch (result.action) {
+    case ContentBlocking::FFI::ContentBlockerAction::Allow:
+        return {};
+    case ContentBlocking::FFI::ContentBlockerAction::Block:
+        return { RequestDecision::Action::Block, {} };
+    case ContentBlocking::FFI::ContentBlockerAction::Redirect:
+        if (auto surrogate = result_url(); surrogate.has_value())
