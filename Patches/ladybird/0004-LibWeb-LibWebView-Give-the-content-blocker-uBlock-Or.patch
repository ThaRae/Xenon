+static ErrorOr<Core::AnonymousBuffer> read_files_into_buffer(ReadonlySpan<ByteString> paths, size_t maximum_size)
+{
+    Checked<size_t> total_size = 0;
+    for (auto const& path : paths) {
+        auto file = TRY(Core::File::open(path, Core::File::OpenMode::Read));
+        total_size += TRY(file->size());
+        total_size += 1;
+    }
+    if (total_size.has_overflow() || total_size.value() > maximum_size)
+        return Error::from_string_literal("Content blocker files are too large");
+
+    auto buffer = TRY(Core::AnonymousBuffer::create_with_size(total_size.value()));
+    auto bytes = Bytes { buffer.data<u8>(), buffer.size() };
+    size_t offset = 0;
+    for (auto const& path : paths) {
+        auto file = TRY(Core::File::open(path, Core::File::OpenMode::Read));
+        auto file_size = TRY(file->size());
+        TRY(file->read_until_filled(bytes.slice(offset, file_size)));
+        offset += file_size;
+        bytes[offset++] = '\n';
+    }
+    VERIFY(offset == bytes.size());
+    return buffer;
+}
+
+static bool replace_buffer_if_changed(Optional<Core::AnonymousBuffer>& current, Core::AnonymousBuffer replacement)
+{
+    if (current.has_value() && current->bytes() == replacement.bytes())
+        return false;
+    current = move(replacement);
+    return true;
+}
+
+ErrorOr<bool> Application::load_trusted_content_blocker_lists_and_resources()
+{
+    auto trusted_lists = TRY(read_files_into_buffer(m_trusted_content_blocker_list_paths, maximum_combined_content_blocker_list_size));
+    auto changed = replace_buffer_if_changed(m_trusted_content_blocker_list_buffer, move(trusted_lists));
+
+    ReadonlySpan<ByteString> resources_paths;
+    if (m_content_blocker_resources_path.has_value())
+        resources_paths = { &m_content_blocker_resources_path.value(), 1 };
+    auto resources = TRY(read_files_into_buffer(resources_paths, maximum_content_blocker_list_size));
+    changed |= replace_buffer_if_changed(m_content_blocker_resources_buffer, move(resources));
+    return changed;
+}
+
+void Application::send_content_blockers(WebContentClient& client) const
+{
+    if (!m_content_blocker_list_buffer.has_value() || !m_trusted_content_blocker_list_buffer.has_value() || !m_content_blocker_resources_buffer.has_value())
+        return;
+    client.async_set_content_blockers(*m_content_blocker_list_buffer, *m_trusted_content_blocker_list_buffer, *m_content_blocker_resources_buffer);
+}
