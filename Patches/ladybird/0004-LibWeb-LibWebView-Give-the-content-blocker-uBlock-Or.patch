+/// Whether a request that DNS showed to be an alias (CNAME) of `canonical_hostname` must be blocked, following
+/// uBlock Origin's defaults: requests that matched any filter before are left alone, as are aliases within the same
+/// site and requests to the page's own host, and `$cname` exceptions apply.
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_content_blocker_matches_uncloaked(
+    engine: Option<&ContentBlockerEngine>,
+    url: ak::Span<'_, u8>,
+    canonical_hostname: ak::Span<'_, u8>,
+    source_url: ak::Span<'_, u8>,
+    request_type: ak::Span<'_, u8>,
+) -> bool {
+    abort_on_panic(|| {
+        let Some(engine) = engine else {
+            return false;
+        };
+        let (Some(url), Some(canonical_hostname), Some(source_url), Some(request_type)) = (
+            as_str(url),
+            as_str(canonical_hostname),
+            as_str(source_url),
+            as_str(request_type),
+        ) else {
+            return false;
+        };
+        let canonical_hostname = canonical_hostname.trim_end_matches('.').to_ascii_lowercase();
+        let Some(parsed_url) = adblock::url_parser::parse_url(url) else {
+            return false;
+        };
+        let hostname = parsed_url.hostname();
+        if canonical_hostname.is_empty() || canonical_hostname == hostname {
+            return false;
+        }
+        let Some(parsed_canonical) = adblock::url_parser::parse_url(&format!("https://{canonical_hostname}/")) else {
+            return false;
+        };
+        if parsed_canonical.domain() == parsed_url.domain() {
+            return false;
+        }
+        if adblock::url_parser::parse_url(source_url).is_some_and(|source| source.hostname() == hostname) {
+            return false;
+        }
+
+        let Ok(original) = adblock::request::Request::new(url, source_url, request_type, "") else {
+            return false;
+        };
+        let original_result = engine.engine.check_network_request(&original);
+        if original_result.filter.is_some() || original_result.exception.is_some() {
+            return false;
+        }
+
+        let Some(uncloaked) = uncloaked_url(url, hostname, &canonical_hostname) else {
+            return false;
+        };
+        let Ok(request) = adblock::request::Request::new(&uncloaked, source_url, request_type, "") else {
+            return false;
+        };
+        if !engine.engine.check_network_request(&request).should_block() {
+            return false;
+        }
+        if let Some(cname_exception_engine) = &engine.cname_exception_engine
+            && (cname_exception_engine.check_network_request(&request).filter.is_some()
+                || cname_exception_engine.check_network_request(&original).filter.is_some())
+        {
+            return false;
+        }
+        true
+    })
+}
