+        m_engine,
+        url_string.bytes(),
+        source_url_string.bytes(),
+        request_type.bytes(),
+        method.bytes());
+
+    ArmedScopeGuard free_url = [&] {
+        ContentBlocking::FFI::rust_content_blocker_free_string(result.url.data, result.url.length);
+    };
+    auto result_url = [&]() -> Optional<URL::URL> {
+        if (!result.url.data)
+            return {};
+        return URL::Parser::basic_parse(StringView { reinterpret_cast<char const*>(result.url.data), result.url.length });
+    };
