+/// What to do with a request.
+#[repr(u8)]
+pub enum ContentBlockerAction {
+    Allow = 0,
+    Block = 1,
+    /// Answer the request with `url`, a data: URL holding a surrogate resource (a `$redirect` filter).
+    Redirect = 2,
+    /// Send the request to `url` instead, which has tracking parameters removed (a `$removeparam` filter).
+    Rewrite = 3,
+}
+
+#[repr(C)]
+pub struct ContentBlockerRequestResult {
+    action: ContentBlockerAction,
+    url: ContentBlockerString,
+}
+
 pub struct ContentBlockerEngine {
     engine: adblock::engine::Engine,
     generic_selector_list_rules: GenericSelectorListRules,
+    /// Filters with `$popup`, without that option: they decide whether a page may open a new window to a URL.
+    popup_engine: Option<adblock::engine::Engine>,
+    /// Exception filters with `$cname`, as blocking filters: a match means a request must not be uncloaked.
+    cname_exception_engine: Option<adblock::engine::Engine>,
+}
+
+/// The permission bit of the scriptlets that uBlock Origin only lets trusted lists use (`requiresTrust`), as the
+/// resources built from uBlock Origin's source mark them.
+const TRUSTED_LIST_PERMISSION: u8 = 0x01;
+
+/// Applies procedural and action cosmetic filters in the page (see `page_script_for_url`).
+const PROCEDURAL_FILTERING_SCRIPT: &str = include_str!("procedural.js");
+
+/// The filter lines that need their own engine, split out of a list.
+#[derive(Default)]
+struct SplitRules {
+    rules: String,
+    popup_rules: String,
+    cname_exception_rules: String,
+}
+
+/// The option part of a network filter, as the engine finds it (after the last `$`), or none for cosmetic filters.
+fn network_filter_options(line: &str) -> Option<(&str, &str)> {
+    if line.starts_with('!') || ["##", "#@#", "#?#", "#$#", "#%#"].iter().any(|marker| line.contains(marker)) {
+        return None;
+    }
+    let dollar = line.rfind('$')?;
+    Some((&line[..dollar], &line[dollar + 1..]))
+}
+
+impl SplitRules {
+    /// Moves `$popup` filters and `$cname` exceptions out of `text`. The engine does not know either option.
+    fn from_text(text: &str) -> Self {
+        let mut split = Self::default();
+        for line in text.lines() {
+            let trimmed = line.trim();
+            let Some((pattern, options)) = network_filter_options(trimmed) else {
+                split.rules.push_str(line);
+                split.rules.push('\n');
+                continue;
+            };
+            let options: Vec<&str> = options.split(',').collect();
+            let is_popup = options.iter().any(|option| *option == "popup");
+            let is_cname = options.iter().any(|option| *option == "cname");
+            if !is_popup && !is_cname {
+                split.rules.push_str(line);
+                split.rules.push('\n');
+                continue;
+            }
+
+            let remaining: Vec<&str> = options
+                .iter()
+                .copied()
+                .filter(|option| *option != "popup" && *option != "cname")
+                .collect();
+            let rebuilt = |pattern: &str| {
+                if remaining.is_empty() {
+                    pattern.to_string()
+                } else {
+                    format!("{pattern}${}", remaining.join(","))
+                }
+            };
+
+            if is_popup {
+                split.popup_rules.push_str(&rebuilt(pattern));
+                split.popup_rules.push('\n');
+            } else if let Some(exception_pattern) = pattern.strip_prefix("@@") {
+                // A `$cname` exception keeps a request from being uncloaked. Store it as a blocking filter, so a
+                // match is a plain "matched".
+                split.cname_exception_rules.push_str(&rebuilt(exception_pattern));
+                split.cname_exception_rules.push('\n');
+            }
+        }
+        split
+    }
+}
+
+/// An engine for the given lists, or none when both are empty.
+fn engine_from_lists(untrusted: &str, trusted: &str) -> Option<adblock::engine::Engine> {
+    if untrusted.trim().is_empty() && trusted.trim().is_empty() {
+        return None;
+    }
+    Some(main_engine_from_lists(untrusted, trusted))
+}
+
+fn main_engine_from_lists(untrusted: &str, trusted: &str) -> adblock::engine::Engine {
+    let mut filter_set = adblock::lists::FilterSet::new(false);
+    filter_set.add_filter_list(untrusted.to_string(), adblock::lists::ParseOptions::default());
+    if !trusted.is_empty() {
+        let options = adblock::lists::ParseOptions {
+            permissions: adblock::resources::PermissionMask::from_bits(TRUSTED_LIST_PERMISSION),
+            ..Default::default()
+        };
+        filter_set.add_filter_list(trusted.to_string(), options);
+    }
+    adblock::engine::Engine::new_with_filter_set(filter_set)
 }
 
