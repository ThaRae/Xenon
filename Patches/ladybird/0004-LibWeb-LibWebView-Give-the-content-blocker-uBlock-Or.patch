+    auto url_string = serialized_url_for_matching(url);
+    auto opener_url_string = serialized_url_for_matching(source_url_for_matching(opener_url));
+    return ContentBlocking::FFI::rust_content_blocker_matches_popup(m_engine, url_string.bytes(), opener_url_string.bytes());
