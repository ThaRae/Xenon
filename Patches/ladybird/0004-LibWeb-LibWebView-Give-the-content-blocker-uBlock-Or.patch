+fn request_result(action: ContentBlockerAction, url: String) -> ContentBlockerRequestResult {
+    ContentBlockerRequestResult {
+        action,
+        url: string_to_ffi(url),
+    }
+}
+
+/// Decides what happens to a request: allowed, blocked, answered with a surrogate (`$redirect`), or sent to a URL
+/// with tracking parameters removed (`$removeparam`). C++ frees `url` with `rust_content_blocker_free_string`.
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_content_blocker_check_request(
+    engine: Option<&ContentBlockerEngine>,
+    url: ak::Span<'_, u8>,
+    source_url: ak::Span<'_, u8>,
+    request_type: ak::Span<'_, u8>,
+    method: ak::Span<'_, u8>,
+) -> ContentBlockerRequestResult {
+    abort_on_panic(|| {
+        let allow = || request_result(ContentBlockerAction::Allow, String::new());
+        let Some(engine) = engine else {
+            return allow();
+        };
+        let (Some(url), Some(source_url), Some(request_type), Some(method)) =
+            (as_str(url), as_str(source_url), as_str(request_type), as_str(method))
+        else {
+            return allow();
+        };
+        let Ok(request) = adblock::request::Request::new(url, source_url, request_type, method) else {
+            return allow();
+        };
+
+        let result = engine.engine.check_network_request(&request);
+        if result.should_block() {
+            // A redirect only applies to a blocked request: `$redirect-rule` alone never blocks.
+            return match result.redirect {
+                Some(data_url) => request_result(ContentBlockerAction::Redirect, data_url),
+                None => request_result(ContentBlockerAction::Block, String::new()),
+            };
+        }
+        match result.rewritten_url {
+            Some(rewritten_url) if rewritten_url != url => request_result(ContentBlockerAction::Rewrite, rewritten_url),
+            _ => allow(),
+        }
+    })
+}
+
+/// Whether a page at `opener_url` may not open a new window or tab at `url` (a `$popup` filter matches).
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_content_blocker_matches_popup(
+    engine: Option<&ContentBlockerEngine>,
+    url: ak::Span<'_, u8>,
+    opener_url: ak::Span<'_, u8>,
+) -> bool {
+    abort_on_panic(|| {
+        let Some(popup_engine) = engine.and_then(|engine| engine.popup_engine.as_ref()) else {
+            return false;
+        };
+        let (Some(url), Some(opener_url)) = (as_str(url), as_str(opener_url)) else {
+            return false;
+        };
+        // `$popup` filters have no other request type once the option is removed, so they match "other".
+        let Ok(request) = adblock::request::Request::new(url, opener_url, "other", "") else {
+            return false;
+        };
+        popup_engine.check_network_request(&request).should_block()
+    })
+}
+
+/// `url` with its hostname replaced by `canonical_hostname`, cut after the first `/` of the path, as uBlock Origin
+/// replays an uncloaked request (cnameReplayFullURL is off by default).
+fn uncloaked_url(url: &str, hostname: &str, canonical_hostname: &str) -> Option<String> {
+    let hostname_start = url.find(hostname)?;
+    let hostname_end = hostname_start + hostname.len();
+    let mut uncloaked = String::with_capacity(url.len());
+    uncloaked.push_str(&url[..hostname_start]);
+    uncloaked.push_str(canonical_hostname);
+    match url[hostname_end..].find('/') {
