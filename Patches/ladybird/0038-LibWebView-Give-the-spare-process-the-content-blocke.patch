From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Wed, 28 Oct 2026 23:41:45 +0000
Subject: [PATCH] LibWebView: Give the spare process the content blocker when
 it's taken

The spare WebContent process was building the content blocker's engine
as soon as it launched, tens of MiB for a process that has no page.
Leave it without the rules until a tab takes it, and send them then.
---
 Libraries/LibWebView/Application.cpp    | 13 ++++++++-----
 Libraries/LibWebView/Application.h      |  2 +-
 Libraries/LibWebView/Options.h          |  7 +++++++
 Libraries/LibWebView/WebContentClient.h |  4 ++++
 4 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/Libraries/LibWebView/Application.cpp b/Libraries/LibWebView/Application.cpp
index 8361298637f4a4ac7b530d2a5f171f06c5579a98..71990a8b11c60a56ccb890bf675df805d067b368 100644
--- a/Libraries/LibWebView/Application.cpp
+++ b/Libraries/LibWebView/Application.cpp
@@ -976,8 +976,8 @@ void Application::send_content_blockers(WebContentClient& client) const
     if (!m_content_blocker_list_buffer.has_value() || !m_trusted_content_blocker_list_buffer.has_value() || !m_content_blocker_resources_buffer.has_value())
         return;
     // Each process builds an engine from the rules, which can take tens of MiB, so while blocking is off it gets none,
-    // and neither does a process for a view without the content blocker.
-    if (!content_blocking_enabled() || client.enable_content_blocker() == EnableContentBlocker::No) {
+    // and neither does a process for a view without the content blocker, or the spare process until a tab takes it.
+    if (!content_blocking_enabled() || client.enable_content_blocker() == EnableContentBlocker::No || client.content_blocker_rules_deferred()) {
         client.async_set_content_blockers(Core::AnonymousBuffer {}, Core::AnonymousBuffer {}, Core::AnonymousBuffer {});
         return;
     }
@@ -1262,7 +1262,7 @@ void Application::open_urls_in_new_tabs(ReadonlySpan<URL::URL> urls) const
         open_url_in_new_tab(url, Web::HTML::ActivateTab::No);
 }
 
-ErrorOr<NonnullRefPtr<WebContentClient>> Application::create_web_content_client(BrowsingSession& session, Web::PageId initial_page_id, Optional<Web::HTML::CrossProcessId> navigable_to_adopt, Optional<Web::HTML::CrossProcessId> initial_document_state_id, Vector<Web::HTML::RemoteNavigableDescriptor> remote_navigables, Optional<Web::HTML::SessionHistoryEntryDescriptor> canonical_initial_history_entry, Web::HTML::VisibilityState system_visibility_state, EnableContentBlocker enable_content_blocker)
+ErrorOr<NonnullRefPtr<WebContentClient>> Application::create_web_content_client(BrowsingSession& session, Web::PageId initial_page_id, Optional<Web::HTML::CrossProcessId> navigable_to_adopt, Optional<Web::HTML::CrossProcessId> initial_document_state_id, Vector<Web::HTML::RemoteNavigableDescriptor> remote_navigables, Optional<Web::HTML::SessionHistoryEntryDescriptor> canonical_initial_history_entry, Web::HTML::VisibilityState system_visibility_state, EnableContentBlocker enable_content_blocker, DeferContentBlockerRules defer_content_blocker_rules)
 {
     auto cross_process_id_allocator = allocate_cross_process_id_allocator();
     auto root_navigable_id = navigable_to_adopt.has_value() ? *navigable_to_adopt : cross_process_id_allocator.allocate();
@@ -1307,6 +1307,7 @@ ErrorOr<NonnullRefPtr<WebContentClient>> Application::create_web_content_client(
         webdriver_bidi->push_session_state_for_client(*client);
 
     client->set_enable_content_blocker(enable_content_blocker);
+    client->set_content_blocker_rules_deferred(defer_content_blocker_rules == DeferContentBlockerRules::Yes);
     send_content_blockers(*client);
 
     m_web_content_clients.set(client);
@@ -1873,13 +1874,15 @@ ErrorOr<NonnullRefPtr<WebContentPage>> Application::open_page_for_new_tab(IsPriv
         m_spare_web_content_process = nullptr;
 
     RefPtr<WebContentClient> web_content_client;
-    // NB: The spare process has built the content blocker's engine already.
+    // NB: The spare process is launched without the content blocker's engine, and is given it here when a tab takes it.
     if (enable_content_blocker == EnableContentBlocker::No) {
         web_content_client = TRY(create_web_content_client(session_for_new_view(is_private), allocate_page_id(), {}, {}, {}, {}, Web::HTML::VisibilityState::Hidden, EnableContentBlocker::No));
     } else if (is_private == IsPrivate::Yes) {
         web_content_client = TRY(create_web_content_client(session_for_new_view(IsPrivate::Yes), allocate_page_id()));
     } else if (m_spare_web_content_process) {
         web_content_client = m_spare_web_content_process.release_nonnull();
+        web_content_client->set_content_blocker_rules_deferred(false);
+        send_content_blockers(*web_content_client);
         launch_spare_web_content_process();
     } else {
         launch_spare_web_content_process();
@@ -1925,7 +1928,7 @@ void Application::launch_spare_web_content_process()
     Core::deferred_invoke([this]() {
         m_has_queued_task_to_launch_spare_web_content_process = false;
 
-        auto web_content_client = create_web_content_client(default_session(), allocate_page_id());
+        auto web_content_client = create_web_content_client(default_session(), allocate_page_id(), {}, {}, {}, {}, Web::HTML::VisibilityState::Hidden, EnableContentBlocker::Yes, DeferContentBlockerRules::Yes);
         if (web_content_client.is_error()) {
             dbgln("Unable to create spare web content client: {}", web_content_client.error());
             return;
diff --git a/Libraries/LibWebView/Application.h b/Libraries/LibWebView/Application.h
index 223e468500af158f438e6d33e73d2f7f0527de67..570662424d21183ad31e59ac27fd76753abb88b0 100644
--- a/Libraries/LibWebView/Application.h
+++ b/Libraries/LibWebView/Application.h
@@ -489,7 +489,7 @@ private:
     ErrorOr<void> create_profile(Optional<StringView> profile_name, Optional<StringView> profile_path, bool temporary_profile);
     void create_mach_port_server(ByteString const& profile_identity);
     void update_website_color_scheme();
-    ErrorOr<NonnullRefPtr<WebContentClient>> create_web_content_client(BrowsingSession&, Web::PageId initial_page_id, Optional<Web::HTML::CrossProcessId> navigable_to_adopt = {}, Optional<Web::HTML::CrossProcessId> initial_document_state_id = {}, Vector<Web::HTML::RemoteNavigableDescriptor> remote_navigables = {}, Optional<Web::HTML::SessionHistoryEntryDescriptor> canonical_initial_history_entry = {}, Web::HTML::VisibilityState system_visibility_state = Web::HTML::VisibilityState::Hidden, EnableContentBlocker = EnableContentBlocker::Yes);
+    ErrorOr<NonnullRefPtr<WebContentClient>> create_web_content_client(BrowsingSession&, Web::PageId initial_page_id, Optional<Web::HTML::CrossProcessId> navigable_to_adopt = {}, Optional<Web::HTML::CrossProcessId> initial_document_state_id = {}, Vector<Web::HTML::RemoteNavigableDescriptor> remote_navigables = {}, Optional<Web::HTML::SessionHistoryEntryDescriptor> canonical_initial_history_entry = {}, Web::HTML::VisibilityState system_visibility_state = Web::HTML::VisibilityState::Hidden, EnableContentBlocker = EnableContentBlocker::Yes, DeferContentBlockerRules = DeferContentBlockerRules::No);
 
     ErrorOr<void> launch_services();
     void launch_spare_web_content_process();
diff --git a/Libraries/LibWebView/Options.h b/Libraries/LibWebView/Options.h
index 3d0c3eb9d23b96cab3b817beb61fa25c2fc0a4a5..d0f2aa5a90e07cca8370b5a38fd6b3fea0643c47 100644
--- a/Libraries/LibWebView/Options.h
+++ b/Libraries/LibWebView/Options.h
@@ -74,6 +74,13 @@ enum class EnableContentBlocker {
     Yes,
 };
 
+// The spare WebContent process is launched empty of the content blocker's rules, and given them when a tab takes it,
+// so it doesn't spend tens of MiB building the engine while it sits idle.
+enum class DeferContentBlockerRules {
+    No,
+    Yes,
+};
+
 enum class DisableSandbox {
     No,
     Yes,
diff --git a/Libraries/LibWebView/WebContentClient.h b/Libraries/LibWebView/WebContentClient.h
index ba7a8e99a85cec65804b23218f784079649890a7..00f3b6090b837895f417fa0bca01281f296b6296 100644
--- a/Libraries/LibWebView/WebContentClient.h
+++ b/Libraries/LibWebView/WebContentClient.h
@@ -164,6 +164,9 @@ public:
     // A process launched for a view that goes without the content blocker is never given its rules.
     EnableContentBlocker enable_content_blocker() const { return m_enable_content_blocker; }
     void set_enable_content_blocker(EnableContentBlocker enable_content_blocker) { m_enable_content_blocker = enable_content_blocker; }
+    // The spare process is given the rules only when a tab takes it (see Application::send_content_blockers()).
+    bool content_blocker_rules_deferred() const { return m_content_blocker_rules_deferred; }
+    void set_content_blocker_rules_deferred(bool deferred) { m_content_blocker_rules_deferred = deferred; }
     void register_embedded_page(Web::PageId page_id, CanonicalTraversable&);
     void unregister_embedded_page(Web::PageId page_id);
     Optional<Web::PageId> page_id_for_traversable(CanonicalTraversable const&) const;
@@ -295,6 +298,7 @@ private:
     bool m_hosted_tabs_are_origin_keyed { false };
     bool m_has_hosted_more_than_tabs_of_one_origin { false };
     EnableContentBlocker m_enable_content_blocker { EnableContentBlocker::Yes };
+    bool m_content_blocker_rules_deferred { false };
     Vector<u64> m_crashed_view_ids;
 
     WebContentPage& open_page(Web::PageId, CanonicalTraversable&);
