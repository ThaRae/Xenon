+void RequestServerManager::add_certificate_exception(BrowsingSession& session, URL::URL const& url, ByteBuffer certificate)
+{
+    ByteString host { url.serialized_host() };
+    auto port = url.port_or_default();
+
+    session.certificate_exceptions.remove_all_matching([&](auto const& exception) {
+        return exception.host == host && exception.port == port;
+    });
+    session.certificate_exceptions.append({ host, port, certificate });
+
+    for (auto& instance : m_instances) {
+        if (&instance->session() == &session)
+            (void)instance->control_client().send_sync_but_allow_failure<Messages::RequestServerControl::AddCertificateException>(host, port, certificate);
+    }
+}
