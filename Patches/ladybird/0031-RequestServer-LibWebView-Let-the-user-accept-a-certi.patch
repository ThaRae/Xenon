+bool Request::should_retry_without_certificate_exception(int curl_result_code) const
+{
+    return m_type == RequestType::Fetch && curl_result_code == CURLE_SSL_PINNEDPUBKEYNOTMATCH && m_uses_certificate_exception;
+}
+
+// curl only collects the server's certificates when asked to before it connects, which every connection would pay for.
+// So a request whose server's certificate fails verification is made once more, asking for them, to learn which
+// certificate the UI process may show the user. The handshake failed before the request was sent, so nothing is sent
+// twice.
+bool Request::should_retry_to_collect_server_certificate(int curl_result_code) const
+{
+    return m_type == RequestType::Fetch && curl_result_code == CURLE_PEER_FAILED_VERIFICATION && !m_collects_server_certificate;
+}
+
+void Request::retry_after_certificate_failure()
+{
+    MUST(free_curl_structs());
+    m_curl_result_code = {};
+    transition_to_state(State::Fetch);
+}
+
+void Request::report_rejected_server_certificate()
+{
+    curl_certinfo* certificate_info = nullptr;
+    if (curl_easy_getinfo(m_curl_easy_handle, CURLINFO_CERTINFO, &certificate_info) != CURLE_OK || !certificate_info)
+        return;
+
+    auto certificate = server_certificate_from_certinfo(*certificate_info);
+    if (!certificate.has_value())
+        return;
+
+    if (auto connection = ControlConnectionFromClient::the(); connection.has_value())
+        connection->async_server_certificate_rejected(m_url, *certificate);
+}
+
 void Request::transition_to_state(State state)
 {
     // Let clients stop waiting for a cache-only result before DNS or a stalled cache writer can delay the response.
@@ -1510,6 +1547,21 @@ void Request::handle_fetch_state()
     set_option(CURLOPT_SSL_CTX_DATA, m_aia_collector.ptr());
 #endif
 
+    // A certificate the user accepted for this host and port stands in for verifying the server's certificate. curl pins
+    // its public key, so the server must still present that key.
+    m_uses_certificate_exception = false;
+    if (m_url.scheme() == "https"sv && !m_certificate_exception_disabled) {
+        if (auto pin = certificate_exception_public_key_pin(m_url.serialized_host(), m_url.port_or_default()); pin.has_value()) {
+            set_option(CURLOPT_SSL_VERIFYPEER, 0L);
+            set_option(CURLOPT_SSL_VERIFYHOST, 0L);
+            set_option(CURLOPT_PINNEDPUBLICKEY, pin->characters());
+            m_uses_certificate_exception = true;
+        }
+    }
+
+    if (m_collects_server_certificate)
+        set_option(CURLOPT_CERTINFO, 1L);
+
     if (m_content_decoding_disabled) {
         set_option(CURLOPT_ACCEPT_ENCODING, "identity");
         set_option(CURLOPT_HTTP_CONTENT_DECODING, 0L);
@@ -1682,7 +1734,24 @@ void Request::handle_complete_state()
             return;
         }
 
+        if (should_retry_without_certificate_exception(*m_curl_result_code)) {
+            // The server no longer presents the certificate the user accepted. Its new one may well be valid, so it is
+            // verified as usual, and rejected and reported as any other if it isn't.
+            m_certificate_exception_disabled = true;
+            retry_after_certificate_failure();
+            return;
+        }
+
+        if (should_retry_to_collect_server_certificate(*m_curl_result_code)) {
+            m_collects_server_certificate = true;
+            retry_after_certificate_failure();
+            return;
+        }
+
         if (m_curl_result_code != CURLE_OK) {
+            if (m_curl_result_code == CURLE_PEER_FAILED_VERIFICATION && m_collects_server_certificate)
+                report_rejected_server_certificate();
+
             m_network_error = curl_code_to_network_error(*m_curl_result_code);
 
             if (m_network_error == Requests::NetworkError::Unknown) {
