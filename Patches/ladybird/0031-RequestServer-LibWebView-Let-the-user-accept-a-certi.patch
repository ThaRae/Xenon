diff --git a/Services/RequestServer/CertificateExceptions.cpp b/Services/RequestServer/CertificateExceptions.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c18e49e788a410d8890daeca99d5dcc17943c8a1
--- /dev/null
+++ b/Services/RequestServer/CertificateExceptions.cpp
@@ -0,0 +1,100 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/Base64.h>
+#include <AK/HashMap.h>
+#include <AK/ScopeGuard.h>
+#include <RequestServer/CURL.h>
+#include <RequestServer/CertificateExceptions.h>
+#include <openssl/evp.h>
+#include <openssl/pem.h>
+#include <openssl/x509.h>
+#include <string.h>
+
+namespace RequestServer {
+
+// The curl public key pins of the accepted certificates, by host and port.
+static HashMap<ByteString, ByteString>& public_key_pins()
+{
+    static HashMap<ByteString, ByteString> pins;
+    return pins;
+}
+
+static ByteString host_and_port(StringView host, u16 port)
+{
+    return ByteString::formatted("{}:{}", host, port);
+}
+
+void add_certificate_exception(StringView host, u16 port, ReadonlyBytes certificate)
+{
+    auto const* der = certificate.data();
+    auto* x509 = d2i_X509(nullptr, &der, static_cast<long>(certificate.size()));
+    if (!x509)
+        return;
+    ScopeGuard free_certificate = [&] { X509_free(x509); };
+
+    // curl pins a key by the SHA-256 digest of its DER-encoded SubjectPublicKeyInfo, in base64.
+    unsigned char* public_key = nullptr;
+    auto public_key_size = i2d_X509_PUBKEY(X509_get_X509_PUBKEY(x509), &public_key);
+    if (public_key_size <= 0)
+        return;
+    ScopeGuard free_public_key = [&] { OPENSSL_free(public_key); };
+
+    u8 digest[EVP_MAX_MD_SIZE];
+    unsigned int digest_size = 0;
+    if (EVP_Digest(public_key, static_cast<size_t>(public_key_size), digest, &digest_size, EVP_sha256(), nullptr) != 1)
+        return;
+
+    auto encoded_digest = encode_base64(ReadonlyBytes { digest, digest_size });
+    if (encoded_digest.is_error())
+        return;
+    public_key_pins().set(host_and_port(host, port), ByteString::formatted("sha256//{}", encoded_digest.value()));
+}
+
+Optional<ByteString> certificate_exception_public_key_pin(StringView host, u16 port)
+{
+    auto pin = public_key_pins().get(host_and_port(host, port));
+    if (!pin.has_value())
+        return {};
+    return *pin;
+}
+
+Optional<ByteBuffer> server_certificate_from_certinfo(curl_certinfo const& certificate_info)
+{
+    if (certificate_info.num_of_certs < 1 || !certificate_info.certinfo)
+        return {};
+
+    // The server's own certificate comes first, and curl gives its PEM encoding as the field named "Cert".
+    for (curl_slist const* field = certificate_info.certinfo[0]; field; field = field->next) {
+        StringView text { field->data, strlen(field->data) };
+        if (!text.starts_with("Cert:"sv))
+            continue;
+        auto pem = text.substring_view(5);
+
+        auto* bio = BIO_new_mem_buf(pem.characters_without_null_termination(), static_cast<int>(pem.length()));
+        if (!bio)
+            return {};
+        auto* x509 = PEM_read_bio_X509(bio, nullptr, nullptr, nullptr);
+        BIO_free(bio);
+        if (!x509)
+            return {};
+        ScopeGuard free_certificate = [&] { X509_free(x509); };
+
+        unsigned char* der = nullptr;
+        auto der_size = i2d_X509(x509, &der);
+        if (der_size <= 0)
+            return {};
+        ScopeGuard free_der = [&] { OPENSSL_free(der); };
+
+        auto certificate = ByteBuffer::copy(der, static_cast<size_t>(der_size));
+        if (certificate.is_error())
+            return {};
+        return certificate.release_value();
+    }
+    return {};
+}
+
+}
