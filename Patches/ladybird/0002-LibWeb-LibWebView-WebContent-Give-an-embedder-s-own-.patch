 #include <LibURL/EmbedderSchemes.h>
 #include <LibWebView/URLSchemeHandler.h>
+#include <LibWebView/WebContentPage.h>
 
 namespace WebView {
 
 struct RegisteredScheme {
     String scheme;
     URLSchemeHandler handler;
+    Optional<URLSchemeBridge> bridge;
 };
 
 static Vector<RegisteredScheme>& registered_schemes()
@@ -21,11 +23,11 @@ static Vector<RegisteredScheme>& registered_schemes()
     return *schemes;
 }
 
-void register_url_scheme(String scheme, URLSchemeHandler handler)
+void register_url_scheme(String scheme, URLSchemeHandler handler, Optional<URLSchemeBridge> bridge)
 {
     VERIFY(!url_scheme_handler(scheme));
     URL::register_embedder_scheme(scheme);
-    registered_schemes().append({ move(scheme), move(handler) });
+    registered_schemes().append({ move(scheme), move(handler), move(bridge) });
 }
 
 URLSchemeHandler* url_scheme_handler(StringView scheme)
@@ -37,4 +39,38 @@ URLSchemeHandler* url_scheme_handler(StringView scheme)
     return nullptr;
 }
 
+URLSchemeBridge* url_scheme_bridge(StringView scheme)
+{
+    for (auto& registered : registered_schemes()) {
+        if (registered.scheme == scheme)
+            return registered.bridge.has_value() ? &registered.bridge.value() : nullptr;
+    }
+    return nullptr;
+}
+
+URLSchemeBridgeEndpoint::URLSchemeBridgeEndpoint(WebContentPage& page, Web::HTML::CrossProcessId document_id, URL::URL url, URL::Origin origin)
+    : m_page(page)
+    , m_document_id(document_id)
+    , m_url(move(url))
+    , m_origin(move(origin))
+{
+}
+
+bool URLSchemeBridgeEndpoint::is_open() const
+{
+    auto page = m_page.strong_ref();
+    return page && page->embedder_bridge_endpoint(m_document_id).has_value();
+}
+
+void URLSchemeBridgeEndpoint::post_message(String message) const
+{
+    if (auto page = m_page.strong_ref())
+        page->async_post_embedder_message(m_document_id, move(message));
+}
+
+bool URLSchemeBridgeEndpoint::operator==(URLSchemeBridgeEndpoint const& other) const
+{
+    return m_page.ptr() == other.m_page.ptr() && m_document_id == other.m_document_id;
+}
+
 }
