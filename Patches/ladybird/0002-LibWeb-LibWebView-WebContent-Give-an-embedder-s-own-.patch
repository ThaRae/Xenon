@@ -0,0 +1,99 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibGC/Function.h>
+#include <LibJS/Runtime/AbstractOperations.h>
+#include <LibJS/Runtime/NativeFunction.h>
+#include <LibJS/Runtime/Object.h>
+#include <LibJS/Runtime/PrimitiveString.h>
+#include <LibJS/Runtime/Realm.h>
+#include <LibURL/EmbedderSchemes.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/HTML/EventLoop/EventLoop.h>
+#include <LibWeb/HTML/Scripting/ClassicScript.h>
+#include <LibWeb/HTML/Scripting/Environments.h>
+#include <LibWeb/HTML/Scripting/ExceptionReporter.h>
+#include <LibWeb/HTML/Scripting/TemporaryExecutionContext.h>
+#include <WebContent/ConnectionFromClient.h>
+#include <WebContent/EmbedderBridge.h>
+
+namespace WebContent {
+
+static void call_with_bridge(Web::HTML::EnvironmentSettingsObject& settings, JS::Value function, JS::Value this_value, ReadonlySpan<JS::Value> arguments)
+{
+    if (!function.is_function())
+        return;
+
+    Web::HTML::prepare_to_run_callback(settings);
+    auto result = JS::call(settings.global_object().vm(), function, this_value, arguments);
+    if (result.is_error())
+        Web::HTML::report_exception(JS::throw_completion(result.error_value()), settings.realm());
+    Web::HTML::clean_up_after_running_callback(settings);
+}
+
+void EmbedderBridges::install(ConnectionFromClient& client, Web::PageId page_id, Web::DOM::Document& document)
+{
+    auto origin = document.origin();
+    if (origin.is_opaque() || !origin.scheme().has_value() || !URL::is_embedder_scheme(*origin.scheme()))
+        return;
+
+    auto document_id = document.id();
+    auto response = client.send_sync_but_allow_failure<Messages::WebContentClient::DidRequestEmbedderBootstrap>(page_id, document_id);
+    if (!response)
+        return;
+    auto bootstrap = response->take_script();
+    if (!bootstrap.has_value())
+        return;
+
+    auto& settings = document.relevant_settings_object();
+    auto& realm = settings.realm();
+    Web::HTML::TemporaryExecutionContext execution_context { realm };
+
+    auto bridge = JS::Object::create(realm, realm.intrinsics().object_prototype());
+    bridge->define_native_function(realm, "postMessage"_utf16_fly_string, [&client, page_id, document_id](JS::VM& vm) -> JS::ThrowCompletionOr<JS::Value> {
+        auto message = TRY(vm.argument(0).to_utf16_string(vm)).to_utf8();
+        client.async_did_post_embedder_message(page_id, document_id, move(message));
+        return JS::js_undefined(); }, 1, JS::default_attributes);
+
+    // NB: The bootstrap is a function body, so that the bridge is a parameter rather than something on the global object.
+    auto source = Utf16String::formatted("(function (bridge) {{\n{}\n}})", *bootstrap);
+    auto script = Web::HTML::ClassicScript::create("embedder bootstrap", source.utf16_view(), settings, settings.api_base_url());
+    auto function = script->run(Web::HTML::ClassicScript::RethrowErrors::Yes);
+    if (function.is_abrupt()) {
+        Web::HTML::report_exception(function, realm);
+        return;
+    }
+
+    m_bridges.set(document_id, { .document = document, .object = *bridge });
+    call_with_bridge(settings, function.value(), JS::js_undefined(), { { JS::Value { bridge } } });
+}
+
+void EmbedderBridges::deliver_message(Web::HTML::CrossProcessId document_id, String message)
+{
+    auto bridge = m_bridges.get(document_id);
+    if (!bridge.has_value())
+        return;
+
+    auto document = bridge->document.ptr();
+    auto object = bridge->object.ptr();
+    if (!document || !object) {
+        m_bridges.remove(document_id);
+        return;
+    }
+
+    Web::HTML::queue_a_task(Web::HTML::Task::Source::PostedMessage, nullptr, document, GC::create_function(document->heap(), [document = GC::Ref { *document }, object = GC::Ref { *object }, message = move(message)] {
+        auto& settings = document->relevant_settings_object();
+        auto& vm = settings.global_object().vm();
+
+        Web::HTML::TemporaryExecutionContext execution_context { settings.realm() };
+        auto handler = object->get("onmessage"_utf16_fly_string);
+        if (handler.is_error())
+            return;
+        call_with_bridge(settings, handler.value(), object, { { JS::PrimitiveString::create(vm, Utf16String::from_utf8(message)) } });
+    }));
+}
+
+}
