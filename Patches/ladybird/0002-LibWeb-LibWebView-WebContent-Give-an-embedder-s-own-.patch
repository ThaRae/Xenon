+// The script bridge between the UI process and the documents of the schemes it serves itself (see
+// WebView::register_url_scheme()). Before a document's own scripts run, the UI process may give it a bootstrap script,
+// which runs as the body of a function given the bridge: an object whose postMessage(string) sends a message to the UI
+// process, and whose onmessage, if the script sets it, receives the UI process's messages.
+class EmbedderBridges {
+public:
+    void install(ConnectionFromClient&, Web::PageId, Web::DOM::Document&);
+    void deliver_message(Web::HTML::CrossProcessId document_id, String message);
+
+private:
+    struct Bridge {
+        GC::Weak<Web::DOM::Document> document;
+        GC::Weak<JS::Object> object;
+    };
+    HashMap<Web::HTML::CrossProcessId, Bridge> m_bridges;
+};
+
+}
