+// A document of this page whose scheme has a script bridge, which the page hosts or is creating.
+Optional<URLSchemeBridgeEndpoint> WebContentPage::embedder_bridge_endpoint(Web::HTML::CrossProcessId document_id)
+{
+    Optional<URLSchemeBridgeEndpoint> endpoint;
+    for_each_hosted_document([&](CanonicalDocument& document) {
+        if (document.id() != document_id)
+            return IterationDecision::Continue;
+
+        auto const& origin = document.origin();
+        if (!origin.is_opaque() && origin.scheme().has_value() && url_scheme_bridge(*origin.scheme()))
+            endpoint = URLSchemeBridgeEndpoint { *this, document_id, document.creation_url(), origin };
+        return IterationDecision::Break;
+    });
+    return endpoint;
+}
+
+Optional<String> WebContentPage::did_request_embedder_bootstrap(Web::HTML::CrossProcessId document_id)
+{
+    auto endpoint = embedder_bridge_endpoint(document_id);
+    if (!endpoint.has_value())
+        return Optional<String> {};
+    return url_scheme_bridge(*endpoint->origin().scheme())->bootstrap_script(*endpoint);
+}
+
+void WebContentPage::did_post_embedder_message(Web::HTML::CrossProcessId document_id, String message)
+{
+    // NB: A document may post a message as it goes away, so one this page no longer hosts is dropped rather than taken
+    //     for misbehavior. Who sent the message comes from the UI process's records, never from the message.
+    auto endpoint = embedder_bridge_endpoint(document_id);
+    if (!endpoint.has_value())
+        return;
+    url_scheme_bridge(*endpoint->origin().scheme())->on_message(*endpoint, move(message));
+}
+
 void WebContentPage::did_request_color_picker(Color current_color)
