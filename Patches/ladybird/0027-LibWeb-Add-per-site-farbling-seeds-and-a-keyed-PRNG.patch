new file mode 100644
index 0000000000000000000000000000000000000000..1ee629119abecd6f7420cbe9f076553816f65cf6
--- /dev/null
+++ b/Libraries/LibWebCommon/Farbling/FarblingSeed.h
@@ -0,0 +1,55 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/StringView.h>
+#include <AK/Types.h>
+
+namespace Web::Farbling {
+
+enum class Level : u8 {
+    Off = 0,
+    Standard = 1,
+    Strict = 2,
+};
+
+struct Seed {
+    Level level { Level::Off };
+    u64 high { 0 };
+    u64 low { 0 };
+
+    bool enabled() const { return level != Level::Off; }
+
+    bool operator==(Seed const&) const = default;
+};
+
+inline StringView level_name(Level level)
+{
+    switch (level) {
+    case Level::Off:
+        return "off"sv;
+    case Level::Strict:
+        return "strict"sv;
+    case Level::Standard:
+        return "standard"sv;
+    }
+    return "off"sv;
+}
+
+inline Level level_from_u8(u8 value)
+{
+    switch (value) {
+    case to_underlying(Level::Standard):
+        return Level::Standard;
+    case to_underlying(Level::Strict):
+        return Level::Strict;
+    default:
+        return Level::Off;
+    }
+}
+
+}
