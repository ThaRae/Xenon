index 0000000000000000000000000000000000000000..f26ae58dff32e0c5bee442cbcc4f2e633448ac3b
--- /dev/null
+++ b/Libraries/LibWebView/FarblingSeedStore.cpp
@@ -0,0 +1,204 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/JsonArray.h>
+#include <AK/JsonObject.h>
+#include <AK/JsonValue.h>
+#include <AK/QuickSort.h>
+#include <AK/Random.h>
+#include <LibURL/Site.h>
+#include <LibWebView/FarblingSeedStore.h>
+#include <LibWebView/Utilities.h>
+
+namespace WebView {
+
+static u8 nibble_from_hex(char character)
+{
+    if (character >= '0' && character <= '9')
+        return static_cast<u8>(character - '0');
+    if (character >= 'a' && character <= 'f')
+        return static_cast<u8>(character - 'a' + 10);
+    if (character >= 'A' && character <= 'F')
+        return static_cast<u8>(character - 'A' + 10);
+    return 0;
+}
+
+static String encode_token(u64 high, u64 low)
+{
+    return MUST(String::formatted("{:016x}{:016x}", high, low));
+}
+
+Optional<FarblingSeedStore::Token> decode_token(StringView hex)
+{
+    if (hex.length() != 32)
+        return {};
+    u64 high = 0;
+    u64 low = 0;
+    for (size_t i = 0; i < 16; ++i) {
+        high = (high << 4) | nibble_from_hex(hex[i]);
+        low = (low << 4) | nibble_from_hex(hex[i + 16]);
+    }
+    return FarblingSeedStore::Token { high, low };
+}
+
+FarblingSeedStore::FarblingSeedStore(ByteString persist_path)
+    : m_persist_path(move(persist_path))
+{
+    m_session_entropy = generate_token();
+    load();
+}
+
+void FarblingSeedStore::set_default_level(Web::Farbling::Level level)
+{
+    if (level == Web::Farbling::Level::Off)
+        level = Web::Farbling::Level::Standard;
+    m_default_level = level;
+}
+
+Optional<String> FarblingSeedStore::site_key(URL::URL const& url)
+{
+    auto key = URL::Site::serialize_for_partitioning(url.origin());
+    if (!key.has_value())
+        return {};
+    return key->to_utf8();
+}
+
+Web::Farbling::Level FarblingSeedStore::level_for(URL::URL const& url, IsPrivate is_private) const
+{
+    auto key = site_key(url);
+    if (!key.has_value())
+        return Web::Farbling::Level::Off;
+
+    auto const& off_sites = is_private == IsPrivate::Yes ? m_private_off_sites : m_off_sites;
+    if (off_sites.contains(*key))
+        return Web::Farbling::Level::Off;
+    return m_default_level;
+}
+
+Web::Farbling::Seed FarblingSeedStore::effective_seed(URL::URL const& url, IsPrivate is_private)
+{
+    auto key = site_key(url);
+    if (!key.has_value())
+        return {};
+
+    auto level = level_for(url, is_private);
+    if (level == Web::Farbling::Level::Off)
+        return { .level = Web::Farbling::Level::Off };
+
+    auto token = persistent_token(*key, is_private);
+    return {
+        .level = level,
+        .high = token.high ^ m_session_entropy.high,
+        .low = token.low ^ m_session_entropy.low,
+    };
+}
+
+void FarblingSeedStore::set_level(URL::URL const& url, IsPrivate is_private, Web::Farbling::Level level)
+{
+    auto key = site_key(url);
+    if (!key.has_value())
+        return;
+
+    auto& off_sites = is_private == IsPrivate::Yes ? m_private_off_sites : m_off_sites;
+    if (level == Web::Farbling::Level::Off)
+        off_sites.set(*key);
+    else
+        off_sites.remove(*key);
+
+    if (is_private == IsPrivate::No)
+        persist();
+}
+
+Vector<String> FarblingSeedStore::persisted_off_sites() const
+{
+    Vector<String> sites;
+    sites.ensure_capacity(m_off_sites.size());
+    for (auto const& site : m_off_sites)
+        sites.unchecked_append(site);
+    quick_sort(sites);
+    return sites;
+}
+
+void FarblingSeedStore::clear_site(URL::URL const& url)
+{
+    auto key = site_key(url);
+    if (!key.has_value())
+        return;
+    m_tokens.remove(*key);
+    m_off_sites.remove(*key);
+    persist();
+}
+
+void FarblingSeedStore::clear_all_persisted()
+{
+    m_tokens.clear();
+    m_off_sites.clear();
+    persist();
+}
+
+FarblingSeedStore::Token FarblingSeedStore::generate_token() const
+{
+    Token token;
+    do {
+        token.high = get_random<u64>();
+        token.low = get_random<u64>();
+    } while (token.high == 0 && token.low == 0);
+    return token;
+}
+
+FarblingSeedStore::Token FarblingSeedStore::persistent_token(String const& key, IsPrivate is_private)
+{
+    auto& tokens = is_private == IsPrivate::Yes ? m_private_tokens : m_tokens;
+    if (auto existing = tokens.get(key); existing.has_value())
+        return *existing;
+
+    auto token = generate_token();
+    tokens.set(key, token);
+    if (is_private == IsPrivate::No)
+        persist();
+    return token;
+}
+
+void FarblingSeedStore::load()
+{
+    auto json = read_json_file(m_persist_path);
+    if (json.is_error())
+        return;
+
+    if (auto tokens = json.value().get_object("tokens"sv); tokens.has_value()) {
+        tokens->for_each_member([&](auto const& site, JsonValue const& value) {
+            if (!value.is_string())
+                return;
+            if (auto token = decode_token(value.as_string()); token.has_value())
+                m_tokens.set(site, *token);
+        });
+    }
+
+    if (auto off_sites = json.value().get_array("offSites"sv); off_sites.has_value()) {
+        off_sites->for_each([&](JsonValue const& value) {
+            if (value.is_string())
+                m_off_sites.set(value.as_string());
+        });
+    }
+}
+
+void FarblingSeedStore::persist() const
+{
+    JsonObject tokens;
+    for (auto const& [site, token] : m_tokens)
+        tokens.set(site, encode_token(token.high, token.low));
+
+    JsonArray off_sites;
+    for (auto const& site : persisted_off_sites())
+        off_sites.must_append(site);
+
+    JsonObject root;
+    root.set("tokens"sv, move(tokens));
+    root.set("offSites"sv, move(off_sites));
+    (void)write_json_file(m_persist_path, move(root));
+}
+
+}
