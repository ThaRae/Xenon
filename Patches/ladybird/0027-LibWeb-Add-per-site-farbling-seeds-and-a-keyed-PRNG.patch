+++ b/Tests/LibWeb/TestFarblingRNG.cpp
@@ -0,0 +1,53 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibTest/TestCase.h>
+#include <LibWeb/Farbling/FarblingRNG.h>
+
+TEST_CASE(same_seed_and_key_are_deterministic)
+{
+    Web::Farbling::Seed seed { .level = Web::Farbling::Level::Standard, .high = 0x0123456789abcdefULL, .low = 0xfedcba9876543210ULL };
+    Web::Farbling::RNG first(seed);
+    Web::Farbling::RNG second(seed);
+
+    EXPECT_EQ(first.integer("canvas"sv), second.integer("canvas"sv));
+    EXPECT_EQ(first.integer("webgl"sv), second.integer("webgl"sv));
+}
+
+TEST_CASE(a_second_read_of_the_same_key_does_not_change)
+{
+    Web::Farbling::RNG rng({ .level = Web::Farbling::Level::Standard, .high = 1, .low = 2 });
+    auto first = rng.integer("audio"sv);
+    auto second = rng.integer("audio"sv);
+    EXPECT_EQ(first, second);
+}
+
+TEST_CASE(different_keys_differ)
+{
+    Web::Farbling::RNG rng({ .level = Web::Farbling::Level::Standard, .high = 1, .low = 2 });
+    EXPECT_NE(rng.integer("a"sv), rng.integer("b"sv));
+}
+
+TEST_CASE(different_seeds_differ)
+{
+    Web::Farbling::RNG first({ .level = Web::Farbling::Level::Standard, .high = 1, .low = 2 });
+    Web::Farbling::RNG second({ .level = Web::Farbling::Level::Standard, .high = 3, .low = 4 });
+    EXPECT_NE(first.integer("canvas"sv), second.integer("canvas"sv));
+}
+
+TEST_CASE(off_returns_zero)
+{
+    Web::Farbling::RNG rng({ .level = Web::Farbling::Level::Off });
+    EXPECT_EQ(rng.integer("canvas"sv), 0u);
+}
+
+TEST_CASE(seed_info_names_the_level)
+{
+    EXPECT_EQ(Web::Farbling::seed_info({}), "off"sv);
+    auto info = Web::Farbling::seed_info({ .level = Web::Farbling::Level::Standard, .high = 1, .low = 2 });
+    EXPECT(info.starts_with_bytes("standard:"sv));
+    EXPECT_EQ(info.byte_count(), "standard:"sv.length() + 16);
+}
