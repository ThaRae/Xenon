index 0000000000000000000000000000000000000000..dbea43fef2cb5b93ff39fe30050a80b14c0f4d9c
--- /dev/null
+++ b/Libraries/LibWeb/Farbling/FarblingRNG.cpp
@@ -0,0 +1,82 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/String.h>
+#include <LibWeb/Farbling/FarblingRNG.h>
+
+namespace Web::Farbling {
+
+RNG::RNG(Seed seed)
+    : m_seed(seed)
+{
+}
+
+u64 RNG::splitmix64(u64 state)
+{
+    u64 z = state + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    return z ^ (z >> 31);
+}
+
+u64 RNG::hash_key(StringView key)
+{
+    u64 hash = 14695981039346656037ULL;
+    for (auto byte : key.bytes()) {
+        hash ^= byte;
+        hash *= 1099511628211ULL;
+    }
+    return hash;
+}
+
+u64 RNG::next_unbounded(u64 key_hash)
+{
+    // xorshift128+ seeded from the page seed mixed with the key, so one key is one independent stream.
+    u64 seed_state = m_seed.high ^ key_hash;
+    u64 low = splitmix64(seed_state);
+    seed_state = m_seed.low ^ (key_hash * 0x9e3779b97f4a7c15ULL);
+    u64 high = splitmix64(seed_state);
+    if (low == 0 && high == 0)
+        high = 1;
+
+    u64 s1 = low;
+    u64 const s0 = high;
+    u64 const result = s0 + s1;
+    s1 ^= s1 << 23;
+    s1 ^= s1 >> 18;
+    s1 ^= s0 ^ (s0 >> 5);
+    return result + s1;
+}
+
+u64 RNG::integer(StringView key)
+{
+    if (!m_seed.enabled())
+        return 0;
+
+    auto key_string = MUST(String::from_utf8(key));
+    if (auto cached = m_cache.get(key_string); cached.has_value())
+        return *cached;
+
+    auto value = next_unbounded(hash_key(key));
+    m_cache.set(key_string, value);
+    return value;
+}
+
+String seed_info(Seed const& seed)
+{
+    if (!seed.enabled())
+        return "off"_string;
+
+    auto mixed = seed.high ^ (seed.low + 0x9e3779b97f4a7c15ULL);
+    mixed ^= mixed >> 33;
+    mixed *= 0xff51afd7ed558ccdULL;
+    mixed ^= mixed >> 33;
+    mixed *= 0xc4ceb9fe1a85ec53ULL;
+    mixed ^= mixed >> 33;
+    return MUST(String::formatted("{}:{:016x}", level_name(seed.level), mixed));
+}
+
+}
