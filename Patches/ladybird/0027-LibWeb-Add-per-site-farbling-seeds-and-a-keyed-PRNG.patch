new file mode 100644
index 0000000000000000000000000000000000000000..68536351b22efde6a5ad94ea6aa74ec86a55f09e
--- /dev/null
+++ b/Libraries/LibWeb/Farbling/FarblingRNG.h
@@ -0,0 +1,40 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/HashMap.h>
+#include <AK/String.h>
+#include <AK/StringView.h>
+#include <AK/Types.h>
+#include <AK/kmalloc.h>
+#include <LibWeb/Export.h>
+#include <LibWebCommon/Farbling/FarblingSeed.h>
+
+namespace Web::Farbling {
+
+// A small deterministic generator keyed by the page's farbling seed. The same seed and key always produce the same
+// stream. Integers already returned for a key are cached, so a page that reads one value twice sees the same number.
+class WEB_API RNG {
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    explicit RNG(Seed);
+
+    u64 integer(StringView key);
+
+private:
+    static u64 splitmix64(u64);
+    static u64 hash_key(StringView);
+    u64 next_unbounded(u64 key_hash);
+
+    Seed m_seed;
+    HashMap<String, u64> m_cache;
+};
+
+WEB_API String seed_info(Seed const&);
+
+}
