+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteString.h>
+#include <AK/HashMap.h>
+#include <AK/HashTable.h>
+#include <AK/Optional.h>
+#include <AK/String.h>
+#include <AK/kmalloc.h>
+#include <LibURL/URL.h>
+#include <LibWebCommon/Farbling/FarblingSeed.h>
+#include <LibWebView/BrowsingSession.h>
+#include <LibWebView/Export.h>
+
+namespace WebView {
+
+// Persistent per-site farbling tokens and the session entropy that rotates them, owned by the UI process so every
+// WebContent process (and a restarted one) sees the same values. Private windows keep a memory-only map.
+class WEBVIEW_API FarblingSeedStore {
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    explicit FarblingSeedStore(ByteString persist_path);
+
+    Web::Farbling::Level default_level() const { return m_default_level; }
+    void set_default_level(Web::Farbling::Level);
+
+    Web::Farbling::Seed effective_seed(URL::URL const&, IsPrivate);
+    Web::Farbling::Level level_for(URL::URL const&, IsPrivate) const;
+    void set_level(URL::URL const&, IsPrivate, Web::Farbling::Level);
+
+    Vector<String> persisted_off_sites() const;
+    void clear_site(URL::URL const&);
+    void clear_all_persisted();
+
+    static Optional<String> site_key(URL::URL const&);
+
+private:
+    struct Token {
+        u64 high { 0 };
+        u64 low { 0 };
+    };
+
+    Token persistent_token(String const& key, IsPrivate);
+    Token generate_token() const;
+    void persist() const;
+    void load();
+
+    friend Optional<Token> decode_token(StringView);
+
+    ByteString m_persist_path;
+    Web::Farbling::Level m_default_level { Web::Farbling::Level::Standard };
+    Token m_session_entropy;
+    HashMap<String, Token> m_tokens;
+    HashTable<String> m_off_sites;
+    HashMap<String, Token> m_private_tokens;
+    HashTable<String> m_private_off_sites;
+};
+
+}
