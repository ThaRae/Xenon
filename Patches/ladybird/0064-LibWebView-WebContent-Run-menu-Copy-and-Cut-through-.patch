From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ThaRae <76752281+ThaRae@users.noreply.github.com>
Date: Sat, 7 Nov 2026 21:51:53 -0500
Subject: [PATCH] LibWebView+WebContent: Run menu Copy and Cut through the page

The context menu's Cut and Copy read the selection out of the page from
the UI process, so they never fired the DOM cut and copy events. Pages
that implement editing themselves, such as contenteditable editors,
therefore did nothing, while the keyboard shortcuts worked because
WebContent runs the clipboard actions for those.

Run the copy and cut actions in WebContent for both the context menu and
the application menu, as the keyboard shortcuts do, and give the page
user activation first so that it may write the clipboard.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Libraries/LibWebView/Application.cpp         | 10 ++------
 Libraries/LibWebView/ViewImplementation.cpp  | 24 +++++++++++++-------
 Libraries/LibWebView/ViewImplementation.h    |  2 ++
 Services/WebContent/ConnectionFromClient.cpp | 18 +++++++++++++++
 Services/WebContent/ConnectionFromClient.h   |  2 ++
 Services/WebContent/WebContentServer.ipc     |  2 ++
 6 files changed, 42 insertions(+), 16 deletions(-)

diff --git a/Libraries/LibWebView/Application.cpp b/Libraries/LibWebView/Application.cpp
index 4032e95fc8960dd53f4aebb93ebf965636b788ba..c59272b2bb362b46248eb70611d2e16298d9e68e 100644
--- a/Libraries/LibWebView/Application.cpp
+++ b/Libraries/LibWebView/Application.cpp
@@ -2915,17 +2915,11 @@ void Application::initialize_actions()
     update_editing_history_actions();
     m_copy_selection_action = Action::create("Copy"sv, ActionID::CopySelection, [this]() {
         if (auto view = active_web_view(); view.has_value())
-            view->selected_text()->when_resolved([this](auto& text) {
-                if (!text.is_empty())
-                    insert_clipboard_entry({ "text/plain"_string, text });
-            });
+            view->copy_selection();
     });
     m_cut_selection_action = Action::create("Cut"sv, ActionID::CutSelection, [this]() {
         if (auto view = active_web_view(); view.has_value())
-            view->cut_selected_text()->when_resolved([this](auto& text) {
-                if (!text.is_empty())
-                    insert_clipboard_entry({ "text/plain"_string, text });
-            });
+            view->cut_selection();
     });
     m_paste_action = Action::create("Paste"sv, ActionID::Paste, [this]() {
         if (auto view = active_web_view(); view.has_value())
diff --git a/Libraries/LibWebView/ViewImplementation.cpp b/Libraries/LibWebView/ViewImplementation.cpp
index f0c93bda31ce15b76bc2c8c5eb33db9d348d859c..4c029a8a494903e3372b3c10193338223dbc69ca 100644
--- a/Libraries/LibWebView/ViewImplementation.cpp
+++ b/Libraries/LibWebView/ViewImplementation.cpp
@@ -3178,6 +3178,20 @@ void ViewImplementation::paste_from_clipboard()
     host.async_paste_from_clipboard();
 }
 
+void ViewImplementation::copy_selection()
+{
+    auto& host = focused_navigable_host();
+    host.give_user_activation();
+    host.async_copy_selection();
+}
+
+void ViewImplementation::cut_selection()
+{
+    auto& host = focused_navigable_host();
+    host.give_user_activation();
+    host.async_cut_selection();
+}
+
 void ViewImplementation::set_marked_text_from_input_method(Utf16String const& text)
 {
     auto& host = focused_navigable_host();
@@ -5517,23 +5531,17 @@ void ViewImplementation::add_open_url_actions(Menu& menu, URL::URL const& url, O
     }
 }
 
-static void insert_text_clipboard_entry(ByteString const& text)
-{
-    if (!text.is_empty())
-        Application::the().insert_clipboard_entry({ "text/plain"_string, text });
-}
-
 // Text can be edited only in a field, and copied only where there is some.
 void ViewImplementation::add_text_edit_actions(Menu& menu, bool is_editable, bool has_selected_text)
 {
     if (is_editable) {
         menu.add_action(Action::create("Cut"sv, ActionID::CutSelection, [this]() {
-            cut_selected_text()->when_resolved(insert_text_clipboard_entry);
+            cut_selection();
         }));
     }
     if (is_editable || has_selected_text) {
         menu.add_action(Action::create("Copy"sv, ActionID::CopySelection, [this]() {
-            selected_text()->when_resolved(insert_text_clipboard_entry);
+            copy_selection();
         }));
     }
     if (is_editable) {
