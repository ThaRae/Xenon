From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ThaRae <76752281+ThaRae@users.noreply.github.com>
Date: Thu, 29 Oct 2026 21:45:00 +0000
Subject: [PATCH] Compositor: Release cached rasters and free pages when idle

A compositor that has painted nothing for 4 s keeps the rasters of its
last frames, and Skia/glibc and AK keep the pages they were allocated
from in their heaps. After a presented frame, arm a one-shot 4 s timer;
if no further frame arrives, drop the cached rasters and give mimalloc's
and glibc's free pages back.

Paired A/B on one binary (LADYBIRD_COMPOSITOR_IDLE_RELEASE=0/1), two
rounds, Compositor PSS was smaller in 8/8 cells: local -2.6/-1.5,
github -9.9/-12.1, youtube -6.7/-6.8, x -1.0/-1.2 MiB (mean -5.2). The
page screenshots are byte-identical before and after the release, and
xenon.py's check_compositor_idle_memory_release drives the shipped path.
---
diff --git a/Services/Compositor/CompositorState.cpp b/Services/Compositor/CompositorState.cpp
index 6acec986..e9c98bca 100644
--- a/Services/Compositor/CompositorState.cpp
+++ b/Services/Compositor/CompositorState.cpp
@@ -7,17 +7,39 @@
 #include <AK/Math.h>
 #include <AK/Random.h>
 #include <AK/StdLibExtras.h>
+#include <AK/kmalloc.h>
 #include <Compositor/CanvasHost.h>
 #include <Compositor/CompositorState.h>
+#include <LibCore/Environment.h>
 #include <LibCore/EventLoop.h>
 #include <LibCore/StatsLog.h>
 #include <LibCore/Timer.h>
 #include <LibMedia/Sinks/DisplayingVideoSink.h>
 
+#if defined(__GLIBC__)
+#    include <malloc.h>
+#endif
+
 namespace Compositor {
 
 static constexpr int gpu_completion_check_interval_ms = 1;
 
+// A compositor that has painted nothing for this long keeps the rasters of its last frames for frames that may never
+// come, and leaves the pages they were allocated from in its heaps.
+static constexpr auto idle_memory_release_delay = AK::Duration::from_seconds(4);
+
+static bool idle_memory_release_is_enabled()
+{
+    static auto const enabled = Core::Environment::get("LADYBIRD_COMPOSITOR_IDLE_RELEASE"sv).value_or("1"sv) != "0"sv;
+    return enabled;
+}
+
+static bool idle_memory_release_is_logged()
+{
+    static auto const logged = Core::Environment::get("LADYBIRD_COMPOSITOR_IDLE_RELEASE_LOG"sv).has_value();
+    return logged;
+}
+
 NonnullRefPtr<CompositorState> CompositorState::create(RefPtr<Gfx::SkiaBackendContext> skia_backend_context)
 {
     return adopt_ref(*new CompositorState(move(skia_backend_context)));
@@ -37,6 +59,33 @@ CompositorState::~CompositorState()
     m_gpu_completion_timer->stop();
 }
 
+void CompositorState::schedule_idle_memory_release()
+{
+    if (!idle_memory_release_is_enabled())
+        return;
+    if (!m_idle_memory_release_timer)
+        m_idle_memory_release_timer = Core::Timer::create_single_shot(idle_memory_release_delay, [this] { release_idle_memory(); });
+    m_idle_memory_release_timer->restart();
+}
+
+void CompositorState::release_idle_memory()
+{
+    if (idle_memory_release_is_logged())
+        dbgln("COMPOSITOR-IDLE-RELEASE at={}", MonotonicTime::now().milliseconds());
+    for (auto& context : m_contexts)
+        context.value->scene().release_cached_rasters();
+
+    // Skia and the GPU driver allocate through the C library, and AK through mimalloc. A plain collect only resets
+    // the freed pages, which keeps them in the process, so give both allocators' free pages back to the OS.
+    ak_kmalloc_decommit_free_pages();
+#if defined(__GLIBC__)
+    malloc_trim(0);
+#endif
+
+    if (idle_memory_release_is_logged())
+        dbgln("COMPOSITOR-IDLE-RELEASE released idle compositor memory");
+}
+
 void CompositorState::register_presentation(CompositorStateClient& presentation, PresentationCapabilities capabilities)
 {
     m_presentations.set(&presentation, capabilities);
@@ -1094,6 +1143,9 @@ void CompositorState::present_frame(Web::CompositorContextId context_id, Context
         });
     });
     context.presenter().did_submit_prepared_frame(pending_frame.viewport_rect);
+    if (idle_memory_release_is_logged())
+        dbgln("COMPOSITOR-FRAME at={}", MonotonicTime::now().milliseconds());
+    schedule_idle_memory_release();
 #ifdef AK_OS_MACOS
     // The window server's reads of an IOSurface wait for GPU work that is already scheduled to write it. Handing the
     // frame to the client before that work finishes keeps it ahead of the window server's deadline for the next refresh.
diff --git a/Services/Compositor/CompositorState.h b/Services/Compositor/CompositorState.h
index 838cdf5c..94257d07 100644
--- a/Services/Compositor/CompositorState.h
+++ b/Services/Compositor/CompositorState.h
@@ -279,6 +279,8 @@ private:
     void cancel_pending_async_presents_for_context(Web::CompositorContextId);
     void schedule_gpu_completion_check();
     void check_gpu_completions();
+    void schedule_idle_memory_release();
+    void release_idle_memory();
 
     HashMap<Web::CompositorContextId, OwnPtr<ContextState>> m_contexts;
 
@@ -288,6 +290,7 @@ private:
     OwnPtr<DisplayListPlayerSkia> m_display_list_player;
     HashMap<Optional<u64>, OwnPtr<VSyncScheduler>> m_vsync_schedulers_by_display;
     RefPtr<Core::Timer> m_gpu_completion_timer;
+    RefPtr<Core::Timer> m_idle_memory_release_timer;
 
     HashMap<CompositorStateClient*, PresentationCapabilities> m_presentations;
     HashMap<Web::CompositorContextId, CompositorStateClient*> m_context_presentations;
diff --git a/Services/Compositor/ContextScene.h b/Services/Compositor/ContextScene.h
index 8826dd3d..18bfced8 100644
--- a/Services/Compositor/ContextScene.h
+++ b/Services/Compositor/ContextScene.h
@@ -45,6 +45,8 @@ public:
     Compositing::AccumulatedVisualContextTree const& visual_context_tree_for_compositing();
     Compositing::DisplayListResourceStorage& resource_storage() { return m_resource_storage; }
     DisplayListRasterCache& raster_cache() { return m_raster_cache; }
+    // Drops the rasters kept to make the next frame cheap, for when there is no next frame to make them for.
+    void release_cached_rasters() { m_raster_cache.release_cached_rasters(); }
 
     Compositing::TransformWithOrigin visual_viewport_transform() const;
     Optional<float> visual_viewport_scale() const;
diff --git a/Services/Compositor/ContextState.h b/Services/Compositor/ContextState.h
index ce65b46e..37c161a0 100644
--- a/Services/Compositor/ContextState.h
+++ b/Services/Compositor/ContextState.h
@@ -145,6 +145,7 @@ public:
     Optional<Web::CompositorContextId> parent_context_id() const { return m_parent_context_id; }
     ContextPresenter& presenter() { return m_presenter; }
     ContextPresenter const& presenter() const { return m_presenter; }
+    ContextScene& scene() { return m_scene; }
 
     void apply_display_list_resource_transaction(Compositing::DisplayListResourceTransaction&&);
     void install_display_list_update(
diff --git a/Services/Compositor/DisplayListRasterCache.cpp b/Services/Compositor/DisplayListRasterCache.cpp
index f7413350..ed9bedcc 100644
--- a/Services/Compositor/DisplayListRasterCache.cpp
+++ b/Services/Compositor/DisplayListRasterCache.cpp
@@ -165,6 +165,18 @@ struct DisplayListRasterCache::ClipPath {
 DisplayListRasterCache::DisplayListRasterCache() = default;
 DisplayListRasterCache::~DisplayListRasterCache() = default;
 
+void DisplayListRasterCache::release_cached_rasters()
+{
+    m_repeated_tile_rasters.clear();
+    m_repeated_tile_raster_bytes = 0;
+    m_nested_display_list_rasters.clear();
+    m_nested_raster_cache_reserved_bytes = 0;
+    m_text_blobs.clear();
+    m_text_blob_cache_bytes = 0;
+    m_clip_paths.clear_with_capacity();
+    m_clip_paths_from_last_frame.clear_with_capacity();
+}
+
 void DisplayListRasterCache::evict(DisplayListResourceSet const& removed_resources)
 {
     // Filters retain images resolved from this storage, including resources whose IDs were replaced.
diff --git a/Services/Compositor/DisplayListRasterCache.h b/Services/Compositor/DisplayListRasterCache.h
index 9a3d7984..4e5ba3d5 100644
--- a/Services/Compositor/DisplayListRasterCache.h
+++ b/Services/Compositor/DisplayListRasterCache.h
@@ -75,6 +75,9 @@ public:
     // Drops everything made from these resources, which the storage removed or replaced.
     void evict(Compositing::DisplayListResourceSet const& removed_resources);
 
+    // Drops the rasters and blobs that a later frame can make again from the display list and its resources.
+    void release_cached_rasters();
+
     sk_sp<SkImage> image_for_image_frame(Compositing::DisplayListResourceStorage const&, Compositing::ImageFrameResourceId, RefPtr<Gfx::SkiaBackendContext> const&);
     // The image can be larger than the frame, whose visible size is the part of it to draw.
     sk_sp<SkImage> image_for_video_sink(Compositing::DisplayListResourceStorage const&, Compositing::VideoSinkResourceId, RefPtr<Gfx::SkiaBackendContext> const&, Gfx::IntSize& visible_size);
