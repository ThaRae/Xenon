+    Enterprise,
+}
+
+[ExistingCpp]
+enum Web::WebAuthn::ErrorName : u8 {
+    NotAllowedError,
+    InvalidStateError,
+    NotSupportedError,
+    SecurityError,
+    ConstraintError,
+    UnknownError,
+}
+
+[ExistingCpp]
+struct Web::WebAuthn::PublicKeyCredentialDescriptor {
+    ByteBuffer id;
+    Vector<Web::WebAuthn::AuthenticatorTransport> transports;
+}
+
+[ExistingCpp]
+struct Web::WebAuthn::CreateRequest {
+    String rp_id;
+    String rp_name;
+    ByteBuffer user_id;
+    String user_name;
+    String user_display_name;
+    ByteBuffer challenge;
+    Vector<i32> public_key_algorithms;
