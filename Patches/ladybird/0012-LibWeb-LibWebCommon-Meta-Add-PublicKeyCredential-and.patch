+/// https://webidl.spec.whatwg.org/#js-buffer-source-types
+impl ToJs for BufferSource {
+    fn to_js(self, _: &CallContext) -> ThrowCompletionOr<Value> {
+        Ok(match self {
+            Self::ArrayBuffer(buffer) => Value::from_object(buffer),
+            Self::DataView(view) => Value::from_object(view),
+            Self::TypedArray(array) => Value::from_object(array),
+        })
+    }
+}
+
 /// An object of an interface converted to a JS value, https://webidl.spec.whatwg.org/#js-interface
 impl<T: Interface> ToJs for Ref<T> {
     fn to_js(self, cx: &CallContext) -> ThrowCompletionOr<Value> {
@@ -1436,6 +1447,25 @@ pub(crate) fn mark_sequence<'vm, T: Trace + Clone + 'static>(
     marked
 }
 
+/// A sequence member of a dictionary, which the struct of the dictionary keeps in a Vec, or in a MarkedVec if the
+/// dictionary is also converted from a JS value.
+pub(crate) trait SequenceMember<T: Trace + Clone + 'static> {
+    /// The values, kept alive for as long as the reference to the VM lives.
+    fn to_marked<'vm>(&self, cx: &CallContext<'vm>) -> MarkedVec<'vm, T>;
+}
+
+impl<T: Trace + Clone + 'static> SequenceMember<T> for Vec<T> {
+    fn to_marked<'vm>(&self, cx: &CallContext<'vm>) -> MarkedVec<'vm, T> {
+        mark_sequence(cx, self)
+    }
+}
+
+impl<T: Trace + Clone + 'static> SequenceMember<T> for MarkedVec<'_, T> {
+    fn to_marked<'vm>(&self, cx: &CallContext<'vm>) -> MarkedVec<'vm, T> {
+        mark_sequence(cx, &self.values())
+    }
+}
