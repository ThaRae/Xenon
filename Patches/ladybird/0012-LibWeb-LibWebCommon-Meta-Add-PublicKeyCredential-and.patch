+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+//! The authenticator part of a WebAuthn ceremony, which runs in the browser process.
+
+use core::cell::Cell;
+use core::ffi::c_void;
+use core::ptr::NonNull;
+
+use ak::{Span, Utf16String};
+use libjs_rust::api::{
+    EmbedderCell, EmbedderClass, EmbedderValue, Gc, NativeFunction, PropertyKey, Realm, Throw, Trace, Value, Vm,
+};
+
+use super::public_key_credential::PublicKeyCredential;
+use crate::bindings::global_object::CppWindow;
+use crate::bindings::interface::Ref;
+use crate::bindings::promise::WebIdlPromise;
+use crate::bindings::{Exception, WebIdlResult};
+use crate::credential_management::credential::CredentialMediationRequirement;
+use crate::credential_management::credentials_container::{CreatedCredential, settle_in_a_task};
+use crate::dom::abort_signal::{AbortAlgorithm, AbortSignal};
+
+unsafe extern "C" {
+    fn web_web_authn_request_create(
+        window: *mut c_void,
+        ceremony: *mut c_void,
+        request: &CreateRequestAbi<'_>,
+        request_id: &mut u64,
+    ) -> bool;
+    fn web_web_authn_request_get(
+        window: *mut c_void,
+        ceremony: *mut c_void,
+        request: &GetRequestAbi<'_>,
+        request_id: &mut u64,
+    ) -> bool;
+    fn web_web_authn_cancel_request(window: *mut c_void, request_id: u64);
+}
+
+/// Web::WebAuthn::AuthenticatorAttachment, plus one.
+#[derive(Clone, Copy)]
+#[repr(u8)]
+pub(crate) enum AuthenticatorAttachment {
+    Platform = 1,
+    CrossPlatform = 2,
+}
+
+impl AuthenticatorAttachment {
+    pub(crate) fn from_string(string: &str) -> Option<Self> {
+        match string {
+            "platform" => Some(Self::Platform),
+            "cross-platform" => Some(Self::CrossPlatform),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn as_str(self) -> &'static str {
+        match self {
+            Self::Platform => "platform",
+            Self::CrossPlatform => "cross-platform",
+        }
+    }
+
+    fn from_abi(value: u8) -> Option<Self> {
+        match value {
+            1 => Some(Self::Platform),
+            2 => Some(Self::CrossPlatform),
+            _ => None,
+        }
+    }
+}
+
+/// Web::WebAuthn::ResidentKeyRequirement.
+#[derive(Clone, Copy)]
+#[repr(u8)]
+pub(crate) enum ResidentKeyRequirement {
+    Discouraged = 0,
+    Preferred = 1,
+    Required = 2,
+}
+
+/// Web::WebAuthn::UserVerificationRequirement.
+#[derive(Clone, Copy)]
+#[repr(u8)]
+pub(crate) enum UserVerificationRequirement {
+    Required = 0,
+    Preferred = 1,
+    Discouraged = 2,
+}
+
+impl UserVerificationRequirement {
+    pub(crate) fn from_string(string: &str) -> Option<Self> {
+        match string {
+            "required" => Some(Self::Required),
+            "preferred" => Some(Self::Preferred),
+            "discouraged" => Some(Self::Discouraged),
+            _ => None,
+        }
+    }
+}
+
+/// Web::WebAuthn::AttestationConveyancePreference.
+#[derive(Clone, Copy)]
+#[repr(u8)]
+pub(crate) enum AttestationConveyancePreference {
+    None = 0,
+    Indirect = 1,
+    Direct = 2,
+    Enterprise = 3,
+}
+
+/// Web::WebAuthn::PublicKeyCredentialDescriptor.
+pub(crate) struct CredentialDescriptor {
+    pub(crate) id: Vec<u8>,
+    pub(crate) transports: Vec<String>,
+}
+
+/// Web::WebAuthn::CreateRequest.
+pub(crate) struct CreateRequest {
+    pub(crate) rp_id: String,
+    pub(crate) rp_name: String,
+    pub(crate) user_id: Vec<u8>,
+    pub(crate) user_name: String,
+    pub(crate) user_display_name: String,
+    pub(crate) challenge: Vec<u8>,
+    pub(crate) public_key_algorithms: Vec<i32>,
+    pub(crate) timeout: u32,
+    pub(crate) exclude_credentials: Vec<CredentialDescriptor>,
+    pub(crate) authenticator_attachment: Option<AuthenticatorAttachment>,
+    pub(crate) resident_key: ResidentKeyRequirement,
+    pub(crate) user_verification: UserVerificationRequirement,
+    pub(crate) attestation: AttestationConveyancePreference,
+    pub(crate) hints: Vec<String>,
+    pub(crate) credential_properties: bool,
+}
+
+/// Web::WebAuthn::GetRequest.
+pub(crate) struct GetRequest {
+    pub(crate) rp_id: String,
+    pub(crate) challenge: Vec<u8>,
+    pub(crate) timeout: u32,
+    pub(crate) allow_credentials: Vec<CredentialDescriptor>,
+    pub(crate) user_verification: UserVerificationRequirement,
+    pub(crate) hints: Vec<String>,
+    pub(crate) app_id: Option<String>,
+}
+
+#[repr(C)]
+struct CredentialDescriptorAbi<'a> {
+    id: Span<'a, u8>,
+    transports: Span<'a, Span<'a, u8>>,
+}
+
+#[repr(C)]
+struct CreateRequestAbi<'a> {
+    rp_id: Span<'a, u8>,
+    rp_name: Span<'a, u8>,
+    user_id: Span<'a, u8>,
+    user_name: Span<'a, u8>,
+    user_display_name: Span<'a, u8>,
+    challenge: Span<'a, u8>,
+    public_key_algorithms: Span<'a, i32>,
+    timeout: u32,
+    exclude_credentials: Span<'a, CredentialDescriptorAbi<'a>>,
+    authenticator_attachment: u8,
+    resident_key: u8,
+    user_verification: u8,
+    attestation: u8,
+    hints: Span<'a, Span<'a, u8>>,
+    credential_properties: bool,
+}
+
+#[repr(C)]
+struct GetRequestAbi<'a> {
+    rp_id: Span<'a, u8>,
+    challenge: Span<'a, u8>,
+    timeout: u32,
+    allow_credentials: Span<'a, CredentialDescriptorAbi<'a>>,
+    user_verification: u8,
+    hints: Span<'a, Span<'a, u8>>,
+    has_app_id: bool,
+    app_id: Span<'a, u8>,
+}
+
+/// Web::WebAuthn::Result, which LibWeb lends for the call that completes a ceremony.
+#[repr(C)]
+pub(crate) struct ResultAbi<'a> {
+    kind: u8,
+    credential_id: Span<'a, u8>,
+    client_data_json: Span<'a, u8>,
+    attestation_object: Span<'a, u8>,
+    authenticator_data: Span<'a, u8>,
+    has_public_key: bool,
+    public_key: Span<'a, u8>,
+    public_key_algorithm: i32,
+    transports: Span<'a, Span<'a, u8>>,
+    authenticator_attachment: u8,
+    resident_key: u8,
+    signature: Span<'a, u8>,
+    has_user_handle: bool,
+    user_handle: Span<'a, u8>,
+    used_app_id: u8,
+    error_name: u8,
+    error_message: Span<'a, u8>,
