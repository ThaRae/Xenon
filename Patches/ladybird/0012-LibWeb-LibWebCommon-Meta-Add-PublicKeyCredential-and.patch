+            authenticator_data: result.authenticator_data.as_slice().to_vec(),
+            public_key: result.has_public_key.then(|| result.public_key.as_slice().to_vec()),
+            public_key_algorithm: result.public_key_algorithm,
+            transports: strings_from_abi(result.transports),
+            authenticator_attachment: AuthenticatorAttachment::from_abi(result.authenticator_attachment),
+            resident_key: optional_bool_from_abi(result.resident_key),
+        }
+    }
+}
