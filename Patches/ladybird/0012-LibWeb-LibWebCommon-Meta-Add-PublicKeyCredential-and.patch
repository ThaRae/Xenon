+
+fn optional_bool_from_abi(value: u8) -> Option<bool> {
+    match value {
+        0 => None,
+        1 => Some(false),
+        _ => Some(true),
+    }
+}
+
+fn string_from_abi(bytes: Span<'_, u8>) -> String {
+    String::from_utf8_lossy(bytes.as_slice()).into_owned()
+}
+
+fn strings_from_abi(strings: Span<'_, Span<'_, u8>>) -> Vec<String> {
+    strings
+        .as_slice()
+        .iter()
+        .map(|string| string_from_abi(*string))
+        .collect()
+}
+
+impl RegistrationResponse {
