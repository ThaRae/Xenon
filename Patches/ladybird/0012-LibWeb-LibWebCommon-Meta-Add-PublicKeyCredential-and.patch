+
+static String string_from_abi(ReadonlyBytes bytes)
+{
+    return MUST(String::from_utf8(StringView { bytes }));
+}
+
+static Vector<String> strings_from_abi(ReadonlySpan<ReadonlyBytes> strings)
+{
+    Vector<String> result;
+    for (auto string : strings)
+        result.append(string_from_abi(string));
+    return result;
+}
+
+static Vector<PublicKeyCredentialDescriptor> descriptors_from_abi(ReadonlySpan<CredentialDescriptorAbi> descriptors)
+{
+    Vector<PublicKeyCredentialDescriptor> result;
+    for (auto const& descriptor : descriptors) {
+        PublicKeyCredentialDescriptor entry;
+        entry.id = MUST(ByteBuffer::copy(descriptor.id));
+        for (auto transport : descriptor.transports) {
+            if (auto value = authenticator_transport_from_string(StringView { transport }); value.has_value())
+                entry.transports.append(*value);
+        }
+        result.append(move(entry));
+    }
+    return result;
+}
+
+static u8 optional_bool_to_abi(Optional<bool> value)
+{
+    if (!value.has_value())
+        return 0;
+    return *value ? 2 : 1;
+}
+
+static u8 authenticator_attachment_to_abi(Optional<AuthenticatorAttachment> attachment)
+{
+    if (!attachment.has_value())
+        return 0;
+    return to_underlying(*attachment) + 1;
+}
+
+static void complete_the_ceremony(GC::Cell& ceremony, Result const& result)
+{
+    ResultAbi abi {};
+    Vector<ReadonlyBytes> transports;
+
+    result.visit(
+        [&](RegistrationResponse const& registration) {
+            abi.kind = to_underlying(ResultKind::Registration);
+            abi.credential_id = registration.credential_id.bytes();
+            abi.client_data_json = registration.client_data_json.bytes();
+            abi.attestation_object = registration.attestation_object.bytes();
+            abi.authenticator_data = registration.authenticator_data.bytes();
+            abi.has_public_key = registration.public_key.has_value();
+            if (registration.public_key.has_value())
+                abi.public_key = registration.public_key->bytes();
+            abi.public_key_algorithm = registration.public_key_algorithm;
+            for (auto transport : registration.transports)
+                transports.append(authenticator_transport_to_string(transport).bytes());
+            abi.transports = transports.span();
+            abi.authenticator_attachment = authenticator_attachment_to_abi(registration.authenticator_attachment);
+            abi.resident_key = optional_bool_to_abi(registration.resident_key);
+        },
+        [&](AssertionResponse const& assertion) {
+            abi.kind = to_underlying(ResultKind::Assertion);
+            abi.credential_id = assertion.credential_id.bytes();
+            abi.client_data_json = assertion.client_data_json.bytes();
+            abi.authenticator_data = assertion.authenticator_data.bytes();
+            abi.signature = assertion.signature.bytes();
+            abi.has_user_handle = assertion.user_handle.has_value();
+            if (assertion.user_handle.has_value())
+                abi.user_handle = assertion.user_handle->bytes();
+            abi.authenticator_attachment = authenticator_attachment_to_abi(assertion.authenticator_attachment);
+            abi.used_app_id = optional_bool_to_abi(assertion.used_app_id);
+        },
+        [&](Error const& error) {
+            abi.kind = to_underlying(ResultKind::Error);
+            abi.error_name = to_underlying(error.name);
+            abi.error_message = error.message.bytes();
+        });
+
+    web_rust_web_authn_ceremony_completed(JS::HostABI::vm_to_abi(JS::VM::the()), &ceremony, &abi);
+}
+
+static Page::WebAuthnCallback callback_for(GC::Cell& ceremony)
+{
+    return GC::create_function(GC::Heap::the(), GC::captures(GC::Ref { ceremony }), [](GC::Ref<GC::Cell> ceremony, Result result) {
+        complete_the_ceremony(*ceremony, result);
+    });
+}
+
+template<typename Request>
+static bool request_a_ceremony(HTML::Window& window, GC::Cell& ceremony, Request request, u64& request_id)
+{
+    auto& document = window.associated_document();
+    auto navigable = document.navigable();
+    if (!navigable)
+        return false;
+
+    Optional<u64> id;
+    if constexpr (IsSame<Request, CreateRequest>)
+        id = document.page().request_web_authn_create(navigable->id(), document.id(), move(request), callback_for(ceremony));
+    else
+        id = document.page().request_web_authn_get(navigable->id(), document.id(), move(request), callback_for(ceremony));
+    if (!id.has_value())
+        return false;
+    request_id = *id;
+    return true;
+}
+
+bool web_web_authn_request_create(HTML::Window* window, GC::Cell* ceremony, CreateRequestAbi const* abi, u64* request_id)
+{
+    CreateRequest request;
+    request.rp_id = string_from_abi(abi->rp_id);
+    request.rp_name = string_from_abi(abi->rp_name);
+    request.user_id = MUST(ByteBuffer::copy(abi->user_id));
+    request.user_name = string_from_abi(abi->user_name);
+    request.user_display_name = string_from_abi(abi->user_display_name);
+    request.challenge = MUST(ByteBuffer::copy(abi->challenge));
+    request.public_key_algorithms.append(abi->public_key_algorithms.data(), abi->public_key_algorithms.size());
+    request.timeout = abi->timeout;
+    request.exclude_credentials = descriptors_from_abi(abi->exclude_credentials);
+    if (abi->authenticator_attachment != 0)
+        request.authenticator_attachment = static_cast<AuthenticatorAttachment>(abi->authenticator_attachment - 1);
+    request.resident_key = static_cast<ResidentKeyRequirement>(abi->resident_key);
+    request.user_verification = static_cast<UserVerificationRequirement>(abi->user_verification);
+    request.attestation = static_cast<AttestationConveyancePreference>(abi->attestation);
+    request.hints = strings_from_abi(abi->hints);
+    request.credential_properties = abi->credential_properties;
+    return request_a_ceremony(*window, *ceremony, move(request), *request_id);
+}
+
+bool web_web_authn_request_get(HTML::Window* window, GC::Cell* ceremony, GetRequestAbi const* abi, u64* request_id)
+{
+    GetRequest request;
+    request.rp_id = string_from_abi(abi->rp_id);
+    request.challenge = MUST(ByteBuffer::copy(abi->challenge));
+    request.timeout = abi->timeout;
+    request.allow_credentials = descriptors_from_abi(abi->allow_credentials);
+    request.user_verification = static_cast<UserVerificationRequirement>(abi->user_verification);
+    request.hints = strings_from_abi(abi->hints);
+    if (abi->has_app_id)
+        request.app_id = string_from_abi(abi->app_id);
+    return request_a_ceremony(*window, *ceremony, move(request), *request_id);
+}
+
+void web_web_authn_cancel_request(HTML::Window* window, u64 request_id)
+{
+    window->page().cancel_web_authn_request(request_id);
+}
+
+}
