+struct CredentialDescriptorAbi {
+    ReadonlyBytes id;
+    ReadonlySpan<ReadonlyBytes> transports;
+};
+
+struct CreateRequestAbi {
+    ReadonlyBytes rp_id;
+    ReadonlyBytes rp_name;
+    ReadonlyBytes user_id;
+    ReadonlyBytes user_name;
+    ReadonlyBytes user_display_name;
+    ReadonlyBytes challenge;
+    ReadonlySpan<i32> public_key_algorithms;
+    u32 timeout;
+    ReadonlySpan<CredentialDescriptorAbi> exclude_credentials;
+    u8 authenticator_attachment;
+    u8 resident_key;
+    u8 user_verification;
+    u8 attestation;
+    ReadonlySpan<ReadonlyBytes> hints;
+    bool credential_properties;
+};
+
+struct GetRequestAbi {
+    ReadonlyBytes rp_id;
+    ReadonlyBytes challenge;
+    u32 timeout;
+    ReadonlySpan<CredentialDescriptorAbi> allow_credentials;
+    u8 user_verification;
+    ReadonlySpan<ReadonlyBytes> hints;
+    bool has_app_id;
+    ReadonlyBytes app_id;
+};
+
+struct ResultAbi {
+    u8 kind;
+    ReadonlyBytes credential_id;
+    ReadonlyBytes client_data_json;
+    ReadonlyBytes attestation_object;
+    ReadonlyBytes authenticator_data;
+    bool has_public_key;
+    ReadonlyBytes public_key;
+    i32 public_key_algorithm;
+    ReadonlySpan<ReadonlyBytes> transports;
+    u8 authenticator_attachment;
+    u8 resident_key;
+    ReadonlyBytes signature;
+    bool has_user_handle;
+    ReadonlyBytes user_handle;
+    u8 used_app_id;
+    u8 error_name;
+    ReadonlyBytes error_message;
+};
+
+enum class ResultKind : u8 {
+    Registration,
+    Assertion,
+    Error,
+};
+
+}
+
+static_assert(to_underlying(AuthenticatorAttachment::Platform) == 0);
+static_assert(to_underlying(AuthenticatorAttachment::CrossPlatform) == 1);
