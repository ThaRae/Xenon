+fn base64url_decode(vm: &Vm, realm: Gc<Realm>, string: &Utf16String) -> WebIdlResult<BufferSource> {
+    let result = decode_base64(
+        string.as_units(),
+        Base64Alphabet::Base64Url,
+        LastChunkHandling::Loose,
+        None,
+    );
+    if result.error.is_some() {
+        return Err(Exception::Dom(
+            "EncodingError",
+            Utf16String::from_ascii(b"Invalid base64url string"),
+        ));
+    }
+    Ok(BufferSource::ArrayBuffer(new_array_buffer(vm, realm, &result.bytes)))
+}
+
+fn copy_of_buffer_source(buffer_source: &BufferSource) -> Vec<u8> {
+    // SAFETY: Copying the bytes runs no script and allocates no cell.
+    unsafe { buffer_source.with_bytes(<[u8]>::to_vec) }
+}
+
+fn dom_exception(name: &'static str, message: &str) -> Exception {
+    Exception::Dom(name, Utf16String::from_utf8(message))
+}
+
+fn string_value(cx: &CallContext, string: Utf16String) -> ThrowCompletionOr<Value> {
+    string.to_js(cx)
+}
+
+fn set_member(cx: &CallContext, object: Gc<Object>, key: &str, value: Value) -> ThrowCompletionOr<()> {
+    set_dictionary_member(cx, object, &PropertyKey::from_utf8(key), value)
+}
+
+fn set_base64url_member(cx: &CallContext, object: Gc<Object>, key: &str, bytes: &[u8]) -> ThrowCompletionOr<()> {
+    let value = string_value(cx, base64url_encode(bytes))?;
+    set_member(cx, object, key, value)
+}
+
+impl PublicKeyCredential {
+    fn new(
+        vm: &Vm,
+        realm: Gc<Realm>,
+        credential_id: &[u8],
+        response: AnyAuthenticatorResponse,
+        authenticator_attachment: Option<AuthenticatorAttachment>,
+        client_extension_results: ClientExtensionResults,
+    ) -> Self {
+        Self {
+            credential: Credential::new(
+                UsvString::from_utf16_string(&base64url_encode(credential_id)),
+                "public-key",
+            ),
+            raw_id: new_array_buffer(vm, realm, credential_id),
+            raw_id_bytes: credential_id.to_vec(),
+            response,
+            authenticator_attachment,
+            client_extension_results,
+        }
+    }
+
+    // https://w3c.github.io/webauthn/#sctn-createCredential, constructCredentialAlg
+    pub(crate) fn create_from_registration(
+        vm: &Vm,
+        realm: Gc<Realm>,
+        registration: &RegistrationResponse,
+    ) -> Ref<Self> {
+        // 1. Let pubKeyCred be a new PublicKeyCredential object associated with global whose fields are:
+        //    [[identifier]]: A new DOMString containing the base64url encoding of
+        //                    credentialCreationData.attestationObjectResult.credentialId.
+        //    authenticatorAttachment: The AuthenticatorAttachment value matching the current authenticator attachment
+        //                             modality of authenticator.
+        //    response: A new AuthenticatorAttestationResponse object associated with global.
+        //    [[clientExtensionsResults]]: credentialCreationData.clientExtensionResults.
+        // NB: The browser process has applied the attestation conveyance preference to the attestation object already.
+        let response = AuthenticatorAttestationResponse::create(vm, realm, registration);
+        allocate(vm, |_| {
+            Self::new(
+                vm,
+                realm,
+                &registration.credential_id,
+                AnyAuthenticatorResponse::AuthenticatorAttestationResponse(response),
+                registration.authenticator_attachment,
+                ClientExtensionResults {
+                    app_id: None,
+                    resident_key: registration.resident_key,
+                },
+            )
+        })
+    }
+
+    // https://w3c.github.io/webauthn/#sctn-getAssertion, constructAssertionAlg
+    pub(crate) fn create_from_assertion(vm: &Vm, realm: Gc<Realm>, assertion: &AssertionResponse) -> Ref<Self> {
+        // 1. Let pubKeyCred be a new PublicKeyCredential object associated with global whose fields are:
+        //    [[identifier]]: A new DOMString containing the base64url encoding of the credential ID.
+        //    authenticatorAttachment: The AuthenticatorAttachment value matching the current authenticator attachment
+        //                             modality of authenticator.
+        //    response: A new AuthenticatorAssertionResponse object associated with global.
+        //    [[clientExtensionsResults]]: assertionCreationData.clientExtensionResults.
+        let response = AuthenticatorAssertionResponse::create(vm, realm, assertion);
+        allocate(vm, |_| {
+            Self::new(
+                vm,
+                realm,
+                &assertion.credential_id,
+                AnyAuthenticatorResponse::AuthenticatorAssertionResponse(response),
+                assertion.authenticator_attachment,
+                ClientExtensionResults {
+                    app_id: assertion.used_app_id,
+                    resident_key: None,
+                },
+            )
+        })
+    }
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-rawid
+    pub(crate) fn raw_id(&self, _: &mut CallContext) -> WebIdlResult<Gc<ArrayBuffer>> {
+        Ok(self.raw_id)
+    }
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-response
+    pub(crate) fn response(&self, _: &mut CallContext) -> WebIdlResult<AnyAuthenticatorResponse> {
+        Ok(self.response)
+    }
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-authenticatorattachment
+    pub(crate) fn authenticator_attachment(&self, _: &mut CallContext) -> WebIdlResult<Option<Utf16String>> {
+        Ok(self
+            .authenticator_attachment
+            .map(|attachment| Utf16String::from_ascii(attachment.as_str().as_bytes())))
+    }
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-getclientextensionresults
+    pub(crate) fn get_client_extension_results(
+        &self,
+        _: &mut CallContext,
+    ) -> WebIdlResult<AuthenticationExtensionsClientOutputs> {
+        // This operation returns the value of [[clientExtensionsResults]], which is a map containing extension
+        // identifier → client extension output entries produced by the extension’s client extension processing.
+        Ok(self.client_extension_outputs())
+    }
+
+    fn client_extension_outputs(&self) -> AuthenticationExtensionsClientOutputs {
+        AuthenticationExtensionsClientOutputs {
+            appid: self.client_extension_results.app_id,
+            cred_props: self
+                .client_extension_results
+                .resident_key
+                .map(|resident_key| CredentialPropertiesOutput { rk: Some(resident_key) }),
+        }
+    }
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-tojson
+    pub(crate) fn to_json(&self, cx: &mut CallContext) -> WebIdlResult<Gc<Object>> {
+        self.encode_as_json(cx).map_err(Exception::from)
+    }
+
+    fn encode_as_json(&self, cx: &CallContext) -> ThrowCompletionOr<Gc<Object>> {
+        let json = create_dictionary_object(cx);
+        let response = create_dictionary_object(cx);
+
+        // 1. Let encodedResponse be the result of encoding this.response as RegistrationResponseJSON or
+        //    AuthenticationResponseJSON, whose ArrayBuffer members are base64url encoded.
+        set_base64url_member(
+            cx,
+            response,
+            "clientDataJSON",
+            self.response.response().client_data_json_bytes(),
+        )?;
+        match self.response {
+            // https://w3c.github.io/webauthn/#dictdef-authenticatorattestationresponsejson
+            AnyAuthenticatorResponse::AuthenticatorAttestationResponse(attestation) => {
+                set_base64url_member(
+                    cx,
+                    response,
+                    "authenticatorData",
+                    attestation.authenticator_data_bytes(),
+                )?;
+                let transports = attestation
+                    .transports()
+                    .iter()
+                    .map(|transport| string_value(cx, Utf16String::from_utf8(transport)))
+                    .collect::<ThrowCompletionOr<Vec<Value>>>()?;
+                let transports = Array::create_from(cx.vm(), cx.realm(), &transports);
+                set_member(
+                    cx,
+                    response,
+                    "transports",
+                    Value::from_object(transports.upcast::<Object>()),
+                )?;
+                if let Some(public_key) = attestation.public_key_bytes() {
+                    set_base64url_member(cx, response, "publicKey", public_key)?;
+                }
+                let public_key_algorithm = attestation.public_key_algorithm_value().to_js(cx)?;
+                set_member(cx, response, "publicKeyAlgorithm", public_key_algorithm)?;
+                set_base64url_member(
+                    cx,
+                    response,
+                    "attestationObject",
+                    attestation.attestation_object_bytes(),
+                )?;
+            }
+            // https://w3c.github.io/webauthn/#dictdef-authenticatorassertionresponsejson
+            AnyAuthenticatorResponse::AuthenticatorAssertionResponse(assertion) => {
+                set_base64url_member(cx, response, "authenticatorData", assertion.authenticator_data_bytes())?;
+                set_base64url_member(cx, response, "signature", assertion.signature_bytes())?;
+                if let Some(user_handle) = assertion.user_handle_bytes() {
+                    set_base64url_member(cx, response, "userHandle", user_handle)?;
+                }
+            }
+        }
+
+        let id = string_value(cx, base64url_encode(&self.raw_id_bytes))?;
+        set_member(cx, json, "id", id)?;
+        set_base64url_member(cx, json, "rawId", &self.raw_id_bytes)?;
+        set_member(cx, json, "response", Value::from_object(response))?;
+        if let Some(attachment) = self.authenticator_attachment {
+            let attachment = string_value(cx, Utf16String::from_ascii(attachment.as_str().as_bytes()))?;
+            set_member(cx, json, "authenticatorAttachment", attachment)?;
+        }
+        let client_extension_results = self.client_extension_outputs().to_js(cx)?;
+        set_member(cx, json, "clientExtensionResults", client_extension_results)?;
+        let r#type = string_value(cx, Utf16String::from_ascii(b"public-key"))?;
+        set_member(cx, json, "type", r#type)?;
+
+        // 2. Return encodedResponse.
+        Ok(json)
+    }
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-isconditionalmediationavailable
+    pub(crate) fn is_conditional_mediation_available(cx: &mut CallContext) -> WebIdlResult<WebIdlPromise> {
+        // NB: Conditional mediation needs an autofill UI for discoverable credentials, which Ladybird doesn't have yet.
+        Ok(create_resolved_promise(cx.vm(), cx.realm(), Value::from_bool(false)))
+    }
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-isuserverifyingplatformauthenticatoravailable
+    pub(crate) fn is_user_verifying_platform_authenticator_available(
+        cx: &mut CallContext,
+    ) -> WebIdlResult<WebIdlPromise> {
+        // NB: The browser process only knows of roaming authenticators so far.
+        Ok(create_resolved_promise(cx.vm(), cx.realm(), Value::from_bool(false)))
+    }
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-getclientcapabilities
+    pub(crate) fn get_client_capabilities(cx: &mut CallContext) -> WebIdlResult<WebIdlPromise> {
+        // 1. Let p be a new promise.
+        // 2. Let capabilities be an empty record<DOMString, boolean>.
+        let capabilities = create_dictionary_object(cx);
+
+        // 3. Each ClientCapability, and each WebAuthn extension the client supports as "extension:" followed by its
+        //    extension identifier, is set to whether the client supports it.
+        for (key, value) in [
+            ("conditionalCreate", false),
+            ("conditionalGet", false),
+            ("hybridTransport", false),
+            ("passkeyPlatformAuthenticator", false),
+            ("userVerifyingPlatformAuthenticator", false),
+            ("relatedOrigins", false),
+            ("signalAllAcceptedCredentials", false),
+            ("signalCurrentUserDetails", false),
+            ("signalUnknownCredential", false),
+            ("extension:appid", true),
+            ("extension:credProps", true),
+        ] {
+            set_member(cx, capabilities, key, Value::from_bool(value))?;
+        }
+
+        // 4. Resolve p with capabilities.
+        Ok(create_resolved_promise(
+            cx.vm(),
+            cx.realm(),
+            Value::from_object(capabilities),
+        ))
+    }
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-parsecreationoptionsfromjson
+    pub(crate) fn parse_creation_options_from_json<'vm>(
+        cx: &mut CallContext<'vm>,
+        options: PublicKeyCredentialCreationOptionsJSON,
+    ) -> WebIdlResult<PublicKeyCredentialCreationOptions<'vm>> {
+        let (vm, realm) = (cx.vm(), cx.realm());
+
+        // Each Base64URLString member is base64url decoded into an ArrayBuffer, and an "EncodingError" DOMException is
+        // thrown if decoding fails.
+        let user = PublicKeyCredentialUserEntity {
+            parent: PublicKeyCredentialEntity {
+                name: options.user.name,
+            },
+            display_name: options.user.display_name,
+            id: base64url_decode(vm, realm, &options.user.id)?,
+        };
+        Ok(PublicKeyCredentialCreationOptions {
+            attestation: options.attestation,
+            attestation_formats: options.attestation_formats,
+            authenticator_selection: options.authenticator_selection,
+            challenge: base64url_decode(vm, realm, &options.challenge)?,
+            exclude_credentials: parse_descriptors_from_json(vm, realm, options.exclude_credentials)?,
+            extensions: options.extensions.map(parse_extensions_from_json),
+            hints: options.hints,
+            pub_key_cred_params: options.pub_key_cred_params,
+            rp: options.rp,
+            timeout: options.timeout,
+            user,
+        })
+    }
+
+    // https://w3c.github.io/webauthn/#dom-publickeycredential-parserequestoptionsfromjson
+    pub(crate) fn parse_request_options_from_json<'vm>(
+        cx: &mut CallContext<'vm>,
+        options: PublicKeyCredentialRequestOptionsJSON,
+    ) -> WebIdlResult<PublicKeyCredentialRequestOptions<'vm>> {
+        let (vm, realm) = (cx.vm(), cx.realm());
+        Ok(PublicKeyCredentialRequestOptions {
+            allow_credentials: parse_descriptors_from_json(vm, realm, options.allow_credentials)?,
+            challenge: base64url_decode(vm, realm, &options.challenge)?,
+            extensions: options.extensions.map(parse_extensions_from_json),
+            hints: options.hints,
+            rp_id: options.rp_id,
+            timeout: options.timeout,
+            user_verification: options.user_verification,
+        })
+    }
+
+    // https://w3c.github.io/webauthn/#sctn-createCredential
+    pub(crate) fn create_a_new_credential(
+        cx: &CallContext,
+        origin: &Origin,
+        options: &CredentialCreationOptions<'_>,
+        same_origin_with_ancestors: bool,
+        promise: WebIdlPromise,
+    ) -> WebIdlResult<()> {
+        let (vm, realm) = (cx.vm(), cx.realm());
+        let window =
+            window_from_global_object(realm.global_object()).expect("PublicKeyCredential is only exposed to Window");
+
+        // 1. Assert: options.publicKey is present.
+        let pk_options = options.public_key.as_ref().expect("options.publicKey is present");
+
+        // 2. If sameOriginWithAncestors is false:
+        if !same_origin_with_ancestors {
+            // 1. If options.mediation is present with the value conditional, throw a "NotAllowedError" DOMException.
+            if matches!(options.mediation, CredentialMediationRequirement::Conditional) {
+                return Err(dom_exception(
+                    "NotAllowedError",
+                    "Conditional creation is not allowed in a cross-origin frame",
+                ));
+            }
+
+            // 2. If the relevant global object, as determined by the calling create() implementation, does not have
+            //    transient activation, throw a "NotAllowedError" DOMException.
+            if !window.has_transient_activation() {
+                return Err(dom_exception(
+                    "NotAllowedError",
+                    "A cross-origin frame needs user activation to create a credential",
+                ));
+            }
+
+            // 3. Consume user activation of the relevant global object.
+            window.consume_user_activation();
+
+            // 4. If the origin that is creating a credential is different from the top-level origin of the relevant
+            //    global object, the client SHOULD make this fact clear to the user.
+            // NB: The browser process names both in its prompt.
+        }
+
+        // 3. Let pkOptions be the value of options.publicKey.
+        // 4. If pkOptions.timeout is present, check if its value lies within a reasonable range as defined by the client
+        //    and if not, correct it to the closest value lying within that range. Set a timer lifetimeTimer to this
+        //    adjusted value. If pkOptions.timeout is not present, then set lifetimeTimer to a client-specific default.
+        let timeout = adjusted_timeout(pk_options.timeout);
+
+        // 5. If the length of pkOptions.user.id is not between 1 and 64 bytes (inclusive) then throw a TypeError.
+        // NB: All BufferSource objects used in this algorithm MUST be snapshotted when the algorithm begins.
+        let user_id = copy_of_buffer_source(&pk_options.user.id);
+        if user_id.is_empty() || user_id.len() > 64 {
+            return Err(Exception::type_error("The user ID must be between 1 and 64 bytes long"));
+        }
+        let challenge = copy_of_buffer_source(&pk_options.challenge);
+
+        // 6. Let callerOrigin be origin. If callerOrigin is an opaque origin, throw a "NotAllowedError" DOMException.
+        // 7. Let effectiveDomain be the callerOrigin’s effective domain. If effective domain is not a valid domain, then
+        //    throw a "SecurityError" DOMException.
+        // 8. If pkOptions.rp.id is present, and is not a registrable domain suffix of and is not equal to
+        //    effectiveDomain, throw a "SecurityError" DOMException. If it is not present, set pkOptions.rp.id to
+        //    effectiveDomain.
+        let rp_id = determine_rp_id(origin, pk_options.rp.id.as_ref())?;
+
+        // 9. Let credTypesAndPubKeyAlgs be a new list whose items are pairs of PublicKeyCredentialType and a
+        //    COSEAlgorithmIdentifier.
+        // 10. If pkOptions.pubKeyCredParams’s size is zero, append ("public-key", -7) and ("public-key", -257).
+        //     Otherwise, for each current of pkOptions.pubKeyCredParams, append (current.type, current.alg) if
+        //     current.type is a PublicKeyCredentialType this implementation supports. If credTypesAndPubKeyAlgs is
+        //     empty, throw a "NotSupportedError" DOMException.
+        let public_key_algorithms = if pk_options.pub_key_cred_params.is_empty() {
+            vec![COSE_ALGORITHM_ES256, COSE_ALGORITHM_RS256]
+        } else {
+            let algorithms: Vec<i32> = pk_options
+                .pub_key_cred_params
+                .iter()
+                .filter(|parameters| utf8(&parameters.r#type) == "public-key")
+                .map(|parameters| parameters.alg)
+                .collect();
+            if algorithms.is_empty() {
+                return Err(dom_exception(
+                    "NotSupportedError",
+                    "None of the requested credential types is supported",
+                ));
+            }
+            algorithms
+        };
+
+        let exclude_credentials = descriptors_from(&pk_options.exclude_credentials.values());
+
+        // https://w3c.github.io/webauthn/#dictionary-authenticatorSelection
+        let mut authenticator_attachment = None;
+        let mut resident_key = ResidentKeyRequirement::Discouraged;
+        let mut user_verification = UserVerificationRequirement::Preferred;
+        if let Some(selection) = &pk_options.authenticator_selection {
+            authenticator_attachment = selection
+                .authenticator_attachment
+                .as_ref()
+                .and_then(|attachment| AuthenticatorAttachment::from_string(&utf8(attachment)));
+
+            // residentKey: if it is present and set to a value that is a member of ResidentKeyRequirement, use it.
+            // Otherwise, requireResidentKey true means "required", and false (the default) "discouraged".
+            resident_key = match selection.resident_key.as_ref().map(utf8).as_deref() {
+                Some("discouraged") => ResidentKeyRequirement::Discouraged,
+                Some("preferred") => ResidentKeyRequirement::Preferred,
+                Some("required") => ResidentKeyRequirement::Required,
+                _ if selection.require_resident_key => ResidentKeyRequirement::Required,
+                _ => ResidentKeyRequirement::Discouraged,
+            };
+
+            user_verification = UserVerificationRequirement::from_string(&utf8(&selection.user_verification))
+                .unwrap_or(UserVerificationRequirement::Preferred);
+        }
+
+        // https://w3c.github.io/webauthn/#dom-publickeycredentialcreationoptions-attestation
+        // Its value SHOULD be a member of AttestationConveyancePreference. Unknown values fall back to "none".
+        let attestation = match utf8(&pk_options.attestation).as_str() {
+            "indirect" => AttestationConveyancePreference::Indirect,
+            "direct" => AttestationConveyancePreference::Direct,
+            "enterprise" => AttestationConveyancePreference::Enterprise,
+            _ => AttestationConveyancePreference::None,
+        };
+
+        // 11. Let clientExtensions be a new map and let authenticatorExtensions be a new map.
+        // 12. If pkOptions.extensions is present, then for each extensionId → clientExtensionInput of
+        //     pkOptions.extensions, if extensionId is supported by this client platform and is a registration
+        //     extension, set clientExtensions[extensionId] to clientExtensionInput.
+        // https://w3c.github.io/webauthn/#sctn-authenticator-credential-properties-extension
+        let credential_properties = pk_options
+            .extensions
+            .as_ref()
+            .is_some_and(|extensions| extensions.cred_props == Some(true));
+
+        // 13. Let collectedClientData be a new CollectedClientData instance, and 14. let clientDataJSON be its
+        //     JSON-compatible serialization, and 15. let clientDataHash be its hash.
+        // NB: The browser process builds the client data, from its own record of the caller's origin and ancestors.
+
+        // 16. If options.signal is present and aborted, throw the options.signal’s abort reason.
+        if let Some(signal) = options.signal.filter(|signal| signal.aborted()) {
+            return Err(Exception::Thrown(libjs_rust::api::Throw::new(signal.reason())));
+        }
+
+        // 17-22. Find authenticators, issue authenticatorMakeCredential to them, and wait for one to succeed, for the
+        //        user to cancel, for lifetimeTimer to expire, or for options.signal to be aborted.
+        let request = CreateRequest {
+            rp_id,
+            rp_name: utf8(&pk_options.rp.parent.name),
+            user_id,
+            user_name: utf8(&pk_options.user.parent.name),
+            user_display_name: utf8(&pk_options.user.display_name),
+            challenge,
+            public_key_algorithms,
+            timeout,
+            exclude_credentials,
+            authenticator_attachment,
+            resident_key,
+            user_verification,
+            attestation,
+            hints: hints_from(&pk_options.hints),
+            credential_properties,
+        };
+        run_the_ceremony_in_the_browser_process(
+            vm,
+            realm,
+            window,
+            options.signal,
+            CeremonyRequest::Create(request),
+            promise,
+            options.mediation,
+        );
+        Ok(())
+    }
+
+    // https://w3c.github.io/webauthn/#sctn-discover-from-external-source
+    pub(crate) fn discover_from_external_source(
+        cx: &CallContext,
+        origin: &Origin,
+        options: &CredentialRequestOptions<'_>,
+        _same_origin_with_ancestors: bool,
+        promise: WebIdlPromise,
+    ) -> WebIdlResult<()> {
+        let (vm, realm) = (cx.vm(), cx.realm());
+        let window =
+            window_from_global_object(realm.global_object()).expect("PublicKeyCredential is only exposed to Window");
+
+        // 1. Assert: options.publicKey is present.
+        // 2. Let pkOptions be the value of options.publicKey.
+        let pk_options = options.public_key.as_ref().expect("options.publicKey is present");
+
+        // 3. If options.mediation is present with the value conditional, ...
+        // NB: CredentialsContainer rejects conditional requests, since PublicKeyCredential doesn't support conditional
+        //     user mediation yet.
+        assert!(!matches!(
+            options.mediation,
+            CredentialMediationRequirement::Conditional
+        ));
+
+        // 4. Otherwise: if pkOptions.timeout is present, check if its value lies within a reasonable range as defined by
+        //    the client and if not, correct it to the closest value lying within that range. Set a timer lifetimeTimer to
+        //    this adjusted value. If pkOptions.timeout is not present, then set lifetimeTimer to a client-specific
+        //    default.
+        let timeout = adjusted_timeout(pk_options.timeout);
+        let challenge = copy_of_buffer_source(&pk_options.challenge);
+
+        // 5. Let callerOrigin be origin. If callerOrigin is an opaque origin, throw a "NotAllowedError" DOMException.
+        // 6. Let effectiveDomain be the callerOrigin’s effective domain. If effective domain is not a valid domain, then
+        //    throw a "SecurityError" DOMException.
+        // 7. If pkOptions.rpId is present, and is not a registrable domain suffix of and is not equal to
+        //    effectiveDomain, throw a "SecurityError" DOMException. If it is not present, set pkOptions.rpId to
+        //    effectiveDomain.
+        let rp_id = determine_rp_id(origin, pk_options.rp_id.as_ref())?;
+
+        let allow_credentials = descriptors_from(&pk_options.allow_credentials.values());
+        let user_verification = UserVerificationRequirement::from_string(&utf8(&pk_options.user_verification))
+            .unwrap_or(UserVerificationRequirement::Preferred);
+
+        // 8. Let clientExtensions be a new map and let authenticatorExtensions be a new map.
+        // 9. If pkOptions.extensions is present, then for each extensionId → clientExtensionInput of
+        //    pkOptions.extensions, if extensionId is supported by this client platform and is an authentication
+        //    extension, set clientExtensions[extensionId] to clientExtensionInput.
+        // https://w3c.github.io/webauthn/#sctn-appid-extension
+        let mut app_id = None;
+        if let Some(requested_app_id) = pk_options
+            .extensions
+            .as_ref()
+            .and_then(|extensions| extensions.appid.as_ref())
+        {
+            // 1. Let facetId be the result of passing the caller’s origin to the FIDO algorithm for determining the
+            //    FacetID of a calling application.
+            // 2. Let appId be the extension input.
+            let requested_app_id = utf8(requested_app_id);
+
+            // 3. Pass facetId and appId to the FIDO algorithm for determining if a caller’s FacetID is authorized for
+            //    an AppID. If that algorithm rejects appId then return a "SecurityError" DOMException.
+            if !is_a_caller_s_facet_id_authorized_for_an_app_id(origin, &requested_app_id) {
+                return Err(dom_exception(
+                    "SecurityError",
+                    "The caller isn't authorized for this AppID",
+                ));
+            }
+
+            // 4-7. The browser process retries with the AppID when a credential isn't found under the RP ID, and
+            //      reports which one the assertion used.
+            app_id = Some(requested_app_id);
+        }
+
+        // 10. Let collectedClientData be a new CollectedClientData instance, and 11. let clientDataJSON be its
+        //     JSON-compatible serialization, and 12. let clientDataHash be its hash.
+        // NB: The browser process builds the client data, from its own record of the caller's origin and ancestors.
+
+        // 13. If options.signal is present and aborted, throw the options.signal’s abort reason.
+        if let Some(signal) = options.signal.filter(|signal| signal.aborted()) {
+            return Err(Exception::Thrown(libjs_rust::api::Throw::new(signal.reason())));
+        }
+
+        // 14-21. Find authenticators, issue authenticatorGetAssertion to them, and wait for one to succeed, for the
+        //        user to cancel, for lifetimeTimer to expire, or for options.signal to be aborted.
+        let request = GetRequest {
+            rp_id,
+            challenge,
+            timeout,
+            allow_credentials,
+            user_verification,
+            hints: hints_from(&pk_options.hints),
+            app_id,
+        };
+        run_the_ceremony_in_the_browser_process(
+            vm,
+            realm,
+            window,
+            options.signal,
+            CeremonyRequest::Get(request),
+            promise,
+            options.mediation,
+        );
+        Ok(())
+    }
+}
+
+fn parse_descriptors_from_json<'vm>(
+    vm: &'vm Vm,
+    realm: Gc<Realm>,
+    descriptors: Vec<PublicKeyCredentialDescriptorJSON>,
+) -> WebIdlResult<MarkedVec<'vm, PublicKeyCredentialDescriptor>> {
+    let result = MarkedVec::new(vm);
+    for descriptor in descriptors {
+        result.push(PublicKeyCredentialDescriptor {
+            id: base64url_decode(vm, realm, &descriptor.id)?,
+            transports: descriptor.transports,
+            r#type: descriptor.r#type,
+        });
+    }
+    Ok(result)
+}
+
+fn parse_extensions_from_json(
+    extensions: AuthenticationExtensionsClientInputsJSON,
+) -> AuthenticationExtensionsClientInputs {
+    AuthenticationExtensionsClientInputs {
+        appid: extensions.appid,
+        cred_props: extensions.cred_props,
+    }
+}
+
+fn adjusted_timeout(timeout: Option<u32>) -> u32 {
+    // If timeout is present, check if its value lies within a reasonable range as defined by the client and if not,
+    // correct it to the closest value lying within that range. If timeout is not present, use a client-specific
+    // default.
+    timeout.map_or(DEFAULT_CEREMONY_TIMEOUT, |timeout| {
+        timeout.clamp(MINIMUM_CEREMONY_TIMEOUT, MAXIMUM_CEREMONY_TIMEOUT)
+    })
+}
+
+// https://w3c.github.io/webauthn/#enum-hints
+fn hints_from(hints: &[Utf16String]) -> Vec<String> {
+    hints
+        .iter()
+        .map(utf8)
+        .filter(|hint| matches!(hint.as_str(), "security-key" | "client-device" | "hybrid"))
+        .collect()
+}
+
+fn descriptors_from(descriptors: &[PublicKeyCredentialDescriptor]) -> Vec<CredentialDescriptor> {
+    descriptors
+        .iter()
+        // Client platforms MUST ignore any PublicKeyCredentialDescriptor with an unknown type.
+        .filter(|descriptor| utf8(&descriptor.r#type) == "public-key")
+        .map(|descriptor| CredentialDescriptor {
+            id: copy_of_buffer_source(&descriptor.id),
+            transports: descriptor.transports.iter().flatten().map(utf8).collect(),
+        })
+        .collect()
+}
+
+// https://html.spec.whatwg.org/multipage/browsers.html#concept-origin-effective-domain
+fn effective_domain(origin: &Origin) -> Option<&Host> {
+    match origin {
+        Origin::Opaque { .. } => None,
+        Origin::Tuple { host, domain, .. } => Some(domain.as_ref().unwrap_or(host)),
+    }
+}
+
+// https://w3c.github.io/webauthn/#rp-id, steps shared by [[Create]] and [[DiscoverFromExternalSource]]
+fn determine_rp_id(caller_origin: &Origin, requested_rp_id: Option<&Utf16String>) -> WebIdlResult<String> {
+    // Let callerOrigin be origin. If callerOrigin is an opaque origin, throw a "NotAllowedError" DOMException.
+    if caller_origin.is_opaque() {
+        return Err(dom_exception("NotAllowedError", "Opaque origins can't use WebAuthn"));
+    }
+
+    // Let effectiveDomain be the callerOrigin’s effective domain. If effective domain is not a valid domain, then
+    // throw a "SecurityError" DOMException.
+    let Some(effective_domain) =
+        effective_domain(caller_origin).filter(|host| host.kind == HostKind::Domain && !host.serialization.is_empty())
+    else {
+        return Err(dom_exception(
+            "SecurityError",
+            "The caller's origin has no valid domain",
+        ));
+    };
+
+    // If rpId is present:
+    if let Some(requested_rp_id) = requested_rp_id {
+        // If rpId is not a registrable domain suffix of and is not equal to effectiveDomain, and if the client does
+        // not support related origin requests, throw a "SecurityError" DOMException.
+        if !is_a_registrable_domain_suffix_of_or_is_equal_to(requested_rp_id, effective_domain) {
+            return Err(dom_exception(
+                "SecurityError",
+                "The RP ID is not a registrable domain suffix of the caller's domain",
+            ));
+        }
+        return Ok(utf8(requested_rp_id));
+    }
+
+    // Otherwise, set rpId to effectiveDomain.
+    Ok(effective_domain.serialization.clone())
+}
+
+// https://fidoalliance.org/specs/fido-v2.0-id-20180227/fido-appid-and-facets-v2.0-id-20180227.html#determining-if-a-caller-s-facetid-is-authorized-for-an-appid
+fn is_a_caller_s_facet_id_authorized_for_an_app_id(caller_origin: &Origin, app_id: &str) -> bool {
+    // NB: Like other browsers, this allows an AppID on the caller's own site without fetching its trusted facet list.
+    let Some(app_id_url) = basic_parse(app_id, BasicParseOptions::new()) else {
+        return false;
+    };
+    let Some(app_id_host) = app_id_url.serialized_host() else {
+        return false;
+    };
+    if app_id_url.scheme() != "https" {
+        return false;
+    }
+    let Origin::Tuple {
+        scheme,
+        host: caller_host,
+        ..
+    } = caller_origin
+    else {
+        return false;
+    };
+    if scheme != "https" {
+        return false;
+    }
+
+    let app_id_host = Host {
+        kind: app_id_url.host_kind(),
+        serialization: app_id_host.to_owned(),
+    };
+    if *caller_host == app_id_host {
+        return true;
+    }
+
+    let caller_registrable_domain = caller_host.registrable_domain();
+    caller_registrable_domain.is_some() && caller_registrable_domain == app_id_host.registrable_domain()
+}
