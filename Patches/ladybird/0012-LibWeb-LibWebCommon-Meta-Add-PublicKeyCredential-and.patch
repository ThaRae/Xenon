+
+/// The DOMException of Web::WebAuthn::ErrorName.
+fn error_name_from_abi(value: u8) -> &'static str {
+    match value {
+        0 => "NotAllowedError",
+        1 => "InvalidStateError",
+        2 => "NotSupportedError",
+        3 => "SecurityError",
+        4 => "ConstraintError",
+        _ => "UnknownError",
+    }
+}
+
+fn spans_of_strings(strings: &[String]) -> Vec<Span<'_, u8>> {
+    strings.iter().map(|string| Span::new(string.as_bytes())).collect()
+}
+
+fn with_descriptors_abi<R>(
+    descriptors: &[CredentialDescriptor],
+    steps: impl FnOnce(Span<'_, CredentialDescriptorAbi<'_>>) -> R,
+) -> R {
+    let transports: Vec<Vec<Span<'_, u8>>> = descriptors
+        .iter()
+        .map(|descriptor| spans_of_strings(&descriptor.transports))
+        .collect();
+    let descriptors: Vec<CredentialDescriptorAbi<'_>> = descriptors
+        .iter()
+        .zip(&transports)
+        .map(|(descriptor, transports)| CredentialDescriptorAbi {
+            id: Span::new(&descriptor.id),
+            transports: Span::new(transports),
+        })
+        .collect();
+    steps(Span::new(&descriptors))
+}
+
+/// What a ceremony running in the browser process needs to remember, until it completes.
+#[derive(Trace)]
+#[gc(crate = libjs_rust)]
+struct Ceremony {
+    window: CppWindow,
+    realm: Gc<Realm>,
+    promise: WebIdlPromise,
+    #[gc(untraced)]
+    mediation: CredentialMediationRequirement,
+    signal: Option<Ref<AbortSignal>>,
+    #[gc(untraced)]
+    abort_algorithm_id: Cell<Option<u64>>,
+    #[gc(untraced)]
+    request_id: Cell<Option<u64>>,
+    #[gc(untraced)]
+    is_complete: Cell<bool>,
+}
+
+static CEREMONY_CLASS: EmbedderClass<Ceremony> = EmbedderClass::new("WebAuthnCeremony");
+
+impl EmbedderValue for Ceremony {
+    const CLASS: &'static EmbedderClass<Self> = &CEREMONY_CLASS;
+}
+
+type CeremonyRef = Gc<EmbedderCell<Ceremony>>;
+
+impl Ceremony {
+    fn complete(this: CeremonyRef, vm: &Vm, result: WebIdlResult<Option<CreatedCredential>>) {
+        if this.is_complete.replace(true) {
+            return;
+        }
+        if let (Some(signal), Some(abort_algorithm_id)) = (this.signal, this.abort_algorithm_id.get()) {
+            signal.remove_abort_algorithm(vm, abort_algorithm_id);
+        }
+        settle_in_a_task(vm, this.realm, this.promise, result, this.mediation);
+    }
+}
+
+/// A request for the authenticator part of a ceremony.
+pub(crate) enum CeremonyRequest {
+    Create(CreateRequest),
+    Get(GetRequest),
+}
+
+impl CeremonyRequest {
+    /// Hands the request to the browser process, and returns the ID it has there, or None if the embedder can't run
+    /// ceremonies.
+    fn start(&self, window: &CppWindow, ceremony: CeremonyRef) -> Option<u64> {
+        let mut request_id = 0;
+        let started = match self {
+            Self::Create(request) => {
+                let hints = spans_of_strings(&request.hints);
+                with_descriptors_abi(&request.exclude_credentials, |exclude_credentials| {
+                    let abi = CreateRequestAbi {
+                        rp_id: Span::new(request.rp_id.as_bytes()),
+                        rp_name: Span::new(request.rp_name.as_bytes()),
+                        user_id: Span::new(&request.user_id),
+                        user_name: Span::new(request.user_name.as_bytes()),
+                        user_display_name: Span::new(request.user_display_name.as_bytes()),
+                        challenge: Span::new(&request.challenge),
+                        public_key_algorithms: Span::new(&request.public_key_algorithms),
+                        timeout: request.timeout,
+                        exclude_credentials,
+                        authenticator_attachment: request
+                            .authenticator_attachment
+                            .map_or(0, |attachment| attachment as u8),
+                        resident_key: request.resident_key as u8,
+                        user_verification: request.user_verification as u8,
+                        attestation: request.attestation as u8,
+                        hints: Span::new(&hints),
+                        credential_properties: request.credential_properties,
+                    };
+                    // SAFETY: The window and the ceremony are live, and the request is lent for the call.
+                    unsafe {
+                        web_web_authn_request_create(window.as_ptr(), ceremony.as_ptr().cast(), &abi, &mut request_id)
+                    }
+                })
+            }
+            Self::Get(request) => {
+                let hints = spans_of_strings(&request.hints);
+                with_descriptors_abi(&request.allow_credentials, |allow_credentials| {
+                    let abi = GetRequestAbi {
+                        rp_id: Span::new(request.rp_id.as_bytes()),
+                        challenge: Span::new(&request.challenge),
+                        timeout: request.timeout,
+                        allow_credentials,
+                        user_verification: request.user_verification as u8,
+                        hints: Span::new(&hints),
+                        has_app_id: request.app_id.is_some(),
+                        app_id: Span::new(request.app_id.as_deref().unwrap_or_default().as_bytes()),
+                    };
+                    // SAFETY: The window and the ceremony are live, and the request is lent for the call.
+                    unsafe {
+                        web_web_authn_request_get(window.as_ptr(), ceremony.as_ptr().cast(), &abi, &mut request_id)
+                    }
+                })
+            }
+        };
+        started.then_some(request_id)
+    }
+}
+
+/// Hands the authenticator part of a ceremony to the browser process, and settles the promise with what it returns,
+/// or with the abort reason if the signal is aborted first.
+pub(crate) fn run_the_ceremony_in_the_browser_process(
+    vm: &Vm,
+    realm: Gc<Realm>,
+    window: CppWindow,
+    signal: Option<Ref<AbortSignal>>,
+    request: CeremonyRequest,
+    promise: WebIdlPromise,
+    mediation: CredentialMediationRequirement,
+) {
+    let ceremony = CEREMONY_CLASS.allocate(vm, |_| Ceremony {
+        window: window.clone(),
+        realm,
+        promise,
+        mediation,
+        signal,
+        abort_algorithm_id: Cell::new(None),
+        request_id: Cell::new(None),
+        is_complete: Cell::new(false),
+    });
+
+    // NB: An embedder that can't run ceremonies has no authenticators, and the user can never complete one.
+    let Some(request_id) = request.start(&window, ceremony) else {
+        Ceremony::complete(
+            ceremony,
+            vm,
+            Err(Exception::Dom(
+                "NotAllowedError",
+                Utf16String::from_ascii(b"No authenticators are available"),
+            )),
+        );
+        return;
+    };
+    ceremony.request_id.set(Some(request_id));
+
+    // https://w3c.github.io/webauthn/#sctn-abortoperation
+    // If options.signal is aborted, cancel the authenticator operations and throw the options.signal’s abort reason.
+    if let Some(signal) = signal {
+        let algorithm = NativeFunction::create(
+            vm,
+            ceremony,
+            |vm, ceremony: &CeremonyRef| {
+                let ceremony = *ceremony;
+                if ceremony.is_complete.get() {
+                    return Ok(Value::UNDEFINED);
+                }
+                if let Some(request_id) = ceremony.request_id.get() {
+                    // SAFETY: The window is live.
+                    unsafe { web_web_authn_cancel_request(ceremony.window.as_ptr(), request_id) };
+                }
+                let reason = ceremony.signal.map_or(Value::UNDEFINED, |signal| signal.reason());
+                Ceremony::complete(ceremony, vm, Err(Exception::Thrown(Throw::new(reason))));
+                Ok(Value::UNDEFINED)
+            },
+            0,
+            &PropertyKey::from_utf8(""),
+            Some(realm),
+            None,
+            None,
+        );
+        ceremony
+            .abort_algorithm_id
+            .set(signal.add_abort_algorithm(vm, AbortAlgorithm::Rust(algorithm)));
+    }
+}
+
+/// The browser process's answer to a ceremony's request.
+///
+/// # Safety
+///
+/// `vm` must be the live VM, `ceremony` the live cell that the request was made with, and `result` lent for the call.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn web_rust_web_authn_ceremony_completed(
+    vm: *mut c_void,
+    ceremony: *mut c_void,
+    result: &ResultAbi<'_>,
+) {
+    // SAFETY: The caller passes the live VM and the live cell of a ceremony.
+    let (vm, ceremony) = unsafe {
+        (
+            &*vm.cast::<Vm>(),
+            CEREMONY_CLASS
+                .downcast(NonNull::new(ceremony).expect("LibWeb passes the ceremony"))
+                .expect("LibWeb passes a WebAuthnCeremony"),
+        )
+    };
+    let outcome = match result.kind {
+        RESULT_KIND_REGISTRATION => {
+            let registration = RegistrationResponse::from_abi(result);
+            Ok(Some(CreatedCredential::PublicKey(
+                PublicKeyCredential::create_from_registration(vm, ceremony.realm, &registration),
+            )))
+        }
+        RESULT_KIND_ASSERTION => {
+            let assertion = AssertionResponse::from_abi(result);
+            Ok(Some(CreatedCredential::PublicKey(
+                PublicKeyCredential::create_from_assertion(vm, ceremony.realm, &assertion),
+            )))
+        }
+        _ => Err(Exception::Dom(
+            error_name_from_abi(result.error_name),
+            Utf16String::from_utf8(&string_from_abi(result.error_message)),
+        )),
+    };
+    Ceremony::complete(ceremony, vm, outcome);
+}
