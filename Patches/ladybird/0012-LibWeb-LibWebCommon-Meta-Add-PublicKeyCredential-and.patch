@@ -0,0 +1,86 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+//! AuthenticatorAssertionResponse, https://w3c.github.io/webauthn/#authenticatorassertionresponse
+
+use libjs_rust::api::{ArrayBuffer, Gc, Realm, Trace, Vm};
+
+use super::authenticator_response::{AuthenticatorResponse, new_array_buffer};
+use super::ceremony::AssertionResponse;
+use crate::bindings::interface::{Inherits, Ref, Wrappable, allocate};
+use crate::bindings::{CallContext, WebIdlResult};
+
+#[derive(Trace)]
+#[gc(crate = libjs_rust)]
+pub(crate) struct AuthenticatorAssertionResponse {
+    response: AuthenticatorResponse,
+    authenticator_data: Gc<ArrayBuffer>,
+    signature: Gc<ArrayBuffer>,
+    user_handle: Option<Gc<ArrayBuffer>>,
+    #[gc(untraced)]
+    authenticator_data_bytes: Vec<u8>,
+    #[gc(untraced)]
+    signature_bytes: Vec<u8>,
+    #[gc(untraced)]
+    user_handle_bytes: Option<Vec<u8>>,
+}
+
+impl Wrappable for AuthenticatorAssertionResponse {}
+
+impl Inherits<AuthenticatorResponse> for AuthenticatorAssertionResponse {
+    fn parent(&self) -> &AuthenticatorResponse {
+        &self.response
+    }
+}
+
+impl AuthenticatorAssertionResponse {
+    pub(crate) fn create(vm: &Vm, realm: Gc<Realm>, assertion: &AssertionResponse) -> Ref<Self> {
+        // https://w3c.github.io/webauthn/#dom-authenticatorassertionresponse-userhandle
+        // If the authenticator returned no user handle, userHandle is null.
+        let user_handle_bytes = assertion
+            .user_handle
+            .clone()
+            .filter(|user_handle| !user_handle.is_empty());
+        allocate(vm, |_| Self {
+            response: AuthenticatorResponse::new(vm, realm, &assertion.client_data_json),
+            authenticator_data: new_array_buffer(vm, realm, &assertion.authenticator_data),
+            signature: new_array_buffer(vm, realm, &assertion.signature),
+            user_handle: user_handle_bytes
+                .as_ref()
+                .map(|user_handle| new_array_buffer(vm, realm, user_handle)),
+            authenticator_data_bytes: assertion.authenticator_data.clone(),
+            signature_bytes: assertion.signature.clone(),
+            user_handle_bytes,
+        })
+    }
+
+    pub(crate) fn authenticator_data_bytes(&self) -> &[u8] {
+        &self.authenticator_data_bytes
+    }
+
+    pub(crate) fn signature_bytes(&self) -> &[u8] {
+        &self.signature_bytes
+    }
+
+    pub(crate) fn user_handle_bytes(&self) -> Option<&[u8]> {
+        self.user_handle_bytes.as_deref()
+    }
+
+    // https://w3c.github.io/webauthn/#dom-authenticatorassertionresponse-authenticatordata
+    pub(crate) fn authenticator_data(&self, _: &mut CallContext) -> WebIdlResult<Gc<ArrayBuffer>> {
+        Ok(self.authenticator_data)
+    }
+
+    // https://w3c.github.io/webauthn/#dom-authenticatorassertionresponse-signature
+    pub(crate) fn signature(&self, _: &mut CallContext) -> WebIdlResult<Gc<ArrayBuffer>> {
+        Ok(self.signature)
+    }
+
+    // https://w3c.github.io/webauthn/#dom-authenticatorassertionresponse-userhandle
+    pub(crate) fn user_handle(&self, _: &mut CallContext) -> WebIdlResult<Option<Gc<ArrayBuffer>>> {
+        Ok(self.user_handle)
+    }
+}
