 #include <LibWeb/HTML/EventLoop/EventLoop.h>
 #include <LibWeb/HTML/LocalNavigable.h>
 #include <LibWeb/HTML/PreloadEntry.h>
@@ -2428,7 +2429,15 @@ GC::Ref<PendingResponse> http_network_or_cache_fetch(JS::Realm& realm, Infrastru
         if (!http_request->header_list()->contains("User-Agent"sv)) {
             // 1. Let userAgent be httpRequest’s client’s environment default `User-Agent` value.
             // FIXME: Honor WebDriver BiDi emulated User-Agent.
-            auto user_agent = Infrastructure::default_user_agent_value(fetch_params.loader_config(), http_request->current_url());
+            auto configured = Infrastructure::default_user_agent_value(fetch_params.loader_config(), http_request->current_url());
+            Farbling::Seed seed {};
+            if (auto const& client = http_request->client(); client.has_value()) {
+                if (auto const* address = client->get_pointer<HTML::EnvironmentSettingsObjectAddress>()) {
+                    if (auto settings = HTML::environment_settings_object_at(*address))
+                        seed = settings->farbling_seed();
+                }
+            }
+            auto user_agent = Farbling::effective_user_agent(seed, configured).to_byte_string();
 
             // 2. Append (`User-Agent`, userAgent) to httpRequest’s header list.
             http_request->header_list()->append({ "User-Agent"sv, move(user_agent) });
