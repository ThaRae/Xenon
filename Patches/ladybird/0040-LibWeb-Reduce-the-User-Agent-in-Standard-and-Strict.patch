--- /dev/null
+++ b/Tests/LibWeb/TestUserAgentReduction.cpp
@@ -0,0 +1,59 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibTest/TestCase.h>
+#include <LibWeb/Farbling/UserAgent.h>
+#include <LibWebCommon/Loader/UserAgent.h>
+
+TEST_CASE(off_keeps_ladybird_default)
+{
+    Web::Farbling::Seed off {};
+    auto value = Web::Farbling::effective_user_agent(off, Web::default_user_agent);
+    EXPECT_EQ(value, Web::default_user_agent);
+    EXPECT(value.contains("Ladybird/"sv));
+}
+
+TEST_CASE(standard_is_reduced_and_stable)
+{
+    Web::Farbling::Seed a { .level = Web::Farbling::Level::Standard, .high = 1, .low = 2 };
+    Web::Farbling::Seed b { .level = Web::Farbling::Level::Standard, .high = 9, .low = 8 };
+    auto first = Web::Farbling::effective_user_agent(a, Web::default_user_agent);
+    auto second = Web::Farbling::effective_user_agent(b, Web::default_user_agent);
+    EXPECT_EQ(first, second);
+    EXPECT_EQ(first, Web::Farbling::reduced_user_agent());
+    EXPECT(!first.contains("Ladybird/"sv));
+    EXPECT(first.contains("Chrome/153"sv));
+    EXPECT(first.starts_with_bytes("Mozilla/5.0 ("sv));
+}
+
+TEST_CASE(strict_matches_standard)
+{
+    Web::Farbling::Seed standard { .level = Web::Farbling::Level::Standard, .high = 3, .low = 4 };
+    Web::Farbling::Seed strict { .level = Web::Farbling::Level::Strict, .high = 3, .low = 4 };
+    EXPECT_EQ(Web::Farbling::effective_user_agent(standard, Web::default_user_agent),
+        Web::Farbling::effective_user_agent(strict, Web::default_user_agent));
+}
+
+TEST_CASE(override_wins)
+{
+    Web::Farbling::Seed seed { .level = Web::Farbling::Level::Standard, .high = 1, .low = 1 };
+    auto override_ua = "Mozilla/5.0 (compatible; Override/1.0)"sv;
+    EXPECT_EQ(Web::Farbling::effective_user_agent(seed, override_ua), override_ua);
+}
+
+TEST_CASE(reduced_platform_is_frozen)
+{
+    Web::Farbling::Seed seed { .level = Web::Farbling::Level::Standard, .high = 1, .low = 1 };
+    auto platform = Web::Farbling::effective_platform(seed, "Linux aarch64"sv, Web::default_user_agent);
+    EXPECT_EQ(platform, Web::Farbling::reduced_platform());
+    EXPECT(!platform.contains("aarch64"sv));
+}
+
+TEST_CASE(off_platform_is_unchanged)
+{
+    Web::Farbling::Seed off {};
+    EXPECT_EQ(Web::Farbling::effective_platform(off, "Linux aarch64"sv, Web::default_user_agent), "Linux aarch64"sv);
+}
