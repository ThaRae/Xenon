--- /dev/null
+++ b/Libraries/LibWeb/Farbling/UserAgent.cpp
@@ -0,0 +1,51 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibWeb/Farbling/UserAgent.h>
+
+namespace Web::Farbling {
+
+StringView reduced_user_agent()
+{
+    // Chrome's reduced UA for this OS. Same string for every Xenon user on this platform.
+    static constexpr auto value = "Mozilla/5.0 (" UA_PLATFORM_STRING ") AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36"sv;
+    return value;
+}
+
+StringView reduced_platform()
+{
+#if defined(AK_OS_MACOS)
+    return "MacIntel"sv;
+#elif defined(AK_OS_IOS)
+    return "iPhone"sv;
+#elif defined(AK_OS_WINDOWS)
+    return "Win32"sv;
+#else
+    // Matches the frozen Linux UA token (X11; Linux x86_64), not uname().
+    return "Linux x86_64"sv;
+#endif
+}
+
+static bool user_agent_is_overridden(StringView configured)
+{
+    return configured != default_user_agent;
+}
+
+String effective_user_agent(Seed const& seed, StringView configured)
+{
+    if (!seed.enabled() || user_agent_is_overridden(configured))
+        return MUST(String::from_utf8(configured));
+    return MUST(String::from_utf8(reduced_user_agent()));
+}
+
+String effective_platform(Seed const& seed, StringView configured_platform, StringView configured_user_agent)
+{
+    if (!seed.enabled() || user_agent_is_overridden(configured_user_agent))
+        return MUST(String::from_utf8(configured_platform));
+    return MUST(String::from_utf8(reduced_platform()));
+}
+
+}
diff --git a/Libraries/LibWeb/Farbling/UserAgent.h b/Libraries/LibWeb/Farbling/UserAgent.h
new file mode 100644
index 0000000000000000000000000000000000000000..066a9299c734531cb9a1c5f405f37c0fbe023842
--- /dev/null
+++ b/Libraries/LibWeb/Farbling/UserAgent.h
@@ -0,0 +1,34 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/String.h>
+#include <AK/StringView.h>
+#include <LibWeb/Export.h>
+#include <LibWebCommon/Farbling/FarblingSeed.h>
+#include <LibWebCommon/Loader/UserAgent.h>
+
+namespace Web::Farbling {
+
+// One reduced UA per OS. Tokens, and why each is here:
+//   Mozilla/5.0 — required prefix; every browser sends it.
+//   (UA_PLATFORM_STRING) — Chrome's frozen desktop/mobile token for this OS. No distro,
+//     no kernel, no real CPU: servers only recognize these frozen values.
+//   AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36 — Chrome's
+//     reduced product tokens. Major Chrome version only (zeros after 153). No Ladybird
+//     product: that unique token is the fingerprint.
+// Off keeps Ladybird's default_user_agent. Standard and Strict use this string for every
+// site. A user/devtools spoof of LoaderConfig.user_agent wins over the reduced string.
+
+WEB_API StringView reduced_user_agent();
+WEB_API StringView reduced_platform();
+
+// configured is LoaderConfig.user_agent after site-compatibility transforms.
+WEB_API String effective_user_agent(Seed const& seed, StringView configured);
+WEB_API String effective_platform(Seed const& seed, StringView configured_platform, StringView configured_user_agent);
+
+}
