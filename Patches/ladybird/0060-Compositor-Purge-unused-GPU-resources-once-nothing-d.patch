From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Theo Slater <theoslater1@gmail.com>
Date: Wed, 4 Nov 2026 23:14:07 -0500
Subject: [PATCH] Compositor: Purge unused GPU resources once nothing draws

Skia trims its resource cache only after a flush, so once every context
stops drawing, the cache keeps whatever the last frames left in it for
as long as nothing draws again. Releasing a context's cached rasters
purges only scratch resources, and only when there were rasters to
release.

Five seconds after the last frame or screenshot finishes, purge the
resources that nothing has used in that time, and give the allocators'
free pages back as a raster release does. The next frame makes again
what it needs.

This follows LADYBIRD_COMPOSITOR_IDLE_RELEASE=0, and with
LADYBIRD_COMPOSITOR_IDLE_RELEASE_LOG=1 logs the cache's size before and
after each purge.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Services/Compositor/CompositorState.cpp    | 42 ++++++++++++++++++++++
 Services/Compositor/CompositorState.h      |  4 +++
 Services/Compositor/SkiaBackendContext.cpp |  6 ++++
 Services/Compositor/SkiaBackendContext.h   |  2 ++
 4 files changed, 54 insertions(+)

diff --git a/Services/Compositor/CompositorState.cpp b/Services/Compositor/CompositorState.cpp
index 3679836c35e92184f532ce8b211077459bcbd853..ebdf68ee3a06dc88c78505b5c398b38a66ef9394 100644
--- a/Services/Compositor/CompositorState.cpp
+++ b/Services/Compositor/CompositorState.cpp
@@ -36,6 +36,7 @@ static constexpr auto visible_context_raster_release_delay = AK::Duration::from_
 static constexpr auto free_page_release_interval = AK::Duration::from_seconds(4);
 // Skia can only purge a texture once the GPU work that reads it is done.
 static constexpr auto gpu_work_retry_delay = AK::Duration::from_milliseconds(100);
+static constexpr auto idle_gpu_resource_purge_delay = AK::Duration::from_seconds(5);
 
 static bool idle_memory_release_is_enabled()
 {
@@ -168,6 +169,45 @@ void CompositorState::release_idle_memory()
         schedule_idle_memory_release(*next_release_time);
 }
 
+void CompositorState::schedule_idle_gpu_resource_purge()
+{
+    if (!idle_memory_release_is_enabled() || !m_skia_backend_context)
+        return;
+    m_last_gpu_work_finished_time = MonotonicTime::now();
+    if (!m_idle_gpu_resource_purge_timer)
+        m_idle_gpu_resource_purge_timer = Core::Timer::create_single_shot(AK::Duration::zero(), [this] { purge_idle_gpu_resources(); });
+    if (!m_idle_gpu_resource_purge_timer->is_active())
+        m_idle_gpu_resource_purge_timer->restart(idle_gpu_resource_purge_delay);
+}
+
+void CompositorState::purge_idle_gpu_resources()
+{
+    auto now = MonotonicTime::now();
+    auto idle_time = now - m_last_gpu_work_finished_time;
+    if (idle_time < idle_gpu_resource_purge_delay) {
+        m_idle_gpu_resource_purge_timer->restart(idle_gpu_resource_purge_delay - idle_time);
+        return;
+    }
+    if (!m_pending_async_presents.is_empty()) {
+        m_idle_gpu_resource_purge_timer->restart(gpu_work_retry_delay);
+        return;
+    }
+
+    auto cache_bytes_before = m_skia_backend_context->resource_cache_bytes();
+    m_skia_backend_context->purge_resources_unused_for(idle_gpu_resource_purge_delay);
+    auto cache_bytes_after = m_skia_backend_context->resource_cache_bytes();
+    if (idle_memory_release_is_logged())
+        dbgln("COMPOSITOR-IDLE-GPU-PURGE idle_ms={} cache_bytes={}->{}", idle_time.to_milliseconds(), cache_bytes_before, cache_bytes_after);
+    if (cache_bytes_after >= cache_bytes_before)
+        return;
+
+    m_free_page_release_is_pending = true;
+    if (!m_last_free_page_release_time.has_value() || now - *m_last_free_page_release_time >= free_page_release_interval)
+        release_free_pages();
+    else
+        schedule_idle_memory_release(*m_last_free_page_release_time + free_page_release_interval);
+}
+
 void CompositorState::release_free_pages()
 {
     m_free_page_release_is_pending = false;
@@ -1641,6 +1681,7 @@ bool CompositorState::request_screenshot(Web::CompositorContextId context_id, Gf
     if (idle_memory_release_is_logged())
         dbgln("COMPOSITOR-SCREENSHOT context={} after_release={}", context_id, repaints_released_rasters);
     schedule_idle_memory_release_for(*context);
+    schedule_idle_gpu_resource_purge();
     return true;
 }
 
@@ -1763,6 +1804,7 @@ void CompositorState::did_finish_async_present(PendingAsyncPresent& pending_pres
     (void)m_pending_async_presents.remove(pending_present_iterator);
     if (m_pending_async_presents.is_empty() && m_gpu_completion_timer)
         m_gpu_completion_timer->stop();
+    schedule_idle_gpu_resource_purge();
 
     deliver_rendered_frame(finished_present);
 }
diff --git a/Services/Compositor/CompositorState.h b/Services/Compositor/CompositorState.h
index dc52bd987b792947fecc0576c035d79f1feb3851..f762dfda4379e0107a7607475aeb7150450b37a8 100644
--- a/Services/Compositor/CompositorState.h
+++ b/Services/Compositor/CompositorState.h
@@ -324,6 +324,8 @@ private:
     void schedule_idle_memory_release_for(PresentedContext const&);
     void release_idle_memory();
     void release_free_pages();
+    void schedule_idle_gpu_resource_purge();
+    void purge_idle_gpu_resources();
 
     HashMap<Web::CompositorContextId, NonnullOwnPtr<PresentedContext>> m_presented_contexts;
 
@@ -353,6 +355,8 @@ private:
     Optional<MonotonicTime> m_last_free_page_release_time;
     bool m_free_page_release_is_pending { false };
     RefPtr<Threading::Thread> m_heap_trim_thread;
+    RefPtr<Core::Timer> m_idle_gpu_resource_purge_timer;
+    MonotonicTime m_last_gpu_work_finished_time;
 
     HashMap<CompositorStateClient*, PresentationCapabilities> m_presentations;
     u64 m_next_presentation_id { 1 };
diff --git a/Services/Compositor/SkiaBackendContext.cpp b/Services/Compositor/SkiaBackendContext.cpp
index 219fa868c9884ea12baf83345eacce05ad82c880..1ead07d71bd6e7d82b4e22bf446c981d1eda9d40 100644
--- a/Services/Compositor/SkiaBackendContext.cpp
+++ b/Services/Compositor/SkiaBackendContext.cpp
@@ -201,6 +201,12 @@ void SkiaBackendContext::purge_unlocked_scratch_resources()
         context->purgeUnlockedResources(GrPurgeResourceOptions::kScratchResourcesOnly);
 }
 
+void SkiaBackendContext::purge_resources_unused_for(AK::Duration age)
+{
+    if (auto* context = sk_context())
+        context->performDeferredCleanup(std::chrono::milliseconds(age.to_milliseconds()));
+}
+
 void SkiaBackendContext::initialize_gpu_backend(Optional<GpuDeviceIdentity> const& preferred_device)
 {
     VERIFY(!main_thread_context());
diff --git a/Services/Compositor/SkiaBackendContext.h b/Services/Compositor/SkiaBackendContext.h
index 906e1acdd237276a157c4680fcb7622b2e0b8c3f..ce093ff7821600c36676b0e982d8df3f47be72a3 100644
--- a/Services/Compositor/SkiaBackendContext.h
+++ b/Services/Compositor/SkiaBackendContext.h
@@ -10,6 +10,7 @@
 #include <AK/Function.h>
 #include <AK/Noncopyable.h>
 #include <AK/Optional.h>
+#include <AK/Time.h>
 #include <LibCore/Timer.h>
 #include <LibGfx/GpuDeviceIdentity.h>
 
@@ -67,6 +68,7 @@ public:
     void check_async_work_completion();
     size_t resource_cache_bytes() const;
     void purge_unlocked_scratch_resources();
+    void purge_resources_unused_for(AK::Duration);
     virtual GrDirectContext* sk_context() const = 0;
 
     virtual MetalContext& metal_context() = 0;
