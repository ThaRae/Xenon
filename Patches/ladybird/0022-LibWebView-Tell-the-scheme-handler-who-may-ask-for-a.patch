From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan <ryan@esterlines.com>
Date: Mon, 26 Oct 2026 22:40:26 -0400
Subject: [PATCH] LibWebView: Tell the scheme handler who may ask for a
 subresource

A browser lets web pages load some of an extension's files, those the
extension lists as web accessible for the page's origin, as images,
stylesheets, and scripts. The scheme handler only learned whether the
asking process hosts a document of the URL's own origin, and for a
navigation, who started it, so it couldn't let a page load such a file
as a subresource.

URLSchemeRequest now names the origins that may be asking for a
subresource: a worker's own, or those of the documents the asking
process hosts for its page. The UI process knows which documents those
are from its own records, but not which of them asks, so this is as
close to the request's initiator as it can get without trusting the
renderer. Site isolation keeps them to one site.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Libraries/LibWebView/URLSchemeHandler.h       |  5 +++++
 Libraries/LibWebView/WebContentPage.cpp       | 11 ++++++++++-
 Libraries/LibWebView/WorkerProcessManager.cpp |  1 +
 3 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/Libraries/LibWebView/URLSchemeHandler.h b/Libraries/LibWebView/URLSchemeHandler.h
index 29f3cab80d12c5a7280145f57851eaab00ce34cf..0b5bc6d988baf5001186956a628358ddb184c9f9 100644
--- a/Libraries/LibWebView/URLSchemeHandler.h
+++ b/Libraries/LibWebView/URLSchemeHandler.h
@@ -37,6 +37,11 @@ struct URLSchemeRequest {
     bool is_navigation { false };
     // The origin of the document that started the navigation, or none if the user started it from the browser's UI.
     Optional<URL::Origin> navigation_initiator;
+
+    // For a subresource, the origins that may be asking for it: a worker's, or those of the documents the asking process
+    // hosts for its page. The UI process knows which documents those are, but not which one asks, so this is as close
+    // to the request's initiator as it gets. Site isolation keeps them to one site.
+    Vector<URL::Origin> requester_origins;
 };
 
 struct URLSchemeResponse {
diff --git a/Libraries/LibWebView/WebContentPage.cpp b/Libraries/LibWebView/WebContentPage.cpp
index a4a88a7f13c2166c1dc75292d432e22a59b72290..2cbffb199a4e2e6a4ea4baf4dafea75b94593a3d 100644
--- a/Libraries/LibWebView/WebContentPage.cpp
+++ b/Libraries/LibWebView/WebContentPage.cpp
@@ -1626,7 +1626,7 @@ void WebContentPage::did_request_embedder_resource(URL::URL url, i32 request_id)
         return;
     }
 
-    URLSchemeRequest request { .url = url, .from_same_origin_process = client().hosts_a_document_of_origin(url.origin()), .is_navigation = false, .navigation_initiator = {} };
+    URLSchemeRequest request { .url = url, .from_same_origin_process = client().hosts_a_document_of_origin(url.origin()), .is_navigation = false, .navigation_initiator = {}, .requester_origins = {} };
     traversable().for_each_in_inclusive_subtree([&](CanonicalNavigable const& navigable) {
         auto navigation = navigable.uncommitted_navigation();
         if (!navigation || navigation->worker() != this || !navigation->url.equals(url, URL::ExcludeFragment::Yes))
@@ -1638,6 +1638,15 @@ void WebContentPage::did_request_embedder_resource(URL::URL url, i32 request_id)
         return IterationDecision::Break;
     });
 
+    if (!request.is_navigation) {
+        for_each_hosted_document([&](CanonicalDocument& document) {
+            auto const& origin = document.origin();
+            if (!request.requester_origins.contains_slow(origin))
+                request.requester_origins.append(origin);
+            return IterationDecision::Continue;
+        });
+    }
+
     auto response = (*handler)(request);
     if (response.is_error()) {
         async_handle_embedder_resource_return(response.error().is_errno() ? response.error().code() : ENOENT, {}, {}, request_id);
diff --git a/Libraries/LibWebView/WorkerProcessManager.cpp b/Libraries/LibWebView/WorkerProcessManager.cpp
index 4e8f79f8ced3d1616a1f14fd8a52d08bd174e224..08b2c88d8be71729ca6e96b452939e78dbf0762d 100644
--- a/Libraries/LibWebView/WorkerProcessManager.cpp
+++ b/Libraries/LibWebView/WorkerProcessManager.cpp
@@ -707,6 +707,7 @@ void WorkerProcessManager::worker_did_request_embedder_resource(Web::HTML::Worke
         .from_same_origin_process = agent.inside_settings->origin().is_same_origin(url.origin()),
         .is_navigation = false,
         .navigation_initiator = {},
+        .requester_origins = { agent.inside_settings->origin() },
     };
     auto response = (*handler)(request);
     if (response.is_error()) {
