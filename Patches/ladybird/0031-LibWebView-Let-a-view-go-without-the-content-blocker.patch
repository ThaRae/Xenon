     RefPtr<WebContentClient> web_content_client;
-    if (is_private == IsPrivate::Yes) {
+    // NB: The spare process has built the content blocker's engine already.
+    if (enable_content_blocker == EnableContentBlocker::No) {
+        web_content_client = TRY(create_web_content_client(session_for_new_view(is_private), allocate_page_id(), {}, {}, {}, {}, Web::HTML::VisibilityState::Hidden, EnableContentBlocker::No));
+    } else if (is_private == IsPrivate::Yes) {
         web_content_client = TRY(create_web_content_client(session_for_new_view(IsPrivate::Yes), allocate_page_id()));
     } else if (m_spare_web_content_process) {
         web_content_client = m_spare_web_content_process.release_nonnull();
