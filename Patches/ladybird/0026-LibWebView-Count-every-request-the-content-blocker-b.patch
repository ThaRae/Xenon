From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan <ryan@esterlines.com>
Date: Wed, 28 Oct 2026 09:20:59 -0400
Subject: [PATCH] LibWebView: Count every request the content blocker blocks on
 a page

The content blocking snapshot lists what was blocked on a page by host
and kind of resource, once each, and only so many of them. That says
which resources were blocked, but not how many requests: a page that
asks a blocked ad server for a dozen images lists it once.

A browser that shows a count of blocked requests, as uBlock Origin's
badge and popup do, needs every request counted. The snapshot now
carries that count too, which starts again with each navigation, as
the list does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Libraries/LibWebView/ContentBlocking.h      |  1 +
 Libraries/LibWebView/ViewImplementation.cpp | 10 +++++-----
 Libraries/LibWebView/ViewImplementation.h   |  1 +
 3 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/Libraries/LibWebView/ContentBlocking.h b/Libraries/LibWebView/ContentBlocking.h
index 14b25f7d6c87ca622b382e8ecd3430a813ba6845..cb45628e636fb83763c54b2ed672eeb81a61e9c9 100644
--- a/Libraries/LibWebView/ContentBlocking.h
+++ b/Libraries/LibWebView/ContentBlocking.h
@@ -32,6 +32,7 @@ struct ContentBlockingSnapshot {
     Optional<String> site;
     ContentBlockingState state { ContentBlockingState::Unavailable };
     Vector<BlockedResource> blocked_resources;
+    u64 blocked_request_count { 0 };
 
     bool enabled() const { return state == ContentBlockingState::Enabled || state == ContentBlockingState::NoRules; }
     bool can_toggle() const { return site.has_value() && (enabled() || state == ContentBlockingState::SiteDisabled); }
diff --git a/Libraries/LibWebView/ViewImplementation.cpp b/Libraries/LibWebView/ViewImplementation.cpp
index 3b24bfb839c2b2f808efc930d74b623d5d758afb..ff638fe2de727c403372c804cd934c9d1b3bf287 100644
--- a/Libraries/LibWebView/ViewImplementation.cpp
+++ b/Libraries/LibWebView/ViewImplementation.cpp
@@ -2691,22 +2691,21 @@ static StringView known_blocked_resource_kind(StringView kind)
 
 void ViewImplementation::did_block_resource(Badge<WebContentPage>, URL::URL const& url, StringView kind)
 {
-    if (m_blocked_resources.size() >= MAX_BLOCKED_RESOURCES)
-        return;
+    ++m_blocked_request_count;
 
     auto host = MUST(String::from_utf8(url.serialized_host()));
     auto resource_kind = known_blocked_resource_kind(kind);
     auto is_listed = any_of(m_blocked_resources, [&](auto const& resource) { return resource.host == host && resource.kind == resource_kind; });
-    if (host.is_empty() || is_listed)
-        return;
+    if (m_blocked_resources.size() < MAX_BLOCKED_RESOURCES && !host.is_empty() && !is_listed)
+        m_blocked_resources.append({ move(host), resource_kind });
 
-    m_blocked_resources.append({ move(host), resource_kind });
     notify_content_blocking_changed();
 }
 
 void ViewImplementation::reset_blocked_resources()
 {
     m_blocked_resources.clear();
+    m_blocked_request_count = 0;
     notify_content_blocking_changed();
 }
 
@@ -2720,6 +2719,7 @@ ContentBlockingSnapshot ViewImplementation::content_blocking_snapshot() const
 {
     ContentBlockingSnapshot snapshot;
     snapshot.blocked_resources = m_blocked_resources;
+    snapshot.blocked_request_count = m_blocked_request_count;
 
     if (m_crash_state.has_value() || !traversable().active_document().host())
         return snapshot;
diff --git a/Libraries/LibWebView/ViewImplementation.h b/Libraries/LibWebView/ViewImplementation.h
index b52ef02a6f8703113846b1d82fa8c5114f39a8e8..ea33da1134e58816fe288286d48c3d75ec5caaaa 100644
--- a/Libraries/LibWebView/ViewImplementation.h
+++ b/Libraries/LibWebView/ViewImplementation.h
@@ -1239,6 +1239,7 @@ protected:
     u64 m_next_navigation_listener_id { 1 };
 
     Vector<BlockedResource> m_blocked_resources;
+    u64 m_blocked_request_count { 0 };
 
     enum class NodePickerRequestType : u8 {
         Hovered,
