From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ThaRae <tharae@users.noreply.github.com>
Date: Sat, 7 Nov 2026 19:19:59 -0500
Subject: [PATCH] LibWebView: Give about:newtab a process of its own

about:newtab was a static page, so it went to whichever process hosts
an opaque origin of its initiator: a page that navigates a tab to it
gets it in its own process. An embedder that fills the page with the
user's history and bookmarks puts them in that page's process then.

Make it a dynamic WebUI page, like about:settings, so it always gets a
process that hosts nothing but it. It has no interfaces of its own.
---
 Libraries/LibWebView/WebUI.cpp        |  5 ++++-
 Libraries/LibWebView/WebUI/NewTabUI.h | 20 ++++++++++++++++++++
 2 files changed, 24 insertions(+), 1 deletion(-)
 create mode 100644 Libraries/LibWebView/WebUI/NewTabUI.h

diff --git a/Libraries/LibWebView/WebUI.cpp b/Libraries/LibWebView/WebUI.cpp
index 4e42442eb7a3b30738db137196d6f2b50c0c5818..479be32dff2690cddd4619f3e8cd7715e76f91a3 100644
--- a/Libraries/LibWebView/WebUI.cpp
+++ b/Libraries/LibWebView/WebUI.cpp
@@ -12,6 +12,7 @@
 #include <LibWebView/WebUI.h>
 #include <LibWebView/WebUI/ApplicationWebUI.h>
 #include <LibWebView/WebUI/CrashReportsUI.h>
+#include <LibWebView/WebUI/NewTabUI.h>
 #include <LibWebView/WebUI/SettingsUI.h>
 
 namespace WebView {
@@ -20,7 +21,7 @@ static constexpr auto s_pages = to_array<WebUI::Page>({
     { "about"sv, "About URLs"sv, WebUI::PageType::Static },
     { "blocking"sv, "Blocking"sv, WebUI::PageType::Static },
     { "crashes"sv, "Crash Reports"sv, WebUI::PageType::Dynamic },
-    { "newtab"sv, "New Tab"sv, WebUI::PageType::Static },
+    { "newtab"sv, "New Tab"sv, WebUI::PageType::Dynamic },
     { "settings"sv, "Settings"sv, WebUI::PageType::Dynamic },
     { "services"sv, "Services"sv, WebUI::PageType::Static },
     { "welcome"sv, "Welcome"sv, WebUI::PageType::Dynamic },
@@ -104,6 +105,8 @@ ErrorOr<RefPtr<WebUI>> WebUI::create(WebContentClient& client, Web::PageId page_
         web_ui = TRY(create_web_ui<ApplicationWebUI>(client, page_id, move(host)));
     else if (page->host == "crashes"sv)
         web_ui = TRY(create_web_ui<CrashReportsUI>(client, page_id, move(host)));
+    else if (page->host == "newtab"sv)
+        web_ui = TRY(create_web_ui<NewTabUI>(client, page_id, move(host)));
     else if (page->host.is_one_of("settings"sv, "welcome"sv))
         web_ui = TRY(create_web_ui<SettingsUI>(client, page_id, move(host)));
 
diff --git a/Libraries/LibWebView/WebUI/NewTabUI.h b/Libraries/LibWebView/WebUI/NewTabUI.h
new file mode 100644
index 0000000000000000000000000000000000000000..56269e78dddf3deff222ef2aef61a863ce9e527e
--- /dev/null
+++ b/Libraries/LibWebView/WebUI/NewTabUI.h
@@ -0,0 +1,20 @@
+/*
+ * Copyright (c) 2026, Ryan E <76752281+ThaRae@users.noreply.github.com>
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <LibWebView/WebUI.h>
+
+namespace WebView {
+
+class NewTabUI final : public WebUI {
+    WEB_UI(NewTabUI);
+
+private:
+    virtual void register_interfaces() override { }
+};
+
+}
