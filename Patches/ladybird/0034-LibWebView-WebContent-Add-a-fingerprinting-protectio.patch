+
+bool Application::fingerprinting_protection_enabled() const
+{
+    return m_web_content_options.is_test_mode != IsTestMode::Yes && m_settings->fingerprinting_protection();
+}
+
+u64 Application::fingerprinting_session_secret() const
+{
+    // Function-local static initialization is thread-safe.
+    static u64 const secret = [] {
+        u64 value = 0;
+        while (value == 0)
+            fill_with_random({ &value, sizeof(value) });
+        return value;
+    }();
+    return secret;
+}
