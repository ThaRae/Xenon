+void Application::set_navigation_event_handler(NavigationEventHandler handler)
+{
+    auto was_enabled = static_cast<bool>(m_navigation_event_handler);
+    m_navigation_event_handler = move(handler);
+    if (was_enabled == static_cast<bool>(m_navigation_event_handler))
+        return;
+
+    WebContentClient::for_each_client([&](auto& client) {
+        client.async_set_navigation_events_enabled(static_cast<bool>(m_navigation_event_handler));
+        return IterationDecision::Continue;
+    });
+}
+
+void Application::notify_navigation_event(CanonicalNavigable const& navigable, StringView event_name, URL::URL const& url) const
+{
+    if (m_navigation_event_handler)
+        m_navigation_event_handler(navigable, event_name, url);
+}
