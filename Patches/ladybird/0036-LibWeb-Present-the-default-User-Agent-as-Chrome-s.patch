index 0ce3a04006786c3d0a26d77da5bf81870f6eac6f..2841d219b6636628f6a007b0d34b3489288f591b 100644
--- a/Libraries/LibWeb/Fetch/Fetching/Fetching.cpp
+++ b/Libraries/LibWeb/Fetch/Fetching/Fetching.cpp
@@ -3485,6 +3485,8 @@ void append_user_agent_client_hints_for_request(Infrastructure::Request& request
     brand_list.append(ByteString::formatted("\"Chromium\";v=\"{}\"", *chrome_version));
     if (auto version = product_major_version(*user_agent, BROWSER_NAME "/"sv); version.has_value())
         brand_list.append(ByteString::formatted("\"{}\";v=\"{}\"", BROWSER_NAME, *version));
+    else
+        brand_list.append(ByteString::formatted("\"Google Chrome\";v=\"{}\"", *chrome_version));
 
     StringBuilder brands;
     bool first = true;
diff --git a/Libraries/LibWeb/Internals/Internals.cpp b/Libraries/LibWeb/Internals/Internals.cpp
index 2dd252e00705c64f54e53d920723d0b254e7b90c..0c61864f79ae1b17af697e1142ac45bab5073256 100644
--- a/Libraries/LibWeb/Internals/Internals.cpp
+++ b/Libraries/LibWeb/Internals/Internals.cpp
@@ -1446,6 +1446,11 @@ WebIDL::ExceptionOr<void> Internals::set_site_compatibility_data(Utf16String con
     return {};
 }
 
+void Internals::set_user_agent(Utf16String const& user_agent)
+{
+    Web::update_loader_config([&](auto& config) { config.user_agent = user_agent.to_utf8(); });
+}
+
 void Internals::set_content_blocking_enabled(bool enabled)
 {
     page().set_content_blocking_policy(enabled, {});
