 Libraries/LibWeb/Internals/Internals.cpp                   | 5 +++++
 Libraries/LibWeb/Internals/Internals.h                     | 1 +
 Libraries/LibWeb/Internals/Internals.idl                   | 1 +
 Libraries/LibWebCommon/Loader/UserAgent.h                  | 7 ++-----
 .../LibWeb/Text/expected/Fetch/user-agent-client-hints.txt | 5 +++--
 .../site-compatibility-user-agent-change-during-fetch.html | 4 ++++
 .../Fetch/site-compatibility-user-agent-redirects.html     | 4 ++++
 Tests/LibWeb/Text/input/Fetch/user-agent-client-hints.html | 4 ++--
 .../input/HTML/navigator-useragent-frozen-platform.html    | 2 +-
 10 files changed, 25 insertions(+), 10 deletions(-)

