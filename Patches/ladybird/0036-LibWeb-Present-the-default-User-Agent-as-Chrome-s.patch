From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan E <76752281+ThaRae@users.noreply.github.com>
Date: Wed, 28 Oct 2026 16:46:41 -0400
Subject: [PATCH] LibWeb: Present the default User-Agent as Chrome's

A Ladybird token in the User-Agent makes every Ladybird user stand out
to fingerprinting, and some servers still serve it degraded content.
The default User-Agent is now exactly the one Chrome sends on the same
platform.

The Sec-CH-UA brand list follows: a Chrome User-Agent without a
Ladybird token gets GREASE, Chromium, and Google Chrome at the same
major version, in Chrome's order, so the client hints never contradict
the User-Agent. A User-Agent with a Ladybird token keeps the Ladybird
brand.

internals.setUserAgent() lets the tests of the rules that hide the
Ladybird token set a User-Agent that has one.
---
 Libraries/LibWeb/Fetch/Fetching/Fetching.cpp           |  4 ++++
 Libraries/LibWeb/Internals/Internals.cpp               |  6 ++++++
 Libraries/LibWeb/Internals/Internals.h                 |  1 +
 Libraries/LibWeb/Internals/Internals.idl               |  1 +
 Libraries/LibWebCommon/Loader/UserAgent.h              | 10 +++++-----
 .../Text/expected/Fetch/user-agent-client-hints.txt    |  5 +++--
 ...e-compatibility-user-agent-change-during-fetch.html |  5 +++++
 .../Fetch/site-compatibility-user-agent-redirects.html |  5 +++++
 .../Text/input/Fetch/user-agent-client-hints.html      |  5 +++--
 .../HTML/navigator-useragent-frozen-platform.html      |  3 ++-
 10 files changed, 35 insertions(+), 10 deletions(-)

diff --git a/Libraries/LibWeb/Fetch/Fetching/Fetching.cpp b/Libraries/LibWeb/Fetch/Fetching/Fetching.cpp
index 8f16e0969d1f5fd8cfe5e4eea807e6f6d25247e2..fcad3ab337c1b5d9779c92eede21db44f7b24709 100644
--- a/Libraries/LibWeb/Fetch/Fetching/Fetching.cpp
+++ b/Libraries/LibWeb/Fetch/Fetching/Fetching.cpp
@@ -3355,6 +3355,10 @@ void append_user_agent_client_hints_for_request(Infrastructure::Request& request
     brand_list.append(ByteString::formatted("\"Chromium\";v=\"{}\"", *chrome_version));
     if (auto version = product_major_version(*user_agent, BROWSER_NAME "/"sv); version.has_value())
         brand_list.append(ByteString::formatted("\"{}\";v=\"{}\"", BROWSER_NAME, *version));
+    else
+        // A plain Chrome User-Agent (the default) is answered with the brand list Google Chrome itself sends, so the
+        // client hints don't contradict the User-Agent header.
+        brand_list.append(ByteString::formatted("\"Google Chrome\";v=\"{}\"", *chrome_version));
 
     StringBuilder brands;
     bool first = true;
diff --git a/Libraries/LibWeb/Internals/Internals.cpp b/Libraries/LibWeb/Internals/Internals.cpp
index 4b53524203119e3b413cd2ed91cd5eba217f9205..84f34902548257496fd3d0f79dc005f11026a50a 100644
--- a/Libraries/LibWeb/Internals/Internals.cpp
+++ b/Libraries/LibWeb/Internals/Internals.cpp
@@ -1395,6 +1395,12 @@ WebIDL::ExceptionOr<void> Internals::set_site_compatibility_data(Utf16String con
     return {};
 }
 
+// The default User-Agent has no Ladybird token, so tests of the rules that hide it set one that does.
+void Internals::set_user_agent(Utf16String const& user_agent)
+{
+    Web::update_loader_config([&](auto& config) { config.user_agent = user_agent.to_utf8(); });
+}
+
 void Internals::set_content_blocking_enabled(bool enabled)
 {
     page().set_content_blocking_policy(enabled, {});
