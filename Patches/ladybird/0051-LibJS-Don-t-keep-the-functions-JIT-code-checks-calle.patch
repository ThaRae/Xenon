+    /// Visits the cells the executable's attached JIT code keeps alive while a frame runs it, for a frame that does.
+    pub fn trace_running_jit_code(&self, visitor: &mut Visitor) {
+        if let Some(code) = self.jit_code(Vm::of_cell(self)) {
+            code.trace_guard_cells(visitor);
+        }
+    }
+
+    /// Discards the executable's JIT code if one of the cells it keeps alive only while a frame runs it died, which
+    /// means that no frame runs it. The code checks callees against those cells, and a cell that takes the address of
+    /// one could pass the check.
+    pub fn discard_jit_code_with_dead_guard_cell(&self, vm: &Vm, sweep: &Sweep<'_>) {
+        let Some(code) = self.jit_code(vm) else {
+            return;
+        };
+        if !code.guard_cells.iter().any(|cell| sweep.is_dead(*cell)) {
+            return;
+        }
+        if vm.jit.options.log_exits {
+            eprintln!(
+                "JIT invalidate: {}, a function it checks callees against died",
+                super::describe_executable(self)
+            );
+        }
+        code.invalidate();
+        // NB: The recompile checks against the functions alive by then, so the discard is no fruitless one.
+        self.note_learned_jit_exit_site();
+        match self.jit_compile_state() {
+            CompileState::Installed => self.discard_jit_code(vm),
+            CompileState::Discarding => {
+                self.detach_discarded_jit_code_if_unused(vm);
+            }
+            _ => {}
+        }
+    }
+
     pub fn jit_exit_sites(&self) -> Vec<(u32, ExitKind)> {
         self.jit_state().exit_sites.borrow().clone()
     }
