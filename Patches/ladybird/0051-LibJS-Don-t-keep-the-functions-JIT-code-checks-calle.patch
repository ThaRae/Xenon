diff --git a/Tests/LibJS/Runtime/jit/callee-guards-gc.js b/Tests/LibJS/Runtime/jit/callee-guards-gc.js
new file mode 100644
index 0000000000000000000000000000000000000000..95422fd733ac0f862ba53d291c8ff4c115568a80
--- /dev/null
+++ b/Tests/LibJS/Runtime/jit/callee-guards-gc.js
@@ -0,0 +1,48 @@
+// JIT code may check the callee of a call against the function the call site
+// saw, and inline it. The code does not keep that function alive: once it
+// dies, the code is discarded, so that a function that takes its address is
+// never mistaken for it.
+
+describe("JIT code that checks callees against a function", () => {
+    test("does not keep a closure alive once nothing else does", () => {
+        const caller = new Function("callee", "return callee() + 1;");
+        jit.prepare(caller);
+        const registry = new FinalizationRegistry(() => {});
+
+        function makeCallee(value) {
+            const callee = () => value;
+            registry.register(callee, value);
+            return callee;
+        }
+
+        function compileWithCallee() {
+            const callee = makeCallee(1);
+            for (let i = 0; i < 10; ++i) expect(caller(callee)).toBe(2);
+            return jit.compile(caller);
+        }
+
+        expect(compileWithCallee()).toBe(jit.enabled);
+        gc();
+
+        const collected = [];
+        cleanupFinalizationRegistry(registry, value => collected.push(value));
+        expect(collected).toEqual([1]);
+        expect(jit.isCompiled(caller)).toBeFalse();
+
+        expect(caller(makeCallee(2))).toBe(3);
+    });
+
+    test("keeps the function while it is called", () => {
+        const caller = new Function("callee", "return callee() + 1;");
+        jit.prepare(caller);
+        let callee = () => 1;
+        for (let i = 0; i < 10; ++i) expect(caller(callee)).toBe(2);
+        expect(jit.compile(caller)).toBe(jit.enabled);
+        expect(caller(callee)).toBe(2);
+
+        gc();
+        expect(jit.isCompiled(caller)).toBe(jit.enabled);
+        expect(caller(callee)).toBe(2);
+        callee = null;
+    });
+});
