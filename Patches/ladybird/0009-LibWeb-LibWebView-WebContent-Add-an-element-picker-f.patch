+void ViewImplementation::start_element_picker(Function<void(Optional<String>)> on_element_picked)
+{
+    m_on_element_picked = move(on_element_picked);
+
+    start_node_picker([this](DevTools::DevToolsDelegate::NodePickerEvent event) {
+        switch (event.type) {
+        case DevTools::DevToolsDelegate::NodePickerEvent::Type::Hovered:
+            if (event.node_id.has_value())
+                highlight_dom_node(*event.node_id, {});
+            break;
+        case DevTools::DevToolsDelegate::NodePickerEvent::Type::Previewed:
+            break;
+        case DevTools::DevToolsDelegate::NodePickerEvent::Type::Picked:
+            stop_node_picker();
+            clear_highlighted_dom_node();
+            if (event.node_id.has_value())
+                page().async_request_cosmetic_filter_for_node(++m_element_picker_request_id, *event.node_id);
+            else if (auto on_element_picked = move(m_on_element_picked))
+                on_element_picked({});
+            break;
+        case DevTools::DevToolsDelegate::NodePickerEvent::Type::Canceled:
+            stop_node_picker();
+            clear_highlighted_dom_node();
+            if (auto on_element_picked = move(m_on_element_picked))
+                on_element_picked({});
+            break;
+        }
+    });
+}
+
+void ViewImplementation::did_receive_cosmetic_filter_for_node(u64 request_id, Optional<String> filter)
+{
+    if (request_id != m_element_picker_request_id)
+        return;
+    if (auto on_element_picked = move(m_on_element_picked))
+        on_element_picked(move(filter));
+}
