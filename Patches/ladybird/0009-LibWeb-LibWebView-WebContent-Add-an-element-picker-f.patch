+void ConnectionFromClient::request_cosmetic_filter_for_node(Web::PageId page_id, u64 request_id, Web::UniqueNodeID node_id)
+{
+    Optional<String> filter;
+    if (auto* node = Web::DOM::Node::from_unique_id(node_id)) {
+        // The picker can land on a text node; hide the element that holds it.
+        auto* element = as_if<Web::DOM::Element>(*node);
+        if (!element)
+            element = node->parent_element().ptr();
+        if (element)
+            filter = Web::ContentBlocker::cosmetic_filter_for_element(*element);
+    }
+    async_did_get_cosmetic_filter_for_node(page_id, request_id, move(filter));
+}
