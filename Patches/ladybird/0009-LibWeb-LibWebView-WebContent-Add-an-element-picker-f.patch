+void Settings::add_custom_content_blocker_filter(StringView filter)
+{
+    auto trimmed_filter = filter.trim_whitespace();
+    if (trimmed_filter.is_empty())
+        return;
+
+    auto existing = m_custom_content_blocker_filters.bytes_as_string_view();
+    bool already_present = false;
+    existing.for_each_split_view('\n', SplitBehavior::Nothing, [&](StringView line) {
+        if (line.trim_whitespace() == trimmed_filter)
+            already_present = true;
+    });
+    if (already_present)
+        return;
+
+    StringBuilder builder;
+    builder.append(existing);
+    if (!existing.is_empty() && !existing.ends_with('\n'))
+        builder.append('\n');
+    builder.append(trimmed_filter);
+    builder.append('\n');
+    set_custom_content_blocker_filters(MUST(builder.to_string()));
+}
