+static Utf16String join_with_child_combinators(ReadonlySpan<Utf16String> parts)
+{
+    Utf16StringBuilder builder;
+    for (size_t i = 0; i < parts.size(); ++i) {
+        if (i != 0)
+            builder.append_ascii(" > "sv);
+        builder.append(parts[i].utf16_view());
+    }
+    return builder.to_string();
+}
+
+Optional<String> ContentBlocker::cosmetic_filter_for_element(DOM::Element& element)
+{
+    auto& document = element.document();
+    auto site = content_blocking_site(document.url());
+    if (!site.has_value())
+        return {};
+
+    auto selects_only_element = [&](Utf16String const& selector) {
+        auto result = document.query_selector_all(selector.utf16_view());
+        if (result.is_error())
+            return false;
+        auto const& list = *result.value();
+        return list.length() == 1 && list.item(0) == &element;
+    };
+    auto filter_for = [&](Utf16String const& selector) -> Optional<String> {
+        auto selector_utf8 = selector.utf16_view().to_utf8();
+        if (selector_utf8.is_error())
+            return {};
+        return MUST(String::formatted("{}##{}", *site, selector_utf8.value()));
+    };
+    auto id_selector = [](Utf16FlyString const& id) {
+        Utf16StringBuilder builder;
+        builder.append_ascii('#');
+        CSS::serialize_an_identifier(builder, id.view());
+        return builder.to_string();
+    };
+    auto compound_selector = [](DOM::Element const& element, bool with_classes) {
+        Utf16StringBuilder builder;
+        builder.append(element.local_name().view());
+        if (with_classes) {
+            for (auto const& class_name : element.class_names()) {
+                builder.append_ascii('.');
+                CSS::serialize_an_identifier(builder, class_name.view());
+            }
+        }
+        return builder.to_string();
+    };
+
+    if (auto const& id = element.id(); id.has_value() && !id->is_empty()) {
+        if (auto selector = id_selector(*id); selects_only_element(selector))
+            return filter_for(selector);
+    }
+    if (!element.class_names().is_empty()) {
+        if (auto selector = compound_selector(element, true); selects_only_element(selector))
+            return filter_for(selector);
+    }
+
+    // Walk up, one child combinator at a time, until the selector picks out only the element.
+    Vector<Utf16String> parts;
+    for (DOM::Element* current = &element; current; current = current->parent_element().ptr()) {
+        if (current != &element) {
+            if (auto const& id = current->id(); id.has_value() && !id->is_empty()) {
+                parts.prepend(id_selector(*id));
+                break;
+            }
+        }
+        if (current == document.document_element())
+            break;
+
+        auto part = compound_selector(*current, false);
+        size_t position = 1;
+        bool has_same_type_siblings = false;
+        for (auto* sibling = current->previous_element_sibling(); sibling; sibling = sibling->previous_element_sibling()) {
+            if (sibling->local_name() == current->local_name()) {
+                ++position;
+                has_same_type_siblings = true;
+            }
+        }
+        for (auto* sibling = current->next_element_sibling(); sibling && !has_same_type_siblings; sibling = sibling->next_element_sibling())
+            has_same_type_siblings = sibling->local_name() == current->local_name();
+        if (has_same_type_siblings)
+            part = Utf16String::formatted("{}:nth-of-type({})", part, position);
+        parts.prepend(move(part));
+
+        auto selector = join_with_child_combinators(parts);
+        if (selects_only_element(selector))
+            return filter_for(selector);
+    }
+
+    return filter_for(join_with_child_combinators(parts));
+}
