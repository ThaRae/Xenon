     RefPtr<ImageDecoderClient::Client> m_client;
     u64 m_client_generation { 0 };
+    Function<void()> m_client_needed_handler;
+    RefPtr<Core::Timer> m_idle_timer;
+    size_t m_pending_decodes { 0 };
+    HashTable<i64> m_animation_sessions;
 };
 
