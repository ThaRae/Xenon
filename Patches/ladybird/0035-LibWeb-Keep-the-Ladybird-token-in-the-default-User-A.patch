From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan E <76752281+ThaRae@users.noreply.github.com>
Date: Wed, 28 Oct 2026 16:46:41 -0400
Subject: [PATCH] LibWeb: Keep the Ladybird token in the default User-Agent

Cloudflare's Turnstile refuses to finish its challenge when the
browser claims to be Chrome but sends a different TLS handshake. It
lets Ladybird through when the User-Agent says Ladybird, so the
default User-Agent carries the Ladybird product against Chrome's
tokens rather than dropping Ladybird entirely.

The Sec-CH-UA brand list keeps naming Ladybird. A User-Agent without
the token, from a preset or a site-compatibility rule, gets Google
Chrome's brands as before.
---
 Libraries/LibWeb/Fetch/Fetching/Fetching.cpp          |  4 ++++
 Libraries/LibWebCommon/Loader/UserAgent.h             | 11 ++++++-----
 .../Text/expected/Fetch/user-agent-client-hints.txt   |  2 +-
 .../Text/input/Fetch/user-agent-client-hints.html     |  2 +-
 4 files changed, 12 insertions(+), 7 deletions(-)

diff --git a/Libraries/LibWeb/Fetch/Fetching/Fetching.cpp b/Libraries/LibWeb/Fetch/Fetching/Fetching.cpp
index f9c0a637d5805ed903bc34e26b6cd7e960f87ecc..cbe30f7529c80c60ce72aaf5171ae1a292cfc623 100644
--- a/Libraries/LibWeb/Fetch/Fetching/Fetching.cpp
+++ b/Libraries/LibWeb/Fetch/Fetching/Fetching.cpp
@@ -3512,6 +3512,10 @@ void append_user_agent_client_hints_for_request(Infrastructure::Request& request
     brand_list.append(ByteString::formatted("\"Chromium\";v=\"{}\"", *chrome_version));
     if (auto version = product_major_version(*user_agent, BROWSER_NAME "/"sv); version.has_value())
         brand_list.append(ByteString::formatted("\"{}\";v=\"{}\"", BROWSER_NAME, *version));
+    else
+        // A plain Chrome User-Agent, from a preset or a rule, is answered with the brand list Google Chrome itself
+        // sends, so the client hints don't contradict the User-Agent header.
+        brand_list.append(ByteString::formatted("\"Google Chrome\";v=\"{}\"", *chrome_version));
 
     StringBuilder brands;
     bool first = true;
diff --git a/Libraries/LibWebCommon/Loader/UserAgent.h b/Libraries/LibWebCommon/Loader/UserAgent.h
index eb9ee082370d15d9f7a57b03d6521f4430770f7a..e5f1bb678b8018511383f5add527c1d5da8dd4e7 100644
--- a/Libraries/LibWebCommon/Loader/UserAgent.h
+++ b/Libraries/LibWebCommon/Loader/UserAgent.h
@@ -64,10 +64,11 @@ namespace Web {
 
 #define BROWSER_NAME "Ladybird"
 
-// NB: Some web servers treat us very badly unless we pretend to be one of the major browsers.
-//     This token is appended to the User-Agent string to improve compatibility.
-//     We will need to update this periodically to match a somewhat recent version.
-#define SAD_COMPATIBILITY_HACK "Chrome/153.0.0.0 AppleWebKit/537.36 Safari/537.36"
+// NB: Some web servers treat us very badly unless we pretend to be one of the major browsers, but a User-Agent that
+//     claims to be a browser whose TLS handshake it does not send is treated worse: Cloudflare's Turnstile refuses to
+//     finish its challenge for one. The default User-Agent therefore keeps the Ladybird token and sends Chrome's
+//     tokens alongside it. We will need to update the Chrome version periodically.
+#define CHROME_MAJOR_VERSION "153"
 
 // NB: Servers sniff the parenthesized platform token of the User-Agent string and only recognize
 //     the frozen tokens sent by major browsers. Reporting the actual OS and CPU here gets us
@@ -85,7 +86,7 @@ namespace Web {
 #    define UA_PLATFORM_STRING "X11; Linux x86_64"
 #endif
 
-constexpr auto default_user_agent = "Mozilla/5.0 (" UA_PLATFORM_STRING ") " BROWSER_NAME "/" BROWSER_VERSION " " SAD_COMPATIBILITY_HACK ""sv;
+constexpr auto default_user_agent = "Mozilla/5.0 (" UA_PLATFORM_STRING ") " BROWSER_NAME "/" BROWSER_VERSION " Chrome/" CHROME_MAJOR_VERSION ".0.0.0 AppleWebKit/537.36 Safari/537.36"sv;
 // https://html.spec.whatwg.org/multipage/system-state.html#dom-navigator-platform
 // "Must return either the empty string or a string representing the platform on which the browser is executing, e.g.
 // "MacIntel", "Win32", "Linux x86_64", "Linux armv81"."
diff --git a/Tests/LibWeb/Text/expected/Fetch/user-agent-client-hints.txt b/Tests/LibWeb/Text/expected/Fetch/user-agent-client-hints.txt
index c684a5ba87a0c273e18f2754c248045a953ae09c..b59fa88a40dea043a45be6f5b840021bc61fcba1 100644
--- a/Tests/LibWeb/Text/expected/Fetch/user-agent-client-hints.txt
+++ b/Tests/LibWeb/Text/expected/Fetch/user-agent-client-hints.txt
@@ -5,7 +5,7 @@ own platform hint is quoted: PASS
 Chrome + Ladybird brands: "Ladybird";v="1", "Not_A Brand";v="8", "Chromium";v="153"
 Chrome + Ladybird mobile: ?0
 Chrome + Ladybird platform: "macOS"
-Chrome without Ladybird: "Chromium";v="153", "Not_A Brand";v="8"
+Chrome without Ladybird: "Google Chrome";v="153", "Not_A Brand";v="8", "Chromium";v="153"
 Android mobile: ?1
 Android platform: "Android"
 Firefox User-Agent sends no hints: PASS
diff --git a/Tests/LibWeb/Text/input/Fetch/user-agent-client-hints.html b/Tests/LibWeb/Text/input/Fetch/user-agent-client-hints.html
index 2814440d7a09552452351cda7d99c2a2e6479428..e08382c28a6d06a6611cdb9f939f1e65f57eb43e 100644
--- a/Tests/LibWeb/Text/input/Fetch/user-agent-client-hints.html
+++ b/Tests/LibWeb/Text/input/Fetch/user-agent-client-hints.html
@@ -41,7 +41,7 @@
             println(`Chrome + Ladybird mobile: ${chrome("Sec-CH-UA-Mobile")}`);
             println(`Chrome + Ladybird platform: ${chrome("Sec-CH-UA-Platform")}`);
 
-            // A site-compatibility rule hiding the Ladybird token drops the brand along with it.
+            // Without a Ladybird token, the brands are Google Chrome's.
             const hidden = await hintsFor(chromeUA(""));
             println(`Chrome without Ladybird: ${hidden("Sec-CH-UA")}`);
 
