+++ b/Libraries/LibWeb/Farbling/AudioFudge.h
@@ -0,0 +1,21 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Span.h>
+#include <LibWeb/Export.h>
+#include <LibWebCommon/Farbling/FarblingSeed.h>
+
+namespace Web::Farbling {
+
+// One page-wide factor in [0.999, 1.000) from the ESO seed, or 1.0 when Off. Strict uses the same range.
+WEB_API float audio_fudge_factor(Seed const&);
+
+// Multiply samples in place. No-op when fudge is 1.
+WEB_API void apply_audio_fudge(Span<float> samples, float fudge);
+
+}
