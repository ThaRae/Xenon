--- /dev/null
+++ b/Libraries/LibWeb/Farbling/AudioFudge.cpp
@@ -0,0 +1,34 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibWeb/Farbling/AudioFudge.h>
+#include <LibWeb/Farbling/FarblingRNG.h>
+
+namespace Web::Farbling {
+
+float audio_fudge_factor(Seed const& seed)
+{
+    if (!seed.enabled())
+        return 1.0f;
+
+    // Strict uses the same factor as Standard. 53 bits mapped into [0.999, 1.000).
+    u64 const mixed = RNG(seed).integer("webaudio"sv) >> 11;
+    double const unit = static_cast<double>(mixed) * 0x1p-53;
+    float factor = static_cast<float>(0.999 + unit * 0.001);
+    if (factor >= 1.0f)
+        factor = 0.99999994f;
+    return factor;
+}
+
+void apply_audio_fudge(Span<float> samples, float fudge)
+{
+    if (fudge == 1.0f)
+        return;
+    for (auto& sample : samples)
+        sample *= fudge;
+}
+
+}
