+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibTest/TestCase.h>
+#include <LibWeb/Farbling/AudioFudge.h>
+
+TEST_CASE(off_is_one)
+{
+    Web::Farbling::Seed off {};
+    EXPECT_EQ(Web::Farbling::audio_fudge_factor(off), 1.0f);
+}
+
+TEST_CASE(standard_is_in_range)
+{
+    Web::Farbling::Seed seed { .level = Web::Farbling::Level::Standard, .high = 1, .low = 2 };
+    auto factor = Web::Farbling::audio_fudge_factor(seed);
+    EXPECT(factor >= 0.999f);
+    EXPECT(factor < 1.0f);
+}
+
+TEST_CASE(strict_uses_the_same_fudge)
+{
+    Web::Farbling::Seed standard { .level = Web::Farbling::Level::Standard, .high = 9, .low = 8 };
+    Web::Farbling::Seed strict { .level = Web::Farbling::Level::Strict, .high = 9, .low = 8 };
+    EXPECT_EQ(Web::Farbling::audio_fudge_factor(standard), Web::Farbling::audio_fudge_factor(strict));
+}
+
+TEST_CASE(same_seed_is_deterministic)
+{
+    Web::Farbling::Seed seed { .level = Web::Farbling::Level::Standard, .high = 0x0123456789abcdefULL, .low = 0xfedcba9876543210ULL };
+    auto first = Web::Farbling::audio_fudge_factor(seed);
+    auto second = Web::Farbling::audio_fudge_factor(seed);
+    EXPECT_EQ(first, second);
+}
+
+TEST_CASE(different_seeds_can_differ)
+{
+    bool found_difference = false;
+    Web::Farbling::Seed first { .level = Web::Farbling::Level::Standard, .high = 1, .low = 1 };
+    auto baseline = Web::Farbling::audio_fudge_factor(first);
+    for (u64 n = 2; n <= 64 && !found_difference; ++n) {
+        Web::Farbling::Seed trial { .level = Web::Farbling::Level::Standard, .high = n, .low = n * 7 };
+        if (Web::Farbling::audio_fudge_factor(trial) != baseline)
+            found_difference = true;
+    }
+    EXPECT(found_difference);
+}
+
+TEST_CASE(apply_one_is_a_noop)
+{
+    float samples[4] = { 0.25f, -0.5f, 1.0f, 0.0f };
+    Web::Farbling::apply_audio_fudge({ samples, 4 }, 1.0f);
+    EXPECT_EQ(samples[0], 0.25f);
+    EXPECT_EQ(samples[1], -0.5f);
+    EXPECT_EQ(samples[2], 1.0f);
+    EXPECT_EQ(samples[3], 0.0f);
+}
+
+TEST_CASE(apply_multiplies_exactly_once)
+{
+    float samples[3] = { 0.5f, -0.25f, 0.125f };
+    float const fudge = 0.9995f;
+    Web::Farbling::apply_audio_fudge({ samples, 3 }, fudge);
+    EXPECT_EQ(samples[0], 0.5f * fudge);
+    EXPECT_EQ(samples[1], -0.25f * fudge);
+    EXPECT_EQ(samples[2], 0.125f * fudge);
+}
