+void AudioBuffer::ensure_script_fudge(JS::Object* relevant_global_object)
+{
+    if (m_script_fudge_applied)
+        return;
+    m_script_fudge_applied = true;
+
+    auto& settings = relevant_global_object
+        ? HTML::relevant_settings_object(*relevant_global_object)
+        : HTML::incumbent_settings_object();
+    if (settings.origin().is_opaque())
+        return;
+
+    float const fudge = settings.audio_fudge_factor();
+    if (fudge == 1.0f)
+        return;
+
+    for (auto& channel : m_channels) {
+        Farbling::apply_audio_fudge({ reinterpret_cast<float*>(channel.data.data()), m_length }, fudge);
+    }
+}
