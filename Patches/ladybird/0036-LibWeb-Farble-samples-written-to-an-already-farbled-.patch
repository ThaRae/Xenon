+// Test mode forces fingerprinting protection off so output stays deterministic. Tests of farbling turn it back on.
+void Internals::set_fingerprinting_protection(bool enabled)
+{
+    Web::update_loader_config([&](auto& config) { config.enable_fingerprinting_protection = enabled; });
+}
+
 void Internals::set_content_blocking_enabled(bool enabled)
 {
     page().set_content_blocking_policy(enabled, {});
