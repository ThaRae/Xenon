+
+#pragma once
+
+#include <AK/ByteBuffer.h>
+#include <AK/Optional.h>
+#include <LibURL/Origin.h>
+#include <LibWebView/Export.h>
+
+namespace WebView {
+
+// https://w3c.github.io/webauthn/#dictdef-collectedclientdata
+struct WEBVIEW_API CollectedClientData {
+    enum class Type : u8 {
+        Create,
+        Get,
+    };
+
+    Type type { Type::Create };
+    ByteBuffer challenge;
+    URL::Origin origin { URL::Origin::create_opaque() };
+    bool cross_origin { false };
+    Optional<URL::Origin> top_origin;
+
+    // https://w3c.github.io/webauthn/#clientdatajson-serialization
+    ByteBuffer serialize() const;
+};
+
+// https://w3c.github.io/webauthn/#collectedclientdata-hash-of-the-serialized-client-data
+WEBVIEW_API ByteBuffer hash_of_the_serialized_client_data(ReadonlyBytes client_data_json);
+
+}
diff --git a/Libraries/LibWebView/WebAuthn/Coordinator.cpp b/Libraries/LibWebView/WebAuthn/Coordinator.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..14a098cc789c647c3ea75fec25219563d9b2d320
--- /dev/null
+++ b/Libraries/LibWebView/WebAuthn/Coordinator.cpp
@@ -0,0 +1,897 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/WeakPtr.h>
+#include <AK/Weakable.h>
+#include <LibCore/Timer.h>
+#include <LibWebView/CanonicalDocument.h>
+#include <LibWebView/CanonicalNavigable.h>
+#include <LibWebView/CanonicalTraversable.h>
+#include <LibWebView/ViewImplementation.h>
+#include <LibWebView/WebAuthn/AttestationObject.h>
+#include <LibWebView/WebAuthn/ClientData.h>
+#include <LibWebView/WebAuthn/Coordinator.h>
+#include <LibWebView/WebAuthn/Prompt.h>
+#include <LibWebView/WebContentPage.h>
+
+namespace WebView {
+
+using Web::WebAuthn::AttestationConveyancePreference;
+using Web::WebAuthn::AuthenticatorAttachment;
+using Web::WebAuthn::CreateRequest;
+using Web::WebAuthn::ErrorName;
+using Web::WebAuthn::GetRequest;
+using Web::WebAuthn::ResidentKeyRequirement;
+using Web::WebAuthn::UserVerificationRequirement;
+
+// How often a ceremony checks that its document is still active and its view still in front of the user.
+static constexpr auto LIVENESS_CHECK_INTERVAL = AK::Duration::from_milliseconds(500);
+
+static Web::WebAuthn::Error not_allowed(StringView message)
+{
+    return { ErrorName::NotAllowedError, MUST(String::from_utf8(message)) };
+}
+
+class WebAuthnCoordinator::Ceremony final
+    : public RefCounted<Ceremony>
+    , public Weakable<Ceremony> {
+public:
+    using Request = Variant<CreateRequest, GetRequest>;
+
+    Ceremony(WebContentPage& page, u64 request_id, CeremonyContext context, Request request)
+        : m_page(page)
+        , m_request_id(request_id)
+        , m_context(move(context))
+        , m_request(move(request))
+    {
+    }
+
+    WebContentPage* page() const { return m_page.ptr(); }
+    u64 request_id() const { return m_request_id; }
+    bool is_create() const { return m_request.has<CreateRequest>(); }
+
+    ViewImplementation* view() const
+    {
+        if (!m_page || !m_page->is_open())
+            return nullptr;
+        auto view = m_page->traversable().view();
+        return view.has_value() ? &*view : nullptr;
+    }
+
+    void start(Vector<AuthenticatorSource*> const& sources);
+
+    void authenticator_appeared(NonnullRefPtr<Authenticator>);
+
+    // Ends the ceremony, answering the renderer unless it has been answered already.
+    void end(Optional<Web::WebAuthn::Result>);
+
+    // Ends the ceremony without an answer, because the renderer gave up on it or went away.
+    void abandon();
+
+    void user_cancelled();
+    void user_entered_pin(String pin);
+    void user_chose_account(size_t index);
+    void user_answered_attestation_consent(bool allow);
+
+private:
+    enum class Phase : u8 {
+        // Waiting for the user to insert or touch an authenticator.
+        Waiting,
+        // Waiting for the PIN of the selected authenticator.
+        AwaitingPin,
+        // Waiting for the selected authenticator to finish an operation with the PIN.
+        AwaitingTouch,
+        // Waiting for the user to choose among the accounts on the selected authenticator.
+        AwaitingAccountChoice,
+        // Waiting for the user to allow or refuse the site seeing the authenticator's make and model.
+        AwaitingAttestationConsent,
+        // The renderer has its answer, and the prompt stays up only to inform the user.
+        Answered,
+        Ended,
+    };
+
+    // What an authenticator is asked to do, given what it supports.
+    struct Plan {
+        Optional<WebAuthnPrompt::State> unsuitable;
+        bool needs_pin { false };
+        bool resident_key { false };
+        bool user_verification { false };
+        i32 algorithm { 0 };
+    };
+
+    struct Candidate {
+        NonnullRefPtr<Authenticator> authenticator;
+        Plan plan;
+        bool is_busy { false };
+        bool tried_app_id { false };
+    };
+
+    Plan plan_for(Authenticator::Info const&) const;
+    Candidate* candidate_for(Authenticator const&);
+    void issue_request(Candidate&, Optional<String> pin = {});
+    void select_for_pin_entry(Candidate&);
+    void cancel_other_candidates(Authenticator const* except);
+    void handle_failure(Candidate&, Authenticator::Failure const&);
+    void handle_registration(Candidate&, Authenticator::Registration);
+    void handle_assertions(Candidate&, Vector<Authenticator::Assertion>);
+    void finish_registration(bool share_attestation);
+    void finish_assertion(Authenticator::Assertion const&);
+    void show_prompt(WebAuthnPrompt::State);
+    void close_prompt();
+    void check_liveness();
+
+    WeakPtr<WebContentPage> m_page;
+    u64 m_request_id { 0 };
+    CeremonyContext m_context;
+    Request m_request;
+
+    ByteBuffer m_client_data_json;
+    ByteBuffer m_client_data_hash;
+
+    Phase m_phase { Phase::Waiting };
+    WebAuthnPrompt m_prompt;
+    bool m_prompt_is_shown { false };
+
+    Vector<Candidate> m_candidates;
+    RefPtr<Authenticator> m_selected;
+    Optional<Authenticator::Registration> m_pending_registration;
+    Vector<Authenticator::Assertion> m_pending_assertions;
+    bool m_pending_assertions_used_app_id { false };
+
+    RefPtr<Core::Timer> m_lifetime_timer;
+    RefPtr<Core::Timer> m_liveness_timer;
+
+    Vector<NonnullOwnPtr<AuthenticatorSource::Discovery>> m_discoveries;
+};
+
+void WebAuthnCoordinator::Ceremony::start(Vector<AuthenticatorSource*> const& sources)
+{
+    // https://w3c.github.io/webauthn/#sctn-createCredential and https://w3c.github.io/webauthn/#sctn-getAssertion:
+    // Let collectedClientData be a new CollectedClientData instance whose fields are:
+    //   type: "webauthn.create" or "webauthn.get"
+    //   challenge: The base64url encoding of pkOptions.challenge.
+    //   origin: The serialization of callerOrigin.
+    //   crossOrigin: The inverse of the value of the sameOriginWithAncestors argument.
+    //   topOrigin: The serialization of callerOrigin’s top-level origin if sameOriginWithAncestors is false, else
+    //              undefined.
+    // Let clientDataJSON be the JSON-compatible serialization of client data constructed from collectedClientData.
+    // Let clientDataHash be the hash of the serialized client data represented by clientDataJSON.
+    CollectedClientData client_data;
+    client_data.type = is_create() ? CollectedClientData::Type::Create : CollectedClientData::Type::Get;
+    client_data.challenge = m_request.visit([](auto const& request) { return request.challenge; });
+    client_data.origin = m_context.origin;
+    client_data.cross_origin = m_context.cross_origin;
+    if (m_context.cross_origin)
+        client_data.top_origin = m_context.top_level_origin;
+    m_client_data_json = client_data.serialize();
+    m_client_data_hash = hash_of_the_serialized_client_data(m_client_data_json);
+
+    m_prompt.operation = is_create() ? WebAuthnPrompt::Operation::Create : WebAuthnPrompt::Operation::Get;
+    m_prompt.rp_id = m_request.visit([](auto const& request) { return request.rp_id; });
+    m_prompt.origin = m_context.origin;
+    if (m_context.cross_origin)
+        m_prompt.top_level_origin = m_context.top_level_origin;
+    if (auto const* create_request = m_request.get_pointer<CreateRequest>())
+        m_prompt.user_name = create_request->user_name;
+
+    // Start lifetimeTimer.
+    auto timeout = m_request.visit([](auto const& request) { return request.timeout; });
+    m_lifetime_timer = Core::Timer::create_single_shot(AK::Duration::from_milliseconds(timeout), [weak_self = make_weak_ptr()] {
+        // If lifetimeTimer expires, then for each authenticator in issuedRequests invoke the authenticatorCancel
+        // operation on authenticator and remove authenticator from issuedRequests. Throw a "NotAllowedError".
+        if (auto self = weak_self.strong_ref())
+            self->end(not_allowed("The operation timed out"sv));
+    });
+    m_lifetime_timer->start();
+
+    m_liveness_timer = Core::Timer::create_repeating(LIVENESS_CHECK_INTERVAL, [weak_self = make_weak_ptr()] {
+        if (auto self = weak_self.strong_ref())
+            self->check_liveness();
+    });
+    m_liveness_timer->start();
+
+    show_prompt(WebAuthnPrompt::State::InsertKey);
+
+    for (auto* source : sources) {
+        m_discoveries.append(source->discover(m_page->traversable(), [weak_self = make_weak_ptr()](NonnullRefPtr<Authenticator> authenticator) {
+            if (auto self = weak_self.strong_ref())
+                self->authenticator_appeared(move(authenticator));
+        }));
+    }
+}
+
+void WebAuthnCoordinator::Ceremony::check_liveness()
+{
+    if (m_phase == Phase::Ended)
+        return;
+
+    auto* view = this->view();
+    if (!view) {
+        abandon();
+        return;
+    }
+
+    // If the document stopped being active, nobody is waiting for the answer anymore.
+    auto navigable = m_page->traversable().find(m_context.navigable_id);
+    if (!navigable.has_value() || navigable->active_document().id() != m_context.document_id || navigable->active_document().host() != m_page.ptr()) {
+        abandon();
+        return;
+    }
+
+    if (m_phase == Phase::Answered)
+        return;
+
+    // A ceremony continues only while the user can see the view that started it. It may lose focus to its prompt.
+    if (m_page->traversable().system_visibility_state() != Web::HTML::VisibilityState::Visible)
+        end(not_allowed("The page is no longer visible"sv));
+}
+
+WebAuthnCoordinator::Ceremony::Plan WebAuthnCoordinator::Ceremony::plan_for(Authenticator::Info const& info) const
+{
+    Plan plan;
+    bool can_verify_user = info.has_built_in_user_verification || info.has_client_pin;
+
+    auto user_verification_requirement = m_request.visit([](auto const& request) { return request.user_verification; });
+    switch (user_verification_requirement) {
+    case UserVerificationRequirement::Required:
+        plan.user_verification = true;
+        break;
+    case UserVerificationRequirement::Preferred:
+        // NB: As in other browsers, verify the user when the authenticator is set up for it.
+        plan.user_verification = can_verify_user;
+        break;
+    case UserVerificationRequirement::Discouraged:
+        plan.user_verification = false;
+        break;
+    }
+
+    if (plan.user_verification && !can_verify_user) {
+        plan.unsuitable = info.supports_client_pin ? WebAuthnPrompt::State::PinNotSet : WebAuthnPrompt::State::KeyNotSupported;
+        return plan;
+    }
+
+    if (auto const* request = m_request.get_pointer<CreateRequest>()) {
+        // https://w3c.github.io/webauthn/#dom-authenticatorselectioncriteria-authenticatorattachment
+        if (request->authenticator_attachment.has_value() && *request->authenticator_attachment != info.attachment) {
+            plan.unsuitable = *request->authenticator_attachment == AuthenticatorAttachment::Platform ? WebAuthnPrompt::State::NoPlatformAuthenticator : WebAuthnPrompt::State::KeyNotSupported;
+            return plan;
+        }
+
+        // The first of the requested algorithms the authenticator supports. One that doesn't say supports ES256.
+        auto supported_algorithms = info.algorithms.is_empty() ? Vector<i32> { COSE_ALGORITHM_ES256 } : info.algorithms;
+        Optional<i32> algorithm;
+        for (auto requested : request->public_key_algorithms) {
+            if (supported_algorithms.contains_slow(requested)) {
+                algorithm = requested;
+                break;
+            }
+        }
+        if (!algorithm.has_value()) {
+            plan.unsuitable = WebAuthnPrompt::State::KeyNotSupported;
+            return plan;
+        }
+        plan.algorithm = *algorithm;
+
+        // https://w3c.github.io/webauthn/#dom-authenticatorselectioncriteria-residentkey
+        switch (request->resident_key) {
+        case ResidentKeyRequirement::Required:
+            plan.resident_key = true;
+            break;
+        case ResidentKeyRequirement::Preferred:
+            // NB: As in other browsers, make a discoverable credential when the authenticator can protect it.
+            plan.resident_key = info.supports_resident_keys && can_verify_user;
+            break;
+        case ResidentKeyRequirement::Discouraged:
+            plan.resident_key = false;
+            break;
+        }
+        if (plan.resident_key && !info.supports_resident_keys) {
+            plan.unsuitable = WebAuthnPrompt::State::KeyNotSupported;
+            return plan;
+        }
+
+        // A CTAP2 authenticator with a PIN makes a credential only with the PIN, unless it is a non-discoverable one
+        // and the authenticator offers makeCredUvNotRqd.
+        plan.needs_pin = !info.has_built_in_user_verification && info.has_client_pin && (plan.user_verification || plan.resident_key || !info.make_credential_without_user_verification);
+    } else {
+        auto const& get_request = m_request.get<GetRequest>();
+
+        // An empty allow list asks for discoverable credentials.
+        if (get_request.allow_credentials.is_empty() && !info.supports_resident_keys) {
+            plan.unsuitable = WebAuthnPrompt::State::KeyNotSupported;
+            return plan;
+        }
+
+        plan.needs_pin = plan.user_verification && !info.has_built_in_user_verification && info.has_client_pin;
+    }
+
+    if (plan.needs_pin)
+        plan.user_verification = true;
+    return plan;
+}
+
+WebAuthnCoordinator::Ceremony::Candidate* WebAuthnCoordinator::Ceremony::candidate_for(Authenticator const& authenticator)
+{
+    for (auto& candidate : m_candidates) {
+        if (candidate.authenticator.ptr() == &authenticator)
+            return &candidate;
+    }
+    return nullptr;
+}
+
+void WebAuthnCoordinator::Ceremony::authenticator_appeared(NonnullRefPtr<Authenticator> authenticator)
+{
+    if (m_phase == Phase::Ended || m_phase == Phase::Answered)
+        return;
+
+    auto plan = plan_for(authenticator->info());
+    m_candidates.append({ authenticator, plan });
+    auto& candidate = m_candidates.last();
+
+    // Once the user has chosen an authenticator, others wait.
+    if (m_phase != Phase::Waiting)
+        return;
+
+    if (plan.unsuitable.has_value()) {
+        show_prompt(*plan.unsuitable);
+        return;
+    }
+
+    if (!plan.needs_pin) {
+        issue_request(candidate);
+        return;
+    }
+
+    // An authenticator needing a PIN is chosen first, so that the PIN goes to the right one: right away if it's the
+    // only one, and otherwise when the user touches it.
+    bool another_is_present = any_of(m_candidates, [&](auto const& other) { return other.authenticator != candidate.authenticator && !other.plan.unsuitable.has_value(); });
+    if (!another_is_present) {
+        select_for_pin_entry(candidate);
+        return;
+    }
+
+    candidate.is_busy = true;
+    authenticator->wait_for_touch([this, protect = NonnullRefPtr { *this }, authenticator](Optional<Authenticator::Failure> failure) {
+        auto* candidate = candidate_for(*authenticator);
+        if (!candidate)
+            return;
+        candidate->is_busy = false;
+        if (m_phase != Phase::Waiting)
+            return;
+        if (failure.has_value()) {
+            handle_failure(*candidate, *failure);
+            return;
+        }
+        select_for_pin_entry(*candidate);
+    });
+}
+
+void WebAuthnCoordinator::Ceremony::select_for_pin_entry(Candidate& candidate)
+{
+    m_selected = candidate.authenticator;
+    cancel_other_candidates(m_selected.ptr());
+    m_phase = Phase::AwaitingPin;
+
+    candidate.authenticator->get_pin_retries([this, protect = NonnullRefPtr { *this }](Optional<u32> retries) {
+        if (m_phase != Phase::AwaitingPin)
+            return;
+        m_prompt.pin_retries = retries;
+        m_prompt.pin_was_wrong = false;
+        show_prompt(WebAuthnPrompt::State::EnterPin);
+    });
+}
+
+void WebAuthnCoordinator::Ceremony::cancel_other_candidates(Authenticator const* except)
+{
+    for (auto& candidate : m_candidates) {
+        if (candidate.authenticator.ptr() == except || !candidate.is_busy)
+            continue;
+        candidate.authenticator->cancel();
+    }
+}
+
+void WebAuthnCoordinator::Ceremony::issue_request(Candidate& candidate, Optional<String> pin)
+{
+    candidate.is_busy = true;
+    auto authenticator = candidate.authenticator;
+
+    // NB: A PIN is passed on for the one request it was entered for, and never leaves the browser process.
+    auto user_verification = candidate.plan.user_verification || pin.has_value();
+
+    if (auto const* request = m_request.get_pointer<CreateRequest>()) {
+        // https://w3c.github.io/webauthn/#sctn-op-make-cred
+        Authenticator::MakeCredentialRequest make_credential;
+        make_credential.client_data_hash = m_client_data_hash;
+        make_credential.rp_id = request->rp_id;
+        make_credential.rp_name = request->rp_name;
+        make_credential.user_id = request->user_id;
+        make_credential.user_name = request->user_name;
+        make_credential.user_display_name = request->user_display_name;
+        make_credential.algorithm = candidate.plan.algorithm;
+        make_credential.exclude_list = request->exclude_credentials;
+        make_credential.resident_key = candidate.plan.resident_key;
+        make_credential.user_verification = user_verification;
+        make_credential.pin = move(pin);
+        authenticator->make_credential(move(make_credential), [this, protect = NonnullRefPtr { *this }, authenticator](Authenticator::MakeCredentialResult result) {
+            auto* candidate = candidate_for(*authenticator);
+            if (!candidate)
+                return;
+            candidate->is_busy = false;
+            result.visit(
+                [&](Authenticator::Registration& registration) { handle_registration(*candidate, move(registration)); },
+                [&](Authenticator::Failure const& failure) { handle_failure(*candidate, failure); });
+        });
+        return;
+    }
+
+    // https://w3c.github.io/webauthn/#sctn-op-get-assertion
+    auto const& request = m_request.get<GetRequest>();
+    Authenticator::GetAssertionRequest get_assertion;
+    get_assertion.client_data_hash = m_client_data_hash;
+    get_assertion.rp_id = candidate.tried_app_id ? *request.app_id : request.rp_id;
+    get_assertion.allow_list = request.allow_credentials;
+    get_assertion.user_verification = user_verification;
+    get_assertion.pin = move(pin);
+    authenticator->get_assertion(move(get_assertion), [this, protect = NonnullRefPtr { *this }, authenticator](Authenticator::GetAssertionResult result) {
+        auto* candidate = candidate_for(*authenticator);
+        if (!candidate)
+            return;
+        candidate->is_busy = false;
+        result.visit(
+            [&](Vector<Authenticator::Assertion>& assertions) { handle_assertions(*candidate, move(assertions)); },
+            [&](Authenticator::Failure const& failure) { handle_failure(*candidate, failure); });
+    });
+}
+
+void WebAuthnCoordinator::Ceremony::user_entered_pin(String pin)
+{
+    if (m_phase != Phase::AwaitingPin || !m_selected)
+        return;
+    auto* candidate = candidate_for(*m_selected);
+    if (!candidate)
+        return;
+
+    m_phase = Phase::AwaitingTouch;
+    show_prompt(WebAuthnPrompt::State::TouchKey);
+    issue_request(*candidate, move(pin));
+}
+
+void WebAuthnCoordinator::Ceremony::handle_failure(Candidate& candidate, Authenticator::Failure const& failure)
+{
+    if (m_phase == Phase::Ended || m_phase == Phase::Answered)
+        return;
+
+    auto is_selected = m_selected == candidate.authenticator.ptr();
+
+    switch (failure.error) {
+    case Authenticator::Error::Cancelled:
+        return;
+
+    case Authenticator::Error::NoCredentials:
+        // https://w3c.github.io/webauthn/#sctn-appid-extension
+        // If a U2F authenticator indicates that a credential is not applicable, try again with the AppID as the RP ID.
+        if (auto const* request = m_request.get_pointer<GetRequest>(); request && request->app_id.has_value() && !candidate.tried_app_id) {
+            candidate.tried_app_id = true;
+            if (is_selected && m_phase == Phase::AwaitingTouch) {
+                // NB: The PIN has been used up, so the user enters it again for the second request.
+                m_phase = Phase::AwaitingPin;
+                m_prompt.pin_was_wrong = false;
+                show_prompt(WebAuthnPrompt::State::EnterPin);
+                return;
+            }
+            issue_request(candidate);
+            return;
+        }
+        // NB: The page isn't told, so that it can't learn whether the user has a credential for it. The user can try
+        //     another authenticator, or cancel.
+        break;
+
+    case Authenticator::Error::CredentialExcluded:
+        // https://w3c.github.io/webauthn/#sctn-createCredential
+        // If any authenticator returns an error status equivalent to "InvalidStateError", cancel the others, and
+        // throw an "InvalidStateError" DOMException. The authenticator only says so once the user has consented, so
+        // the RP may know.
+        cancel_other_candidates(candidate.authenticator.ptr());
+        if (m_page && m_page->is_open())
+            m_page->async_web_authn_request_completed(m_request_id, Web::WebAuthn::Error { ErrorName::InvalidStateError, "The authenticator is already registered"_string });
+        m_phase = Phase::Answered;
+        m_lifetime_timer->stop();
+        show_prompt(WebAuthnPrompt::State::KeyAlreadyRegistered);
+        return;
+
+    case Authenticator::Error::PinRequired:
+        if (m_phase == Phase::Waiting) {
+            candidate.plan.needs_pin = true;
+            candidate.plan.user_verification = true;
+            select_for_pin_entry(candidate);
+            return;
+        }
+        break;
+
+    case Authenticator::Error::PinInvalid:
+        if (is_selected) {
+            m_phase = Phase::AwaitingPin;
+            m_prompt.pin_was_wrong = true;
+            m_prompt.pin_retries = failure.pin_retries;
+            if (m_prompt.pin_retries.has_value()) {
+                show_prompt(WebAuthnPrompt::State::EnterPin);
+                return;
+            }
+            candidate.authenticator->get_pin_retries([this, protect = NonnullRefPtr { *this }](Optional<u32> retries) {
+                if (m_phase != Phase::AwaitingPin)
+                    return;
+                m_prompt.pin_retries = retries;
+                show_prompt(WebAuthnPrompt::State::EnterPin);
+            });
+            return;
+        }
+        break;
+
+    case Authenticator::Error::PinBlocked:
+        show_prompt(WebAuthnPrompt::State::PinBlocked);
+        break;
+
+    case Authenticator::Error::PinNotSet:
+        show_prompt(WebAuthnPrompt::State::PinNotSet);
+        break;
+
+    case Authenticator::Error::NotSupported:
+        show_prompt(WebAuthnPrompt::State::KeyNotSupported);
+        break;
+
+    case Authenticator::Error::OperationDenied:
+        // The user declined on the authenticator itself.
+        end(not_allowed("The user declined"sv));
+        return;
+
+    case Authenticator::Error::Removed:
+        m_candidates.remove_first_matching([&](auto const& other) { return other.authenticator == candidate.authenticator; });
+        if (is_selected) {
+            m_selected = nullptr;
+            m_phase = Phase::Waiting;
+            show_prompt(WebAuthnPrompt::State::InsertKey);
+        }
+        return;
+
+    case Authenticator::Error::Timeout:
+    case Authenticator::Error::Other:
+        break;
+    }
+
+    if (failure.error == Authenticator::Error::NoCredentials)
+        show_prompt(WebAuthnPrompt::State::KeyNotRegistered);
+
+    // The authenticator that failed is done. If the user had chosen it, they may now choose another.
+    if (is_selected) {
+        m_selected = nullptr;
+        m_phase = Phase::Waiting;
+    }
+}
+
+void WebAuthnCoordinator::Ceremony::handle_registration(Candidate& candidate, Authenticator::Registration registration)
+{
+    if (m_phase == Phase::Ended || m_phase == Phase::Answered)
+        return;
+
+    // When an authenticator succeeds, cancel the others.
+    cancel_other_candidates(candidate.authenticator.ptr());
+    m_selected = candidate.authenticator;
+    m_pending_registration = move(registration);
+
+    // https://w3c.github.io/webauthn/#dom-attestationconveyancepreference-direct
+    // The RP wants the attestation statement as the authenticator generated it. Since it identifies the
+    // authenticator's make and model, the user is asked first.
+    auto const& request = m_request.get<CreateRequest>();
+    auto wants_attestation = request.attestation == AttestationConveyancePreference::Direct || request.attestation == AttestationConveyancePreference::Enterprise;
+    auto authenticator_data = AuthenticatorData::parse(m_pending_registration->authenticator_data);
+    auto is_identifying = m_pending_registration->attestation_format != "none"sv
+        && !(authenticator_data.is_error() || !authenticator_data.value().attested_credential_data.has_value()
+            || is_self_attestation(m_pending_registration->attestation_format, m_pending_registration->attestation_statement, authenticator_data.value().attested_credential_data->aaguid));
+
+    if (wants_attestation && is_identifying) {
+        m_phase = Phase::AwaitingAttestationConsent;
+        show_prompt(WebAuthnPrompt::State::AttestationConsent);
+        return;
+    }
+
+    finish_registration(false);
+}
+
+void WebAuthnCoordinator::Ceremony::user_answered_attestation_consent(bool allow)
+{
+    if (m_phase != Phase::AwaitingAttestationConsent)
+        return;
+    finish_registration(allow);
+}
+
+void WebAuthnCoordinator::Ceremony::finish_registration(bool share_attestation)
+{
+    VERIFY(m_pending_registration.has_value());
+    auto registration = m_pending_registration.release_value();
+
+    auto authenticator_data = AuthenticatorData::parse(registration.authenticator_data);
+    if (authenticator_data.is_error() || !authenticator_data.value().attested_credential_data.has_value()) {
+        dbgln("WebAuthn: {} returned authenticator data without a credential", m_selected ? m_selected->name() : String {});
+        end(Web::WebAuthn::Error { ErrorName::UnknownError, "The authenticator returned invalid data"_string });
+        return;
+    }
+    auto const& attested_credential_data = *authenticator_data.value().attested_credential_data;
+
+    // https://w3c.github.io/webauthn/#sctn-createCredential, constructCredentialAlg:
+    // If credentialCreationData.attestationConveyancePreferenceOption’s value is "none", replace potentially uniquely
+    // identifying information with non-identifying versions of the same: unless self attestation is being used, set
+    // the attestation statement format to "none" and the attestation statement to an empty CBOR map. "indirect" may
+    // be treated the same way. "direct" and "enterprise" convey the attestation statement as it is, once the user has
+    // allowed it.
+    auto format = registration.attestation_format;
+    auto statement = registration.attestation_statement;
+    if (!share_attestation && !is_self_attestation(format, statement, attested_credential_data.aaguid)) {
+        format = "none"_string;
+        statement = none_attestation_statement();
+    }
+
+    auto const& request = m_request.get<CreateRequest>();
+    auto public_key = CredentialPublicKey::from_cose_key(attested_credential_data.credential_public_key);
+
+    Web::WebAuthn::RegistrationResponse response;
+    response.credential_id = registration.credential_id.is_empty() ? attested_credential_data.credential_id : registration.credential_id;
+    response.client_data_json = m_client_data_json;
+    response.attestation_object = encode_attestation_object(format, statement, registration.authenticator_data);
+    response.authenticator_data = registration.authenticator_data;
+    if (!public_key.is_error()) {
+        response.public_key = public_key.value().subject_public_key_info;
+        response.public_key_algorithm = public_key.value().algorithm;
+    }
+    if (m_selected) {
+        response.transports = m_selected->info().transports;
+        response.authenticator_attachment = m_selected->info().attachment;
+    }
+
+    // https://w3c.github.io/webauthn/#sctn-authenticator-credential-properties-extension
+    if (request.credential_properties)
+        response.resident_key = registration.resident_key;
+
+    end(move(response));
+}
+
+void WebAuthnCoordinator::Ceremony::handle_assertions(Candidate& candidate, Vector<Authenticator::Assertion> assertions)
+{
+    if (m_phase == Phase::Ended || m_phase == Phase::Answered)
+        return;
+
+    if (assertions.is_empty()) {
+        handle_failure(candidate, { Authenticator::Error::NoCredentials, {} });
+        return;
+    }
+
+    cancel_other_candidates(candidate.authenticator.ptr());
+    m_selected = candidate.authenticator;
+    m_pending_assertions_used_app_id = candidate.tried_app_id;
+
+    if (assertions.size() == 1) {
+        finish_assertion(assertions.first());
+        return;
+    }
+
+    // https://w3c.github.io/webauthn/#sctn-op-get-assertion
+    // With several credentials for the RP and no allow list, the user chooses one.
+    m_pending_assertions = move(assertions);
+    m_prompt.accounts.clear();
+    for (auto const& assertion : m_pending_assertions) {
+        WebAuthnPrompt::Account account;
+        if (assertion.user.has_value()) {
+            account.name = assertion.user->name;
+            account.display_name = assertion.user->display_name;
+        }
+        m_prompt.accounts.append(move(account));
+    }
+    m_phase = Phase::AwaitingAccountChoice;
+    show_prompt(WebAuthnPrompt::State::ChooseAccount);
+}
+
+void WebAuthnCoordinator::Ceremony::user_chose_account(size_t index)
+{
+    if (m_phase != Phase::AwaitingAccountChoice || index >= m_pending_assertions.size())
+        return;
+    auto assertion = m_pending_assertions[index];
+    m_pending_assertions.clear();
+    finish_assertion(assertion);
+}
+
+void WebAuthnCoordinator::Ceremony::finish_assertion(Authenticator::Assertion const& assertion)
+{
+    auto const& request = m_request.get<GetRequest>();
+
+    // https://w3c.github.io/webauthn/#sctn-getAssertion, constructAssertionAlg:
+    Web::WebAuthn::AssertionResponse response;
+
+    // If the allow list had one credential, the authenticator may leave out which one it used.
+    response.credential_id = assertion.credential_id;
+    if (response.credential_id.is_empty() && request.allow_credentials.size() == 1)
+        response.credential_id = request.allow_credentials.first().id;
+
+    response.client_data_json = m_client_data_json;
+    response.authenticator_data = assertion.authenticator_data;
+    response.signature = assertion.signature;
+    if (assertion.user.has_value() && !assertion.user->id.is_empty())
+        response.user_handle = assertion.user->id;
+    if (m_selected)
+        response.authenticator_attachment = m_selected->info().attachment;
+
+    // https://w3c.github.io/webauthn/#sctn-appid-extension
+    // When creating assertionCreationData, if the assertion was created by a U2F authenticator with the U2F
+    // application parameter set to the SHA-256 hash of appId instead of the SHA-256 hash of the RP ID, set output to
+    // true.
+    if (request.app_id.has_value())
+        response.used_app_id = m_pending_assertions_used_app_id;
+
+    end(move(response));
+}
+
+void WebAuthnCoordinator::Ceremony::user_cancelled()
+{
+    // If the user cancels the process, cancel the authenticator operations and throw a "NotAllowedError".
+    // NB: A ceremony that has answered already just closes its prompt.
+    end(not_allowed("The user cancelled"sv));
+}
+
+void WebAuthnCoordinator::Ceremony::end(Optional<Web::WebAuthn::Result> result)
+{
+    if (m_phase == Phase::Ended)
+        return;
+    auto was_answered = m_phase == Phase::Answered;
+    m_phase = Phase::Ended;
+
+    for (auto& candidate : m_candidates) {
+        if (candidate.is_busy)
+            candidate.authenticator->cancel();
+    }
+
+    if (m_lifetime_timer)
+        m_lifetime_timer->stop();
+    if (m_liveness_timer)
+        m_liveness_timer->stop();
+
+    if (!was_answered && result.has_value() && m_page && m_page->is_open())
+        m_page->async_web_authn_request_completed(m_request_id, result.release_value());
+
+    close_prompt();
+    m_candidates.clear();
+    m_selected = nullptr;
+
+    // NB: A discovery may be reporting an authenticator right now, on the stack below.
+    Core::deferred_invoke([discoveries = move(m_discoveries)] { });
+    m_pending_registration.clear();
+    m_pending_assertions.clear();
+
+    WebAuthnCoordinator::the().ceremony_ended(*this);
+}
+
+void WebAuthnCoordinator::Ceremony::abandon()
+{
+    end({});
+}
+
+void WebAuthnCoordinator::Ceremony::show_prompt(WebAuthnPrompt::State state)
+{
+    m_prompt.state = state;
+
+    auto* view = this->view();
+    if (!view || !view->on_web_authn_prompt)
+        return;
+    m_prompt_is_shown = true;
+    view->on_web_authn_prompt(m_prompt);
+}
+
+void WebAuthnCoordinator::Ceremony::close_prompt()
+{
+    if (!m_prompt_is_shown)
+        return;
+    m_prompt_is_shown = false;
+    auto* view = this->view();
+    if (view && view->on_web_authn_prompt_closed)
+        view->on_web_authn_prompt_closed();
+}
+
+WebAuthnCoordinator& WebAuthnCoordinator::the()
+{
+    static auto& coordinator = *new WebAuthnCoordinator;
+    return coordinator;
+}
+
+void WebAuthnCoordinator::add_authenticator_source(AuthenticatorSource& source)
+{
+    m_sources.append(&source);
+}
+
+void WebAuthnCoordinator::begin_create(WebContentPage& page, u64 request_id, CeremonyContext context, CreateRequest request)
+{
+    begin(page, request_id, move(context), move(request));
+}
+
+void WebAuthnCoordinator::begin_get(WebContentPage& page, u64 request_id, CeremonyContext context, GetRequest request)
+{
+    begin(page, request_id, move(context), move(request));
+}
+
+void WebAuthnCoordinator::begin(WebContentPage& page, u64 request_id, CeremonyContext context, Variant<CreateRequest, GetRequest> request)
+{
+    // A ceremony may only start in a view that can ask the user, and that the user is looking at: as in other browsers,
+    // a page in the background can't ask for a credential.
+    auto& traversable = page.traversable();
+    auto view = traversable.view();
+    if (!view.has_value() || !view->on_web_authn_prompt) {
+        page.async_web_authn_request_completed(request_id, not_allowed("No authenticators are available"sv));
+        return;
+    }
+    if (traversable.system_visibility_state() != Web::HTML::VisibilityState::Visible || !traversable.has_system_focus()) {
+        page.async_web_authn_request_completed(request_id, not_allowed("The page does not have focus"sv));
+        return;
+    }
+
+    if (any_of(m_ceremonies, [&](auto const& ceremony) { return ceremony->page() && &ceremony->page()->traversable() == &traversable; })) {
+        page.async_web_authn_request_completed(request_id, not_allowed("Another WebAuthn request is in progress"sv));
+        return;
+    }
+
+    auto ceremony = adopt_ref(*new Ceremony(page, request_id, move(context), move(request)));
+    m_ceremonies.append(ceremony);
+    ceremony->start(m_sources);
+}
+
+void WebAuthnCoordinator::ceremony_ended(Ceremony& ceremony)
+{
+    // NB: The ceremony may be on the stack, in one of its own callbacks.
+    auto index = m_ceremonies.find_first_index_if([&](auto const& other) { return other.ptr() == &ceremony; });
+    if (!index.has_value())
+        return;
+    Core::deferred_invoke([ceremony = m_ceremonies.take(*index)] { });
+}
+
+void WebAuthnCoordinator::cancel(WebContentPage const& page, u64 request_id)
+{
+    for (auto& ceremony : m_ceremonies) {
+        if (ceremony->page() == &page && ceremony->request_id() == request_id) {
+            ceremony->abandon();
+            return;
+        }
+    }
+}
+
+WebAuthnCoordinator::Ceremony* WebAuthnCoordinator::ceremony_in_view(ViewImplementation const& view) const
+{
+    for (auto const& ceremony : m_ceremonies) {
+        if (ceremony->view() == &view)
+            return ceremony.ptr();
+    }
+    return nullptr;
+}
+
+void WebAuthnCoordinator::user_cancelled(ViewImplementation const& view)
+{
+    if (auto* ceremony = ceremony_in_view(view))
+        ceremony->user_cancelled();
+}
+
+void WebAuthnCoordinator::user_entered_pin(ViewImplementation const& view, String pin)
+{
+    if (auto* ceremony = ceremony_in_view(view))
+        ceremony->user_entered_pin(move(pin));
+}
+
+void WebAuthnCoordinator::user_chose_account(ViewImplementation const& view, size_t index)
+{
+    if (auto* ceremony = ceremony_in_view(view))
+        ceremony->user_chose_account(index);
+}
+
+void WebAuthnCoordinator::user_answered_attestation_consent(ViewImplementation const& view, bool allow)
+{
+    if (auto* ceremony = ceremony_in_view(view))
+        ceremony->user_answered_attestation_consent(allow);
+}
+
+}
diff --git a/Libraries/LibWebView/WebAuthn/Coordinator.h b/Libraries/LibWebView/WebAuthn/Coordinator.h
new file mode 100644
index 0000000000000000000000000000000000000000..0d9212e1b59692fc89eeb84bfb9d3384dc3f5962
--- /dev/null
+++ b/Libraries/LibWebView/WebAuthn/Coordinator.h
@@ -0,0 +1,68 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/NonnullRefPtr.h>
+#include <AK/Vector.h>
+#include <LibURL/Origin.h>
+#include <LibWebCommon/HTML/CrossProcessId.h>
+#include <LibWebCommon/WebAuthn/WebAuthn.h>
+#include <LibWebView/Export.h>
+#include <LibWebView/Forward.h>
+#include <LibWebView/WebAuthn/Authenticator.h>
+
+namespace WebView {
+
+// Runs the authenticator part of WebAuthn ceremonies: it finds authenticators, issues them requests, asks the user
+// what it needs to through the requesting view's prompt, and answers the renderer.
+// https://w3c.github.io/webauthn/#sctn-createCredential
+// https://w3c.github.io/webauthn/#sctn-discover-from-external-source
+class WEBVIEW_API WebAuthnCoordinator {
+public:
+    static WebAuthnCoordinator& the();
+
+    // The caller, as the browser process's own records of documents describe it.
+    struct CeremonyContext {
+        URL::Origin origin { URL::Origin::create_opaque() };
+        bool cross_origin { false };
+        Optional<URL::Origin> top_level_origin;
+        Web::HTML::CrossProcessId navigable_id;
+        Web::HTML::CrossProcessId document_id;
+    };
+
+    // NB: A source must outlive the coordinator.
+    void add_authenticator_source(AuthenticatorSource&);
+
+    void begin_create(WebContentPage&, u64 request_id, CeremonyContext, Web::WebAuthn::CreateRequest);
+    void begin_get(WebContentPage&, u64 request_id, CeremonyContext, Web::WebAuthn::GetRequest);
+
+    // The renderer gave up on a request, because its AbortSignal was aborted.
+    void cancel(WebContentPage const&, u64 request_id);
+
+    // What the user does in the prompt of the ceremony a view shows.
+    void user_cancelled(ViewImplementation const&);
+    void user_entered_pin(ViewImplementation const&, String pin);
+    void user_chose_account(ViewImplementation const&, size_t index);
+    void user_answered_attestation_consent(ViewImplementation const&, bool allow);
+
+private:
+    class Ceremony;
+    friend class Ceremony;
+
+    WebAuthnCoordinator() = default;
+
+    void begin(WebContentPage&, u64 request_id, CeremonyContext, Variant<Web::WebAuthn::CreateRequest, Web::WebAuthn::GetRequest>);
+    void ceremony_ended(Ceremony&);
+    Ceremony* ceremony_in_view(ViewImplementation const&) const;
+
+    // NB: A tab runs one ceremony at a time.
+    Vector<NonnullRefPtr<Ceremony>> m_ceremonies;
+
+    Vector<AuthenticatorSource*> m_sources;
+};
+
+}
diff --git a/Libraries/LibWebView/WebAuthn/Prompt.h b/Libraries/LibWebView/WebAuthn/Prompt.h
new file mode 100644
index 0000000000000000000000000000000000000000..bfd39cfcfc12ae4ff3e82254ad9b5151b45680fd
--- /dev/null
+++ b/Libraries/LibWebView/WebAuthn/Prompt.h
@@ -0,0 +1,79 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Optional.h>
+#include <AK/String.h>
+#include <AK/Vector.h>
+#include <LibURL/Origin.h>
+#include <LibWebView/Export.h>
+
+namespace WebView {
+
+// What a WebAuthn ceremony is waiting for, for the embedder to show the user. The embedder answers through
+// ViewImplementation's web_authn_* methods.
+struct WEBVIEW_API WebAuthnPrompt {
+    enum class Operation : u8 {
+        // navigator.credentials.create(): registering an authenticator with a site.
+        Create,
+        // navigator.credentials.get(): signing in with one.
+        Get,
+    };
+
+    enum class State : u8 {
+        // Insert a security key, and touch it.
+        InsertKey,
+        // Enter the security key's PIN. pin_retries says how many attempts are left, if the key said.
+        EnterPin,
+        // Touch the security key to finish, after entering its PIN.
+        TouchKey,
+        // The security key holds several accounts for the site: choose one of accounts.
+        ChooseAccount,
+        // The site asks to see the security key's make and model: answer with web_authn_allow_attestation().
+        AttestationConsent,
+        // This security key isn't registered with the site. Another one may be.
+        KeyNotRegistered,
+        // This security key is already registered with the site. The ceremony has ended.
+        KeyAlreadyRegistered,
+        // This security key's PIN is blocked, after too many wrong attempts.
+        PinBlocked,
+        // The site requires a PIN or other verification, and this security key has none set up.
+        PinNotSet,
+        // This security key can't do what the site asked.
+        KeyNotSupported,
+        // The site asked for an authenticator built into the device, and there is none.
+        NoPlatformAuthenticator,
+    };
+
+    struct Account {
+        String name;
+        String display_name;
+    };
+
+    Operation operation { Operation::Get };
+    State state { State::InsertKey };
+
+    // The site the credential is for.
+    String rp_id;
+
+    // The origin asking, and, when it is a frame of another site, the origin the address bar shows.
+    URL::Origin origin { URL::Origin::create_opaque() };
+    Optional<URL::Origin> top_level_origin;
+
+    // For Create: the account being registered.
+    String user_name;
+
+    Optional<u32> pin_retries;
+    bool pin_was_wrong { false };
+
+    Vector<Account> accounts;
+
+    // Whether the ceremony is over, so that the prompt only informs.
+    bool has_ended() const { return state == State::KeyAlreadyRegistered; }
+};
+
+}
