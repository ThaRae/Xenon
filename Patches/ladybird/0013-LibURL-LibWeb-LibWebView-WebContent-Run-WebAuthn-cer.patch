+// https://w3c.github.io/webauthn/#sctn-api
+// The renderer has checked the request already, but this process decides: it knows which document asks, and
+// where, from its own records, which a renderer can't forge.
+ErrorOr<WebAuthnCoordinator::CeremonyContext, Web::WebAuthn::Error> WebContentPage::web_authn_ceremony_context(StringView message_name, Web::HTML::CrossProcessId navigable_id, Web::HTML::CrossProcessId document_id, Web::PermissionsPolicy::PolicyControlledFeature feature, String const& rp_id)
+{
+    auto not_allowed = [](StringView message) {
+        return Web::WebAuthn::Error { Web::WebAuthn::ErrorName::NotAllowedError, MUST(String::from_utf8(message)) };
+    };
+    auto security_error = [](StringView message) {
+        return Web::WebAuthn::Error { Web::WebAuthn::ErrorName::SecurityError, MUST(String::from_utf8(message)) };
+    };
+
+    // Only the process hosting a document speaks for it. The document may have been replaced since it asked.
+    auto navigable = traversable().find(navigable_id);
+    if (!navigable.has_value())
+        return not_allowed("The document is gone"sv);
+    auto document = navigable->document_with_id(document_id);
+    if (!document)
+        return not_allowed("The document is gone"sv);
+    if (document->host() != this) {
+        client().did_misbehave(message_name, "WebAuthn request for a document the page does not host"sv);
+        return not_allowed("The document is not hosted by this page"sv);
+    }
+    if (&navigable->active_document() != document.ptr())
+        return not_allowed("The document is not active"sv);
+
+    WebAuthnCoordinator::CeremonyContext context;
+    context.origin = document->origin();
+    context.navigable_id = navigable_id;
+    context.document_id = document_id;
+
+    // Let callerOrigin be origin. If callerOrigin is an opaque origin, throw a "NotAllowedError" DOMException.
+    if (context.origin.is_opaque())
+        return not_allowed("Opaque origins can't use WebAuthn"sv);
+
+    // NB: Only secure contexts have the API.
+    auto top_level_origin = document->top_level_origin();
+    if (!top_level_origin.has_value())
+        return not_allowed("The document has no top-level browsing context"sv);
+    if (Web::SecureContexts::is_origin_potentially_trustworthy(context.origin) != Web::SecureContexts::Trustworthiness::PotentiallyTrustworthy
+        || Web::SecureContexts::is_origin_potentially_trustworthy(*top_level_origin) != Web::SecureContexts::Trustworthiness::PotentiallyTrustworthy)
+        return not_allowed("WebAuthn requires a secure context"sv);
+
+    // Let effectiveDomain be the callerOrigin’s effective domain. If effective domain is not a valid domain, then throw
+    // a "SecurityError" DOMException.
+    // NB: This process doesn't follow document.domain, which only ever shortens the host to one of its registrable
+    //     suffixes, so the host allows every RP ID that the effective domain does.
+    auto const& host = context.origin.host();
+    if (!host.is_domain() || host.is_empty_host())
+        return security_error("The caller's origin has no valid domain"sv);
+
+    // If the RP ID is not a registrable domain suffix of and is not equal to effectiveDomain, throw a "SecurityError"
+    // DOMException.
+    auto rp_id_host = URL::Parser::parse_host(rp_id);
+    if (rp_id.is_empty() || !rp_id_host.has_value() || !rp_id_host->is_a_registrable_domain_suffix_of_or_is_equal_to(host))
+        return security_error("The RP ID is not a registrable domain suffix of the caller's domain"sv);
+
+    // https://w3c.github.io/webauthn/#sctn-permissions-policy
+    if (Web::PermissionsPolicy::check_permissions_policy(document->permissions_policy(), feature, context.origin, context.origin) != Web::PermissionsPolicy::FeatureValue::Enabled)
+        return not_allowed("The permissions policy does not allow this request"sv);
+
+    // https://w3c.github.io/webappsec-credential-management/#same-origin-with-its-ancestors
+    for (auto const* ancestor = navigable->parent(); ancestor; ancestor = ancestor->parent()) {
+        if (!ancestor->active_document().origin().is_same_origin(context.origin)) {
+            context.cross_origin = true;
+            break;
+        }
+    }
+    context.top_level_origin = top_level_origin.release_value();
+
+    return context;
+}
+
+void WebContentPage::did_request_web_authn_create(u64 request_id, Web::HTML::CrossProcessId navigable_id, Web::HTML::CrossProcessId document_id, Web::WebAuthn::CreateRequest request)
+{
+    auto context = web_authn_ceremony_context("did_request_web_authn_create"sv, navigable_id, document_id, Web::PermissionsPolicy::PolicyControlledFeature::PublicKeyCredentialsCreate, request.rp_id);
+    if (context.is_error()) {
+        async_web_authn_request_completed(request_id, context.release_error());
+        return;
+    }
+    WebAuthnCoordinator::the().begin_create(*this, request_id, context.release_value(), move(request));
+}
+
+void WebContentPage::did_request_web_authn_get(u64 request_id, Web::HTML::CrossProcessId navigable_id, Web::HTML::CrossProcessId document_id, Web::WebAuthn::GetRequest request)
+{
+    auto context = web_authn_ceremony_context("did_request_web_authn_get"sv, navigable_id, document_id, Web::PermissionsPolicy::PolicyControlledFeature::PublicKeyCredentialsGet, request.rp_id);
+    if (context.is_error()) {
+        async_web_authn_request_completed(request_id, context.release_error());
+        return;
+    }
+    WebAuthnCoordinator::the().begin_get(*this, request_id, context.release_value(), move(request));
+}
+
+void WebContentPage::did_cancel_web_authn_request(u64 request_id)
+{
+    WebAuthnCoordinator::the().cancel(*this, request_id);
+}
