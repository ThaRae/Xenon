+
+static ByteBuffer from_hex(StringView hex)
+{
+    VERIFY(hex.length() % 2 == 0);
+    ByteBuffer bytes;
+    for (size_t i = 0; i < hex.length(); i += 2)
+        bytes.append(AK::parse_hexadecimal_number<u8>(hex.substring_view(i, 2)).value());
+    return bytes;
+}
+
+static URL::Origin origin(StringView url)
+{
+    return URL::Parser::basic_parse(url)->origin();
+}
+
+// https://w3c.github.io/webauthn/#sctn-test-vectors-none-es256-topOrigin
+static constexpr auto TOP_ORIGIN_CHALLENGE = "4e1f4c6198699e33c14f192153f49d7e0e8e3577d5ac416c5f3adc92a41f27e5"sv;
+static constexpr auto TOP_ORIGIN_CLIENT_DATA_JSON = ""sv;
+static constexpr auto TOP_ORIGIN_ATTESTATION_OBJECT = ""sv;
+
+TEST_CASE(client_data_serialization)
+{
+    WebView::CollectedClientData client_data;
+    client_data.type = WebView::CollectedClientData::Type::Create;
+    client_data.challenge = from_hex(TOP_ORIGIN_CHALLENGE);
+    client_data.origin = origin("https://example.org"sv);
+    client_data.cross_origin = true;
+    client_data.top_origin = origin("https://example.com"sv);
+    EXPECT_EQ(client_data.serialize(), from_hex(TOP_ORIGIN_CLIENT_DATA_JSON));
+
+    client_data.type = WebView::CollectedClientData::Type::Get;
+    client_data.challenge = from_hex("0102"sv);
+    client_data.cross_origin = false;
+    client_data.top_origin = {};
+    auto serialized = client_data.serialize();
+    EXPECT_EQ(StringView { serialized }, R"({"type":"webauthn.get","challenge":"AQI","origin":"https://example.org","crossOrigin":false})"sv);
+}
+
+TEST_CASE(attestation_object_round_trip)
+{
+    auto attestation_object = from_hex(TOP_ORIGIN_ATTESTATION_OBJECT);
+    auto decoded = TRY_OR_FAIL(WebView::CBOR::decode(attestation_object));
+
+    auto const* format = decoded.get("fmt"sv);
+    auto const* authenticator_data_bytes = decoded.get("authData"sv);
+    EXPECT(format && format->is_text() && format->value.get<String>() == "none"sv);
+    EXPECT(authenticator_data_bytes && authenticator_data_bytes->is_bytes());
+
+    auto authenticator_data = TRY_OR_FAIL(WebView::AuthenticatorData::parse(authenticator_data_bytes->value.get<ByteBuffer>()));
+    EXPECT(authenticator_data.attested_credential_data.has_value());
+    EXPECT_EQ(authenticator_data.attested_credential_data->credential_id, from_hex("b8ad59b996047ab18e2ceb57206c362da57458793481f4a8ebf101c7ca7cc0f1"sv));
+    EXPECT_EQ(authenticator_data.attested_credential_data->aaguid, from_hex("97586fd09799a76401c200455099ef2a"sv));
+    EXPECT_EQ(authenticator_data.serialize(), authenticator_data_bytes->value.get<ByteBuffer>());
+
+    // Building the attestation object again gives the same bytes, in CTAP2 canonical order.
+    auto none_statement = WebView::none_attestation_statement();
+    EXPECT_EQ(WebView::encode_attestation_object("none"sv, none_statement, authenticator_data_bytes->value.get<ByteBuffer>()), attestation_object);
+}
+
+TEST_CASE(credential_public_key)
+{
+    auto attestation_object_bytes = from_hex(TOP_ORIGIN_ATTESTATION_OBJECT);
+    auto attestation_object = TRY_OR_FAIL(WebView::CBOR::decode(attestation_object_bytes));
+    auto authenticator_data = TRY_OR_FAIL(WebView::AuthenticatorData::parse(attestation_object.get("authData"sv)->value.get<ByteBuffer>()));
+
+    auto public_key = TRY_OR_FAIL(WebView::CredentialPublicKey::from_cose_key(authenticator_data.attested_credential_data->credential_public_key));
+    EXPECT_EQ(public_key.algorithm, WebView::COSE_ALGORITHM_ES256);
+    EXPECT(public_key.subject_public_key_info.has_value());
+
+    // The SubjectPublicKeyInfo holds the uncompressed point.
+    Crypto::ASN1::Decoder decoder { *public_key.subject_public_key_info };
+    auto subject_public_key = TRY_OR_FAIL(Crypto::Certificate::parse_subject_public_key_info(decoder));
+    auto expected_point = from_hex("04a1c47c1d82da4ebe82cd72207102b380670701993bc35398ae2e5726427fe01d86c1080d82987028c7f54ecb1b01185de243b359294a0ed210cd47480f0adc88"sv);
+    EXPECT_EQ(subject_public_key.raw_key, expected_point);
+
+    // A key of an algorithm getPublicKey() doesn't support has no SubjectPublicKeyInfo.
+    WebView::CBOR::Encoder encoder;
+    encoder.begin_map(2);
+    encoder.write_integer(1);
+    encoder.write_integer(2);
+    encoder.write_integer(3);
+    encoder.write_integer(-35);
+    auto es384_key = encoder.finish();
+    auto es384 = TRY_OR_FAIL(WebView::CredentialPublicKey::from_cose_key(es384_key));
+    EXPECT_EQ(es384.algorithm, -35);
+    EXPECT(!es384.subject_public_key_info.has_value());
+}
+
+TEST_CASE(self_attestation)
+{
+    auto zero_aaguid = MUST(ByteBuffer::create_zeroed(16));
+    auto signature = from_hex("3006020101020101"sv);
+
+    WebView::CBOR::Encoder self;
+    self.begin_map(2);
+    self.write_text("alg"sv);
+    self.write_integer(-7);
+    self.write_text("sig"sv);
+    self.write_bytes(signature);
+    auto self_statement = self.finish();
+    EXPECT(WebView::is_self_attestation("packed"sv, self_statement, zero_aaguid));
+
+    WebView::CBOR::Encoder full;
+    full.begin_map(3);
+    full.write_text("alg"sv);
+    full.write_integer(-7);
+    full.write_text("sig"sv);
+    full.write_bytes(signature);
+    full.write_text("x5c"sv);
+    full.begin_array(0);
+    auto full_statement = full.finish();
+    EXPECT(!WebView::is_self_attestation("packed"sv, full_statement, zero_aaguid));
+    EXPECT(!WebView::is_self_attestation("fido-u2f"sv, self_statement, zero_aaguid));
+    auto aaguid = from_hex("97586fd09799a76401c200455099ef2a"sv);
+    EXPECT(!WebView::is_self_attestation("packed"sv, self_statement, aaguid));
+}
+
+static bool is_malformed(StringView hex)
+{
+    auto bytes = from_hex(hex);
+    return WebView::CBOR::decode(bytes).is_error();
+}
+
+TEST_CASE(cbor_rejects_malformed_input)
+{
+    // Truncated byte string, indefinite length, trailing data, and nesting deeper than any authenticator needs.
+    EXPECT(is_malformed("4401"sv));
+    EXPECT(is_malformed("5f4101ff"sv));
+    EXPECT(is_malformed("0000"sv));
+    ByteBuffer deep;
+    for (size_t i = 0; i < 64; ++i)
+        deep.append(0x81);
+    deep.append(0x00);
+    EXPECT(WebView::CBOR::decode(deep).is_error());
+
+    // A map claiming more entries than there are bytes.
+    EXPECT(is_malformed("bb7fffffffffffffff"sv));
+}
+
+TEST_CASE(registrable_domain_suffix)
+{
+    auto host = [](StringView string) { return URL::Parser::parse_host(string).release_value(); };
+
+    EXPECT(host("example.com"sv).is_a_registrable_domain_suffix_of_or_is_equal_to(host("login.example.com"sv)));
+    EXPECT(host("login.example.com"sv).is_a_registrable_domain_suffix_of_or_is_equal_to(host("login.example.com"sv)));
+    EXPECT(!host("com"sv).is_a_registrable_domain_suffix_of_or_is_equal_to(host("example.com"sv)));
+    EXPECT(!host("other.com"sv).is_a_registrable_domain_suffix_of_or_is_equal_to(host("example.com"sv)));
+    EXPECT(!host("github.io"sv).is_a_registrable_domain_suffix_of_or_is_equal_to(host("someone.github.io"sv)));
+    EXPECT(!host("1.2.3.4"sv).is_a_registrable_domain_suffix_of_or_is_equal_to(host("example.com"sv)));
+    EXPECT(host("localhost"sv).is_a_registrable_domain_suffix_of_or_is_equal_to(host("localhost"sv)));
+}
