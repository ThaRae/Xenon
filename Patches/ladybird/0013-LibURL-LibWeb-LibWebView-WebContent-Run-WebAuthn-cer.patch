@@ -0,0 +1,102 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/Base64.h>
+#include <AK/StringBuilder.h>
+#include <AK/Utf8View.h>
+#include <LibCrypto/Hash/SHA2.h>
+#include <LibWebView/WebAuthn/ClientData.h>
+
+namespace WebView {
+
+// https://w3c.github.io/webauthn/#ccdtostring
+static void append_ccd_to_string(StringBuilder& result, StringView string)
+{
+    // 1. Let encoded be an empty byte string.
+    // 2. Append 0x22 (") to encoded.
+    result.append('"');
+
+    // 3. Invoke ToString on the given object to convert to a string.
+    // 4. For each code point in the resulting string, if the code point:
+    for (auto code_point : Utf8View { string }) {
+        // - is in the set {U+0020, U+0021, U+0023–U+005B, U+005D–U+10FFFF}: Append the UTF-8 encoding of that code
+        //   point to encoded.
+        if (code_point == 0x20 || code_point == 0x21 || (code_point >= 0x23 && code_point <= 0x5b) || code_point >= 0x5d)
+            result.append_code_point(code_point);
+        // - is U+0022: Append 0x5c22 (\") to encoded.
+        else if (code_point == '"')
+            result.append("\\\""sv);
+        // - is U+005C: Append 0x5c5c (\\) to encoded.
+        else if (code_point == '\\')
+            result.append("\\\\"sv);
+        // - otherwise: Append 0x5c75 (\u) to encoded, followed by four, lower-case hex digits that, when interpreted
+        //   as a base-16 number, represent that code point.
+        else
+            result.appendff("\\u{:04x}", code_point);
+    }
+
+    // 5. Append 0x22 (") to encoded.
+    result.append('"');
+}
+
+// https://w3c.github.io/webauthn/#clientdatajson-serialization
+ByteBuffer CollectedClientData::serialize() const
+{
+    // 1. Let result be an empty byte string.
+    StringBuilder result;
+
+    // 2. Append 0x7b2274797065223a ({"type":) to result.
+    result.append("{\"type\":"sv);
+
+    // 3. Append CCDToString(type) to result.
+    append_ccd_to_string(result, type == Type::Create ? "webauthn.create"sv : "webauthn.get"sv);
+
+    // 4. Append 0x2c226368616c6c656e6765223a (,"challenge":) to result.
+    result.append(",\"challenge\":"sv);
+
+    // 5. Append CCDToString(challenge) to result.
+    // NB: challenge is the base64url encoding of the challenge.
+    append_ccd_to_string(result, MUST(encode_base64url(challenge, AK::OmitPadding::Yes)));
+
+    // 6. Append 0x2c226f726967696e223a (,"origin":) to result.
+    result.append(",\"origin\":"sv);
+
+    // 7. Append CCDToString(origin) to result.
+    append_ccd_to_string(result, origin.serialize());
+
+    // 8. Append 0x2c2263726f73734f726967696e223a (,"crossOrigin":) to result.
+    result.append(",\"crossOrigin\":"sv);
+
+    // 9. If crossOrigin is not present, or is false, append 0x66616c7365 (false) to result. Otherwise, append
+    //    0x74727565 (true) to result.
+    result.append(cross_origin ? "true"sv : "false"sv);
+
+    // 10. If topOrigin is present:
+    if (top_origin.has_value()) {
+        // 1. Append 0x2c22746f704f726967696e223a (,"topOrigin":) to result.
+        result.append(",\"topOrigin\":"sv);
+
+        // 2. Append CCDToString(topOrigin) to result.
+        append_ccd_to_string(result, top_origin->serialize());
+    }
+
+    // 11. Create a temporary copy of the CollectedClientData and remove the fields type, challenge, origin,
+    //     crossOrigin (if present), and topOrigin (if present).
+    // 12. If no fields remain in the temporary copy then append 0x7d (}) to result.
+    result.append('}');
+
+    return MUST(result.to_byte_buffer());
+}
+
+// https://w3c.github.io/webauthn/#collectedclientdata-hash-of-the-serialized-client-data
+ByteBuffer hash_of_the_serialized_client_data(ReadonlyBytes client_data_json)
+{
+    // This is the hash (computed using SHA-256) of the JSON-compatible serialization of client data.
+    auto digest = Crypto::Hash::SHA256::hash(client_data_json);
+    return MUST(ByteBuffer::copy(digest.bytes()));
+}
+
+}
