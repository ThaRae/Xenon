diff --git a/Libraries/LibWebView/WebAuthn/AttestationObject.cpp b/Libraries/LibWebView/WebAuthn/AttestationObject.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2a0f6ec78234b0483bf558279101de1be43df510
--- /dev/null
+++ b/Libraries/LibWebView/WebAuthn/AttestationObject.cpp
@@ -0,0 +1,197 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/Endian.h>
+#include <LibCrypto/ASN1/Constants.h>
+#include <LibCrypto/BigInt/UnsignedBigInteger.h>
+#include <LibCrypto/PK/PK.h>
+#include <LibCrypto/PK/RSA.h>
+#include <LibWebView/WebAuthn/AttestationObject.h>
+#include <LibWebView/WebAuthn/CBOR.h>
+
+namespace WebView {
+
+// https://datatracker.ietf.org/doc/html/rfc9053#name-key-object-parameters
+static constexpr i64 COSE_KEY_KTY = 1;
+static constexpr i64 COSE_KEY_ALG = 3;
+static constexpr i64 COSE_KEY_EC2_CRV = -1;
+static constexpr i64 COSE_KEY_EC2_X = -2;
+static constexpr i64 COSE_KEY_EC2_Y = -3;
+static constexpr i64 COSE_KEY_OKP_X = -2;
+static constexpr i64 COSE_KEY_RSA_N = -1;
+static constexpr i64 COSE_KEY_RSA_E = -2;
+
+static constexpr i64 COSE_KEY_TYPE_OKP = 1;
+static constexpr i64 COSE_KEY_TYPE_EC2 = 2;
+static constexpr i64 COSE_KEY_TYPE_RSA = 3;
+
+static constexpr i64 COSE_CURVE_P256 = 1;
+static constexpr i64 COSE_CURVE_ED25519 = 6;
+
+ErrorOr<AuthenticatorData> AuthenticatorData::parse(ReadonlyBytes bytes)
+{
+    // rpIdHash (32), flags (1), signCount (4), then attestedCredentialData and extensions, if their flags are set.
+    if (bytes.size() < 37)
+        return Error::from_string_literal("Authenticator data is too short");
+
+    AuthenticatorData data;
+    data.rp_id_hash = TRY(ByteBuffer::copy(bytes.slice(0, 32)));
+    data.flags = bytes[32];
+    data.sign_count = (static_cast<u32>(bytes[33]) << 24) | (static_cast<u32>(bytes[34]) << 16) | (static_cast<u32>(bytes[35]) << 8) | bytes[36];
+
+    if (!(data.flags & AttestedCredentialDataIncluded))
+        return data;
+
+    // aaguid (16), credentialIdLength (2), credentialId, credentialPublicKey (CBOR).
+    auto rest = bytes.slice(37);
+    if (rest.size() < 18)
+        return Error::from_string_literal("Attested credential data is too short");
+
+    AttestedCredentialData attested;
+    attested.aaguid = TRY(ByteBuffer::copy(rest.slice(0, 16)));
+    size_t credential_id_length = (static_cast<size_t>(rest[16]) << 8) | rest[17];
+    rest = rest.slice(18);
+    if (rest.size() < credential_id_length)
+        return Error::from_string_literal("Credential ID is longer than the authenticator data");
+    attested.credential_id = TRY(ByteBuffer::copy(rest.slice(0, credential_id_length)));
+    rest = rest.slice(credential_id_length);
+
+    auto public_key = TRY(CBOR::decode_prefix(rest));
+    attested.credential_public_key = TRY(ByteBuffer::copy(rest.slice(0, public_key.length)));
+    data.attested_credential_data = move(attested);
+    return data;
+}
+
+ByteBuffer AuthenticatorData::serialize() const
+{
+    ByteBuffer bytes;
+    bytes.append(rp_id_hash);
+    bytes.append(attested_credential_data.has_value() ? flags | AttestedCredentialDataIncluded : flags);
+    for (int shift = 24; shift >= 0; shift -= 8)
+        bytes.append(static_cast<u8>(sign_count >> shift));
+    if (attested_credential_data.has_value()) {
+        bytes.append(attested_credential_data->aaguid);
+        bytes.append(static_cast<u8>(attested_credential_data->credential_id.size() >> 8));
+        bytes.append(static_cast<u8>(attested_credential_data->credential_id.size()));
+        bytes.append(attested_credential_data->credential_id);
+        bytes.append(attested_credential_data->credential_public_key);
+    }
+    return bytes;
+}
+
+// https://w3c.github.io/webauthn/#sctn-generating-an-attestation-object
+ByteBuffer encode_attestation_object(StringView format, ReadonlyBytes attestation_statement, ReadonlyBytes authenticator_data)
+{
+    // attObj = { authData: bytes, $$attStmtType }, with attStmtType = ( fmt: text, attStmt: { * tstr => any } ), in
+    // CTAP2 canonical CBOR, whose map keys sort shortest first: "fmt", "attStmt", "authData".
+    CBOR::Encoder encoder;
+    encoder.begin_map(3);
+    encoder.write_text("fmt"sv);
+    encoder.write_text(format);
+    encoder.write_text("attStmt"sv);
+    encoder.write_encoded(attestation_statement);
+    encoder.write_text("authData"sv);
+    encoder.write_bytes(authenticator_data);
+    return encoder.finish();
+}
+
+// https://w3c.github.io/webauthn/#sctn-none-attestation
+ByteBuffer none_attestation_statement()
+{
+    // The attestation statement is an empty CBOR map.
+    CBOR::Encoder encoder;
+    encoder.begin_map(0);
+    return encoder.finish();
+}
+
+bool is_self_attestation(StringView format, ReadonlyBytes attestation_statement, ReadonlyBytes aaguid)
+{
+    // https://w3c.github.io/webauthn/#sctn-createCredential, constructCredentialAlg:
+    // If the aaguid in the attested credential data is 16 zero bytes, credentialCreationData.attestationObjectResult.fmt
+    // is "packed", and "x5c" is absent from credentialCreationData.attestationObjectResult, then self attestation is
+    // being used and no further action is needed.
+    if (format != "packed"sv)
+        return false;
+    if (!all_of(aaguid, [](u8 byte) { return byte == 0; }))
+        return false;
+    auto statement = CBOR::decode(attestation_statement);
+    if (statement.is_error() || !statement.value().is_map())
+        return false;
+    return !statement.value().get("x5c"sv);
+}
+
+static ErrorOr<ByteBuffer> bytes_member(CBOR::Value const& map, i64 key)
+{
+    auto const* value = map.get(key);
+    if (!value || !value->is_bytes())
+        return Error::from_string_literal("COSE key is missing a parameter");
+    return value->value.get<ByteBuffer>();
+}
+
+// https://w3c.github.io/webauthn/#sctn-public-key-easy
+ErrorOr<CredentialPublicKey> CredentialPublicKey::from_cose_key(ReadonlyBytes cose_key)
+{
+    auto key = TRY(CBOR::decode(cose_key));
+    auto const* key_type = key.get(COSE_KEY_KTY);
+    auto const* algorithm = key.get(COSE_KEY_ALG);
+    if (!key_type || !key_type->is_integer() || !algorithm || !algorithm->is_integer())
+        return Error::from_string_literal("COSE key has no key type or algorithm");
+
+    CredentialPublicKey result;
+    result.algorithm = static_cast<i32>(algorithm->value.get<i64>());
+
+    auto key_type_value = key_type->value.get<i64>();
+    // NB: EC2 and OKP keys both keep their curve under -1.
+    auto const* curve = key.get(COSE_KEY_EC2_CRV);
+    auto curve_value = curve && curve->is_integer() ? curve->value.get<i64>() : 0;
+
+    if (result.algorithm == COSE_ALGORITHM_ES256 && key_type_value == COSE_KEY_TYPE_EC2 && curve_value == COSE_CURVE_P256) {
+        auto x = TRY(bytes_member(key, COSE_KEY_EC2_X));
+        auto y = TRY(bytes_member(key, COSE_KEY_EC2_Y));
+        if (x.size() != 32 || y.size() != 32)
+            return Error::from_string_literal("Invalid P-256 point");
+        ByteBuffer point;
+        point.append(0x04);
+        point.append(x);
+        point.append(y);
+        Span<u32 const> parameters = ::Crypto::ASN1::secp256r1_oid;
+        result.subject_public_key_info = TRY(::Crypto::PK::wrap_in_subject_public_key_info(point, ::Crypto::ASN1::ec_public_key_encryption_oid, parameters));
+    } else if (result.algorithm == COSE_ALGORITHM_EDDSA && key_type_value == COSE_KEY_TYPE_OKP && curve_value == COSE_CURVE_ED25519) {
+        auto x = TRY(bytes_member(key, COSE_KEY_OKP_X));
+        if (x.size() != 32)
+            return Error::from_string_literal("Invalid Ed25519 key");
+        result.subject_public_key_info = TRY(::Crypto::PK::wrap_in_subject_public_key_info(x, ::Crypto::ASN1::ed25519_oid));
+    } else if (result.algorithm == COSE_ALGORITHM_RS256 && key_type_value == COSE_KEY_TYPE_RSA) {
+        auto n = TRY(bytes_member(key, COSE_KEY_RSA_N));
+        auto e = TRY(bytes_member(key, COSE_KEY_RSA_E));
+        ::Crypto::PK::RSAPublicKey public_key { ::Crypto::UnsignedBigInteger::import_data(n), ::Crypto::UnsignedBigInteger::import_data(e) };
+        auto der = TRY(public_key.export_as_der());
+        result.subject_public_key_info = TRY(::Crypto::PK::wrap_in_subject_public_key_info(der, ::Crypto::ASN1::rsa_encryption_oid, nullptr));
+    }
+
+    // NB: Another algorithm's key leaves getPublicKey() returning null, as the spec allows.
+    return result;
+}
+
+ByteBuffer cose_key_for_es256(ReadonlyBytes x, ReadonlyBytes y)
+{
+    // {1: 2, 3: -7, -1: 1, -2: x, -3: y}, in CTAP2 canonical order.
+    CBOR::Encoder encoder;
+    encoder.begin_map(5);
+    encoder.write_integer(COSE_KEY_KTY);
+    encoder.write_integer(COSE_KEY_TYPE_EC2);
+    encoder.write_integer(COSE_KEY_ALG);
+    encoder.write_integer(COSE_ALGORITHM_ES256);
+    encoder.write_integer(COSE_KEY_EC2_CRV);
+    encoder.write_integer(COSE_CURVE_P256);
+    encoder.write_integer(COSE_KEY_EC2_X);
+    encoder.write_bytes(x);
+    encoder.write_integer(COSE_KEY_EC2_Y);
+    encoder.write_bytes(y);
+    return encoder.finish();
+}
+
+}
diff --git a/Libraries/LibWebView/WebAuthn/AttestationObject.h b/Libraries/LibWebView/WebAuthn/AttestationObject.h
new file mode 100644
index 0000000000000000000000000000000000000000..c7c31ea181e19112a85b89c7cc93cce2d1a1fd78
--- /dev/null
+++ b/Libraries/LibWebView/WebAuthn/AttestationObject.h
@@ -0,0 +1,75 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteBuffer.h>
+#include <AK/Error.h>
+#include <AK/Optional.h>
+#include <AK/StringView.h>
+#include <LibWebView/Export.h>
+
+namespace WebView {
+
+// https://w3c.github.io/webauthn/#sctn-alg-identifier
+static constexpr i32 COSE_ALGORITHM_ES256 = -7;
+static constexpr i32 COSE_ALGORITHM_EDDSA = -8;
+static constexpr i32 COSE_ALGORITHM_RS256 = -257;
+
+// https://w3c.github.io/webauthn/#sctn-authenticator-data
+struct WEBVIEW_API AuthenticatorData {
+    // https://w3c.github.io/webauthn/#authdata-flags
+    enum Flags : u8 {
+        UserPresent = 1 << 0,
+        UserVerified = 1 << 2,
+        BackupEligible = 1 << 3,
+        BackupState = 1 << 4,
+        AttestedCredentialDataIncluded = 1 << 6,
+        ExtensionDataIncluded = 1 << 7,
+    };
+
+    // https://w3c.github.io/webauthn/#sctn-attested-credential-data
+    struct AttestedCredentialData {
+        ByteBuffer aaguid;
+        ByteBuffer credential_id;
+        ByteBuffer credential_public_key;
+    };
+
+    ByteBuffer rp_id_hash;
+    u8 flags { 0 };
+    u32 sign_count { 0 };
+    Optional<AttestedCredentialData> attested_credential_data;
+
+    static ErrorOr<AuthenticatorData> parse(ReadonlyBytes);
+
+    // Serializes authenticator data with no extensions.
+    ByteBuffer serialize() const;
+};
+
+// https://w3c.github.io/webauthn/#sctn-generating-an-attestation-object
+WEBVIEW_API ByteBuffer encode_attestation_object(StringView format, ReadonlyBytes attestation_statement, ReadonlyBytes authenticator_data);
+
+// https://w3c.github.io/webauthn/#sctn-none-attestation
+WEBVIEW_API ByteBuffer none_attestation_statement();
+
+// Whether a packed attestation statement is self attestation, which WebAuthn passes on even when the RP asked for no
+// attestation, since it identifies nothing.
+WEBVIEW_API bool is_self_attestation(StringView format, ReadonlyBytes attestation_statement, ReadonlyBytes aaguid);
+
+// https://w3c.github.io/webauthn/#sctn-public-key-easy
+struct WEBVIEW_API CredentialPublicKey {
+    i32 algorithm { 0 };
+
+    // The key as a DER SubjectPublicKeyInfo, for the algorithms getPublicKey() supports: ES256, EdDSA and RS256.
+    Optional<ByteBuffer> subject_public_key_info;
+
+    static ErrorOr<CredentialPublicKey> from_cose_key(ReadonlyBytes);
+};
+
+// https://w3c.github.io/webauthn/#sctn-encoded-credPubKey-examples
+WEBVIEW_API ByteBuffer cose_key_for_es256(ReadonlyBytes x, ReadonlyBytes y);
+
+}
diff --git a/Libraries/LibWebView/WebAuthn/Authenticator.h b/Libraries/LibWebView/WebAuthn/Authenticator.h
new file mode 100644
index 0000000000000000000000000000000000000000..4226c1a85332dc4ff93b804792acd544460a5678
--- /dev/null
+++ b/Libraries/LibWebView/WebAuthn/Authenticator.h
@@ -0,0 +1,167 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteBuffer.h>
+#include <AK/Function.h>
+#include <AK/NonnullOwnPtr.h>
+#include <AK/NonnullRefPtr.h>
+#include <AK/Optional.h>
+#include <AK/RefCounted.h>
+#include <AK/String.h>
+#include <AK/Variant.h>
+#include <AK/Vector.h>
+#include <LibWebCommon/WebAuthn/WebAuthn.h>
+#include <LibWebView/Export.h>
+#include <LibWebView/Forward.h>
+
+namespace WebView {
+
+// https://w3c.github.io/webauthn/#sctn-authenticator-model
+// An authenticator the browser process can reach, such as a security key on USB. Its operations are those of CTAP2,
+// one at a time, and complete on the thread that started them.
+class WEBVIEW_API Authenticator : public RefCounted<Authenticator> {
+public:
+    // What authenticatorGetInfo says about the authenticator.
+    struct Info {
+        // The COSE algorithms it supports, in its order of preference.
+        Vector<i32> algorithms;
+
+        bool supports_resident_keys { false };
+        bool supports_client_pin { false };
+        bool has_client_pin { false };
+        bool has_built_in_user_verification { false };
+
+        // CTAP 2.1's makeCredUvNotRqd: whether it makes non-discoverable credentials without user verification
+        // even when it is protected by user verification.
+        bool make_credential_without_user_verification { false };
+
+        // Whether it only speaks CTAP1/U2F.
+        bool is_u2f_only { false };
+
+        Vector<Web::WebAuthn::AuthenticatorTransport> transports;
+        Web::WebAuthn::AuthenticatorAttachment attachment { Web::WebAuthn::AuthenticatorAttachment::CrossPlatform };
+    };
+
+    // https://w3c.github.io/webauthn/#sctn-op-make-cred
+    struct MakeCredentialRequest {
+        ByteBuffer client_data_hash;
+        String rp_id;
+        String rp_name;
+        ByteBuffer user_id;
+        String user_name;
+        String user_display_name;
+        i32 algorithm { 0 };
+        Vector<Web::WebAuthn::PublicKeyCredentialDescriptor> exclude_list;
+        bool resident_key { false };
+        bool user_verification { false };
+        Optional<String> pin;
+    };
+
+    // https://w3c.github.io/webauthn/#sctn-op-get-assertion
+    struct GetAssertionRequest {
+        ByteBuffer client_data_hash;
+        String rp_id;
+        Vector<Web::WebAuthn::PublicKeyCredentialDescriptor> allow_list;
+        bool user_verification { false };
+        Optional<String> pin;
+    };
+
+    struct Registration {
+        ByteBuffer credential_id;
+        ByteBuffer authenticator_data;
+        String attestation_format;
+        // The CBOR encoding of the attestation statement.
+        ByteBuffer attestation_statement;
+        bool resident_key { false };
+    };
+
+    struct UserEntity {
+        ByteBuffer id;
+        String name;
+        String display_name;
+    };
+
+    struct Assertion {
+        ByteBuffer credential_id;
+        ByteBuffer authenticator_data;
+        ByteBuffer signature;
+        Optional<UserEntity> user;
+    };
+
+    enum class Error : u8 {
+        // No credential in the allow list is on the authenticator (CTAP2_ERR_NO_CREDENTIALS).
+        NoCredentials,
+        // A credential in the exclude list is on the authenticator (CTAP2_ERR_CREDENTIAL_EXCLUDED).
+        CredentialExcluded,
+        // The operation needs the PIN (CTAP2_ERR_PIN_REQUIRED, CTAP2_ERR_PUAT_REQUIRED).
+        PinRequired,
+        // The PIN was wrong (CTAP2_ERR_PIN_INVALID).
+        PinInvalid,
+        // Too many wrong PINs or failed verifications (CTAP2_ERR_PIN_BLOCKED, CTAP2_ERR_PIN_AUTH_BLOCKED,
+        // CTAP2_ERR_UV_BLOCKED).
+        PinBlocked,
+        // User verification is required, and no PIN is set (CTAP2_ERR_PIN_NOT_SET).
+        PinNotSet,
+        // The authenticator can't do what was asked (CTAP2_ERR_UNSUPPORTED_ALGORITHM, CTAP2_ERR_UNSUPPORTED_OPTION).
+        NotSupported,
+        // The user declined on the authenticator (CTAP2_ERR_OPERATION_DENIED).
+        OperationDenied,
+        // The user didn't respond in time (CTAP2_ERR_USER_ACTION_TIMEOUT).
+        Timeout,
+        // The operation was cancelled.
+        Cancelled,
+        // The authenticator went away.
+        Removed,
+        Other,
+    };
+
+    struct Failure {
+        Error error { Error::Other };
+        Optional<u32> pin_retries;
+    };
+
+    using MakeCredentialResult = Variant<Registration, Failure>;
+    using GetAssertionResult = Variant<Vector<Assertion>, Failure>;
+
+    virtual ~Authenticator() = default;
+
+    virtual Info const& info() const = 0;
+    virtual String const& name() const = 0;
+
+    virtual void make_credential(MakeCredentialRequest, Function<void(MakeCredentialResult)>) = 0;
+    virtual void get_assertion(GetAssertionRequest, Function<void(GetAssertionResult)>) = 0;
+
+    // Waits for the user to touch the authenticator to choose it (CTAP 2.1's authenticatorSelection).
+    virtual void wait_for_touch(Function<void(Optional<Failure>)>) = 0;
+
+    // How many PIN attempts are left before the PIN is blocked.
+    virtual void get_pin_retries(Function<void(Optional<u32>)>) = 0;
+
+    // Stops the operation in progress, which then completes with Error::Cancelled.
+    virtual void cancel() = 0;
+};
+
+// Finds authenticators for a ceremony while it waits for one.
+class WEBVIEW_API AuthenticatorSource {
+public:
+    // Reports authenticators until it is destroyed.
+    class Discovery {
+        AK_ALLOC_WITH_KMALLOC;
+
+    public:
+        virtual ~Discovery() = default;
+    };
+
+    virtual ~AuthenticatorSource() = default;
+
+    // Reports the authenticators that a ceremony in the traversable may use: those present now, and then each that
+    // appears.
+    virtual NonnullOwnPtr<Discovery> discover(CanonicalTraversable const&, Function<void(NonnullRefPtr<Authenticator>)> on_authenticator) = 0;
+};
+
+}
diff --git a/Libraries/LibWebView/WebAuthn/CBOR.cpp b/Libraries/LibWebView/WebAuthn/CBOR.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2593a1ee6ddfc67f8f62d89d49b33cdbaa33b439
--- /dev/null
+++ b/Libraries/LibWebView/WebAuthn/CBOR.cpp
@@ -0,0 +1,264 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/Utf8View.h>
+#include <LibWebView/WebAuthn/CBOR.h>
+
+namespace WebView::CBOR {
+
+// Authenticators nest a few levels deep at most; this keeps a hostile one from exhausting the stack.
+static constexpr size_t MAXIMUM_NESTING_DEPTH = 16;
+
+enum MajorType : u8 {
+    UnsignedInteger = 0,
+    NegativeInteger = 1,
+    ByteString = 2,
+    TextString = 3,
+    ArrayType = 4,
+    MapType = 5,
+    Tag = 6,
+    SimpleOrFloat = 7,
+};
+
+Value const* Value::get(i64 key) const
+{
+    if (!is_map())
+        return nullptr;
+    for (auto const& entry : value.get<Map>()) {
+        if (entry.key.is_integer() && entry.key.value.get<i64>() == key)
+            return &entry.value;
+    }
+    return nullptr;
+}
+
+Value const* Value::get(StringView key) const
+{
+    if (!is_map())
+        return nullptr;
+    for (auto const& entry : value.get<Map>()) {
+        if (entry.key.is_text() && entry.key.value.get<String>() == key)
+            return &entry.value;
+    }
+    return nullptr;
+}
+
+class Decoder {
+public:
+    explicit Decoder(ReadonlyBytes bytes)
+        : m_bytes(bytes)
+    {
+    }
+
+    size_t offset() const { return m_offset; }
+
+    ErrorOr<Value> read_value(size_t depth)
+    {
+        if (depth > MAXIMUM_NESTING_DEPTH)
+            return Error::from_string_literal("CBOR is nested too deeply");
+
+        auto initial_byte = TRY(read_byte());
+        auto major_type = static_cast<MajorType>(initial_byte >> 5);
+        auto additional_information = initial_byte & 0x1f;
+
+        if (major_type == SimpleOrFloat) {
+            switch (additional_information) {
+            case 20:
+                return Value { false };
+            case 21:
+                return Value { true };
+            case 22:
+                return Value { Null {} };
+            default:
+                return Error::from_string_literal("Unsupported CBOR simple value or float");
+            }
+        }
+
+        auto argument = TRY(read_argument(additional_information));
+
+        switch (major_type) {
+        case UnsignedInteger:
+            if (argument > static_cast<u64>(NumericLimits<i64>::max()))
+                return Error::from_string_literal("CBOR integer out of range");
+            return Value { static_cast<i64>(argument) };
+        case NegativeInteger:
+            if (argument > static_cast<u64>(NumericLimits<i64>::max()))
+                return Error::from_string_literal("CBOR integer out of range");
+            return Value { -1 - static_cast<i64>(argument) };
+        case ByteString:
+            return Value { TRY(ByteBuffer::copy(TRY(read_bytes(argument)))) };
+        case TextString: {
+            auto bytes = TRY(read_bytes(argument));
+            auto view = StringView { bytes };
+            if (!Utf8View { view }.validate())
+                return Error::from_string_literal("CBOR text string is not UTF-8");
+            return Value { TRY(String::from_utf8(view)) };
+        }
+        case ArrayType: {
+            if (argument > remaining())
+                return Error::from_string_literal("CBOR array is longer than its data");
+            Array array;
+            TRY(array.try_ensure_capacity(argument));
+            for (u64 i = 0; i < argument; ++i)
+                array.unchecked_append(TRY(read_value(depth + 1)));
+            return Value { move(array) };
+        }
+        case MapType: {
+            if (argument > remaining())
+                return Error::from_string_literal("CBOR map is longer than its data");
+            Map map;
+            TRY(map.try_ensure_capacity(argument));
+            for (u64 i = 0; i < argument; ++i) {
+                auto key = TRY(read_value(depth + 1));
+                auto value = TRY(read_value(depth + 1));
+                map.unchecked_append({ move(key), move(value) });
+            }
+            return Value { move(map) };
+        }
+        case Tag:
+            return Error::from_string_literal("CBOR tags are not supported");
+        case SimpleOrFloat:
+            break;
+        }
+        VERIFY_NOT_REACHED();
+    }
+
+private:
+    size_t remaining() const { return m_bytes.size() - m_offset; }
+
+    ErrorOr<u8> read_byte()
+    {
+        if (remaining() < 1)
+            return Error::from_string_literal("CBOR ended early");
+        return m_bytes[m_offset++];
+    }
+
+    ErrorOr<ReadonlyBytes> read_bytes(u64 length)
+    {
+        if (length > remaining())
+            return Error::from_string_literal("CBOR ended early");
+        auto bytes = m_bytes.slice(m_offset, length);
+        m_offset += length;
+        return bytes;
+    }
+
+    ErrorOr<u64> read_argument(u8 additional_information)
+    {
+        if (additional_information < 24)
+            return additional_information;
+
+        size_t length = 0;
+        switch (additional_information) {
+        case 24:
+            length = 1;
+            break;
+        case 25:
+            length = 2;
+            break;
+        case 26:
+            length = 4;
+            break;
+        case 27:
+            length = 8;
+            break;
+        default:
+            return Error::from_string_literal("Indefinite-length or reserved CBOR item");
+        }
+
+        auto bytes = TRY(read_bytes(length));
+        u64 argument = 0;
+        for (auto byte : bytes)
+            argument = (argument << 8) | byte;
+        return argument;
+    }
+
+    ReadonlyBytes m_bytes;
+    size_t m_offset { 0 };
+};
+
+ErrorOr<DecodedValue> decode_prefix(ReadonlyBytes bytes)
+{
+    Decoder decoder { bytes };
+    auto value = TRY(decoder.read_value(0));
+    return DecodedValue { move(value), decoder.offset() };
+}
+
+ErrorOr<Value> decode(ReadonlyBytes bytes)
+{
+    auto decoded = TRY(decode_prefix(bytes));
+    if (decoded.length != bytes.size())
+        return Error::from_string_literal("Trailing data after CBOR");
+    return move(decoded.value);
+}
+
+void Encoder::write_head(u8 major_type, u64 argument)
+{
+    auto initial_byte = static_cast<u8>(major_type << 5);
+    if (argument < 24) {
+        m_buffer.append(initial_byte | argument);
+    } else if (argument <= 0xff) {
+        m_buffer.append(initial_byte | 24);
+        m_buffer.append(argument);
+    } else if (argument <= 0xffff) {
+        m_buffer.append(initial_byte | 25);
+        for (int shift = 8; shift >= 0; shift -= 8)
+            m_buffer.append(argument >> shift);
+    } else if (argument <= 0xffffffff) {
+        m_buffer.append(initial_byte | 26);
+        for (int shift = 24; shift >= 0; shift -= 8)
+            m_buffer.append(argument >> shift);
+    } else {
+        m_buffer.append(initial_byte | 27);
+        for (int shift = 56; shift >= 0; shift -= 8)
+            m_buffer.append(argument >> shift);
+    }
+}
+
+void Encoder::write_integer(i64 value)
+{
+    if (value >= 0)
+        write_head(UnsignedInteger, value);
+    else
+        write_head(NegativeInteger, static_cast<u64>(-1 - value));
+}
+
+void Encoder::write_bytes(ReadonlyBytes bytes)
+{
+    write_head(ByteString, bytes.size());
+    m_buffer.append(bytes);
+}
+
+void Encoder::write_text(StringView text)
+{
+    write_head(TextString, text.length());
+    m_buffer.append(text.bytes());
+}
+
+void Encoder::write_bool(bool value)
+{
+    m_buffer.append(value ? 0xf5 : 0xf4);
+}
+
+void Encoder::write_null()
+{
+    m_buffer.append(0xf6);
+}
+
+void Encoder::begin_array(size_t length)
+{
+    write_head(ArrayType, length);
+}
+
+void Encoder::begin_map(size_t length)
+{
+    write_head(MapType, length);
+}
+
+void Encoder::write_encoded(ReadonlyBytes bytes)
+{
+    m_buffer.append(bytes);
+}
+
+}
diff --git a/Libraries/LibWebView/WebAuthn/CBOR.h b/Libraries/LibWebView/WebAuthn/CBOR.h
new file mode 100644
index 0000000000000000000000000000000000000000..cec299a91e2430b6dcb6015a3ff7c071dfc5ee58
--- /dev/null
+++ b/Libraries/LibWebView/WebAuthn/CBOR.h
@@ -0,0 +1,79 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteBuffer.h>
+#include <AK/Error.h>
+#include <AK/NonnullOwnPtr.h>
+#include <AK/String.h>
+#include <AK/Variant.h>
+#include <AK/Vector.h>
+#include <LibWebView/Export.h>
+
+// The subset of CBOR (RFC 8949) that WebAuthn and CTAP2 use: integers, byte and text strings, arrays, maps, booleans
+// and null, all of definite length. https://w3c.github.io/webauthn/#sctn-conforming-all-classes
+namespace WebView::CBOR {
+
+struct Value;
+
+using Array = Vector<Value>;
+using Map = Vector<struct MapEntry>;
+
+struct Null { };
+
+struct WEBVIEW_API Value {
+    // Integers are kept as i64 when they fit, which covers everything WebAuthn uses.
+    Variant<i64, ByteBuffer, String, Array, Map, bool, Null> value;
+
+    bool is_integer() const { return value.has<i64>(); }
+    bool is_bytes() const { return value.has<ByteBuffer>(); }
+    bool is_text() const { return value.has<String>(); }
+    bool is_map() const { return value.has<Map>(); }
+
+    // Looks up a map entry by an integer or text key.
+    Value const* get(i64 key) const;
+    Value const* get(StringView key) const;
+};
+
+struct MapEntry {
+    Value key;
+    Value value;
+};
+
+// Decodes one data item from the start of the bytes, and says how many bytes it took.
+struct DecodedValue {
+    Value value;
+    size_t length { 0 };
+};
+WEBVIEW_API ErrorOr<DecodedValue> decode_prefix(ReadonlyBytes);
+
+// Decodes bytes that hold exactly one data item.
+WEBVIEW_API ErrorOr<Value> decode(ReadonlyBytes);
+
+// Writes CBOR. Map entries are written in the order given, so writers of CTAP2 canonical CBOR sort them themselves.
+class WEBVIEW_API Encoder {
+public:
+    void write_integer(i64);
+    void write_bytes(ReadonlyBytes);
+    void write_text(StringView);
+    void write_bool(bool);
+    void write_null();
+    void begin_array(size_t length);
+    void begin_map(size_t length);
+
+    // Writes an already encoded data item as it is.
+    void write_encoded(ReadonlyBytes);
+
+    ByteBuffer finish() { return move(m_buffer); }
+
+private:
+    void write_head(u8 major_type, u64 argument);
+
+    ByteBuffer m_buffer;
+};
+
+}
