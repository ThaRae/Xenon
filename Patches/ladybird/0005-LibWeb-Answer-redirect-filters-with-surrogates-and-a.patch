From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan <ryan@esterlines.com>
Date: Mon, 26 Oct 2026 14:29:17 -0400
Subject: [PATCH] LibWeb: Answer $redirect filters with surrogates, and apply
 $removeparam

A request that a $redirect filter blocks is now answered with the
filter's surrogate (a no-op script, an empty frame, a 1x1 GIF, a stub of
an ad library), the way uBlock Origin does, instead of failing. Pages
that depend on the blocked resource keep working. The surrogate gets
CORS headers for the requesting origin, as the resource it replaces
would have had.

$removeparam filters take tracking parameters out of a request's URL in
main fetch, next to the HSTS upgrade. Like that upgrade, this changes
the request's URL in place, so a navigation's document ends up at the
cleaned URL.

The blocker now also gets the request method, so $method filters match.
---
 Libraries/LibWeb/Fetch/Fetching/Fetching.cpp | 23 ++++++++++++
 Libraries/LibWeb/Loader/ResourceLoader.cpp   | 39 +++++++++++++++++---
 2 files changed, 56 insertions(+), 6 deletions(-)

diff --git a/Libraries/LibWeb/Fetch/Fetching/Fetching.cpp b/Libraries/LibWeb/Fetch/Fetching/Fetching.cpp
index a77c8298502cf57a6b9a965586ca46adf1058f8c..0ce3a04006786c3d0a26d77da5bf81870f6eac6f 100644
--- a/Libraries/LibWeb/Fetch/Fetching/Fetching.cpp
+++ b/Libraries/LibWeb/Fetch/Fetching/Fetching.cpp
@@ -66,6 +66,7 @@
 #include <LibWeb/HTML/WorkerGlobalScope.h>
 #include <LibWeb/HighResolutionTime/TimeOrigin.h>
 #include <LibWeb/Infra/SerializedURL.h>
+#include <LibWeb/Loader/ContentBlocker.h>
 #include <LibWeb/Loader/LoadRequest.h>
 #include <LibWeb/Loader/LoaderConfig.h>
 #include <LibWeb/Loader/ResourceLoader.h>
@@ -559,6 +560,26 @@ void populate_request_from_client(Infrastructure::Request& request, Optional<HTM
         request.set_client_snapshot(client->visit([](auto const& client) { return snapshot_client_context(*client); }));
 }
 
+static URL::URL content_blocker_source_url_for_request(Infrastructure::Request&);
+
+static void remove_tracking_parameters(JS::Realm& realm, Infrastructure::Request& request)
+{
+    if (!request.current_url().scheme().is_one_of("http"sv, "https"sv))
+        return;
+
+    Optional<URL::URL> top_level_creation_url;
+    if (auto const& reserved_client = request.reserved_client_snapshot())
+        top_level_creation_url = reserved_client->top_level_creation_url;
+    else if (auto const& client = request.client_snapshot())
+        top_level_creation_url = client->top_level_creation_url;
+    if (!Bindings::principal_host_defined_page(realm).content_blocking_enabled_for_url(top_level_creation_url))
+        return;
+
+    auto decision = ContentBlocker::the().check_request(request.current_url(), content_blocker_source_url_for_request(request), request.destination(), request.initiator_type(), request.mode(), request.method());
+    if (decision.action == ContentBlocker::RequestDecision::Action::Rewrite)
+        request.current_url() = decision.url.release_value();
+}
+
 // https://fetch.spec.whatwg.org/#concept-main-fetch
 GC::Ptr<PendingResponse> main_fetch(JS::Realm& realm, Infrastructure::FetchParams const& fetch_params, Recursive recursive)
 {
@@ -633,6 +654,8 @@ GC::Ptr<PendingResponse> main_fetch(JS::Realm& realm, Infrastructure::FetchParam
         request->current_url().set_scheme("https"sv);
     }
 
+    remove_tracking_parameters(realm, *request);
+
     auto get_response = GC::create_function(GC::Heap::the(), [&realm, fetch_params = NonnullRefPtr { fetch_params }, controller = fetch_params.controller(), request]() -> GC::Ref<PendingResponse> {
         dbgln_if(WEB_FETCH_DEBUG, "Fetch: Running 'main fetch' get_response() function");
         auto const* origin = request->origin().get_pointer<URL::Origin>();
diff --git a/Libraries/LibWeb/Loader/ResourceLoader.cpp b/Libraries/LibWeb/Loader/ResourceLoader.cpp
index 39747b0204ccc11af1ad334d33785879c3b25893..d13600c3a818b3c7c4e856520c6dbdcec7af242e 100644
--- a/Libraries/LibWeb/Loader/ResourceLoader.cpp
+++ b/Libraries/LibWeb/Loader/ResourceLoader.cpp
@@ -30,6 +30,7 @@
 #include <LibWeb/Page/Page.h>
 #include <LibWeb/Platform/EventLoopPlugin.h>
 #include <LibWeb/Platform/Timer.h>
+#include <LibWebCommon/Fetch/Infrastructure/DataURL.h>
 #include <LibWebCommon/Loader/UserAgent.h>
 
 namespace Web {
@@ -292,7 +293,11 @@ static StringView blocked_resource_kind(LoadRequest const& request)
     VERIFY_NOT_REACHED();
 }
 
-static bool should_block_request(LoadRequest const& request)
+struct BlockedRequest {
+    Optional<URL::URL> surrogate;
+};
+
+static Optional<BlockedRequest> should_block_request(LoadRequest const& request)
 {
     auto const& url = request.url().value();
 
@@ -307,19 +312,39 @@ static bool should_block_request(LoadRequest const& request)
 
     if (is_port_blocked(url.port_or_default())) {
         log_failure(request, ByteString::formatted("Port #{} is blocked", url.port_or_default()));
-        return true;
+        return BlockedRequest {};
     }
 
     if (auto page = request.page(); !page || page->content_blocking_enabled_for_url(request.top_level_creation_url())) {
         auto source_url = request.source_url().value_or(url);
-        if (ContentBlocker::the().is_filtered(url, source_url, request.destination(), request.initiator_type(), request.request_mode())) {
+        auto decision = ContentBlocker::the().check_request(url, source_url, request.destination(), request.initiator_type(), request.request_mode(), request.method());
+        if (decision.action == ContentBlocker::RequestDecision::Action::Block || decision.action == ContentBlocker::RequestDecision::Action::Redirect) {
             if (page)
                 page->client().page_did_block_resource(url, blocked_resource_kind(request));
-            return true;
+            return BlockedRequest { move(decision.url) };
         }
     }
 
-    return false;
+    return {};
+}
+
+static bool respond_with_surrogate(LoadRequest const& request, URL::URL const& surrogate, ResourceLoader::OnHeadersReceived& on_headers_received, ResourceLoader::OnDataReceived& on_data_received, ResourceLoader::OnComplete& on_complete)
+{
+    auto data_url = Fetch::Infrastructure::process_data_url(surrogate);
+    if (data_url.is_error())
+        return false;
+
+    auto headers = HTTP::HeaderList::create();
+    headers->append(HTTP::Header::isomorphic_encode("Content-Type"sv, data_url.value().mime_type.serialized()));
+    if (auto origin = request.headers().get("Origin"sv); origin.has_value()) {
+        headers->append(HTTP::Header::isomorphic_encode("Access-Control-Allow-Origin"sv, *origin));
+        headers->append(HTTP::Header::isomorphic_encode("Access-Control-Allow-Credentials"sv, "true"sv));
+    }
+
+    on_headers_received.function()(nullptr, headers, 200, {}, {}, {}, Requests::CacheState::NotCached);
+    on_data_received.function()(Requests::ResponseData::from_bytes(data_url.value().body.bytes()));
+    on_complete.function()(true, {}, {});
+    return true;
 }
 
 template<typename FileHandler, typename ErrorHandler>
@@ -512,7 +537,9 @@ RefPtr<Fetch::Engine::NetworkTransportHandle> ResourceLoader::load(LoadRequest&
     log_request_start(request);
     request.start_timer();
 
-    if (should_block_request(request)) {
+    if (auto blocked = should_block_request(request); blocked.has_value()) {
+        if (blocked->surrogate.has_value() && respond_with_surrogate(request, *blocked->surrogate, *on_headers_received, *on_data_received, *on_complete))
+            return nullptr;
         on_complete->function()(false, {}, "Request was blocked"sv);
         return nullptr;
     }
