@@ -85,12 +86,23 @@ Optional<Gfx::DecodedImageFrame> CanvasHost::get_frame_from_surface()
 
 Optional<Gfx::DecodedImageFrame> CanvasHost::get_frame_for_serialization(Utf16View type)
 {
-    if (serialization_of_the_bitmap_supports_color_profiles(type))
-        return get_frame_from_surface();
-    auto bitmap = get_bitmap_from_surface();
-    if (!bitmap)
-        return {};
-    return Gfx::DecodedImageFrame { *bitmap };
+    Optional<Gfx::DecodedImageFrame> frame;
+    if (serialization_of_the_bitmap_supports_color_profiles(type)) {
+        frame = get_frame_from_surface();
+    } else if (auto bitmap = get_bitmap_from_surface()) {
+        frame = Gfx::DecodedImageFrame { *bitmap };
+    }
+    if (!frame.has_value() || !Fingerprinting::protection_enabled())
+        return frame;
+
+    auto copy_or_error = frame->bitmap().clone();
+    if (copy_or_error.is_error())
+        return frame;
+    auto copy = copy_or_error.release_value();
+    Fingerprinting::perturb_pixels({ reinterpret_cast<u8*>(copy->begin()), copy->size_in_bytes() },
+        Fingerprinting::seed_for_relevant_global(canvas_relevant_global_object()),
+        copy->has_alpha_channel() ? Fingerprinting::PixelsHaveAlpha::Yes : Fingerprinting::PixelsHaveAlpha::No);
+    return Gfx::DecodedImageFrame { *copy, frame->color_space() };
 }
 
