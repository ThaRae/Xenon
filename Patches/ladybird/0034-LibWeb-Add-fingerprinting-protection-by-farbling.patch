+/*
+ * Copyright (c) 2026, Ryan E <76752281+ThaRae@users.noreply.github.com>
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Span.h>
+#include <AK/StringView.h>
+#include <AK/Types.h>
+#include <LibJS/Forward.h>
+
+namespace Web::Fingerprinting {
+
+enum class FarbleKey : u8 {
+    HardwareConcurrency,
+    DeviceMemory,
+    Canvas,
+    Audio,
+};
+
+u64 session_secret();
+
+u64 seed_for_host(StringView host);
+
+u64 seed_for_relevant_global(JS::Object const&);
+
+u64 seed_for_current_settings_object();
+
+u64 seed_for_key(u64 seed, FarbleKey);
+
+u64 lfsr_next(u64 value);
+
+enum class PixelsHaveAlpha : u8 {
+    No,
+    Yes,
+};
+
+void perturb_pixels(Bytes rgba, u64 seed, PixelsHaveAlpha = PixelsHaveAlpha::Yes);
+
+void farble_audio(Span<float> samples, u64 seed);
+
+int farbled_hardware_concurrency(unsigned true_value, u64 seed);
+
+double farbled_device_memory_gib(double true_rounded_gib, u64 seed);
+
+bool protection_enabled();
+
+}
