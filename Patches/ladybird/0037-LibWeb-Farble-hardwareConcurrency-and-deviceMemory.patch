+
+// Off: real. Standard: stable value in [2, real] from (seed, "hardwareConcurrency");
+// if real < 2, real. Strict: 4, or real if real < 4.
+WEB_API unsigned farbled_hardware_concurrency(Seed const& seed, unsigned real);
+
+}
