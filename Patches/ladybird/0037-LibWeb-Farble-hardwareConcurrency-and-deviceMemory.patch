+ */
+
+#pragma once
+
+#include <LibWeb/Export.h>
+#include <LibWebCommon/Farbling/FarblingSeed.h>
+
+namespace Web::Farbling {
+
+// Spec buckets: 0.25, 0.5, 1, 2, 4, 8. Off: real. Standard: a bucket <= real, keyed by
+// (seed, "deviceMemory"). Strict: 8, or the real bucket if that is lower. Never outside the set.
+WEB_API double farbled_device_memory(Seed const& seed, double real);
+
+}
diff --git a/Libraries/LibWeb/Farbling/HardwareConcurrency.cpp b/Libraries/LibWeb/Farbling/HardwareConcurrency.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b4c7c5f8cbddddad6d33cf696d0acdbde5eec2a9
--- /dev/null
+++ b/Libraries/LibWeb/Farbling/HardwareConcurrency.cpp
@@ -0,0 +1,25 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/StdLibExtras.h>
+#include <LibWeb/Farbling/FarblingRNG.h>
+#include <LibWeb/Farbling/HardwareConcurrency.h>
+
+namespace Web::Farbling {
+
+unsigned farbled_hardware_concurrency(Seed const& seed, unsigned real)
+{
+    if (!seed.enabled() || real < 2)
+        return real;
+
+    if (seed.level == Level::Strict)
+        return AK::min(real, 4u);
+
+    auto span = real - 1; // [2, real] inclusive has (real - 1) values
+    return 2 + static_cast<unsigned>(RNG(seed).integer("hardwareConcurrency"sv) % span);
+}
+
+}
