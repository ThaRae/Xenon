diff --git a/Tests/LibWeb/TestHardwareFarbling.cpp b/Tests/LibWeb/TestHardwareFarbling.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..816695164a1e9db33a971b17335f2abc54c7d874
--- /dev/null
+++ b/Tests/LibWeb/TestHardwareFarbling.cpp
@@ -0,0 +1,115 @@
+/*
+ * Copyright (c) 2026, the Xenon developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibTest/TestCase.h>
+#include <LibWeb/Farbling/DeviceMemory.h>
+#include <LibWeb/Farbling/HardwareConcurrency.h>
+
+static Web::Farbling::Seed standard_seed(u64 high, u64 low)
+{
+    return { .level = Web::Farbling::Level::Standard, .high = high, .low = low };
+}
+
+TEST_CASE(concurrency_off_returns_real)
+{
+    Web::Farbling::Seed off {};
+    EXPECT_EQ(Web::Farbling::farbled_hardware_concurrency(off, 1), 1u);
+    EXPECT_EQ(Web::Farbling::farbled_hardware_concurrency(off, 2), 2u);
+    EXPECT_EQ(Web::Farbling::farbled_hardware_concurrency(off, 4), 4u);
+    EXPECT_EQ(Web::Farbling::farbled_hardware_concurrency(off, 8), 8u);
+    EXPECT_EQ(Web::Farbling::farbled_hardware_concurrency(off, 64), 64u);
+}
+
+TEST_CASE(concurrency_real_below_two_is_unchanged)
+{
+    auto seed = standard_seed(1, 2);
+    EXPECT_EQ(Web::Farbling::farbled_hardware_concurrency(seed, 1), 1u);
+    Web::Farbling::Seed strict { .level = Web::Farbling::Level::Strict, .high = 1, .low = 2 };
+    EXPECT_EQ(Web::Farbling::farbled_hardware_concurrency(strict, 1), 1u);
+}
+
+TEST_CASE(concurrency_standard_is_in_range)
+{
+    unsigned const reals[] = { 2, 4, 8, 64 };
+    for (auto real : reals) {
+        for (u64 n = 1; n <= 32; ++n) {
+            auto value = Web::Farbling::farbled_hardware_concurrency(standard_seed(n, n * 3), real);
+            EXPECT(value >= 2u);
+            EXPECT(value <= real);
+        }
+    }
+}
+
+TEST_CASE(concurrency_strict_is_four_or_real)
+{
+    Web::Farbling::Seed strict { .level = Web::Farbling::Level::Strict, .high = 9, .low = 8 };
+    EXPECT_EQ(Web::Farbling::farbled_hardware_concurrency(strict, 1), 1u);
+    EXPECT_EQ(Web::Farbling::farbled_hardware_concurrency(strict, 2), 2u);
+    EXPECT_EQ(Web::Farbling::farbled_hardware_concurrency(strict, 4), 4u);
+    EXPECT_EQ(Web::Farbling::farbled_hardware_concurrency(strict, 8), 4u);
+    EXPECT_EQ(Web::Farbling::farbled_hardware_concurrency(strict, 64), 4u);
+}
+
+TEST_CASE(concurrency_same_seed_is_deterministic)
+{
+    auto seed = standard_seed(0x0123456789abcdefULL, 0xfedcba9876543210ULL);
+    auto first = Web::Farbling::farbled_hardware_concurrency(seed, 12);
+    auto second = Web::Farbling::farbled_hardware_concurrency(seed, 12);
+    EXPECT_EQ(first, second);
+}
+
+TEST_CASE(concurrency_different_seeds_can_differ)
+{
+    bool found_difference = false;
+    auto baseline = Web::Farbling::farbled_hardware_concurrency(standard_seed(1, 1), 12);
+    for (u64 n = 2; n <= 64 && !found_difference; ++n) {
+        if (Web::Farbling::farbled_hardware_concurrency(standard_seed(n, n * 7), 12) != baseline)
+            found_difference = true;
+    }
+    EXPECT(found_difference);
+}
+
+TEST_CASE(memory_off_returns_real)
+{
+    Web::Farbling::Seed off {};
+    EXPECT_EQ(Web::Farbling::farbled_device_memory(off, 0.25), 0.25);
+    EXPECT_EQ(Web::Farbling::farbled_device_memory(off, 1.0), 1.0);
+    EXPECT_EQ(Web::Farbling::farbled_device_memory(off, 4.0), 4.0);
+    EXPECT_EQ(Web::Farbling::farbled_device_memory(off, 8.0), 8.0);
+}
+
+TEST_CASE(memory_standard_is_a_capped_spec_bucket)
+{
+    double const reals[] = { 0.25, 0.5, 1.0, 2.0, 4.0, 8.0, 64.0 };
+    double const buckets[] = { 0.25, 0.5, 1.0, 2.0, 4.0, 8.0 };
+    for (auto real : reals) {
+        for (u64 n = 1; n <= 32; ++n) {
+            auto value = Web::Farbling::farbled_device_memory(standard_seed(n, n * 5), real);
+            bool allowed = false;
+            for (auto bucket : buckets) {
+                if (value == bucket && bucket <= real)
+                    allowed = true;
+            }
+            EXPECT(allowed);
+        }
+    }
+}
+
+TEST_CASE(memory_strict_is_eight_or_real_bucket)
+{
+    Web::Farbling::Seed strict { .level = Web::Farbling::Level::Strict, .high = 3, .low = 4 };
+    EXPECT_EQ(Web::Farbling::farbled_device_memory(strict, 0.25), 0.25);
+    EXPECT_EQ(Web::Farbling::farbled_device_memory(strict, 1.0), 1.0);
+    EXPECT_EQ(Web::Farbling::farbled_device_memory(strict, 4.0), 4.0);
+    EXPECT_EQ(Web::Farbling::farbled_device_memory(strict, 8.0), 8.0);
+    EXPECT_EQ(Web::Farbling::farbled_device_memory(strict, 64.0), 8.0);
+}
+
+TEST_CASE(memory_same_seed_is_deterministic)
+{
+    auto seed = standard_seed(11, 22);
+    EXPECT_EQ(Web::Farbling::farbled_device_memory(seed, 8.0), Web::Farbling::farbled_device_memory(seed, 8.0));
+}
