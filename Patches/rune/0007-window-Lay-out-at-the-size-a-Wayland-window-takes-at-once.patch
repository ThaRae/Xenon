+    #[cfg(not(target_os = "macos"))]
+    fn take_inner_size(&mut self, size: winit::dpi::PhysicalSize<u32>) {
+        let gpu = self.gpu.as_ref().map(|(gpu, _)| &**gpu);
+        let Some(l) = self.win.as_mut() else { return };
+        if size.width == 0 || size.height == 0 || !l.resize_surface(gpu, size) { return; }
+        let scale = l.window.scale_factor() as f32;
+        self.frame_move = None;
+        self.rt.set_viewport((size.width as f32 / scale, size.height as f32 / scale), scale);
+        l.request_redraw();
+    }
