+    #[cfg(not(target_os = "macos"))]
+    fn take_inner_size(&mut self, size: winit::dpi::PhysicalSize<u32>) {
+        let (Some(l), Some((gpu, ..))) = (self.win.as_mut(), self.gpu.as_ref()) else { return };
+        if size.width == 0 || size.height == 0 || !l.resize_surface(&gpu.device, size) { return; }
